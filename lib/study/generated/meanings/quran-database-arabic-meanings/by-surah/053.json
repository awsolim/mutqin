{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 53,
  "entries": [
    {
      "verseKey": "53:1",
      "surahNumber": 53,
      "ayahNumber": 1,
      "text": "و النّجم إذا هوَى : (قسَم) بالنّجم إذا غرب و سَقط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:2",
      "surahNumber": 53,
      "ayahNumber": 2,
      "text": "ما ضلّ صاحبكم : ما عدَل الرّسول عن الحقّ و الهُـدَى (جواب القسم)\\nما غوَى : ما اعتقد باطلا قطّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:5",
      "surahNumber": 53,
      "ayahNumber": 5,
      "text": "شديد القوى : أمين الوحي جبريل عليه السلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:6",
      "surahNumber": 53,
      "ayahNumber": 6,
      "text": "ذو مرّة : قوة أو خَلْق ٍ حَسَن . أو آثار بديعة\\nفاستوى : فاسْتقام على صورته الخِلقـيّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:8",
      "surahNumber": 53,
      "ayahNumber": 8,
      "text": "دنا : قـَرُبَ جبريل من النبي صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:9",
      "surahNumber": 53,
      "ayahNumber": 9,
      "text": "قاب قوسين : قـَـدْرَ قـَوْسَيْن أو ذراعَـيْن من النبي صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:10",
      "surahNumber": 53,
      "ayahNumber": 10,
      "text": "عبده : عبد الله و هو محمد صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:12",
      "surahNumber": 53,
      "ayahNumber": 12,
      "text": "أفتمارونه : أفَتـُـكذبونه فتجادلونه صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:13",
      "surahNumber": 53,
      "ayahNumber": 13,
      "text": "نزلـَة أخرى : مرّة أخرى في صورته الخِـلـْـقـيّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:14",
      "surahNumber": 53,
      "ayahNumber": 14,
      "text": "سدرة المنتهى : التي تنتهي إليها علومُ الخلائق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:15",
      "surahNumber": 53,
      "ayahNumber": 15,
      "text": "جنّة المأوى : مُـقام أرواح الشهداء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:16",
      "surahNumber": 53,
      "ayahNumber": 16,
      "text": "يغشى السّدرة : يُغَـطّيها و يسْـتـرها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:17",
      "surahNumber": 53,
      "ayahNumber": 17,
      "text": "ما زاغ البصر : ما مال بَصَره عمّا أمِرَ برُؤيته\\nما طغى : ما جاوزه إلى ما لم يُؤمَر برُؤيته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:18",
      "surahNumber": 53,
      "ayahNumber": 18,
      "text": "لقد رآى : ليلة المِعراج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:19",
      "surahNumber": 53,
      "ayahNumber": 19,
      "text": "أفرأيْتم : فأخبروني ألهذه الأصنام قدرَة\\nاللاّت و العزّى : أصنام كانوا يعبدونها في الجاهليّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:20",
      "surahNumber": 53,
      "ayahNumber": 20,
      "text": "و مناة : أصنام كانوا يعبدونها في الجاهليّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:22",
      "surahNumber": 53,
      "ayahNumber": 22,
      "text": "قسمة ضيزى : جائِـرَة . أو عَوْجَاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:24",
      "surahNumber": 53,
      "ayahNumber": 24,
      "text": "أمْ للإنسان ما تمنّى : بل ألـَـهُ كل ما يشتهيه – لاَ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:26",
      "surahNumber": 53,
      "ayahNumber": 26,
      "text": "لا تـُـغني شفاعتهم : لاَ تدفَع . أو لا تنفع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:32",
      "surahNumber": 53,
      "ayahNumber": 32,
      "text": "الفوَاحش : ما عَظم قـُـبْحه من الذنوب\\nاللـّـمم : صغائر الذنوب\\nفلا تزكّوا أنفسكم : فلا تمدحوها بحُسْنِ الأعمال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:34",
      "surahNumber": 53,
      "ayahNumber": 34,
      "text": "أكْـدَى : قطعَ عطيّته بخْلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:37",
      "surahNumber": 53,
      "ayahNumber": 37,
      "text": "الذي وفّى : أتمّ و أكمل ما أمِر به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:38",
      "surahNumber": 53,
      "ayahNumber": 38,
      "text": "لا تـزر وازرة . . : لا تحْمِل نفسٌ آثمَة . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:42",
      "surahNumber": 53,
      "ayahNumber": 42,
      "text": "المنتهى : المصير في الآخرة للجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:46",
      "surahNumber": 53,
      "ayahNumber": 46,
      "text": "تـُمْنـَى : تدْفق في الرّحم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:47",
      "surahNumber": 53,
      "ayahNumber": 47,
      "text": "النّشأة الأخرى : الإحياء بعد الإماتة كما وَعَدَ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:48",
      "surahNumber": 53,
      "ayahNumber": 48,
      "text": "أقْـنى : أفقرَ. أو أرْضى بما أعْـطَى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:49",
      "surahNumber": 53,
      "ayahNumber": 49,
      "text": "الشِـّــعْـرى : كوكبٌ معروف كانوا يعبدونه في الجاهليّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:50",
      "surahNumber": 53,
      "ayahNumber": 50,
      "text": "عادًا الأولى : قـَـوْم هودٍ عليه السلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:51",
      "surahNumber": 53,
      "ayahNumber": 51,
      "text": "ثمود : قوم صالح عليه السلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:53",
      "surahNumber": 53,
      "ayahNumber": 53,
      "text": "المؤتـفـكة : قُرى قوم لوطٍ عليه السلام\\nأهْوى : أسْـقـَـطها إلى الأرض بعد رفعها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:54",
      "surahNumber": 53,
      "ayahNumber": 54,
      "text": "فغشّاها : ألبَسَها و غطّـاها بأنواع من العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:55",
      "surahNumber": 53,
      "ayahNumber": 55,
      "text": "آلاك ربـّــك : نِعَـمِـهِ تعالى و منها دلائل قدرته\\nتتمارى : تتشكّـك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:57",
      "surahNumber": 53,
      "ayahNumber": 57,
      "text": "أزفتِ الآزفة : اقترَبَتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:58",
      "surahNumber": 53,
      "ayahNumber": 58,
      "text": "كاشفة : نـَفـْـسٌ تكشف أهوالها و شدائدها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "53:61",
      "surahNumber": 53,
      "ayahNumber": 61,
      "text": "أنتم سامِدون : لاهون غَافـلون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
