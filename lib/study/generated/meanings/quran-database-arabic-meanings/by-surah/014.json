{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 14,
  "entries": [
    {
      "verseKey": "14:1",
      "surahNumber": 14,
      "ayahNumber": 1,
      "text": "بإذن ربّهم : بتيسيره و توفيقه لهم أو بأمره\\nالعزيز : الغالب أو الذي لا مثل له\\nالحميد : المحمود الُثنى عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:2",
      "surahNumber": 14,
      "ayahNumber": 2,
      "text": "ويلٌ : هلاك أو حسرة أو وادٍ في جهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:3",
      "surahNumber": 14,
      "ayahNumber": 3,
      "text": "يستحبّون : يختارون و يؤثرون\\nيبغونها عوجا : يطلبونها مُعوجّة أو ذات اعوجاج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:5",
      "surahNumber": 14,
      "ayahNumber": 5,
      "text": "بأيّام الله : بنعمائه أو وقائعه في الأمم الخالية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:6",
      "surahNumber": 14,
      "ayahNumber": 6,
      "text": "يسومونكم : يذيقونكم و يكلّفونكم\\nيستحيون نساءكم : يستبقون بناتكم للخدمة\\nبلاء : ابتلاء بالنّعم و النّقم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:7",
      "surahNumber": 14,
      "ayahNumber": 7,
      "text": "تأذّن ربّكم : أعلم اعلاما لا شُبهة معه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:9",
      "surahNumber": 14,
      "ayahNumber": 9,
      "text": "فردّوا أيديهم في أفواههم : عظّوا على أناملهم تغيّظا من الرّسل و كلامهم\\nمريبٍ : موقعٍ في الرّيبة و القلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:10",
      "surahNumber": 14,
      "ayahNumber": 10,
      "text": "فاطر. . : مُبدع و مُخترع . .\\nبسلطان : حجّة و برهان على صدقكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:14",
      "surahNumber": 14,
      "ayahNumber": 14,
      "text": "خاف مقامي : موقفه بين يديّ للحساب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:15",
      "surahNumber": 14,
      "ayahNumber": 15,
      "text": "استفتحوا : استنصر الرّسل بالله على الظالمين\\nخاب كلّ جبّار : خسر و هلك كلّ مُتعاظم متكبّر\\nعنيدٍ : معاند للحقّ ، مُجانب له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:16",
      "surahNumber": 14,
      "ayahNumber": 16,
      "text": "صديدٍ : ما يسيل من أجساد أهل النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:17",
      "surahNumber": 14,
      "ayahNumber": 17,
      "text": "يتجرّعه : يتكلّف بلعه لحرارته و مرارته\\nلا يكاد بسيغه : يبتلعه لشدّة كراهته و نتنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:18",
      "surahNumber": 14,
      "ayahNumber": 18,
      "text": "يوم عاصف : شديد هبوب الرّيح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:21",
      "surahNumber": 14,
      "ayahNumber": 21,
      "text": "برزوا : خرجوا من القبور للحساب\\nمُغنون عنّا : دافِعون عنّا\\nمحيصٍ : منجى و مهرب و مزاغ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:22",
      "surahNumber": 14,
      "ayahNumber": 22,
      "text": "سلطان : تسلّط أو حجّة\\nبمصرخكم : بمُغيثكم من العذاب\\nبمصرخيّ : بمغيثيّ من العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:25",
      "surahNumber": 14,
      "ayahNumber": 25,
      "text": "كلمةً طيّبةً : كلمة التوحيد و الإسلام\\nتُؤتي أُكلها : تعطي ثمرها الذي يُؤكل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:26",
      "surahNumber": 14,
      "ayahNumber": 26,
      "text": "كلمة خبيثة : كلمة الكفر و الضّلال\\nاجتُثّت : اقتُلِعت جثّتها من أصلها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:27",
      "surahNumber": 14,
      "ayahNumber": 27,
      "text": "في الحياة الدّنيا : في القبر عند السّؤال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:28",
      "surahNumber": 14,
      "ayahNumber": 28,
      "text": "دار البوار : دار الهلاك ( جهنّم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:29",
      "surahNumber": 14,
      "ayahNumber": 29,
      "text": "يصلونها : يدخلونها أو يُقاسون حرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:30",
      "surahNumber": 14,
      "ayahNumber": 30,
      "text": "أندادا : أمثالا من الأوثان يعبدونها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:31",
      "surahNumber": 14,
      "ayahNumber": 31,
      "text": "لا خِلالٌ : لا مُخالّة و لا مُوادّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:33",
      "surahNumber": 14,
      "ayahNumber": 33,
      "text": "دائبين : دائمين في منافعهما لكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:34",
      "surahNumber": 14,
      "ayahNumber": 34,
      "text": "لا تُحصوها : لا تطيقوا عدّها لعدم تناهيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:35",
      "surahNumber": 14,
      "ayahNumber": 35,
      "text": "اجنبني : أبعِدني و نحّني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:37",
      "surahNumber": 14,
      "ayahNumber": 37,
      "text": "تهوي إليهم : تسرع إليه شوقا و وٍدادا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:42",
      "surahNumber": 14,
      "ayahNumber": 42,
      "text": "تشخص فيه الأبصار : ترتفع دون أن تطرف من الهول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:43",
      "surahNumber": 14,
      "ayahNumber": 43,
      "text": "مهطعين : مسرعين إلى الدّاعي بذلّة\\nمقنعي رءوسهم : رافعيها مديمي النّظر للأمام\\nأفئدتهم هواء : قلوبهم خالية لا تعي لفرط الحيرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:48",
      "surahNumber": 14,
      "ayahNumber": 48,
      "text": "برزوا لله : خرجوا من القبور للحساب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:49",
      "surahNumber": 14,
      "ayahNumber": 49,
      "text": "مقرّنين : مقرونا بعضهم مع بعض\\nالأصفاد : القيود أو الأغلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:50",
      "surahNumber": 14,
      "ayahNumber": 50,
      "text": "سرابيلهم : قمصانهم أو ثيابهم\\nتغشى وجوههم : تغطّيها و تجلّلها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "14:52",
      "surahNumber": 14,
      "ayahNumber": 52,
      "text": "بلاغ للنّاس : كفاية في الغظة و التذكير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
