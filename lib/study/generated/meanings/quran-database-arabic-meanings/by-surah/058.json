{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 58,
  "entries": [
    {
      "verseKey": "58:1",
      "surahNumber": 58,
      "ayahNumber": 1,
      "text": "تجادلك : تحاورُك و تـُـراجعك الكلام\\nتحاوركما : مراجعتكما القوْل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:2",
      "surahNumber": 58,
      "ayahNumber": 2,
      "text": "يظاهرون : يُحَرّمون نساءَهمْ تحريم أمّهاتهم\\nمنكرا من القول : فظيعا منه يُنكِرهالشرع و العَقل\\nزورا : كذِبا باطلاً مُـنـحَرفا عن الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:3",
      "surahNumber": 58,
      "ayahNumber": 3,
      "text": "يتماسّـا : يستمْـتعا بالوقاع ، أو دواعيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:5",
      "surahNumber": 58,
      "ayahNumber": 5,
      "text": "يحادّون : يعادون و يشاقّـون و يخالفون\\nكبتوا : أذلـّـوا أو أهلكوا . أوْ لعِنوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:6",
      "surahNumber": 58,
      "ayahNumber": 6,
      "text": "أحصاه الله : أحاط به عِلما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:7",
      "surahNumber": 58,
      "ayahNumber": 7,
      "text": "نجوى ثلاثة : تـَـنـَـاجيهم و مُـسارّتهمْ\\nهو رابعهم : بعلمه حيث يطلِع على نجواهم\\nهو معهم : بعلمه المحيط بكل شيء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:8",
      "surahNumber": 58,
      "ayahNumber": 8,
      "text": "لولا يعذبنا : هلاّ يعذبنا\\nحسبهم جهنم : كافيهم جهنّم عذابا\\nيَصلونها : يدخلونها أو يُقاسون حرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:10",
      "surahNumber": 58,
      "ayahNumber": 10,
      "text": "إنما النجوى : المَنهيّ عنها\\nليَحْـزن : ليُوقِع في الهمّ الشديد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:11",
      "surahNumber": 58,
      "ayahNumber": 11,
      "text": "تفسّحوا في المجالس : توَسّـعوا فيها و لا تضامّوا\\nانشزوا : انهضوا للتوسعة أو لعبادةٍ أو خيْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:13",
      "surahNumber": 58,
      "ayahNumber": 13,
      "text": "ءَأشـفـقـتـمْ : أخِفـتم الفقر و العَيلة\\nتاب الله عليكم : خفّـف عنكم بنسخ حكمِها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:14",
      "surahNumber": 58,
      "ayahNumber": 14,
      "text": "إلى الذين : هم المنافقون\\nتوَلوْا قومًا : اتـّـخذوا اليهود أولياء\\nغضب الله عليه : هم اليهود",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:16",
      "surahNumber": 58,
      "ayahNumber": 16,
      "text": "جُـنّـة : وقاية لأنفسهم و أموالهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:17",
      "surahNumber": 58,
      "ayahNumber": 17,
      "text": "لنْ تغنِيَ . . : لن تدفع . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:19",
      "surahNumber": 58,
      "ayahNumber": 19,
      "text": "استحوذ عليهم : اسْـتولى و غلبَ على عقولهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:20",
      "surahNumber": 58,
      "ayahNumber": 20,
      "text": "يُحادّون : يُـعادون و يُشاقّـون و يُخالفون\\nالأذلين : الزّائدين في الذلة و الهوان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:21",
      "surahNumber": 58,
      "ayahNumber": 21,
      "text": "عزيزٌ : غالب على أعدائه غير مغلوب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "58:22",
      "surahNumber": 58,
      "ayahNumber": 22,
      "text": "بروح منه : بنور يقذفه في قلوبهم . أو بالقرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
