{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 56,
  "entries": [
    {
      "verseKey": "56:1",
      "surahNumber": 56,
      "ayahNumber": 1,
      "text": "وقعت الواقعة : قامت القيامة بنفخة البعْث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:2",
      "surahNumber": 56,
      "ayahNumber": 2,
      "text": "كاذبة : نفْسٌ كاذبة تـُـنـْـكر وقوعها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:3",
      "surahNumber": 56,
      "ayahNumber": 3,
      "text": "خافضة رافعة : هي خافضة للأشقياء رافعة للسّعداء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:4",
      "surahNumber": 56,
      "ayahNumber": 4,
      "text": "رُجّت الأرض : زلزلتْ وحُرّكت تحريكا بشدة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:5",
      "surahNumber": 56,
      "ayahNumber": 5,
      "text": "بُسّت الجبال : فـتـّـتْ كالسّويق المَـلْـتوت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:6",
      "surahNumber": 56,
      "ayahNumber": 6,
      "text": "هباءً منبثـّـا : غبارًا متفرقا منتشِرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:7",
      "surahNumber": 56,
      "ayahNumber": 7,
      "text": "كنتم أزواجا : أصنافا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:8",
      "surahNumber": 56,
      "ayahNumber": 8,
      "text": "فأصحاب الميمنة : اليُـمْن و البركة . أو ناحية اليمين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:9",
      "surahNumber": 56,
      "ayahNumber": 9,
      "text": "أصحاب المشأمة : الشؤم . أو ناحية الشمال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:13",
      "surahNumber": 56,
      "ayahNumber": 13,
      "text": "ثـلـّـة : هم أمّة من الناس كثيرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:15",
      "surahNumber": 56,
      "ayahNumber": 15,
      "text": "سُرُر موضونة : منسوجة من الذهب بإحكام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:17",
      "surahNumber": 56,
      "ayahNumber": 17,
      "text": "ولدان مُخلّدون : مُبْـقون على هيئة الولدان في البهاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:18",
      "surahNumber": 56,
      "ayahNumber": 18,
      "text": "بأكواب : أقداح لا عُرى لها و لا خراطيم\\nأباريق : أوان لها عُرى و خراطيم\\nكأس : خمْر أو قدَح فيه خمْر\\nمن معين : خمْر جارية من العيون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:19",
      "surahNumber": 56,
      "ayahNumber": 19,
      "text": "لا يُصدّعون عنها : لا يُصيبهم صداع بشربها\\nلا يُنزفون : لا تذهَبُ عقولهم بسببها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:22",
      "surahNumber": 56,
      "ayahNumber": 22,
      "text": "حورٌ عين : نساء بيض واسعات الأعين حِسانُها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:23",
      "surahNumber": 56,
      "ayahNumber": 23,
      "text": "اللؤلؤ المكنون : المصون في أصدافه مما يغيّره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:25",
      "surahNumber": 56,
      "ayahNumber": 25,
      "text": "لغْوًا : كلاما لا خير فيه أو باطلا\\nو لا تأثيما : ولا نسبة إلى الإثم أو لا ما يوجبه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:28",
      "surahNumber": 56,
      "ayahNumber": 28,
      "text": "في سِدْر : في شجر النـّـبَـق ينعّمون به\\nمخضود : مقطوع شوكه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:29",
      "surahNumber": 56,
      "ayahNumber": 29,
      "text": "طلح : شجر الموز أو مثله\\nمنضود : نضّد بالحمْل من أسفله إلى أعلاه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:30",
      "surahNumber": 56,
      "ayahNumber": 30,
      "text": "ظل ممدود : دائم لا يتقلّص أو ممتدّ منبسط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:31",
      "surahNumber": 56,
      "ayahNumber": 31,
      "text": "ماءٍ مسكوب : مصبوب يجري في غير أخاديد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:34",
      "surahNumber": 56,
      "ayahNumber": 34,
      "text": "مرفوعة : على الأسرّة أو منضدّة مرتفعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:37",
      "surahNumber": 56,
      "ayahNumber": 37,
      "text": "عُرُبا : متحبّبات إلى أزواجهنّ\\nأترابا : مسْتويات في السّنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:42",
      "surahNumber": 56,
      "ayahNumber": 42,
      "text": "سموم : ريح شديدة الحرارة تدخل المَسام\\nحميم : ماءٍ بالغ غاية الحرارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:43",
      "surahNumber": 56,
      "ayahNumber": 43,
      "text": "يَحْموم : دخان شديد السّواد أو نار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:44",
      "surahNumber": 56,
      "ayahNumber": 44,
      "text": "لا كريم : لا نافع من أذى الحرّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:45",
      "surahNumber": 56,
      "ayahNumber": 45,
      "text": "مُترَفين : منعّمين متّبعين أهواء أنفسهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:46",
      "surahNumber": 56,
      "ayahNumber": 46,
      "text": "الحِنث : الذنب العظيم – الشرك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:52",
      "surahNumber": 56,
      "ayahNumber": 52,
      "text": "زقوم : شجر كريه جدّا في النار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:55",
      "surahNumber": 56,
      "ayahNumber": 55,
      "text": "شرب الهيم : الإبل العِطاش التي لا تروى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:56",
      "surahNumber": 56,
      "ayahNumber": 56,
      "text": "هذا نزلهم : ما أعدّ لهم من الجزاء\\nيوم الدين : يوم الجزاء ( يوم القيامة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:58",
      "surahNumber": 56,
      "ayahNumber": 58,
      "text": "أفرأيتم : أخبروني\\nما تـُـمْـنون : المنيّ الذي تقذفونه في الأرحام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:59",
      "surahNumber": 56,
      "ayahNumber": 59,
      "text": "تخلقونه : تصوّرونه بشرًا سويّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:60",
      "surahNumber": 56,
      "ayahNumber": 60,
      "text": "بمسبوقين : بمغلوبين عاجزين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:63",
      "surahNumber": 56,
      "ayahNumber": 63,
      "text": "ما تحرثون : البَذر الذي تلقونه في الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:64",
      "surahNumber": 56,
      "ayahNumber": 64,
      "text": "تزرعونه : تنبتونه حتى يشتدّ و يبلغ الغاية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:65",
      "surahNumber": 56,
      "ayahNumber": 65,
      "text": "حُطاما : هشيما متكسّرا لا يُنتفع به\\nتفكّهون : تتعجّبون من سوء حاله و مصيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:66",
      "surahNumber": 56,
      "ayahNumber": 66,
      "text": "إنّـا لمُغرمون : مُهلكون بهلاك رزقنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:67",
      "surahNumber": 56,
      "ayahNumber": 67,
      "text": "محرومون : ممنوعون الرّزق بالكلّـيّـة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:69",
      "surahNumber": 56,
      "ayahNumber": 69,
      "text": "المُـزن : السّحاب أو الأبيض منه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:70",
      "surahNumber": 56,
      "ayahNumber": 70,
      "text": "جعلناه أجاجا : مِلحًا زُعاقا أو مُرّا لا يُمكن شربه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:71",
      "surahNumber": 56,
      "ayahNumber": 71,
      "text": "النّار التي تورون : تقدحون الزّناد لاستخراجها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:73",
      "surahNumber": 56,
      "ayahNumber": 73,
      "text": "تذكرة : تذكيرا لنار جهنّم\\nمتاعا للمقوين : مَنفعَة للمسافرين في القـَـوَاءِ (القـَـفـْـر) أو المُحتاجين إليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:75",
      "surahNumber": 56,
      "ayahNumber": 75,
      "text": "فلا أقسم : \\\"فأقسِم و \\\"\\\"لا\\\"\\\" مزيدة للتأكيد\\\"\\nبمواقع النجوم : بمغاربها . أو منازلها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:77",
      "surahNumber": 56,
      "ayahNumber": 77,
      "text": "إنّه لقرآن كريم : نـفّـاعٌ جمّ المنافع . أو رفيع القدْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:78",
      "surahNumber": 56,
      "ayahNumber": 78,
      "text": "كتاب مكنون : مستور مصون عند الله في اللوح المحفوظ من السّوء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:79",
      "surahNumber": 56,
      "ayahNumber": 79,
      "text": "لا يَمسّه إلا المطهّرون : صفة أخرى للقرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:81",
      "surahNumber": 56,
      "ayahNumber": 81,
      "text": "أنتم مُدهنون : مُتهاونون أو مكذبون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:82",
      "surahNumber": 56,
      "ayahNumber": 82,
      "text": "تجعلون رزقكم : شكركم على الإنعام به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:83",
      "surahNumber": 56,
      "ayahNumber": 83,
      "text": "بلغت الحلقوم : بلغت الرّوح الحلقوم عند المَوْت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:85",
      "surahNumber": 56,
      "ayahNumber": 85,
      "text": "نحن أقرب إليه : بعِلمِنا و قدْرَتنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:86",
      "surahNumber": 56,
      "ayahNumber": 86,
      "text": "غير مَدينين : غير مربوبين مقهورين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:89",
      "surahNumber": 56,
      "ayahNumber": 89,
      "text": "فرَوْح : فله استراحة أو رحمة\\nريحان : رزق حسن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "56:93",
      "surahNumber": 56,
      "ayahNumber": 93,
      "text": "فـنُـزُلٌ : فله قِرًى و ضِيافة\\nحميم : ماءٍ تناهت حرارته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
