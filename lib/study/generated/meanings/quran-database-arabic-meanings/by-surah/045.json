  "surahNumber": 45,
  "entries": [
    {
      "verseKey": "45:4",
      "surahNumber": 45,
      "ayahNumber": 4,
      "text": "يبثّ : يَنشر و يفرّق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:5",
      "surahNumber": 45,
      "ayahNumber": 5,
      "text": "تصريف الرياح : تقليبها في مهابّها و أحوالها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:7",
      "surahNumber": 45,
      "ayahNumber": 7,
      "text": "ويْلٌ : هلاكٌ ، أو حَسرة أو شدة عذاب\\nأفّاك أثيم : كذاب كثير الإثم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:9",
      "surahNumber": 45,
      "ayahNumber": 9,
      "text": "اتـّـخذها هزوا : سخريّة أو مهزوءً بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:10",
      "surahNumber": 45,
      "ayahNumber": 10,
      "text": "لا يغني عنهم . . : لا يدفع عنهم . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:11",
      "surahNumber": 45,
      "ayahNumber": 11,
      "text": "رجْزٌ : أشدّ العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:14",
      "surahNumber": 45,
      "ayahNumber": 14,
      "text": "لا يرجون أيام الله : لا يتوقعون وقائعه بأعدائه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:17",
      "surahNumber": 45,
      "ayahNumber": 17,
      "text": "يغيا بينهم : حسدا و عداوة بينهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:18",
      "surahNumber": 45,
      "ayahNumber": 18,
      "text": "شريعة من الأمر : طريقة و منهاج من أمر الدين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:19",
      "surahNumber": 45,
      "ayahNumber": 19,
      "text": "لن يغنوا عنك : لن يدفعوا عنك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:20",
      "surahNumber": 45,
      "ayahNumber": 20,
      "text": "بصائر للناس : بيّـنات تبصّرُهم سبيل الفلاح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:21",
      "surahNumber": 45,
      "ayahNumber": 21,
      "text": "اجترحوا السيئات : اكتسبوا المعاصي و الكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:23",
      "surahNumber": 45,
      "ayahNumber": 23,
      "text": "أفرأيت : أخبرني\\nغشاوة : غطاءً حتى لا يُـبْـصِرَ الرّشد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:28",
      "surahNumber": 45,
      "ayahNumber": 28,
      "text": "جاثية : باركة على الرّكب لشدة الهوْل\\nكتابها : صحائف أعمالها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:29",
      "surahNumber": 45,
      "ayahNumber": 29,
      "text": "نستنسخ . . : نأمر الملائكة بنسخ . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:33",
      "surahNumber": 45,
      "ayahNumber": 33,
      "text": "حاقَ بهم : نزَل أو أحاط بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:34",
      "surahNumber": 45,
      "ayahNumber": 34,
      "text": "ننساكم : نترككم في العذاب\\nمأواكم النار : منزلكم و مقرّكم النّـار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:35",
      "surahNumber": 45,
      "ayahNumber": 35,
      "text": "غرتكم . . : خدعتكم ببهرَجها . .\\nيستعتبون : يُطلب منهم الرجوع إلى ما يرضي الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "45:37",
      "surahNumber": 45,
      "ayahNumber": 37,
      "text": "له الكبرياء : العظمة و الملك و الجلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
