{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 34,
  "entries": [
    {
      "verseKey": "34:2",
      "surahNumber": 34,
      "ayahNumber": 2,
      "text": "ما يلِج في الأرض : ما يدخل فيها من مطر و غيره\\nما يعرج : ما يصعد من الملائكة و الأعمال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:3",
      "surahNumber": 34,
      "ayahNumber": 3,
      "text": "لا يعزب عنه : لا يغيب عنه و لا يخفى عليه\\nمثقال ذرّة : مفدار أصغر نملة أو هَباءة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:5",
      "surahNumber": 34,
      "ayahNumber": 5,
      "text": "معاجزين : مسابقين ظانّين أنّهم يفوتوننا\\nمن رجز : أشدّ العذاب و أسرئه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:7",
      "surahNumber": 34,
      "ayahNumber": 7,
      "text": "مُـزقْـتم : قطّعتم و صرتم رفاتا و ترابا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:8",
      "surahNumber": 34,
      "ayahNumber": 8,
      "text": "به جـِـنّة : به جنون يوهِمه ما يقول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:9",
      "surahNumber": 34,
      "ayahNumber": 9,
      "text": "نخسف بهم الأرض : نغيّب بهم الأرض كقارون\\nكسَفا من السّماء : قطعا منها كأصحاب الأيكة\\nمنيب : راجـِع إلى ربّه بالتـّوبة و الطاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:10",
      "surahNumber": 34,
      "ayahNumber": 10,
      "text": "أوّبي معه : سَبّحِي أو رَجّعي معه التسبيح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:11",
      "surahNumber": 34,
      "ayahNumber": 11,
      "text": "اعمل سابغات : دُروعا واسعةً كاملة\\nقدّر في السّرد : أَحْكِم صَنعتك في نسج الدّروع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:12",
      "surahNumber": 34,
      "ayahNumber": 12,
      "text": "غّدوّها شهر : جَرْيها بالغداة مسيرة شهر\\nرواحها شهر : جَرْيُها بالعشيّ كذلك\\nعين القِطر : عين النّحاس فَـنَـبَع ذائبا كالماء\\nيزغ منهم : يَمِلْ و يَعْدِلْ منهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:13",
      "surahNumber": 34,
      "ayahNumber": 13,
      "text": "من محاريب : قصور أو مساجد\\nتماثيل : صُوَرٍ مُجسّمة من نحاس و غيره\\nجفان كالجواب : قصاع كباركالحـِـياض العظام\\nقدور راسيات : ثابتات على المواقد لِعِظمها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:14",
      "surahNumber": 34,
      "ayahNumber": 14,
      "text": "دابّة الأرض : الأرضة التي تأكل الخشب\\nتأكل منسأته : تـَـأْرضُ عصَاه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:15",
      "surahNumber": 34,
      "ayahNumber": 15,
      "text": "لِـسَـبإ : حيّ بمأرب باليمن\\nآية : على قدرتنا أو عبرة و عِظة\\nجنّـتان : بستانان أو جماعتان من البساتين\\nبلدة طيّبة : زكيّة مُستـَـلَذة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:16",
      "surahNumber": 34,
      "ayahNumber": 16,
      "text": "فأعرضوا : عن الشّكر أو كذبوا أنبياءهم\\nسيل العرم : سيل السّــدّ . أو المطر الشّديد\\nأكل خمطٍ : ثمرٍ مرّ حامض بشع\\nأثل : ضرْب من الطّرفاء\\nسِدْر : الضّالِ أو شجرة النّبق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:18",
      "surahNumber": 34,
      "ayahNumber": 18,
      "text": "القرى : قرى الشام\\nقرًى ظاهرة : متواصلة متقاربة\\nقدّرنا فيها السّير : جعلناه على مراحل متقاربة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:19",
      "surahNumber": 34,
      "ayahNumber": 19,
      "text": "فجعلناهم أحاديث : أخبارا يُتلهّى بها و يُتعجّبُ منها\\nمزقناهم : فرّقناهم في البلاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:20",
      "surahNumber": 34,
      "ayahNumber": 20,
      "text": "صدّق عليهم : حقّق عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:21",
      "surahNumber": 34,
      "ayahNumber": 21,
      "text": "سلطان : تسلـّـط و استيلاء بالوسوسو و الإغواء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:22",
      "surahNumber": 34,
      "ayahNumber": 22,
      "text": "مثقال ذرّة : وزْنها من نفع أو ضُرّ\\nظهيرٍ : مُعين على الخلق و التـّـدبير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:23",
      "surahNumber": 34,
      "ayahNumber": 23,
      "text": "فُـزّع عن قلوبهم : أزيل عنها الفزع و الخوف\\nالحقّ : قال القول الحقّ (الإذن بالشّـفاعة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:25",
      "surahNumber": 34,
      "ayahNumber": 25,
      "text": "أجرمنا : اكتسبنا من الزّلات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:26",
      "surahNumber": 34,
      "ayahNumber": 26,
      "text": "يفتح بيننا : يقضي و يحكم بيننا\\nهو الفتـّاح : القاضي و الحاكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:27",
      "surahNumber": 34,
      "ayahNumber": 27,
      "text": "كلاّ : ارتدعوا عن دعوى الشركة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:28",
      "surahNumber": 34,
      "ayahNumber": 28,
      "text": "كافّة للنّاس : إلى النّاس جميعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:31",
      "surahNumber": 34,
      "ayahNumber": 31,
      "text": "مَوْقوفون : محبوسُون في موقف الحساب\\nيرجع . . : يَرُدّ . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:33",
      "surahNumber": 34,
      "ayahNumber": 33,
      "text": "مَكرُ الليل و النّهار : صَدّ نا مكْرُهم بنا فيهما\\nأندادا : أمثالا من مخلوقاته نعبُدُها\\nأسرّوا النّـدامة : أخفوا الندم أو أظهروه\\nالأغلال : القيود تجمع الأيدي إلى الأعناق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:34",
      "surahNumber": 34,
      "ayahNumber": 34,
      "text": "مُـترفوها : مُـتـنـعّـموها و قادة الشّر فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:36",
      "surahNumber": 34,
      "ayahNumber": 36,
      "text": "يَقـْـدِر : يضيّقه على من يشاء بحكمته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:37",
      "surahNumber": 34,
      "ayahNumber": 37,
      "text": "زلفَى : تقريبا\\nلهم جزاء الضّعف : لهم الثواب المضاعف\\nفي الغرفات : المنازل الرّفيعة العالية في الجنّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:38",
      "surahNumber": 34,
      "ayahNumber": 38,
      "text": "مُعاجزين : مُسابقينا ظانين أنهم يفوتوننا\\nمُحضرون : تُحضرهم الزبانية إلى جهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:39",
      "surahNumber": 34,
      "ayahNumber": 39,
      "text": "يَـقـْـدِرُ له : يُضيّـقه على من يشاء بحكمته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:41",
      "surahNumber": 34,
      "ayahNumber": 41,
      "text": "أنت وليّـنا : أنت الذي نواليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:43",
      "surahNumber": 34,
      "ayahNumber": 43,
      "text": "إفك مفترى : كذِب مُختلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:45",
      "surahNumber": 34,
      "ayahNumber": 45,
      "text": "معشار ما آتيناهم : عُشر ما أعطيناهم من النّعم\\nكان نكير : إنكاري عليهم بالتـّـدمير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:46",
      "surahNumber": 34,
      "ayahNumber": 46,
      "text": "من جـِـنّة : من جنون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:48",
      "surahNumber": 34,
      "ayahNumber": 48,
      "text": "يقذف بالحقّ : يرمي به الباطل فيدمغه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:51",
      "surahNumber": 34,
      "ayahNumber": 51,
      "text": "فزعوا : خافوا عند الموت أو البعث\\nفلا فوْت : فلا مهرَبَ و لا نجاة من العذاب\\nمكان قريب : موقف الحساب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:52",
      "surahNumber": 34,
      "ayahNumber": 52,
      "text": "التـّـناوُش : تناوُل الإيمان و التـّـوبة\\nمكان بعيد : هو الآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:53",
      "surahNumber": 34,
      "ayahNumber": 53,
      "text": "يقذفون بالغيْب : يرجمون بالظّـنون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "34:54",
      "surahNumber": 34,
      "ayahNumber": 54,
      "text": "بأشياعهم : بأمثالهم من الكفّار\\nمُريب : موقع في الرّيبة و القلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
