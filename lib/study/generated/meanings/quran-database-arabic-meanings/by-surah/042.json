{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 42,
  "entries": [
    {
      "verseKey": "42:5",
      "surahNumber": 42,
      "ayahNumber": 5,
      "text": "يتـفطّـرن : يتشقـّـقـْـنَ من عظمته تعالى و جلاله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:6",
      "surahNumber": 42,
      "ayahNumber": 6,
      "text": "أوْلياءَ : معْبودات يزعمون نصْرَتـَـها لهم\\nالله حفيظ عليهم : رقيبٌ على أعمالهم و مُجَازيهمْ\\nبوَكيل : بمَوْكولٍ إليك أمرهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:7",
      "surahNumber": 42,
      "ayahNumber": 7,
      "text": "أمّ القرى : مَكّة: أي أهلها\\nيَوم الجَمع : يومَ القيامة لاجتماع الخلائق فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:10",
      "surahNumber": 42,
      "ayahNumber": 10,
      "text": "إليه أنيبُ : إليه أرجع في كلّ الأمور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:11",
      "surahNumber": 42,
      "ayahNumber": 11,
      "text": "فاطِرُ . . : مبْدع و مخترع . .\\nمن أنفسكم أزْواجًا : حلائل\\nمن الأنعام أزواجًا : أصنافا ذكورا و إناثا\\nيَذرَؤكمْ فيه : يَـذرؤكم فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:12",
      "surahNumber": 42,
      "ayahNumber": 12,
      "text": "له مقاليد . . : له مقاليد . .\\nيَقدِرُ : يَقدِر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:13",
      "surahNumber": 42,
      "ayahNumber": 13,
      "text": "شـَـرَعَ لكم . . : شرَعَ لكم . .\\nما وصّى : ما وصّى\\nأقيموا الدّين : أقيموا الدّين\\nكَـبُـرَ. . : كَبُرَ. .\\nيَـجْـتـَـبي : يجْتـَـبي\\nيُنيبُ : ينيب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:14",
      "surahNumber": 42,
      "ayahNumber": 14,
      "text": "بَغْياً بَيْـنـَـهمْ : بَغيا بَينهمْ\\nمُريبٍ : مريب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:15",
      "surahNumber": 42,
      "ayahNumber": 15,
      "text": "اسْقِـمْ : استقمْ\\nلا حُجّة : لا حجّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:16",
      "surahNumber": 42,
      "ayahNumber": 16,
      "text": "استجيب له : استجيبَ له\\nحُجّـتهم داحضة : حُجّـتـهمْ دَاحِضة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:17",
      "surahNumber": 42,
      "ayahNumber": 17,
      "text": "الميزان : العدّل و التـّسوية في الحقوق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:18",
      "surahNumber": 42,
      "ayahNumber": 18,
      "text": "مُشفقون منها : خائفون منها مع اعتنائهم بها\\nيُمَارون في الساعة : يُجَادلون . أوْ يَشكّونَ فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:19",
      "surahNumber": 42,
      "ayahNumber": 19,
      "text": "لطيف بعباده : بَرٌّ رفيقٌ بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:20",
      "surahNumber": 42,
      "ayahNumber": 20,
      "text": "حَرْث الآخرة : ثوَابَها الموعود . أو العمل لها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:21",
      "surahNumber": 42,
      "ayahNumber": 21,
      "text": "كلمة الفَصْـل : الحكم بتأخير العذاب للآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:22",
      "surahNumber": 42,
      "ayahNumber": 22,
      "text": "رَوضات الجنّـات : مَحَاسنها و مَلاذها أو أطيب بـِـقاعها و أنزهِها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:23",
      "surahNumber": 42,
      "ayahNumber": 23,
      "text": "يقترف حسنة : يَكـتـَـسِبْ طاعة ً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:27",
      "surahNumber": 42,
      "ayahNumber": 27,
      "text": "لبَغَوْا : لـَـطغَـوْا و تجـبّـروا . أو لظلموا\\nيُـنـَـزّل بـِقـَـدَرٍ : بتقدير حكيم مُحْكَمٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:28",
      "surahNumber": 42,
      "ayahNumber": 28,
      "text": "قـَـنـَطوا : يَـئـسوا من نزوله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:29",
      "surahNumber": 42,
      "ayahNumber": 29,
      "text": "بَثّ فيهما : فرّق و نـَـشرَ فيهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:31",
      "surahNumber": 42,
      "ayahNumber": 31,
      "text": "بمُعْجزينَ : بفائتينَ من العذاب بالهرَب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:32",
      "surahNumber": 42,
      "ayahNumber": 32,
      "text": "الجوَار : السّـفن الجَاريَة\\nكالأعلام : كالجبال . أو القصور العالية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:33",
      "surahNumber": 42,
      "ayahNumber": 33,
      "text": "فيظللن رَواكدَ : فيَـصِرْن ثوَابت سَوَاكن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:34",
      "surahNumber": 42,
      "ayahNumber": 34,
      "text": "يوبقـْـبهنّ : يُهلكْهنّ بالغرَق أي أهلهنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:35",
      "surahNumber": 42,
      "ayahNumber": 35,
      "text": "مَحيص : مَهْرَب و مَخلَصٍ من العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:37",
      "surahNumber": 42,
      "ayahNumber": 37,
      "text": "الفواحش : مَا عَــُظمَ قبْحه من الذنوب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:38",
      "surahNumber": 42,
      "ayahNumber": 38,
      "text": "أمرهمْ شورى : يَتشاوَرون و يَترَاجعون فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:39",
      "surahNumber": 42,
      "ayahNumber": 39,
      "text": "أصابهم البَغْي : نـَـالهم الظلْم و العدْوَان\\nينتصرون : ينتقمون ممّن ظلمهمْ و لا يَعْـتدون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:42",
      "surahNumber": 42,
      "ayahNumber": 42,
      "text": "يَبْـغون في الأرض : يُـفـسدون . أو يَتجبّـرون فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:45",
      "surahNumber": 42,
      "ayahNumber": 45,
      "text": "خاشعين : خاضعين متضائلين\\nينظرون منْ طرْفٍ خفيّ : يُسَارقون النّظر منْ شدّة الخوف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:47",
      "surahNumber": 42,
      "ayahNumber": 47,
      "text": "نكير : إنكار لذنوبكمْ أو مُنْكر لعَذابكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:48",
      "surahNumber": 42,
      "ayahNumber": 48,
      "text": "فرح بها : بَطِرَ لأجْـلِها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "42:52",
      "surahNumber": 42,
      "ayahNumber": 52,
      "text": "روحا : قرآناً . أو نبُـوّة أو جبريل\\nالإيمان : الشّرائع الـتـّـفصيلـيّـة التي لا تـُـعْـلـَـم إلا بالوَحْي\\nصراطٍ مستقيم : دينٍ قويم (دين الإسلام)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
