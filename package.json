  "scripts": {
    "import:mushaf": "node scripts/import-mushaf.mjs",
    "import:irab": "tsc scripts/import-irab-from-quran-db.ts --module commonjs --target es2020 --outDir .tmp/irab-import --esModuleInterop --skipLibCheck && node .tmp/irab-import/import-irab-from-quran-db.js",
    "inspect:furqan": "tsc scripts/inspect-furqan-data.ts --module commonjs --target es2020 --outDir .tmp/furqan-inspect --esModuleInterop --skipLibCheck && node .tmp/furqan-inspect/inspect-furqan-data.js",
    "import:irab:furqan": "tsc scripts/import-irab-from-furqan.ts --module commonjs --target es2020 --outDir .tmp/furqan-import --esModuleInterop --skipLibCheck && node .tmp/furqan-import/import-irab-from-furqan.js",
    "import:study:quran-db": "tsc scripts/import-study-from-quran-db.ts --module commonjs --target es2020 --outDir .tmp/study-import --esModuleInterop --skipLibCheck && node .tmp/study-import/import-study-from-quran-db.js",
    "inspect:qf-translations": "tsc scripts/inspect-qf-translations.ts --module commonjs --target es2020 --outDir .tmp/qf-translations-inspect --esModuleInterop --skipLibCheck && node .tmp/qf-translations-inspect/inspect-qf-translations.js",
    "import:qf-translations": "tsc scripts/import-qf-translations.ts --module commonjs --target es2020 --outDir .tmp/qf-translations-import --esModuleInterop --skipLibCheck && node .tmp/qf-translations-import/import-qf-translations.js",
    "inspect:qf-tafsirs": "tsc scripts/inspect-qf-tafsirs.ts --module commonjs --target es2020 --outDir .tmp/qf-tafsirs-inspect --esModuleInterop --skipLibCheck && node .tmp/qf-tafsirs-inspect/inspect-qf-tafsirs.js",
    "import:qf-tafsirs": "tsc scripts/import-qf-tafsirs.ts --module commonjs --target es2020 --outDir .tmp/qf-tafsirs-import --esModuleInterop --skipLibCheck && node .tmp/qf-tafsirs-import/import-qf-tafsirs.js",
    "dev": "next dev",
    "build": "node scripts/verify-generated-data.mjs && next build",
    "lint": "eslint .",
    "start": "next start"
