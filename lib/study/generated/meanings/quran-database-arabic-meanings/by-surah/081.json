  "surahNumber": 81,
  "entries": [
    {
      "verseKey": "81:1",
      "surahNumber": 81,
      "ayahNumber": 1,
      "text": "الشّمس كوّرت ْ : أزيل ضِـياؤها أو لـُـفّـت و طُويَتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:2",
      "surahNumber": 81,
      "ayahNumber": 2,
      "text": "النجوم انكدرت : تـَسَاقـَطتْ و تـَـهاوَت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:3",
      "surahNumber": 81,
      "ayahNumber": 3,
      "text": "الجبال سُـيّـرت : أزيلتْ عن مَوَاضعها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:4",
      "surahNumber": 81,
      "ayahNumber": 4,
      "text": "العِشار عُطلت : النـّوق الحَوَامل أهْـمِلـَتْ بلا رَاع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:5",
      "surahNumber": 81,
      "ayahNumber": 5,
      "text": "الوُحوش حُشِرت : جُمِعَـتْ مِنْ كلّ صَوْب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:6",
      "surahNumber": 81,
      "ayahNumber": 6,
      "text": "البحار سُجّـرت : أوقِدَتْ فصَـارتْ نـارًا تـَـضْـطرم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:7",
      "surahNumber": 81,
      "ayahNumber": 7,
      "text": "النـّـفـوس زُوّجَت ْ : قـُرنـَتْ كلّ نـَفـس بـشـَـكْـلِـها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:8",
      "surahNumber": 81,
      "ayahNumber": 8,
      "text": "المَوْءودة : البنـْـت التي تـُـدْفـن حَـيّـة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:10",
      "surahNumber": 81,
      "ayahNumber": 10,
      "text": "الصّـحُف نشِرَت : صحف الأعمال فـُرقـَـتْ بين أصحابها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:11",
      "surahNumber": 81,
      "ayahNumber": 11,
      "text": "السّماء كُشِطت : قـُـلِعَتْ كما يُـقـْـلع السّـقف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:12",
      "surahNumber": 81,
      "ayahNumber": 12,
      "text": "الجَحيم سُعّـرَتْ : أوقِدَتْ و أضْرمَتْ للكفـّـار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:13",
      "surahNumber": 81,
      "ayahNumber": 13,
      "text": "الجَـنـّـة أزلفتْ : قـُـرّبَتْ و أدْنِـيَـتْمن المتـّـقين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:14",
      "surahNumber": 81,
      "ayahNumber": 14,
      "text": "عَلِمَـتْ نـَـفـْـسٌ ما أحْضَرَتْ : ما عَـمِلـَـتْ منْ خير أو شرّ (جواب إذا)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:15",
      "surahNumber": 81,
      "ayahNumber": 15,
      "text": "فلا أقسِم : \\\"(أقـْسِم) و\\\"\\\"لا\\\"\\\" مزيدة ...\\\"\\nبالخُـنـّـس : ...بالكواكب السّـيّـارة تخْـنُـس نهارا و تخْـتـفي عن البَصر و هي فوق الأفق ، و تظهر ليلا ثم...",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:16",
      "surahNumber": 81,
      "ayahNumber": 16,
      "text": "الجَوَار الكنـّس : ...تكنس و تستتر في مغيبها تحت الأفق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:17",
      "surahNumber": 81,
      "ayahNumber": 17,
      "text": "و الليل إذا عسعس : أقبل ظلامه . أو أدْبر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:18",
      "surahNumber": 81,
      "ayahNumber": 18,
      "text": "و الصّـبْح إذا تـنفّـس : أقبل أو أضاء و تـَـبَـلـّج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:19",
      "surahNumber": 81,
      "ayahNumber": 19,
      "text": "إنـّـه لقـوْل رَسول : جبريل عن الله ( جواب القسم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:20",
      "surahNumber": 81,
      "ayahNumber": 20,
      "text": "مكين : ذي مكانة رفيعة و شرف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:23",
      "surahNumber": 81,
      "ayahNumber": 23,
      "text": "رَآه : رأى الرسول جبريل بصورته الخِـلقـيّـة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "81:24",
      "surahNumber": 81,
      "ayahNumber": 24,
      "text": "الغَيْب : الوَحْي و خبَـر السّماء\\nبضَـنين : ِببَخيل فـيُـقـصّـر في تبليغه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
