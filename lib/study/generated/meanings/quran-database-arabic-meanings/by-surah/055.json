{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 55,
  "entries": [
    {
      "verseKey": "55:2",
      "surahNumber": 55,
      "ayahNumber": 2,
      "text": "علـّـمَ القرآن : عَـلـّـم الإنسان القرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:5",
      "surahNumber": 55,
      "ayahNumber": 5,
      "text": "بحُـسبان : يجريان بحساب مقدّر في بروجهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:6",
      "surahNumber": 55,
      "ayahNumber": 6,
      "text": "النّجم : النبات الذي ينجم و لا ساق له\\nيسجدان : ينقادان لله فيما خُـلِقا له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:7",
      "surahNumber": 55,
      "ayahNumber": 7,
      "text": "وضع الميزان : شرَع العدل و أمر به الخلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:8",
      "surahNumber": 55,
      "ayahNumber": 8,
      "text": "ألا تطْغَوْا : لئلاّ تتجاوزوا العدل و الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:9",
      "surahNumber": 55,
      "ayahNumber": 9,
      "text": "بالقسْط : بالعدْل\\nلا تـُـخْـسِروا الميزان : لا تنقصوا مَوْزون الميزان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:10",
      "surahNumber": 55,
      "ayahNumber": 10,
      "text": "الأرض وضعها : خلقها محفوظة عن السماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:11",
      "surahNumber": 55,
      "ayahNumber": 11,
      "text": "ذات الأكمام : أوعية الثمر و هي الطلْع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:12",
      "surahNumber": 55,
      "ayahNumber": 12,
      "text": "ذو العَصْف : القِـشْـر أو التـّـبْن أو الوَرَق اليابس\\nالرّيحان : النبات المشموم الطيّب الرّائحة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:13",
      "surahNumber": 55,
      "ayahNumber": 13,
      "text": "آلاء ربّكما : نعمِه تعالى\\nتكذبان : تكفران أيها الثقلان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:14",
      "surahNumber": 55,
      "ayahNumber": 14,
      "text": "صلصال : طين يابس يُسمع له صلصلة\\nكالفخّار : هو الطين يُحرَق حتى يتحجّر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:15",
      "surahNumber": 55,
      "ayahNumber": 15,
      "text": "مارج : لهبٍ صافٍ لا دخان فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:19",
      "surahNumber": 55,
      "ayahNumber": 19,
      "text": "مَرَج البحرين : أرْسَل العـذب و المِلح في مجاريهما\\nيلتقِـيان : يتجاوران أو يلتقي طرفاهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:20",
      "surahNumber": 55,
      "ayahNumber": 20,
      "text": "بيْنهما برْزخ : حاجز أرضي أو من قدرته تعالى\\nلا يبْغِيان : لا يطغى أحدهما على الآخر بالمُـمَـازحَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:24",
      "surahNumber": 55,
      "ayahNumber": 24,
      "text": "له الجوار : السّـفـن الجارية\\nالمنشئات : المرفوعات الشّرُع (القلوع)\\nكالأعلام : كالجبالالشّاهقة أو القصور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:26",
      "surahNumber": 55,
      "ayahNumber": 26,
      "text": "فان : هالك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:27",
      "surahNumber": 55,
      "ayahNumber": 27,
      "text": "ذو الجلال : العظمة و الاستغناء المطلق\\nالإكرام : الفَـضْـل التام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:29",
      "surahNumber": 55,
      "ayahNumber": 29,
      "text": "في شأن : يأتي بأحوالٍ و يذهب بأحوالٍ بالحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:31",
      "surahNumber": 55,
      "ayahNumber": 31,
      "text": "سنفرُغ لكم : سنقصِد لمحاسَبتكم بعد الإمهال\\nأيها الثقلان : الإنس و الجنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:33",
      "surahNumber": 55,
      "ayahNumber": 33,
      "text": "تنفذوا : تخرجوا هربا من قضائي\\nفانفذوا : فاخرجوا (أمر تعجيز)\\nبسلطان : بقوّة و قهر، و هيهات . . !",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:35",
      "surahNumber": 55,
      "ayahNumber": 35,
      "text": "شواظ : لهب خالص لا دخان فيه\\nنحاس : صُـفْـرٌ مُذاب أو دخان بلا لهَب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:37",
      "surahNumber": 55,
      "ayahNumber": 37,
      "text": "فكانت وردة : كالوردة في الحمرة\\nكالدّهان : كدُهْن الزيت في الذوبان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:41",
      "surahNumber": 55,
      "ayahNumber": 41,
      "text": "بسيماهم : بسواد الوجوه ، و زرقة العيون\\nفيؤخذ بالنّواصي : بشعور مقدّم الرّءوس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:44",
      "surahNumber": 55,
      "ayahNumber": 44,
      "text": "حميم آن : ماءٍ حارتناهى حرّه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:46",
      "surahNumber": 55,
      "ayahNumber": 46,
      "text": "جنّـتان : بستان داخل القصر و آخر خارجه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:48",
      "surahNumber": 55,
      "ayahNumber": 48,
      "text": "ذواتا أفنان : أغصان . أو أنواع من الثمار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:50",
      "surahNumber": 55,
      "ayahNumber": 50,
      "text": "عينان : التسْـنيم و السلسبيل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:52",
      "surahNumber": 55,
      "ayahNumber": 52,
      "text": "زوجان : صِنفان : معروف و غريب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:54",
      "surahNumber": 55,
      "ayahNumber": 54,
      "text": "استبرق : غليظ الديباج\\nجنى الجنـّـتـيْـن : ما يُجنى من ثمارهما\\nدان : قريب من يد المتناول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:56",
      "surahNumber": 55,
      "ayahNumber": 56,
      "text": "قاصرات الطّرف : قصَرْنَ أبصارَهنّ على أزواجهنّ\\nلم يطمثهنّ : لمْ يفـتضّهنّ قبل أزواجهنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:62",
      "surahNumber": 55,
      "ayahNumber": 62,
      "text": "و من دونهما جنـّـتان : أعلى أو أدنى من السابقـتـيْن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:64",
      "surahNumber": 55,
      "ayahNumber": 64,
      "text": "مدهامّـتان : خضراوان شديدتا الخضرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:66",
      "surahNumber": 55,
      "ayahNumber": 66,
      "text": "نضّاختان : فوّارتان بالماء لا تنقطعان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:70",
      "surahNumber": 55,
      "ayahNumber": 70,
      "text": "خيرات حسان : خيّرات الأخلاق حِسان الوُجوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:72",
      "surahNumber": 55,
      "ayahNumber": 72,
      "text": "حور : نساءٌ بيض حِسان\\nمقصورات في الخِيام : مخدّرات في بيوت من اللؤلؤ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:76",
      "surahNumber": 55,
      "ayahNumber": 76,
      "text": "رفرف : وسائد أو فُرُش مُرتفعة\\nعبقريّ : بُسطٍ ذات خمْل رقيق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "55:78",
      "surahNumber": 55,
      "ayahNumber": 78,
      "text": "تبارك : تعالى . أو كثـُـرَ خيْرُه و إحسانه\\nذي الجلال : العظمة و الإستغناء المُطلق\\nالإكرام : الفضل التام و الإحسان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
