{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 40,
  "entries": [
    {
      "verseKey": "40:3",
      "surahNumber": 40,
      "ayahNumber": 3,
      "text": "غافر الذنب : ساتر الذنب للمؤمنين\\nقابل التوب : التوبة من الذنب من كل مُذنب\\nذي الطوْل : الغِنى أو الإنعام و التـّـفضل أو المنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:4",
      "surahNumber": 40,
      "ayahNumber": 4,
      "text": "فلا يغرُرْك : فلا يَخدَعك\\nتقلبهم : تنـقـّـلهُمْ سالمين غانمين فإنّه استدراج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:5",
      "surahNumber": 40,
      "ayahNumber": 5,
      "text": "لدحضوا به الحق : ليبْطلواو يزيلوا بالباطل الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:6",
      "surahNumber": 40,
      "ayahNumber": 6,
      "text": "حقـّت : وَجَبَتْ و ثبتتْبالإهلاك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:7",
      "surahNumber": 40,
      "ayahNumber": 7,
      "text": "سبيلك : طريق الهدى (دين الإسلام)\\nقهم عذاب الجحيم : احفظهمْ منه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:9",
      "surahNumber": 40,
      "ayahNumber": 9,
      "text": "قِهم السّيئات : المعاصي أو عقوبَاتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:10",
      "surahNumber": 40,
      "ayahNumber": 10,
      "text": "لمَقت الله : لبغضه الشديد و غَضبه عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:12",
      "surahNumber": 40,
      "ayahNumber": 12,
      "text": "تؤمنوا : تذعـنوا و تقِرّوا بالشرك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:13",
      "surahNumber": 40,
      "ayahNumber": 13,
      "text": "ينيب : يَرْجع إلى التـّـفكّر في الآيات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:15",
      "surahNumber": 40,
      "ayahNumber": 15,
      "text": "رفيع الدرجات : رافع السّموات بعضها فوق بعض\\nيلقي الروح : يُنزل الوَحْيَ أو القـرآن أو جبريل\\nيوم التلاق : يوم الإجتماع في المَحشر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:16",
      "surahNumber": 40,
      "ayahNumber": 16,
      "text": "هم بارزون : خارجون من القبور ظاهرون لا يسْترهمْ شيء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:18",
      "surahNumber": 40,
      "ayahNumber": 18,
      "text": "يوم الآزفة : يوم القيامة لِقربها\\nالحناجر : التـّـراقي و الحلاقيم\\nكاظمين : مُـمْـسكين على الغمّ الممتلئينَ منه\\nحميم : قريب مُـشفـق يَهتمّ بهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:19",
      "surahNumber": 40,
      "ayahNumber": 19,
      "text": "خائنة الأعين : النظرة الخائنة إلى مالا يحلّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:21",
      "surahNumber": 40,
      "ayahNumber": 21,
      "text": "واق : دافع يدْفع عنهم العَذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:25",
      "surahNumber": 40,
      "ayahNumber": 25,
      "text": "استحيوا نساءهم : استبْـقـُـوا بناتهمْ للخِدْمة\\nضلال : ضَيَاعَ و بُطْلان وَ وبال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:27",
      "surahNumber": 40,
      "ayahNumber": 27,
      "text": "عذت بربّي : اعْـتصمْت و تحصّـنت به تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:29",
      "surahNumber": 40,
      "ayahNumber": 29,
      "text": "ظاهرين : غالبين عاليين\\nبأس الله : عذابه و نِقمَته\\nما أريكم : ما أشِـير عليكمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:30",
      "surahNumber": 40,
      "ayahNumber": 30,
      "text": "الأحزاب : الأمم الماضية المتحزّبة على الأنبياء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:31",
      "surahNumber": 40,
      "ayahNumber": 31,
      "text": "دأب قوم نوح : عَادَتهمْ في القيامة و على التـّـكذيب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:32",
      "surahNumber": 40,
      "ayahNumber": 32,
      "text": "يوم التـّـناد : يوم القيامة (للنّداء فيه إلى المَحشر)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:33",
      "surahNumber": 40,
      "ayahNumber": 33,
      "text": "عاصم : مانع و دافع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:34",
      "surahNumber": 40,
      "ayahNumber": 34,
      "text": "مرتاب : في دين الله شاكّ في وَحْدانيّـته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:35",
      "surahNumber": 40,
      "ayahNumber": 35,
      "text": "بغير سلطان : بغير برهان و حجّة\\nكبُرَ مقتا : عَـظُـم جدالهمْ بغير حجّة بُغضا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:36",
      "surahNumber": 40,
      "ayahNumber": 36,
      "text": "صرحا : قصرًا . أو بناءً عاليا ظاهرا\\nأبلغ الأسباب : الأبواب أو الطّرق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:37",
      "surahNumber": 40,
      "ayahNumber": 37,
      "text": "تباب : خسران و هلاك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:40",
      "surahNumber": 40,
      "ayahNumber": 40,
      "text": "بغير حساب : بلا نهاية من الرزاق لِما يُعطي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:43",
      "surahNumber": 40,
      "ayahNumber": 43,
      "text": "لا جرَم : حقّ و ثبَتَ أو لا مَحالة أو حقـّـا\\nليس له دعوة : مستجابة . أو استجابة دعوة\\nمردنا إلى الله : رُجُوعنا بعد المَوت إليه تعالى للجَزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:45",
      "surahNumber": 40,
      "ayahNumber": 45,
      "text": "حاق : أحَاطَ أو نـَـزَل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:46",
      "surahNumber": 40,
      "ayahNumber": 46,
      "text": "غدوّا و عشيّا : صبَاحا و مساءً أو دائما في البرزخ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:47",
      "surahNumber": 40,
      "ayahNumber": 47,
      "text": "مغنون عنا : دافِـعون . أو حاملون عنّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:51",
      "surahNumber": 40,
      "ayahNumber": 51,
      "text": "يقوم الأشهاد : الملائكة و الرّسل و المؤمنون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:52",
      "surahNumber": 40,
      "ayahNumber": 52,
      "text": "معذرتهم : عذرهمْ أو اعتذارهم حين يعتذرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:55",
      "surahNumber": 40,
      "ayahNumber": 55,
      "text": "بالعشيّ و الإبكار : طرَفي النهار. أو دائما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:56",
      "surahNumber": 40,
      "ayahNumber": 56,
      "text": "سلطان : حُجّـة و برهان\\nما هم ببالغيه : ِببَالغي مُقـتضى الكِبْر و التـّعاظم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:60",
      "surahNumber": 40,
      "ayahNumber": 60,
      "text": "داخرين : صاغرين أذلاّء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:62",
      "surahNumber": 40,
      "ayahNumber": 62,
      "text": "فأنى تؤفكون ؟ : فكيف تصرفون عن توحيدهِ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:63",
      "surahNumber": 40,
      "ayahNumber": 63,
      "text": "يؤفك : يُصْرَف عن التـّـوحيد الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:64",
      "surahNumber": 40,
      "ayahNumber": 64,
      "text": "الأرض قرارا : مستقرّا تعيشون فيها\\nالسماء بناءً : سَقـْـفا مَرْفوعا كالقـبّـة فوقكم\\nفتبارك الله : تعالى أو تمجّد أو كَـثـُـرَ خيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:66",
      "surahNumber": 40,
      "ayahNumber": 66,
      "text": "أنْ أسْلم : أنْ أنقاد أو أُخْلص ديني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:67",
      "surahNumber": 40,
      "ayahNumber": 67,
      "text": "لتبلغوا أشدّكُمْ : كمال عَقلكم و قوتِكمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:68",
      "surahNumber": 40,
      "ayahNumber": 68,
      "text": "قـَـضى أمرًا : أرَاد إيجادَ أمرٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:69",
      "surahNumber": 40,
      "ayahNumber": 69,
      "text": "أنـّى يصرفون ؟ : كيف يُصرفون عن الآيات مع صِدْقِها و وضوحها ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:71",
      "surahNumber": 40,
      "ayahNumber": 71,
      "text": "الأغلال : القيود تجمع الأيدي إلى الأعناق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:72",
      "surahNumber": 40,
      "ayahNumber": 72,
      "text": "الحميم : الماء البالغ نِهاية الحرارة\\nيُسْجرون : توقد أو تـُـملأ بهِمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:75",
      "surahNumber": 40,
      "ayahNumber": 75,
      "text": "تفرحون : تـَـبْـطرونَ و تأشرون\\nتمرحون : تتوسّعون في الفرح و البطر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:76",
      "surahNumber": 40,
      "ayahNumber": 76,
      "text": "مثوى المتكبّـرين : مأواهمْ و مُقامَهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:80",
      "surahNumber": 40,
      "ayahNumber": 80,
      "text": "حَاجَة في صدوركم : أمرًا ذا بال تهتمّون به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:82",
      "surahNumber": 40,
      "ayahNumber": 82,
      "text": "فما أغنى عنهم : فما دفع عنهم و ما نـَـفَعهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:83",
      "surahNumber": 40,
      "ayahNumber": 83,
      "text": "من العلم : بأمور الدنيا مستهزئين بالدين\\nحَاق بهم : أحاط . أو نزل بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:84",
      "surahNumber": 40,
      "ayahNumber": 84,
      "text": "رَأوْا بَأسنا : عاينوا شدة عذابنا في الدنيا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "40:85",
      "surahNumber": 40,
      "ayahNumber": 85,
      "text": "خلتْ : مَضَتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
