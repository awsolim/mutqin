{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 25,
  "entries": [
    {
      "verseKey": "25:1",
      "surahNumber": 25,
      "ayahNumber": 1,
      "text": "تبارك الذي . . : تعالى و تمجّد . أو تكاثر خيره . .\\nنزل الفرقان : القرآن الفاصل بين الحقّ و الباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:2",
      "surahNumber": 25,
      "ayahNumber": 2,
      "text": "فقدّره : فهيّأه لما يصلح له و يليق به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:3",
      "surahNumber": 25,
      "ayahNumber": 3,
      "text": "نشورا : بعثا بعد الموت في الآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:4",
      "surahNumber": 25,
      "ayahNumber": 4,
      "text": "إفك افتراه : كذب إخترعه من عند نفسه\\nزورا : كذبا عظيما لا تـُبلَـغ غايته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:5",
      "surahNumber": 25,
      "ayahNumber": 5,
      "text": "أساطير الأوّلين : أكاذيبهم المسطورة في كتبهم\\nبكرة و أصيلا : أول النهار و آخره : أي دائما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:6",
      "surahNumber": 25,
      "ayahNumber": 6,
      "text": "يعلم السّر : يعلم كلّما يغيب و يخفى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:8",
      "surahNumber": 25,
      "ayahNumber": 8,
      "text": "جنّة يأكل منها : بستان مثمر يتعيّش منه\\nرجلا مسحورا : غلب السّحر على عقله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:11",
      "surahNumber": 25,
      "ayahNumber": 11,
      "text": "سعيرا : نارا عظيمة شديدة الإشتعال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:12",
      "surahNumber": 25,
      "ayahNumber": 12,
      "text": "تغيّظا : صوت غليان كصوت المتغيّظ\\nزفيرا : صوتا شديدا كصوت الزّافر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:13",
      "surahNumber": 25,
      "ayahNumber": 13,
      "text": "مقرّنين : مقرونه أيديهم إلى أعناقهم بالأغلال\\nثبورا : هلاكا فقالوا وَا ثبوراه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:16",
      "surahNumber": 25,
      "ayahNumber": 16,
      "text": "وعدا مسئولا : موعودا حقيقا أن يُسأل و يُطلب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:18",
      "surahNumber": 25,
      "ayahNumber": 18,
      "text": "نسوا الذكر : غفلوا عن دلائل الوحدانية\\nقوما بورا : هالكين . أو فاسدين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:19",
      "surahNumber": 25,
      "ayahNumber": 19,
      "text": "صرفا : دفعا للعذاب عن أنفسكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:20",
      "surahNumber": 25,
      "ayahNumber": 20,
      "text": "فتنة : ابتلاء و محنة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:21",
      "surahNumber": 25,
      "ayahNumber": 21,
      "text": "لا يرجون لقاءنا : لا يأملونه لكفرهم بالبعث\\nعتوا : تجاوزوا الحدّ في الطّغيان و الظلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:22",
      "surahNumber": 25,
      "ayahNumber": 22,
      "text": "حجرا محجورا : حراما محرّما عليكم البُشرى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:23",
      "surahNumber": 25,
      "ayahNumber": 23,
      "text": "هباءً : كالهباء ( ما يُرى في الكُوى مع ضوء الشمس كالغبار)\\nمنثورا : مفرّقا ذاهبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:24",
      "surahNumber": 25,
      "ayahNumber": 24,
      "text": "مقيلا : مكان استرواح و تمتّع ظهيرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:25",
      "surahNumber": 25,
      "ayahNumber": 25,
      "text": "تشقّق السّماء : تتفتح السموات\\nبالغمام : بالسّحاب الأبيض الرقيق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:27",
      "surahNumber": 25,
      "ayahNumber": 27,
      "text": "سبيلا : طريقا إلى الهدى أو إلى النجاة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:29",
      "surahNumber": 25,
      "ayahNumber": 29,
      "text": "للإنسان خذولا : كثير الخذلان لمن يواليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:30",
      "surahNumber": 25,
      "ayahNumber": 30,
      "text": "مهجورا : متروكا مهملا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:32",
      "surahNumber": 25,
      "ayahNumber": 32,
      "text": "رتـّلناه : فرّقناه آية بعد آية . أو بيّـناه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:33",
      "surahNumber": 25,
      "ayahNumber": 33,
      "text": "أحسن تفسيرا : أصدق بيانا و تفصيلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:36",
      "surahNumber": 25,
      "ayahNumber": 36,
      "text": "فدمّرناهم : فأهلكناهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:38",
      "surahNumber": 25,
      "ayahNumber": 38,
      "text": "أصحاب الرس : البئر – قتلوا نبيّهم و دسوه فيها\\nقرونا : أُمما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:39",
      "surahNumber": 25,
      "ayahNumber": 39,
      "text": "تبّرنا تتبيرا : أهلكنا إهلاكا عجيبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:40",
      "surahNumber": 25,
      "ayahNumber": 40,
      "text": "مطر السّوء : حجارة من السماء مهلكة\\nلا يرجون نشورا : لا يتوقّعون بعثا بل ينكرونه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:41",
      "surahNumber": 25,
      "ayahNumber": 41,
      "text": "هزوا : مهزوءً به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:43",
      "surahNumber": 25,
      "ayahNumber": 43,
      "text": "أرأيت : أخبرني\\nوكيلا : حفيظا تمنعُه من عبادة ما يهواه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:45",
      "surahNumber": 25,
      "ayahNumber": 45,
      "text": "مدّ الظلّ : بسطه بين الفجر و طلوع الشّمس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:47",
      "surahNumber": 25,
      "ayahNumber": 47,
      "text": "الليل لباسا : ساترا لكم بظلامه كاللباس\\nالنوم سُباتا : راحة لأبدانكم ، بقطع أعمالكم\\nالنهار نشورا : إمبعاثا من النّوم للسعي و العمل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:48",
      "surahNumber": 25,
      "ayahNumber": 48,
      "text": "الرّياح بشرا : مبشّرات بالرّحمة و هي المطر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:50",
      "surahNumber": 25,
      "ayahNumber": 50,
      "text": "صرّفناه بينهم : أنزلنا المطر على أنحاء مختلفة\\nكفورا : جحودا و كفرانا بالنّعمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:53",
      "surahNumber": 25,
      "ayahNumber": 53,
      "text": "مرج البحرين : أرسلهما في مجاريهما أو أجراهما\\nعذب فرات : حلو شديد العذوبة\\nملح أجاج : شديد الكلوحة و الحرارة أو المرارة\\nبرزخا : حاجزا عظيما يمنع اختلاطهما\\nحجرا محجورا : حراما محرّما تغيّر صفاتهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:54",
      "surahNumber": 25,
      "ayahNumber": 54,
      "text": "نسبا : ذوي نسب ذكورا يُنسب إليهم\\nصهرا : ذوات صهر إناثا يُصاهر بهن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:55",
      "surahNumber": 25,
      "ayahNumber": 55,
      "text": "على ربّه ظهيرا : مُعينا للشّيطان على ربّه بالشّرك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:58",
      "surahNumber": 25,
      "ayahNumber": 58,
      "text": "سبّح : نزّه تعالى عن جميع النقائص\\nبحمده : مُثنيا عليه بأوصاف الكمال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:59",
      "surahNumber": 25,
      "ayahNumber": 59,
      "text": "استوى على العرش : إستواء يليق بكماله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:60",
      "surahNumber": 25,
      "ayahNumber": 60,
      "text": "زادهم نفورا : تباعدا عن الإيمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:61",
      "surahNumber": 25,
      "ayahNumber": 61,
      "text": "تبارك الذي . . : تعالى و تمجّد أو تكاثر خيره\\nبروجا : منازل للكواكب السّيارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:62",
      "surahNumber": 25,
      "ayahNumber": 62,
      "text": "خِـلفة : يخلُف أحدهما الآخر و يتعاقبان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:63",
      "surahNumber": 25,
      "ayahNumber": 63,
      "text": "هونا : بسكينة و وقار و تواضع\\nقالوا سلاما : قولا سديدا يسلمون به من الأذى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:65",
      "surahNumber": 25,
      "ayahNumber": 65,
      "text": "كان غراما : لازما أو ممتدّا ، كلزوم الغريم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:67",
      "surahNumber": 25,
      "ayahNumber": 67,
      "text": "لم يقتروا : لم يُضيّقوا تضييق الأشحّاء\\nقواما : عدلا وسطا بين الطّرفين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:68",
      "surahNumber": 25,
      "ayahNumber": 68,
      "text": "يلقى أثاما : عقابا و جزاء في الآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:72",
      "surahNumber": 25,
      "ayahNumber": 72,
      "text": "مرّوا باللغو : بما ينبغي أن يُلغى و يُطرح\\nمرّوا كراما : مُكرمين أنفسهم بالإعراض عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:73",
      "surahNumber": 25,
      "ayahNumber": 73,
      "text": "لم يخروا : لم يسقطوا و لم يقعوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:74",
      "surahNumber": 25,
      "ayahNumber": 74,
      "text": "قرّة أعين : مسرّة و فرحا\\nإماما : قدوة و حجّة أو أئمّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:75",
      "surahNumber": 25,
      "ayahNumber": 75,
      "text": "يُجزون الغرفة : أعلى منازل الجنّة و أفضلها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "25:77",
      "surahNumber": 25,
      "ayahNumber": 77,
      "text": "ما يعبأ بكم : ما يكترث و ما يبالي بكم\\nدعاؤكم : عبادتكم له تعالى\\nيكون لزاما : يكون جزاء تكذيبكم عذابا دائما مُلازما لكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
