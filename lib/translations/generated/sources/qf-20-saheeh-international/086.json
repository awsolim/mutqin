{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 86,
  "entries": [
    {
      "verseKey": "86:1",
      "surahNumber": 86,
      "ayahNumber": 1,
      "text": "By the sky and the knocker",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:2",
      "surahNumber": 86,
      "ayahNumber": 2,
      "text": "And what can make you know what is the knocker?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:3",
      "surahNumber": 86,
      "ayahNumber": 3,
      "text": "It is the piercing star.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:4",
      "surahNumber": 86,
      "ayahNumber": 4,
      "text": "There is no soul but that it has over it a protector.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:5",
      "surahNumber": 86,
      "ayahNumber": 5,
      "text": "So let man observe from what he was created.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:6",
      "surahNumber": 86,
      "ayahNumber": 6,
      "text": "He was created from a fluid, ejected,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:7",
      "surahNumber": 86,
      "ayahNumber": 7,
      "text": "Emerging from between the backbone and the ribs.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:8",
      "surahNumber": 86,
      "ayahNumber": 8,
      "text": "Indeed, He [i.e., Allāh], to return him [to life], is Able.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:9",
      "surahNumber": 86,
      "ayahNumber": 9,
      "text": "The Day when secrets will be put on trial,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:10",
      "surahNumber": 86,
      "ayahNumber": 10,
      "text": "Then he [i.e., man] will have no power or any helper.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:11",
      "surahNumber": 86,
      "ayahNumber": 11,
      "text": "By the sky which sends back",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:12",
      "surahNumber": 86,
      "ayahNumber": 12,
      "text": "And [by] the earth which splits,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:13",
      "surahNumber": 86,
      "ayahNumber": 13,
      "text": "Indeed, it [i.e., the Qur’ān] is a decisive statement,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:14",
      "surahNumber": 86,
      "ayahNumber": 14,
      "text": "And it is not amusement.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:15",
      "surahNumber": 86,
      "ayahNumber": 15,
      "text": "Indeed, they are planning a plan,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:16",
      "surahNumber": 86,
      "ayahNumber": 16,
      "text": "But I am planning a plan.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "86:17",
      "surahNumber": 86,
      "ayahNumber": 17,
      "text": "So allow time for the disbelievers. Leave them awhile.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
