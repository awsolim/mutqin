{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 77,
  "entries": [
    {
      "verseKey": "77:1",
      "surahNumber": 77,
      "ayahNumber": 1,
      "text": "و المرسلات عُرْفا ( لهذه الأقسام الخمسة تفسيرات كثيرة اخترنا هذا منها ) : (أقسم الله) برياح العذاب ممتابعة كَعُرْف الفَـرس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:2",
      "surahNumber": 77,
      "ayahNumber": 2,
      "text": "فالعاصفات عَصفا : الرّياح الشديدة الهبوب المُهلكة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:3",
      "surahNumber": 77,
      "ayahNumber": 3,
      "text": "و الناشرات نشرا : الملائكة تنشر أجنحتها في الجَوّ عند النّـزول بالوحي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:4",
      "surahNumber": 77,
      "ayahNumber": 4,
      "text": "فالفارقات فرقا : الملائكة تأتي بالوحي فُرقانا بين الحقّ و الباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:5",
      "surahNumber": 77,
      "ayahNumber": 5,
      "text": "فالمُلقِـيات ذكرا : الملائكة تُـلقي الوحْي إلى الأنبياء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:6",
      "surahNumber": 77,
      "ayahNumber": 6,
      "text": "عُذرا : للإعذار من الله للخَلـْـق\\nنـُـذرا : للإنذار و التـّـخويف بالعِقاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:7",
      "surahNumber": 77,
      "ayahNumber": 7,
      "text": "إنما توعدون : من البَعْثْ ( جَوَاب القـَـسَم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:8",
      "surahNumber": 77,
      "ayahNumber": 8,
      "text": "النجوم طُمِسَتْ : مُـحِـيَ نورُها و أذهِبَ ضوؤها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:9",
      "surahNumber": 77,
      "ayahNumber": 9,
      "text": "السّماء فُـرجَت : شُـقّـت أو فُتِحَتْ فكانت أبوابا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:10",
      "surahNumber": 77,
      "ayahNumber": 10,
      "text": "الجبال نُسِفت : قُـلِعَت من أماكِنِها بسُرْعَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:11",
      "surahNumber": 77,
      "ayahNumber": 11,
      "text": "الرّسل أقـّـتت : بُلـّـغَتْ ميقاتـَها ( يوم القيامة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:12",
      "surahNumber": 77,
      "ayahNumber": 12,
      "text": "لأي يوم أجّـلت : يُقال لأيّ يوم أخِّرَتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:13",
      "surahNumber": 77,
      "ayahNumber": 13,
      "text": "ليوم الفـَـصْـل : بين الخلائق أو الحقّ و الباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:15",
      "surahNumber": 77,
      "ayahNumber": 15,
      "text": "ويْـلٌ يومئذ : هلاكٌ في ذلك اليوم الهائل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:20",
      "surahNumber": 77,
      "ayahNumber": 20,
      "text": "ماءٍ مهين : مَنِـيّ ضعيف حَقير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:21",
      "surahNumber": 77,
      "ayahNumber": 21,
      "text": "قرار مكين : مُتمَكّن ، و هو الرّحِم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:23",
      "surahNumber": 77,
      "ayahNumber": 23,
      "text": "فقـَدَرنا : فـقـَـدّرْنا ذلك تقديرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:25",
      "surahNumber": 77,
      "ayahNumber": 25,
      "text": "الأرض كِفاتا : وعاءًا تضمّ الأحياء على ظهرها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:26",
      "surahNumber": 77,
      "ayahNumber": 26,
      "text": "أحْياءً و أمْوَاتا : و الأموات في بطنها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:27",
      "surahNumber": 77,
      "ayahNumber": 27,
      "text": "رواسِيَ شامخات : جـِبالا ثوابتَ مُرْتـَفِعات\\nماءً فـُرَاتـًا : حُـلوًا عَذبًـا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:30",
      "surahNumber": 77,
      "ayahNumber": 30,
      "text": "ظلّ : هو دُخان جهنّم\\nثلاث شُعَب : فِرَقٍ ثلاث كالذوائب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:31",
      "surahNumber": 77,
      "ayahNumber": 31,
      "text": "لا ظليل : لا مظلـّـل من الحرّ\\nلا يُغني من اللـّهَب : لا يَدْفـَعُ شيْئا من حرّه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:32",
      "surahNumber": 77,
      "ayahNumber": 32,
      "text": "ترمي بشَرَر : هو ما تطايَر من النّار مُتفـرّقًـا\\nكالقـَـصْر : كلّ شرَرَة كالبناء المُشيّد في العِظم و الإرتفاع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:33",
      "surahNumber": 77,
      "ayahNumber": 33,
      "text": "كأنّه جـِمالة ٌ صُـفر : \\\"كأنّ الشّرر إبل سودٌ \\\"\\\"و تـُسـمّيها العَرَب صفرا\\\"\\\" في الكثرة و التـّـتابع و سُرْعة الحركة و اللون \\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "77:39",
      "surahNumber": 77,
      "ayahNumber": 39,
      "text": "لكم كيْدٌ :",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
