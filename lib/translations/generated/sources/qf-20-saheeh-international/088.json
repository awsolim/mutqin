{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 88,
  "entries": [
    {
      "verseKey": "88:1",
      "surahNumber": 88,
      "ayahNumber": 1,
      "text": "Has there reached you the report of the Overwhelming [event]?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:2",
      "surahNumber": 88,
      "ayahNumber": 2,
      "text": "[Some] faces, that Day, will be humbled,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:3",
      "surahNumber": 88,
      "ayahNumber": 3,
      "text": "Working [hard] and exhausted.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:4",
      "surahNumber": 88,
      "ayahNumber": 4,
      "text": "They will [enter to] burn in an intensely hot Fire.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:5",
      "surahNumber": 88,
      "ayahNumber": 5,
      "text": "They will be given drink from a boiling spring.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:6",
      "surahNumber": 88,
      "ayahNumber": 6,
      "text": "For them there will be no food except from a poisonous, thorny plant",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:7",
      "surahNumber": 88,
      "ayahNumber": 7,
      "text": "Which neither nourishes nor avails against hunger.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:8",
      "surahNumber": 88,
      "ayahNumber": 8,
      "text": "[Other] faces, that Day, will show pleasure.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:9",
      "surahNumber": 88,
      "ayahNumber": 9,
      "text": "With their effort [they are] satisfied",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:10",
      "surahNumber": 88,
      "ayahNumber": 10,
      "text": "In an elevated garden,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:11",
      "surahNumber": 88,
      "ayahNumber": 11,
      "text": "Wherein they will hear no unsuitable speech.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:12",
      "surahNumber": 88,
      "ayahNumber": 12,
      "text": "Within it is a flowing spring.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:13",
      "surahNumber": 88,
      "ayahNumber": 13,
      "text": "Within it are couches raised high",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:14",
      "surahNumber": 88,
      "ayahNumber": 14,
      "text": "And cups put in place",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:15",
      "surahNumber": 88,
      "ayahNumber": 15,
      "text": "And cushions lined up",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:16",
      "surahNumber": 88,
      "ayahNumber": 16,
      "text": "And carpets spread around.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:17",
      "surahNumber": 88,
      "ayahNumber": 17,
      "text": "Then do they not look at the camels - how they are created?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:18",
      "surahNumber": 88,
      "ayahNumber": 18,
      "text": "And at the sky - how it is raised?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:19",
      "surahNumber": 88,
      "ayahNumber": 19,
      "text": "And at the mountains - how they are erected?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:20",
      "surahNumber": 88,
      "ayahNumber": 20,
      "text": "And at the earth - how it is spread out?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:21",
      "surahNumber": 88,
      "ayahNumber": 21,
      "text": "So remind, [O Muḥammad]; you are only a reminder.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:22",
      "surahNumber": 88,
      "ayahNumber": 22,
      "text": "You are not over them a controller.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:23",
      "surahNumber": 88,
      "ayahNumber": 23,
      "text": "However, he who turns away and disbelieves –",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:24",
      "surahNumber": 88,
      "ayahNumber": 24,
      "text": "Then Allāh will punish him with the greatest punishment.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:25",
      "surahNumber": 88,
      "ayahNumber": 25,
      "text": "Indeed, to Us is their return.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "88:26",
      "surahNumber": 88,
      "ayahNumber": 26,
      "text": "Then indeed, upon Us is their account.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
