  "entries": [
    {
      "verseKey": "26:3",
      "surahNumber": 26,
      "ayahNumber": 3,
      "text": "باخعا نفسك : مُهلِكُها حسرة و حُزنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:4",
      "surahNumber": 26,
      "ayahNumber": 4,
      "text": "أعناقهم : جماعاتهم أو رؤساؤهم و مقدّموهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:7",
      "surahNumber": 26,
      "ayahNumber": 7,
      "text": "زوج كريم : صِنفٍ حسن كثير النّــفع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:19",
      "surahNumber": 26,
      "ayahNumber": 19,
      "text": "الكافرين : الجاحدين لِنعمتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:20",
      "surahNumber": 26,
      "ayahNumber": 20,
      "text": "الضّالين : المخطئين لا المتعمّدين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:22",
      "surahNumber": 26,
      "ayahNumber": 22,
      "text": "عبّدت بني إسرائيل : اتـّخذتهم عبيدا لك مستذلـّين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:33",
      "surahNumber": 26,
      "ayahNumber": 33,
      "text": "نزع يده : أخرجها من جيبه\\nهي بيضاء : بياضا نورانيا يغشى الأبصار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:34",
      "surahNumber": 26,
      "ayahNumber": 34,
      "text": "للملأ : وجوه القوم و سادتهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:36",
      "surahNumber": 26,
      "ayahNumber": 36,
      "text": "أرجه و أخاه : أخِرْ أمرهما و لا تعجل بعقوبتهما\\nحاشرين . . : الشّـرَط يجمعون كل السّحرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:39",
      "surahNumber": 26,
      "ayahNumber": 39,
      "text": "هل أنتم مجتمعون : حثّ على الإجتماع و استعجالٌ له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:44",
      "surahNumber": 26,
      "ayahNumber": 44,
      "text": "بعزّة فرعون : بقوّته و عظمته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:45",
      "surahNumber": 26,
      "ayahNumber": 45,
      "text": "تلقف : تبتلِع بسرعة\\nما يأفكون : ما يقلبونه عن وجهه بالتـّمْـويه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:50",
      "surahNumber": 26,
      "ayahNumber": 50,
      "text": "لا ضير : لا ضرر علينا فيما يُـصيبنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:52",
      "surahNumber": 26,
      "ayahNumber": 52,
      "text": "إنّكم مُـتـّــبعون : يتّـبعُكُم فِرعون و جُنُوده",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:53",
      "surahNumber": 26,
      "ayahNumber": 53,
      "text": "حاشرين : جامعين للجيش ليتبَعوهُم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:54",
      "surahNumber": 26,
      "ayahNumber": 54,
      "text": "لشرذمة : لطائفة قليلة بالنّسبة إلينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:56",
      "surahNumber": 26,
      "ayahNumber": 56,
      "text": "حاذرون : مُحترزون . أو مُتأهّبون بالسلاح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:60",
      "surahNumber": 26,
      "ayahNumber": 60,
      "text": "مشرقين : داخلين في وقت الشّروق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:61",
      "surahNumber": 26,
      "ayahNumber": 61,
      "text": "تراءى الجمعان : رأى كلّ منهما الآخر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:63",
      "surahNumber": 26,
      "ayahNumber": 63,
      "text": "فانفلق : انشقّ اثنيْ عشر فِرقا\\nفرق : قطعة من البحر مُرتقعة\\nكالطّود العظيم : كالجبل المُنطاد في السماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:64",
      "surahNumber": 26,
      "ayahNumber": 64,
      "text": "أزلفنا ثمّ الآخرين : قرّبنا هنالك آل فرعون من البحر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:75",
      "surahNumber": 26,
      "ayahNumber": 75,
      "text": "أفرأيتم . . : أتأمّـلتـُـم فعلِمتم . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:84",
      "surahNumber": 26,
      "ayahNumber": 84,
      "text": "لسان صدق : ثناءً حسنا و ذكرا جميلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:87",
      "surahNumber": 26,
      "ayahNumber": 87,
      "text": "لا تخزني : لا تفضحني و لا تذلـّـني بعقابك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:89",
      "surahNumber": 26,
      "ayahNumber": 89,
      "text": "بقلب سليم : بريء من مرض النفاق و الكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:90",
      "surahNumber": 26,
      "ayahNumber": 90,
      "text": "أزلفة الجنّة : قُـرّبت بحيث يُـرى نعيمها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:91",
      "surahNumber": 26,
      "ayahNumber": 91,
      "text": "برّزت الجحيم : أُظهرت بحيث تُرى أهوالها\\nللغاوين : الضّالين عن طريق الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:94",
      "surahNumber": 26,
      "ayahNumber": 94,
      "text": "فكبكبوا : فأُلقي الأصنام على وجوههم مرارا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:98",
      "surahNumber": 26,
      "ayahNumber": 98,
      "text": "نسوّيكم بربّ العالمين : نجعلكم و إياه سواءً في استحقاق العبادة و أنتم أعجز الخلْق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:101",
      "surahNumber": 26,
      "ayahNumber": 101,
      "text": "حميم : قريب أو شفيق يهتمّ بأمرنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:102",
      "surahNumber": 26,
      "ayahNumber": 102,
      "text": "كرّة : رجعة إلى الدنيا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:111",
      "surahNumber": 26,
      "ayahNumber": 111,
      "text": "اتبعك الأرذلون : السِفلة الأدنياء من النّاس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:118",
      "surahNumber": 26,
      "ayahNumber": 118,
      "text": "فافتح : فاحكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:119",
      "surahNumber": 26,
      "ayahNumber": 119,
      "text": "المشحون : المملوء بالناس و الدوابّ و المتاع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:128",
      "surahNumber": 26,
      "ayahNumber": 128,
      "text": "ريع : طريق . أو مكان مرتفع\\nآية : بناءً شامخا كالعلَم في الإرتفاع\\nتعبثون : ببنائها . أو بمن يمرّ بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:129",
      "surahNumber": 26,
      "ayahNumber": 129,
      "text": "مصانع : حصونا أو قصورا أو حِياضا للماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:132",
      "surahNumber": 26,
      "ayahNumber": 132,
      "text": "أمدّكم : أنعم عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:137",
      "surahNumber": 26,
      "ayahNumber": 137,
      "text": "خلُق الأولين : عادتهم في اعتقاد أن لا بعث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:148",
      "surahNumber": 26,
      "ayahNumber": 148,
      "text": "طلعها : ثمرُها الذي يؤول إليه الطّـلْـع\\nهضيم : رُطب نضيج أو متدلّ لكثرته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:149",
      "surahNumber": 26,
      "ayahNumber": 149,
      "text": "فارهين : حاذقين بـِــنحتها أو متجبّرين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:153",
      "surahNumber": 26,
      "ayahNumber": 153,
      "text": "من المسحّرين : المغلوب على عقولهم بكثرة السّحر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:155",
      "surahNumber": 26,
      "ayahNumber": 155,
      "text": "لها شرب : نصيب مشروب من الماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:166",
      "surahNumber": 26,
      "ayahNumber": 166,
      "text": "قوم عادون : متجاوزون الحدّ في المعاصي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:168",
      "surahNumber": 26,
      "ayahNumber": 168,
      "text": "من القالين : من المبغضين أشدّ البغض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:171",
      "surahNumber": 26,
      "ayahNumber": 171,
      "text": "في الغابرين : في الباقين في العذاب كأمثالها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:172",
      "surahNumber": 26,
      "ayahNumber": 172,
      "text": "دمّرنا الأخرين : أهلكناهم أشدّ إهلاك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:173",
      "surahNumber": 26,
      "ayahNumber": 173,
      "text": "مطرا : حجارة من سجيل مُهلكة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:176",
      "surahNumber": 26,
      "ayahNumber": 176,
      "text": "أصحاب الأيكة : أصحاب الغيْضَة الكثيفة الملتفة الشجر (قرب مدين)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:181",
      "surahNumber": 26,
      "ayahNumber": 181,
      "text": "من المخسرين : من النّاقصين للحقوق بالتطفيف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:183",
      "surahNumber": 26,
      "ayahNumber": 183,
      "text": "لا تبخسوا : لا تنقُصوا\\nلا تعثوا : لا تُفسِدوا أشدّ الإفساد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:184",
      "surahNumber": 26,
      "ayahNumber": 184,
      "text": "و الجبلّة الأوّلين : و خلَق الخليقة و الأمم الماضين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:185",
      "surahNumber": 26,
      "ayahNumber": 185,
      "text": "المسحّرين : المغلوبة عقولهم بكثرة السّحر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:187",
      "surahNumber": 26,
      "ayahNumber": 187,
      "text": "كسفا : قطَعَ عذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:189",
      "surahNumber": 26,
      "ayahNumber": 189,
      "text": "الظّلة : سحابة أظلّــتهم ثم أمطرتهم نارًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:196",
      "surahNumber": 26,
      "ayahNumber": 196,
      "text": "زبر الأولين : كتب الرّسل السابقين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "26:202",
      "surahNumber": 26,
      "ayahNumber": 202,
      "text": "بغتة : فجأة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
