{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 17,
  "entries": [
    {
      "verseKey": "17:1",
      "surahNumber": 17,
      "ayahNumber": 1,
      "text": "سبحان الذي : تنزيها لله و تعجيبا من قدرته\\nأسرى بعبده : جعَلَ البراق يسري به صلى الله عليه و سلم\\nلِنُريه . . : لِنرفعه إلى السّماء فنُريه . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:2",
      "surahNumber": 17,
      "ayahNumber": 2,
      "text": "وكيلا : ربّا تكلون إليه أموركم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:3",
      "surahNumber": 17,
      "ayahNumber": 3,
      "text": "ذرّية . . : أخصُّ ذرّية أو يا ذرّية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:4",
      "surahNumber": 17,
      "ayahNumber": 4,
      "text": "قضينا إلى بني إسرائيل : أوحينا إليهم و أعلمناهم بما سيقع منهم من الإفساد مرّتين\\nلتعلُنّ : لَتفرطُنّ في الظلم و العدوان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:5",
      "surahNumber": 17,
      "ayahNumber": 5,
      "text": "وعد أولاهما : العقاب الموعود على أولاهما\\nأولي بأس : ذوي قوّة و بطش في الحروب\\nفجاسوا : تردّدوا لطلبكم باستقصاء\\nخلال الدّيار : وسطها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:6",
      "surahNumber": 17,
      "ayahNumber": 6,
      "text": "الكَرّة : الدّولة و الغَلَبَة\\nأكثر نفيرا : أكثر عددا أو عشيرة من أعدائكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:7",
      "surahNumber": 17,
      "ayahNumber": 7,
      "text": "ليسوءوا وُجوهكم : ليُحزنوكم حزنا يبدو في وجوهكم\\nليُتبّروا : ليُهلكوا و يُدمّروا\\nما علوْا : ما استولوا عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:8",
      "surahNumber": 17,
      "ayahNumber": 8,
      "text": "حصيرا : سجنا أو مهادا و فراشا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:9",
      "surahNumber": 17,
      "ayahNumber": 9,
      "text": "هي أقوم : أسدّ الطرق (ملة الإسلام – و التوحيد)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:12",
      "surahNumber": 17,
      "ayahNumber": 12,
      "text": "الليل و النّهار : نفسهما أو نيّرى الليل و النّهار\\nفمحوْنا آية الليل : خلقنا القمر مطموس النّور مظلما\\nآية النّهار مُبصرة : الشمس مضيئة منيرة للأبصار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:13",
      "surahNumber": 17,
      "ayahNumber": 13,
      "text": "ألزمناه طائره : عمله المقدّر عليه لا ينفكّ عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:14",
      "surahNumber": 17,
      "ayahNumber": 14,
      "text": "حسيبا : حاسبا و عادّا . أو محاسبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:15",
      "surahNumber": 17,
      "ayahNumber": 15,
      "text": "لا تزر وازرة . . : لا تحمل نفس آثمةٌ . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:16",
      "surahNumber": 17,
      "ayahNumber": 16,
      "text": "أمَرنا مُترفيها : أمرنا متنعّميها بطاعة الله\\nففسقوا فيها : فتمرّدوا و عَصوْا\\nفدمّرناها : استأصلناها و محونا آثارها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:17",
      "surahNumber": 17,
      "ayahNumber": 17,
      "text": "القرون : الأمم المكذبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:18",
      "surahNumber": 17,
      "ayahNumber": 18,
      "text": "يصلاها : يدْخلها . أو يقاسي حرّها\\nمدحورا : مطرودا مُبعدا من رحمة الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:20",
      "surahNumber": 17,
      "ayahNumber": 20,
      "text": "كُلاّ نمِدّ : نزيد من العطاء مرّة بعد أخرى\\nمحظورا : ممنوعا عمّن يريده تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:22",
      "surahNumber": 17,
      "ayahNumber": 22,
      "text": "مخذولا : غير منصور و لا مُعان من الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:23",
      "surahNumber": 17,
      "ayahNumber": 23,
      "text": "قضى ربّك : أمر و ألزم و حَكَم\\nأفّ : كلمة تضجُّر و كراهيّة و تبرّم\\nلا تنهرهما : لا تزجرهما عمّا لا يعجبك\\nقولا كريما : حسنا جميلا ليّنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:25",
      "surahNumber": 17,
      "ayahNumber": 25,
      "text": "للأوّابين : للتّوابين مما يفرُط منهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:29",
      "surahNumber": 17,
      "ayahNumber": 29,
      "text": "يَدَك مغلولة : كناية عن الشّح\\nتبسطها كلّ البسط : كناية عن التّبذير و الإسراف\\nمحسورا : نادما أو مُنقطعا بك مُعدما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:30",
      "surahNumber": 17,
      "ayahNumber": 30,
      "text": "يقْدِر : يضيّقه على من يشاء لحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:31",
      "surahNumber": 17,
      "ayahNumber": 31,
      "text": "خشية إملاق : خوف فقر و فاقة\\nخِطئاً كبيرا : إثما عظيما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:33",
      "surahNumber": 17,
      "ayahNumber": 33,
      "text": "سُلطانا : تسلّطا على القاتل بالقصاص أو الدّيّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:34",
      "surahNumber": 17,
      "ayahNumber": 34,
      "text": "يبلغ أشدّه : قوّته على حفظ ماله و رشده فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:35",
      "surahNumber": 17,
      "ayahNumber": 35,
      "text": "بالقسطاس المستقيم : بالميزان العدل\\nأحسن تأويلا : مآلا و عاقبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:36",
      "surahNumber": 17,
      "ayahNumber": 36,
      "text": "لا تَقْــف : لا تتبع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:37",
      "surahNumber": 17,
      "ayahNumber": 37,
      "text": "مرَحا : فرحا و بطرا و اختيالا و فخرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:39",
      "surahNumber": 17,
      "ayahNumber": 39,
      "text": "مدحورا : مُبعدا من رحمة الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:40",
      "surahNumber": 17,
      "ayahNumber": 40,
      "text": "أفصأفاكم ربّكم : أفضّلكم ربّكم فخصّكم ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:41",
      "surahNumber": 17,
      "ayahNumber": 41,
      "text": "صرّفنا : كرّرنا القول بأساليب مختلفة\\nنفورا : تباعُدا و إعراضا عن الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:42",
      "surahNumber": 17,
      "ayahNumber": 42,
      "text": "لابتغوْا : لَطلبوا\\nسبيلا : بالمُغالبة و الممانعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:45",
      "surahNumber": 17,
      "ayahNumber": 45,
      "text": "حجابا مستورا : ساترا أو مستورا عن الحسّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:46",
      "surahNumber": 17,
      "ayahNumber": 46,
      "text": "أكنّة : أغطية كثيرة مانعة\\nوقرا : صمما و ثقلا في السّمع عظيما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:47",
      "surahNumber": 17,
      "ayahNumber": 47,
      "text": "هم نجوى : مُتناجون في أمرك فيما بينهم\\nمسحورا : مغلوبا على عقله بالسِّحر أو ساحرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:49",
      "surahNumber": 17,
      "ayahNumber": 49,
      "text": "رُفاتا : أجزاءً مفتتة . أو ترابا أو غُبارا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:51",
      "surahNumber": 17,
      "ayahNumber": 51,
      "text": "يكبر : يعظم عن قبول الحياة كالسّماوات\\nفطركم : أبدعكم و أحدثكم\\nفسينغظون . . : يُحرّكون استهزاءً . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:52",
      "surahNumber": 17,
      "ayahNumber": 52,
      "text": "بحمده : مُنْقادين انْنقياد الحامدين له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:53",
      "surahNumber": 17,
      "ayahNumber": 53,
      "text": "ينزغ بينهم : يُفسد و يُهيج الشّرّ بينهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:54",
      "surahNumber": 17,
      "ayahNumber": 54,
      "text": "وكيلا : موكلا إليك أمرُهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:55",
      "surahNumber": 17,
      "ayahNumber": 55,
      "text": "زبورا : كتابا فيه تحميد و تمجيد و مواعظ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:56",
      "surahNumber": 17,
      "ayahNumber": 56,
      "text": "تحويلا : نقلَه إلى غيركم ممّن لم يعبُدهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:57",
      "surahNumber": 17,
      "ayahNumber": 57,
      "text": "الوسيلة : القربة بالطاعة و العبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:59",
      "surahNumber": 17,
      "ayahNumber": 59,
      "text": "مُبصرة : آية بيّنةً واضحةً\\nفظلموا بها : فكروا بها ظالمين فأُهلكوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:60",
      "surahNumber": 17,
      "ayahNumber": 60,
      "text": "أحاط بالنّاس : علما و قدْرة فهم في قبضته تعالى\\nالشّجرة الملعونة : شجرة الزّقوم (جعلناها فتنة)\\nطُغيانا : تجاوزا للحدّ في كفرهم و تمرّدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:62",
      "surahNumber": 17,
      "ayahNumber": 62,
      "text": "أرأيتَك : أخبرني\\nلأحتنكنّ ذرّيّته : لأستولينّ عليهم . أو لأستأصلنّهم بالإغواء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:64",
      "surahNumber": 17,
      "ayahNumber": 64,
      "text": "استفزز : استخِفّ و استعجلْ و أزعِجْ\\nأجلب عليهم : صِحْ عليهم و سُقهم\\nبخيلك و رجلك : بكلّ راكب و ماشٍ في معاصي الله\\nغرورا : باطلا و خِداعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:65",
      "surahNumber": 17,
      "ayahNumber": 65,
      "text": "عليهم سلطان : تسلّط و قدرة على إغوائهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:66",
      "surahNumber": 17,
      "ayahNumber": 66,
      "text": "يُزجي : يُجري و يسيّر و يسوق برفق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:68",
      "surahNumber": 17,
      "ayahNumber": 68,
      "text": "أن يخسف بكم : يُغوّر و يُغيّب بكم تحت الثرى\\nحاصبا : ريحا شديدة ترميكم بالحصباء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:69",
      "surahNumber": 17,
      "ayahNumber": 69,
      "text": "قاصفا : عاصفا شديدا مُهلكا\\nتبيعا : نصيرا أو مُطالبا بالثأر منّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:71",
      "surahNumber": 17,
      "ayahNumber": 71,
      "text": "بإمامهم : بمن ائتموا به أو بكتابهم\\nفتيلا : قدْر الخيط في شِقّ النواة من الجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:73",
      "surahNumber": 17,
      "ayahNumber": 73,
      "text": "ليَفتنونك : ليوقِعونك في الفتنة و ليصرفونك\\nلتفتري علينا : لتختلق و تتقوّل علينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:74",
      "surahNumber": 17,
      "ayahNumber": 74,
      "text": "تركنُ إليهم : تميل إليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:75",
      "surahNumber": 17,
      "ayahNumber": 75,
      "text": "ضعف الحياة : عذابا مُضاعفا في الحياة الدّنيا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:76",
      "surahNumber": 17,
      "ayahNumber": 76,
      "text": "ليستفزّونك : لَيستخفّونك و يُـزعِجونك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:77",
      "surahNumber": 17,
      "ayahNumber": 77,
      "text": "تحويلا : تغييرا و تبديلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:78",
      "surahNumber": 17,
      "ayahNumber": 78,
      "text": "لدُلوك الشّمس : بعد أو عند زوالها عن كبد السّماء\\nغَسق الليل : ظُلمته أو شِدّتِها\\nو قرآن الفجر : و أقِم صلاة الصّبح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:79",
      "surahNumber": 17,
      "ayahNumber": 79,
      "text": "فتهجّدْ : التّهجّد : الصّلاة ليلا بعد الإستيقاظ\\nنافلة لك : فريضة زائدة خاصّة بك\\nمقاما محمودا : مقام الشفاعة العُظمى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:80",
      "surahNumber": 17,
      "ayahNumber": 80,
      "text": "مُدخل صدق : إدْخالا مرضيّا جيّدا في أموري\\nسلطانا نصيرا : قهرا و عِزّا ننصر به الإسلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:81",
      "surahNumber": 17,
      "ayahNumber": 81,
      "text": "زهق الباطل : زال و اضمحلّ الشّرك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:82",
      "surahNumber": 17,
      "ayahNumber": 82,
      "text": "خسارا : هلاكا بسبب كُفرهم به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:83",
      "surahNumber": 17,
      "ayahNumber": 83,
      "text": "نأى بجانبه : لوَى عِطفهُ تكبّرا و عِنادا\\nكان يئوسا : شديد اليأس و القنوط من رحمتنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:84",
      "surahNumber": 17,
      "ayahNumber": 84,
      "text": "شاكلته : مذهبــِـهِ الذي يُشاكلُ حاله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:86",
      "surahNumber": 17,
      "ayahNumber": 86,
      "text": "وكيلا : منْ تعهّد يإعادته إليك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:88",
      "surahNumber": 17,
      "ayahNumber": 88,
      "text": "ظهيرا : مُعينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:89",
      "surahNumber": 17,
      "ayahNumber": 89,
      "text": "صرّفنا : ردّدنا بأساليب مختلفة\\nكلّ مثل : معنى غريب حسن بديع\\nفأبى : فلمْ يرضَ\\nكُفورا : جُحُودا للحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:90",
      "surahNumber": 17,
      "ayahNumber": 90,
      "text": "ينبوعا : عينا لا ينْضَبُ ماؤها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:92",
      "surahNumber": 17,
      "ayahNumber": 92,
      "text": "كِسفا : قِطعا\\nقبيلا : مُقابلة و عِيانا . أو جماعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:93",
      "surahNumber": 17,
      "ayahNumber": 93,
      "text": "زُخرف : ذهَبٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:97",
      "surahNumber": 17,
      "ayahNumber": 97,
      "text": "خبتْ : سكَنَ لَهبُها\\nسعيرا : لهبا و توقّدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:98",
      "surahNumber": 17,
      "ayahNumber": 98,
      "text": "رُفاتا : أجزاء مُفتّتة . أو تُرابا أو غُبارا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:100",
      "surahNumber": 17,
      "ayahNumber": 100,
      "text": "قتورا : مُبالغا في البُخل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:101",
      "surahNumber": 17,
      "ayahNumber": 101,
      "text": "مسحورا : مغلوبا على عقلك بالسّحر أو ساحرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:102",
      "surahNumber": 17,
      "ayahNumber": 102,
      "text": "بَصائر : بيّنات تُبَصِّر من يشهدها بصدقي\\nمثبورا : هالكا أو مصروفا عن الخير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:103",
      "surahNumber": 17,
      "ayahNumber": 103,
      "text": "يستفزّهم : يَستخِفّهُمْ و يُزعجهم للخروج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:104",
      "surahNumber": 17,
      "ayahNumber": 104,
      "text": "لفيفا : جميعا مُختلطين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:106",
      "surahNumber": 17,
      "ayahNumber": 106,
      "text": "فرقناه : بيّــنّاه و فصّلناه أو أنزلناه مُفرّقا\\nعلى مُكث : على تُؤَدَة و تأنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "17:110",
      "surahNumber": 17,
      "ayahNumber": 110,
      "text": "لا تُخافت بها : لا تسرّ بها حتى لا تُسمع مَن خلفك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
