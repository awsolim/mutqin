{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 50,
  "entries": [
    {
      "verseKey": "50:1",
      "surahNumber": 50,
      "ayahNumber": 1,
      "text": "و القرآن : قسم جوابه لتبعثنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:3",
      "surahNumber": 50,
      "ayahNumber": 3,
      "text": "رَجْع بعيدٌ : رجوعٌ إلى الحياة غير ممكن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:5",
      "surahNumber": 50,
      "ayahNumber": 5,
      "text": "أمرٍ مريج : مختلط مضطرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:6",
      "surahNumber": 50,
      "ayahNumber": 6,
      "text": "فروج : فتوق و شقوق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:7",
      "surahNumber": 50,
      "ayahNumber": 7,
      "text": "الأرض مددناها : بسطناها للاستقرارعليها\\nرواسيَ : جبالا ثوابت تمنعها المَيَدَان\\nزوْج بهيج : صِنـْـف حسن نضير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:8",
      "surahNumber": 50,
      "ayahNumber": 8,
      "text": "عبد منيب : راجع إلينا مذعن ٍ بقدرتنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:9",
      "surahNumber": 50,
      "ayahNumber": 9,
      "text": "حبّ الحصيد : حبّ الزّرع الذي يحصد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:10",
      "surahNumber": 50,
      "ayahNumber": 10,
      "text": "النخل باسقات : طوالاً . أو حوامل\\nلها طلعٌ : هو ثمرها ما دام في وعائه\\nنضيد : متراكمٌ بعضه فوق بعض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:11",
      "surahNumber": 50,
      "ayahNumber": 11,
      "text": "كذلك الخروج : من القبور أحياءً عند البعث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:12",
      "surahNumber": 50,
      "ayahNumber": 12,
      "text": "أصحاب الرّس : البئر ، رسّوا نبيّهم فيها فأهلكوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:14",
      "surahNumber": 50,
      "ayahNumber": 14,
      "text": "أصحاب الأيكة : سُـكّـان الغيضة الكثيفة الملتفّة الشجر (قوم شعيب)\\nقوْم تبّع : أبي كَــِربٍ الحِمْـيَريّ ملِك اليَمَن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:15",
      "surahNumber": 50,
      "ayahNumber": 15,
      "text": "أفعيينا بالخلق : أفعجزنا عنه – كلاّ\\nفي لـَـبْس ٍ : خَلـْط و شبهةٍ و شكّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:16",
      "surahNumber": 50,
      "ayahNumber": 16,
      "text": "حَبْـل الوريد : عِرْق كبير في العنق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:17",
      "surahNumber": 50,
      "ayahNumber": 17,
      "text": "يَتلـقّى المتلقّـيان : يحفظ و يكتب الملكان\\nقعيدٌ : مَلـَـكٌ قاعد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:18",
      "surahNumber": 50,
      "ayahNumber": 18,
      "text": "رقيبٌ عتيدٌ : مَلـَـكٌ حافظ لأقواله مُعدّ حاضرٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:19",
      "surahNumber": 50,
      "ayahNumber": 19,
      "text": "سَكْرة الموت : شِدّته و غَمْرَته الذاهبة بالعقل\\nتحيد : تميل عنه و تفرّ منه و تـَـهْرُب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:22",
      "surahNumber": 50,
      "ayahNumber": 22,
      "text": "غِطاءَك : حِحاب غفلتك عن الآخرة\\nحديد : نافِذ قويّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:23",
      "surahNumber": 50,
      "ayahNumber": 23,
      "text": "عتيد : مُعدّ حاضر مُهَـيّـأ للعرْض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:24",
      "surahNumber": 50,
      "ayahNumber": 24,
      "text": "عنيد : شديد العِناد و المجافاة للحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:25",
      "surahNumber": 50,
      "ayahNumber": 25,
      "text": "مُعتد : ظالم متجاوز للحدّ\\nمُريب : شاكّ في الله و في دينه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:27",
      "surahNumber": 50,
      "ayahNumber": 27,
      "text": "ما أطْغيته : ما قهَرْتـُـهعلى الطغيان و الغَواية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:31",
      "surahNumber": 50,
      "ayahNumber": 31,
      "text": "أزلفت الجَنة : قـُـــِرّبَتْ و أدْنِيَتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:32",
      "surahNumber": 50,
      "ayahNumber": 32,
      "text": "أوّاب : رجّاع إلى الله بالتوبة\\nحفيظ : لما استودعه الله من حقّه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:33",
      "surahNumber": 50,
      "ayahNumber": 33,
      "text": "بقلب منيب : مُخلص مُقبل على طاعة الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:36",
      "surahNumber": 50,
      "ayahNumber": 36,
      "text": "كمْ أهلكنا : كثيرا أهلكنا\\nقرنٍ : أمّة\\nبَطشًا : قوّة أو أخْذا شديدا في كلّ شيء\\nفنقـّـبوا في البلاد : طوّفوا في الأرض حَذرَ الموت\\nمحيص : مَهْرَبٍ و مفرّ من الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:38",
      "surahNumber": 50,
      "ayahNumber": 38,
      "text": "لُغوب : تعب و إعياءٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:39",
      "surahNumber": 50,
      "ayahNumber": 39,
      "text": "سبّح بحمد ربّـك : نـَــِزّهْهُ تعالى عن كلّ نقص أو صَلّ له تعالى حامدًا له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:40",
      "surahNumber": 50,
      "ayahNumber": 40,
      "text": "أدبار السّجود : أعقاب الصلوات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:42",
      "surahNumber": 50,
      "ayahNumber": 42,
      "text": "يسْمعون الصيحة : نفخة البعث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:44",
      "surahNumber": 50,
      "ayahNumber": 44,
      "text": "تشقّق الأرض. . : تنفلق و تتصدّع . .\\nسِراعًا : مُسرعين إلى الدّاعي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "50:45",
      "surahNumber": 50,
      "ayahNumber": 45,
      "text": "بجبّار : بمُسلـّط تجْـبـرُهمْ على الإيمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
