{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 57,
  "entries": [
    {
      "verseKey": "57:1",
      "surahNumber": 57,
      "ayahNumber": 1,
      "text": "سبَّح لله . . : نزه الله و مجده و دلّ عليه\\nالعزيز : القادر الغالب على كل شيء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:3",
      "surahNumber": 57,
      "ayahNumber": 3,
      "text": "الأوّل : السابق على جميع الموجودات\\nالآخر : الباقي بعد فَـنائِها\\nالظاهر : بوجوده و مصنوعاته و تدبيره\\nالباطن : بكُنه ذاته عن العقول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:4",
      "surahNumber": 57,
      "ayahNumber": 4,
      "text": "استوى على العرش : استواءٍ يليق بكماله تعالى\\nما يلج : ما يدخل من مطر و غيره\\nما يعرج فيها : ما يصعد إليها من الملائكة و الأعمال\\nو هو معكم : بعلمه المحيط بكل شيء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:6",
      "surahNumber": 57,
      "ayahNumber": 6,
      "text": "يولج الليل : يدخله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:10",
      "surahNumber": 57,
      "ayahNumber": 10,
      "text": "قبْل الفتح : فتح مكة أو صلح الحديبية\\nالحسنى : المثوبة الحسنى (الجنّة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:11",
      "surahNumber": 57,
      "ayahNumber": 11,
      "text": "قرْضا حسنا : محتسبا به ، طيبة به نفسه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:13",
      "surahNumber": 57,
      "ayahNumber": 13,
      "text": "انظرونا : انتظرونا\\nنقتبس : نـُـصِـبْ و نأخذ و نستضيء\\nبسور : حاجز بين الجنة و النار (الأعراف)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:14",
      "surahNumber": 57,
      "ayahNumber": 14,
      "text": "ينادونهم : ينادي المنافقون المؤمنين\\nفتنـْـتم أنفسكم : محنتموها و أهلكتموها بالنفاق\\nتربّـصتم : انتظرتم بالمؤمنين النوائب\\nغرتكم الأماني : خدعتكم الأباطيل\\nالغرور : الشيطان و كل خادع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:15",
      "surahNumber": 57,
      "ayahNumber": 15,
      "text": "هي مولاكم : النار أولى بكم . أو ناصركم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:16",
      "surahNumber": 57,
      "ayahNumber": 16,
      "text": "ألمْ يأن . . : ألمْ يجيء . .\\nأن تخشع : وقت أن تخضع و ترق و تلين\\nالأمد : الأجل أو الزمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:20",
      "surahNumber": 57,
      "ayahNumber": 20,
      "text": "تكاثرٌ . . : مباهاة و تطاول بالعَدد و العُدد\\nأعْجَب الكفار : راق الزّراع\\nيهيج : يَيْبس في أقصى غايته\\nيكون حطاما : فتاتا هشيما متكسّرا بعد يُـبْـسِه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:21",
      "surahNumber": 57,
      "ayahNumber": 21,
      "text": "سابقوا : سارعوا مسارعة المتسابقين في المضمار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:22",
      "surahNumber": 57,
      "ayahNumber": 22,
      "text": "نبرأها : نـَـخْـلـُـقَ هذه الكائنات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:23",
      "surahNumber": 57,
      "ayahNumber": 23,
      "text": "لكيلا تأسَوْا : لكيلا تحزنوا حزن قنوط\\nلا تفرحوا : فَرَحَ بَطَــٍر و اختيال\\nمختال فخور : متكبّر مُـبَاهٍ متطاول بما أوتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:25",
      "surahNumber": 57,
      "ayahNumber": 25,
      "text": "الميزان : العَدْل و أمَرْنا به أو الآلة المعروفة\\nو أنزلنا الحديد : خلقناه . أو هيّـأناه للنّاس\\nبأس شديد : قوة شديدة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:27",
      "surahNumber": 57,
      "ayahNumber": 27,
      "text": "قـفـينا على آثارهم : أتبَعناهم و بعثنا بعدهمْ\\nالإنجيل : و قد حرّفوه بَعد\\nالذين اتبعوه : على دينه الذي أرسل به\\nرأفة و رحمة : مودّة و لينا ، و شفـَقة ً و تعطّـفا\\nرهبانية : مغالاة في التعبّد و التـّـقـشّـف\\nما كتبناها عليهم : ما فرضناها عليهم بل ابتدعوها\\nفما رعوها : بلْ ضيّعها أخلافهم و كفروا بدين عيسى عليه السلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:28",
      "surahNumber": 57,
      "ayahNumber": 28,
      "text": "يؤتكم كـفــلـيـن : نصِـيبَـين (أجْرَيْن)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "57:29",
      "surahNumber": 57,
      "ayahNumber": 29,
      "text": "لئلاّ يَعلم : \\\"ليعلم و \\\"\\\"لا\\\"\\\" مزيدة \\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
