{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 37,
  "entries": [
    {
      "verseKey": "37:1",
      "surahNumber": 37,
      "ayahNumber": 1,
      "text": "و الصّـافات صفّا : قـَسَمبالجماعات تصطفّ للعبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:2",
      "surahNumber": 37,
      "ayahNumber": 2,
      "text": "فالزّاجرات زجرا : تزْجر عن المعاصي بالأقوال و الأفعال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:3",
      "surahNumber": 37,
      "ayahNumber": 3,
      "text": "فالتـّـاليات ذِكرا : تتلوا آيات الله للعلم و التّعليم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:4",
      "surahNumber": 37,
      "ayahNumber": 4,
      "text": "إنّ إلهكم لواحد : جواب القسم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:7",
      "surahNumber": 37,
      "ayahNumber": 7,
      "text": "شيطان مارد : متمرّد خارج عن الطاعة\\nعلى آثارهم يُهرعون : يُزعجون و يُحثّون على الإسراع الشّديد على أثارهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:8",
      "surahNumber": 37,
      "ayahNumber": 8,
      "text": "يقذفون : يُرْجمون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:9",
      "surahNumber": 37,
      "ayahNumber": 9,
      "text": "دحورا : إبعادا و طردا\\nعذابٌ واصبٌ : دائمٌ لا ينـْـقطع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:10",
      "surahNumber": 37,
      "ayahNumber": 10,
      "text": "خَطِـف الخطفة : اختلس الكلمة مسارقة بسرعة\\nشهاب : ما يرى كالكوكب منقضّا من السّماء\\nثاقبٌ : مُضيءٌ . أو مُـحْـرقٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:11",
      "surahNumber": 37,
      "ayahNumber": 11,
      "text": "طين لازب : ملتزق بَعْـضه ببَعض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:12",
      "surahNumber": 37,
      "ayahNumber": 12,
      "text": "و يسخرون : و هم يَهزءون بتعَجّبكَ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:14",
      "surahNumber": 37,
      "ayahNumber": 14,
      "text": "بستسخِرون : يُبالِغونَ في سُخْريَتهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:18",
      "surahNumber": 37,
      "ayahNumber": 18,
      "text": "أنتم داخرون : صاغِـرون أذلاّء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:19",
      "surahNumber": 37,
      "ayahNumber": 19,
      "text": "زجْرَة واحدة : \\\"صيحة واحدة \\\"\\\" نـَفخة البَعث \\\"\\\"\\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:20",
      "surahNumber": 37,
      "ayahNumber": 20,
      "text": "ياويْـلنا : يا هلاكنا احضر\\nيوم الدّين : يوم الجَزاء و الحساب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:22",
      "surahNumber": 37,
      "ayahNumber": 22,
      "text": "أزواجَهم : أشباههم . أو قُرناءهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:24",
      "surahNumber": 37,
      "ayahNumber": 24,
      "text": "قِـفوهم : احبسوهم في موقف الحساب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:28",
      "surahNumber": 37,
      "ayahNumber": 28,
      "text": "عن اليمين : من جهة الدّين فتصدّوننا عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:30",
      "surahNumber": 37,
      "ayahNumber": 30,
      "text": "قوما طاغين : مُجاوزين الحدّ في العصيان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:31",
      "surahNumber": 37,
      "ayahNumber": 31,
      "text": "فحقّ علينا : ثبت ووجب علينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:32",
      "surahNumber": 37,
      "ayahNumber": 32,
      "text": "فأغويناكم : فدعوناكم إلى الغيّ فاستجبتم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:40",
      "surahNumber": 37,
      "ayahNumber": 40,
      "text": "المخلصين : الذين أخلصهم الله لطاعته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:45",
      "surahNumber": 37,
      "ayahNumber": 45,
      "text": "بكأسٍ : بخمر . أو بقدح فيه خمر\\nمِنْ مَعين : من شراب نابع من العيون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:47",
      "surahNumber": 37,
      "ayahNumber": 47,
      "text": "لا فيها غوْلٌ : ليس فيها ضرر ما كخمر الدنيا\\nعنها يُنزفون : بسببها يسكرون و تُنزع عقولهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:48",
      "surahNumber": 37,
      "ayahNumber": 48,
      "text": "قاصرات الطّرف : حور لا ينظرن إلى غير أزواجهنّ\\nعِـينٌ : نُـجْـلُ العيون حِسانها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:49",
      "surahNumber": 37,
      "ayahNumber": 49,
      "text": "بيْضٌ مكنونٌ : مصون مستور لم يُصبه غبار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:53",
      "surahNumber": 37,
      "ayahNumber": 53,
      "text": "لَمَدينون : لمجزيون و محاسبون ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:55",
      "surahNumber": 37,
      "ayahNumber": 55,
      "text": "سَوَاء الجحيم : وسطها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:56",
      "surahNumber": 37,
      "ayahNumber": 56,
      "text": "إنْ كِدْت لترْدين : إنّك قاربت لتهلكني بالإغواء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:57",
      "surahNumber": 37,
      "ayahNumber": 57,
      "text": "المُحضرين : للعذاب مثلك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:62",
      "surahNumber": 37,
      "ayahNumber": 62,
      "text": "خيرٌ نُزُلا : ضيافة و تكرمة و لذة\\nشجرة الزّقوم : شجرة من أخبث الشّجر بتهامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:63",
      "surahNumber": 37,
      "ayahNumber": 63,
      "text": "فتنة للظّالمين : مَحنة و عذابا لهم في الآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:64",
      "surahNumber": 37,
      "ayahNumber": 64,
      "text": "أصْـل الجحيم : قعر جهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:65",
      "surahNumber": 37,
      "ayahNumber": 65,
      "text": "طلـْعها : ثمرها الشبيه بطلع النّخل\\nكأنّه رءوس الشياطين : تمثيل لتناهيه في البشاعة و القبح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:67",
      "surahNumber": 37,
      "ayahNumber": 67,
      "text": "لشَوبا : لخَـلـْـطاً و مزاجا\\nمنْ حميم : ماءٍ بالغ غاية الحرارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:83",
      "surahNumber": 37,
      "ayahNumber": 83,
      "text": "منْ شيعَتِه : ممّن شايعه على منهاجه و ملّـته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:86",
      "surahNumber": 37,
      "ayahNumber": 86,
      "text": "أإفْـكا ؟ : أكذبا و باطلا ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:88",
      "surahNumber": 37,
      "ayahNumber": 88,
      "text": "فَـنـَظر : تأمَـل تأمُـلَ الكاملين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:89",
      "surahNumber": 37,
      "ayahNumber": 89,
      "text": "إنّي سقيمٌ : يُريد أنه سقيم القلب لكفرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:91",
      "surahNumber": 37,
      "ayahNumber": 91,
      "text": "فرَاغ إلى آلهتهم : فمال إليها خفية ليُـحطّمها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:93",
      "surahNumber": 37,
      "ayahNumber": 93,
      "text": "ضربا باليمين : يضربهم ضربا مُلتبسا بالقوّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:94",
      "surahNumber": 37,
      "ayahNumber": 94,
      "text": "يزفّون : يسرعون في مشيهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:101",
      "surahNumber": 37,
      "ayahNumber": 101,
      "text": "بغلام حليم : رجّح كثيرٌ أنّه إسماعيل عليه السلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:102",
      "surahNumber": 37,
      "ayahNumber": 102,
      "text": "بَلغَ مَعَه السّـعْي : درجة العمل معه في حوائجه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:103",
      "surahNumber": 37,
      "ayahNumber": 103,
      "text": "أسلما : استسلما و انقادا لأمره تعالى\\nتلّه للجبين : أضجعه على جبينه على الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:106",
      "surahNumber": 37,
      "ayahNumber": 106,
      "text": "البلاء المبين : الإختبار البيّن. أو المحنة البيّـنة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:107",
      "surahNumber": 37,
      "ayahNumber": 107,
      "text": "بذِبْح : بكبشٍ يُذبح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:125",
      "surahNumber": 37,
      "ayahNumber": 125,
      "text": "أتدْعون بَعْلا : أتعبدون الصّـنم المسمّى بعلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:127",
      "surahNumber": 37,
      "ayahNumber": 127,
      "text": "لمُحضرون : تُحضرهم الزّبانية في النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:130",
      "surahNumber": 37,
      "ayahNumber": 130,
      "text": "إلياسين : إلياس . أو إلياس و أتباعه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:135",
      "surahNumber": 37,
      "ayahNumber": 135,
      "text": "في الغابرين : في الباقين في العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:136",
      "surahNumber": 37,
      "ayahNumber": 136,
      "text": "دمّرنا الآخرين : أهلكناهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:137",
      "surahNumber": 37,
      "ayahNumber": 137,
      "text": "مُصبحين : داخلين في وقت الصّباح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:140",
      "surahNumber": 37,
      "ayahNumber": 140,
      "text": "أبق : هَرَبَ\\nالمشحون : المملوء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:141",
      "surahNumber": 37,
      "ayahNumber": 141,
      "text": "فَساهم : فقارع من في الفلك\\nالمدْحضين : المغلوبين بالقرعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "37:142",
      "surahNumber": 37,
      "ayahNumber": 142,
      "text": "فالتـَـقـَـمَه الحوت : ابتلعه\\nهو مُـليم : آتٍ بما يُلام عليه",
      "kind": "meaning",
