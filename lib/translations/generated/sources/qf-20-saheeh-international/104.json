{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 104,
  "entries": [
    {
      "verseKey": "104:1",
      "surahNumber": 104,
      "ayahNumber": 1,
      "text": "Woe to every scorner and mocker",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "104:2",
      "surahNumber": 104,
      "ayahNumber": 2,
      "text": "Who collects wealth and [continuously] counts it.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "104:3",
      "surahNumber": 104,
      "ayahNumber": 3,
      "text": "He thinks that his wealth will make him immortal.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "104:4",
      "surahNumber": 104,
      "ayahNumber": 4,
      "text": "No! He will surely be thrown into the Crusher.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "104:5",
      "surahNumber": 104,
      "ayahNumber": 5,
      "text": "And what can make you know what is the Crusher?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "104:6",
      "surahNumber": 104,
      "ayahNumber": 6,
      "text": "It is the fire of Allāh, [eternally] fueled,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "104:7",
      "surahNumber": 104,
      "ayahNumber": 7,
      "text": "Which mounts directed at the hearts.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "104:8",
      "surahNumber": 104,
      "ayahNumber": 8,
      "text": "Indeed, it [i.e., Hellfire] will be closed down upon them",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "104:9",
      "surahNumber": 104,
      "ayahNumber": 9,
      "text": "In extended columns.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
