  "entries": [
    {
      "verseKey": "63:2",
      "surahNumber": 63,
      "ayahNumber": 2,
      "text": "جُـنّة : وقاية لأنفسهم و أموالهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "63:3",
      "surahNumber": 63,
      "ayahNumber": 3,
      "text": "آمنوا : بألسِنـَتهم لا غير\\nفطُــبع : خُـتم بسبَب الكفر\\nلا يفقهون : لا يعرفون حقيقة الإيمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "63:4",
      "surahNumber": 63,
      "ayahNumber": 4,
      "text": "خُشُبٌ مُسنّـدة : إلى الحائط ، أجسامٌ بلا أحلام\\nهم العدوّ : الراسخون في العداوة\\nأنّى يؤفكون ؟ : كيف يُصرَفون عن الحقّ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "63:5",
      "surahNumber": 63,
      "ayahNumber": 5,
      "text": "لوّوْا رؤوسهم : عَطفوها إعرَاضا و استهزاءً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "63:7",
      "surahNumber": 63,
      "ayahNumber": 7,
      "text": "حتى ينفضّوا : كيْ يَـتفـرقوا عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "63:8",
      "surahNumber": 63,
      "ayahNumber": 8,
      "text": "رَجَعْنـَـا : من غزوة بني المصطلق\\nليُـخْرجَنّ الأعزّ : الأشد و الأقوى يَعنون أنفسهم\\nالأذلّ : الأضعف و الأهون . يعنون الرسول و المؤمنين\\nو لله العزّة : الغَـلبة و القهْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "63:9",
      "surahNumber": 63,
      "ayahNumber": 9,
      "text": "لا تـلهكم : لا تشغَـلْـكم و تصْرفكمْ\\nذِكر الله : عِبادَته و طاعته و مراقبته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "63:10",
      "surahNumber": 63,
      "ayahNumber": 10,
      "text": "لوْلا أخّرتني : هلاّ أمهلتني و أخّرت أجَلي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
