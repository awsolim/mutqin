{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 22,
  "entries": [
    {
      "verseKey": "22:1",
      "surahNumber": 22,
      "ayahNumber": 1,
      "text": "زلزلة الساعة : أهوال القيامة وشدائدها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:2",
      "surahNumber": 22,
      "ayahNumber": 2,
      "text": "تذهل : تغفُلُ وتُشغلُ لشدة الهول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:3",
      "surahNumber": 22,
      "ayahNumber": 3,
      "text": "مريد : متمرّدٍ عاتٍ متجرد للفساد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:4",
      "surahNumber": 22,
      "ayahNumber": 4,
      "text": "تولاّه : اتخذه وليا وتبعه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:5",
      "surahNumber": 22,
      "ayahNumber": 5,
      "text": "نطفة : منيّ\\nعلقة : قطعة دم جامدة\\nمُضغة : قطعة لحم قدر ما يمضغ\\nمُخلقة : مستبينة الخلق مُصوّرة\\nلتبلغوا أشدكم : كمال قوتكم وعقلكم\\nأرذل العمر : أخسّـِـه , أي الخَرَف والهَرَم\\nهامدة : ميتة يابسة قاحلة\\nاهتزتْ : تحركت بالنبات\\nرَبَتْ : ازدادت وانتفخت\\nزوج بهيج : صنف حسن نضير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:9",
      "surahNumber": 22,
      "ayahNumber": 9,
      "text": "ثانيَ عِطفه : لاويا لجانبه تكبرا وإباء\\nخزيٌ : ذلّ وهوان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:11",
      "surahNumber": 22,
      "ayahNumber": 11,
      "text": "على حرْف : شكّ وقلق و تزلزل في الدين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:13",
      "surahNumber": 22,
      "ayahNumber": 13,
      "text": "المولى : الناصر\\nالعشير : المصاحب المعاشر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:15",
      "surahNumber": 22,
      "ayahNumber": 15,
      "text": "ينصره الله : ينصر الله رسوله صلى الله عليه وسلم\\nبسبب إلى السماء : بحبل إلى سقف بيته\\nثم ليقطع : ثم ليختنق به حتى يموت\\nكيده : صنيعه بنفسه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:17",
      "surahNumber": 22,
      "ayahNumber": 17,
      "text": "الصّـابئين : عبدة الملائكة أو الكواكب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:18",
      "surahNumber": 22,
      "ayahNumber": 18,
      "text": "يسجد له : يخضع وينقاد لإرادته تعالى\\nحق عليه : ثبت ووجب عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:19",
      "surahNumber": 22,
      "ayahNumber": 19,
      "text": "خصْـمان : المؤمنون وسائر الكفار\\nالحميم : الماء البالغ نهاية الحرارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:20",
      "surahNumber": 22,
      "ayahNumber": 20,
      "text": "يُصهر به : يُذاب به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:21",
      "surahNumber": 22,
      "ayahNumber": 21,
      "text": "مقامِع : مطارق أو سِـياط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:24",
      "surahNumber": 22,
      "ayahNumber": 24,
      "text": "صراط الحميد : الإسلام الذي ارتضاه لعباده دينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:25",
      "surahNumber": 22,
      "ayahNumber": 25,
      "text": "المسجد الحرام : مكة (الحرم)\\nالعاكف فيه : المقيم فيه الملازم له\\nالباد : الطارئ غير المقيم\\nبإلحاد بظلم : بميل عن الحق إلى الباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:26",
      "surahNumber": 22,
      "ayahNumber": 26,
      "text": "بوأنا لإبراهيم : وطـّـأنا . أو بـيّـنا له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:27",
      "surahNumber": 22,
      "ayahNumber": 27,
      "text": "أذن في الناس : نادِ فيهم وأعـلِـمهم\\nرجالا : مشاة على أرجلهم\\nضامر : بعير مهزول من بُعد الشـقـّـة\\nفج عميق : طريق بعيد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:28",
      "surahNumber": 22,
      "ayahNumber": 28,
      "text": "بهيمة الأنعام : الإبل والبقر والضأن والمعز",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:29",
      "surahNumber": 22,
      "ayahNumber": 29,
      "text": "ثم ليقضوا تـفـثهم : ثم ليزيلوا بالتحلل أوساخهم أو ثم ليؤدوا مناسكهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:30",
      "surahNumber": 22,
      "ayahNumber": 30,
      "text": "حُرمات الله : تكاليفه من مناسك الحج وغيرها\\nالرّجس . . : القذر والنجس وهو الأوثان\\nقول الزور : قول الباطل والكذب القبيح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:31",
      "surahNumber": 22,
      "ayahNumber": 31,
      "text": "حُنفاء لله : مائلين عن الباطل الى دين الحقّ\\nتهوى به الريح : تُسقطه وتقذفه\\nمكان سحيق : موضع بعيد مُـهـلـِـك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:32",
      "surahNumber": 22,
      "ayahNumber": 32,
      "text": "شعائر الله : البُدن المهداة للبيت المُعظم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:33",
      "surahNumber": 22,
      "ayahNumber": 33,
      "text": "محلها : وجوب نحرها\\nإلى البيت العتيق : منتهية إلى أرض الحرم كله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:34",
      "surahNumber": 22,
      "ayahNumber": 34,
      "text": "منسكا : نُسكا وعبادة ( الذبح قُربة لله )\\nبَشـّر المُخبتين : المُطمئنين إلى الله أو المُتواضعين له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:35",
      "surahNumber": 22,
      "ayahNumber": 35,
      "text": "وجلت قلوبهم : خافت هـيْـبة و إجلالا منه تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:36",
      "surahNumber": 22,
      "ayahNumber": 36,
      "text": "البُدن : الإبل . أو هي البقر المهداة للبيت\\nشعائر الله : أعلام شريعته في الحج\\nصوافّ : قائمات صففن أيديَهُن وأرجـُـلهُن\\nوجبت جُنُوبُها : سقطت على الأرض بعد النحر\\nأطعموا القانع : السائل\\nالمُعترّ : الذي يتعرض لكم دون سؤال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:38",
      "surahNumber": 22,
      "ayahNumber": 38,
      "text": "خوان كفور : خائن للأمانات – جاحد للنعم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:40",
      "surahNumber": 22,
      "ayahNumber": 40,
      "text": "صوامعُ : معابدُ رُهبان النصارى\\nبـِــيَع : كنائس النصارى\\nصلواتٌ : كنائس اليهود\\nمساجدُ : للمسلمين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:44",
      "surahNumber": 22,
      "ayahNumber": 44,
      "text": "أصحابُ مدين : قومُ شعيب عليه السلام\\nفأمليتُ للكافرين : أمهلتهم وأخـّـرت عقوبتهمْ\\nكان نكير : إنكاري عليهم بإهلاكهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:45",
      "surahNumber": 22,
      "ayahNumber": 45,
      "text": "فكأين من قرية : فكثير من القرى\\nخاوية على عروشها : ساقطة حيطانها على سقوفها المتهدمة\\nقصر مشيد : مرفوع البنيان خالٍ من ساكنيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:48",
      "surahNumber": 22,
      "ayahNumber": 48,
      "text": "أمليت لها : أمْـهَـلـتـُـها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:51",
      "surahNumber": 22,
      "ayahNumber": 51,
      "text": "مُعاجزين : ظانين أنهم يُعجزوننا ويفُوتوننا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:52",
      "surahNumber": 22,
      "ayahNumber": 52,
      "text": "تمنّى : قرأ الآيات المنزلة عليه\\nألقى الشيطان في أمنيته : ألقى في قلوب أوليائه الشُـبَهَ فيما يقرؤه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:54",
      "surahNumber": 22,
      "ayahNumber": 54,
      "text": "فـتـُخبت له : فتطمئن وتسْكن للقرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:55",
      "surahNumber": 22,
      "ayahNumber": 55,
      "text": "ِمرية منه : شك وقلق من القرآن\\nيوم عقيم : لا يوم بعده ( يوم القيامة )",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:59",
      "surahNumber": 22,
      "ayahNumber": 59,
      "text": "مُدخلا : الجنة . أو درجات رفيعة فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:60",
      "surahNumber": 22,
      "ayahNumber": 60,
      "text": "ثم بُغي عليه : ظلم بمعاودة العقاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:61",
      "surahNumber": 22,
      "ayahNumber": 61,
      "text": "يُولج : يُدخل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:67",
      "surahNumber": 22,
      "ayahNumber": 67,
      "text": "منسكا : شريعة خاصة . أو نـُسُـكا وعبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:71",
      "surahNumber": 22,
      "ayahNumber": 71,
      "text": "سُلطانا : حُجة وبرهانا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:72",
      "surahNumber": 22,
      "ayahNumber": 72,
      "text": "المنكر : الأمر المستقبح من العبوس والتجهّم\\nيسْطون : يَــثـِـبـُـون ويَبْطشُون غيظا وغضبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:74",
      "surahNumber": 22,
      "ayahNumber": 74,
      "text": "ما قدروا الله : ما عظّـموه . أو ما عَرَفوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "22:78",
      "surahNumber": 22,
      "ayahNumber": 78,
      "text": "هو اجتباكم : اختاركم لدينه وعبادته ونُصرته\\nحرج : ضيق بتكليف يشقّ ويعسُرُ\\nهو مولاكم : مَالِكِكُم وناصِرُكم و متولّي أموركم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
