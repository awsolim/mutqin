{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 19,
  "entries": [
    {
      "verseKey": "19:3",
      "surahNumber": 19,
      "ayahNumber": 3,
      "text": "نداءً خفيا : دعاءً مستورا لم يسمعه أحد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:4",
      "surahNumber": 19,
      "ayahNumber": 4,
      "text": "وهَنَ العظم : ضَعُـفَ و رَقّ\\nشقيّا : خائبا في وقت مّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:5",
      "surahNumber": 19,
      "ayahNumber": 5,
      "text": "خفت الموالي : أقاربي العَصبَة و كانوا شرار اليهود\\nوليّا : ابناً يلي الأمر بعدي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:6",
      "surahNumber": 19,
      "ayahNumber": 6,
      "text": "رضيّا : مرضيّا عندك قولا و فعلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:8",
      "surahNumber": 19,
      "ayahNumber": 8,
      "text": "أنّى يكون ؟ : كيف أو من أين يكون ؟\\nعتيّا : حالةً لا سبيل إلى مُداواتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:10",
      "surahNumber": 19,
      "ayahNumber": 10,
      "text": "آية : علامة على تحقّق المسئول لأشكرك\\nسويّا : سليما لا خرس بك و لا علة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:11",
      "surahNumber": 19,
      "ayahNumber": 11,
      "text": "من المحراب : المُصلّى أو الغرفة التـّي يتعبّد فيها\\nبُكرة و عشيّا : طرفي النّهار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:12",
      "surahNumber": 19,
      "ayahNumber": 12,
      "text": "الحكم : فهم التّوراة و العبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:13",
      "surahNumber": 19,
      "ayahNumber": 13,
      "text": "حنانا : رحمة و عطفا على النّاس\\nزكاة : بركة . أو طهارة من الذنوب\\nكان تقيّا : مُطيعا مجتنبا للمعاصي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:14",
      "surahNumber": 19,
      "ayahNumber": 14,
      "text": "برّا بوالديه : كثيرَ البرّ و الإحسان إليهما\\nجبّارا عصيّا : مُتكبّرا مخالفا أمر ربّه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:16",
      "surahNumber": 19,
      "ayahNumber": 16,
      "text": "انتبذت : اعتزلت و انفردتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:17",
      "surahNumber": 19,
      "ayahNumber": 17,
      "text": "حجابا : سِترا\\nروحنا : جبريل عليه السّلام\\nبشرا سويّا : إنسانا مُستوي الخلق تامّه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:19",
      "surahNumber": 19,
      "ayahNumber": 19,
      "text": "غُلاما زكيّا : مُزكّى مُطهّرا بالخِلقة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:20",
      "surahNumber": 19,
      "ayahNumber": 20,
      "text": "يغيّا : فاجرة تبغي الرّجال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:22",
      "surahNumber": 19,
      "ayahNumber": 22,
      "text": "مكانا قصيّا : بعيدا من أهلها وراء الجبل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:23",
      "surahNumber": 19,
      "ayahNumber": 23,
      "text": "فأجاءها المخاض : فألجأها و اضطرّها وجع الولادة\\nنسيا منسيّا : شيئا حقيرا متروكا لا يخطر بالبال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:24",
      "surahNumber": 19,
      "ayahNumber": 24,
      "text": "فناداها : جبريل أو عيسى عليهما السلام\\nسريّا : جدولا أو غلاما سامِيَ القـَدْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:25",
      "surahNumber": 19,
      "ayahNumber": 25,
      "text": "رُطبًا جنيّا : صالحا للاجْتِناء . أو طريّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:26",
      "surahNumber": 19,
      "ayahNumber": 26,
      "text": "قرّي عينا : طيبي نفسا و لا تحزني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:27",
      "surahNumber": 19,
      "ayahNumber": 27,
      "text": "شيئا فريّا : عظيما مُنكرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:29",
      "surahNumber": 19,
      "ayahNumber": 29,
      "text": "كان في المهد صبيّا : وُجد في فِراش الصّبية رضيعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:32",
      "surahNumber": 19,
      "ayahNumber": 32,
      "text": "برّا بوالدتي : بارّا بها مُحسنا مُكرما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:34",
      "surahNumber": 19,
      "ayahNumber": 34,
      "text": "قول الحقّ : كلمة الله لخلقه بقوله كنْ\\nيمترون : يشكّون أو يتجادلون بالباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:35",
      "surahNumber": 19,
      "ayahNumber": 35,
      "text": "قضى أمرا : أراد أن يُحدِثه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:38",
      "surahNumber": 19,
      "ayahNumber": 38,
      "text": "أسمع بهم و أبصر : ما أسمعهم و ما أبصرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:39",
      "surahNumber": 19,
      "ayahNumber": 39,
      "text": "يوم الحسرة : النّدامة الشّديدة على ما فات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:43",
      "surahNumber": 19,
      "ayahNumber": 43,
      "text": "صراطا سويّا : طريقا مُستقيما مُنجيا من الضلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:44",
      "surahNumber": 19,
      "ayahNumber": 44,
      "text": "عصيّا : كثير العصيان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:45",
      "surahNumber": 19,
      "ayahNumber": 45,
      "text": "وليّا : قرينا تليه و يليك في النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:46",
      "surahNumber": 19,
      "ayahNumber": 46,
      "text": "اهجرني مليّا : اجتنبني و فارقني دهرا طويلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:47",
      "surahNumber": 19,
      "ayahNumber": 47,
      "text": "حفيّا : برّا لطيفا أو رحيما مُكرما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:48",
      "surahNumber": 19,
      "ayahNumber": 48,
      "text": "شقيّا : خائبا ضائع السّعي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:50",
      "surahNumber": 19,
      "ayahNumber": 50,
      "text": "لسان صِدق : ثناءً حسنا في أهل كلّ دين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:51",
      "surahNumber": 19,
      "ayahNumber": 51,
      "text": "كان مخلصا : أخلصه الله و اصطفاه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:52",
      "surahNumber": 19,
      "ayahNumber": 52,
      "text": "قرّبناه نجيّا : مُناجيا لنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:58",
      "surahNumber": 19,
      "ayahNumber": 58,
      "text": "اجتبينا : اصطفيْنا و اخترنا للنّبوّة\\nبُكيّا : باكين من خشية الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:59",
      "surahNumber": 19,
      "ayahNumber": 59,
      "text": "خلفٌ : عَـقِـبٌ سَوْءٍ\\nيلقون غيّا : جزاء الغيّ . أو واديا في جهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:61",
      "surahNumber": 19,
      "ayahNumber": 61,
      "text": "مأتيّا : آتيا أو مُــنـَـجَّــزًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:62",
      "surahNumber": 19,
      "ayahNumber": 62,
      "text": "لغوا : قبيحا أو فُضولا من الكلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:65",
      "surahNumber": 19,
      "ayahNumber": 65,
      "text": "سميّا : مُضاهيا في ذاته و صفاته : لا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:68",
      "surahNumber": 19,
      "ayahNumber": 68,
      "text": "جثيّا : باركِين على رُكبهم لشدّة الهول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:69",
      "surahNumber": 19,
      "ayahNumber": 69,
      "text": "عتيّا : عِـصيانا ، أو جراءة أو فُجورا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:70",
      "surahNumber": 19,
      "ayahNumber": 70,
      "text": "صليّا : دُخولا أو مُقاساة لحرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:71",
      "surahNumber": 19,
      "ayahNumber": 71,
      "text": "واردها : بالمرور على الصّراط الممدود عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:73",
      "surahNumber": 19,
      "ayahNumber": 73,
      "text": "خيرٌ مُقاما : منزلا و سكنا\\nأحسن نديّا : مجلسا و مُجتمعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:74",
      "surahNumber": 19,
      "ayahNumber": 74,
      "text": "قرْنٍ : أمّة\\nأحسن أثاثا : متاعا من الفَرْش و الثياب و غيرها\\nرئيا : منظرا و هيئة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:75",
      "surahNumber": 19,
      "ayahNumber": 75,
      "text": "فليمدد له : يُمهله استدراجا\\nأضعف جندا : أقلّ أعوانا و أنصارا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:76",
      "surahNumber": 19,
      "ayahNumber": 76,
      "text": "خير مردّا : مرجعا و عاقبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:77",
      "surahNumber": 19,
      "ayahNumber": 77,
      "text": "أفرأيت : أخبرني\\nأطّـلعَ الغيب : أعلم الغيب (استفهام)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:79",
      "surahNumber": 19,
      "ayahNumber": 79,
      "text": "نمدّ له : نُطوّل له أو نزيدُهُ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:81",
      "surahNumber": 19,
      "ayahNumber": 81,
      "text": "عزّا : شُفعاء و أنصارا يتعزّزون بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:82",
      "surahNumber": 19,
      "ayahNumber": 82,
      "text": "ضدّا : ذلاّ و هوانا لا عزّا أو أعوانا عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:83",
      "surahNumber": 19,
      "ayahNumber": 83,
      "text": "تؤزّهم أزّا : تُغريهم بالمعاصي إغراء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:85",
      "surahNumber": 19,
      "ayahNumber": 85,
      "text": "وفدا : ركبانا . أو وافدين استرفاداً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "19:86",
