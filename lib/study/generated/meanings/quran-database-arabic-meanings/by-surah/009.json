{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 9,
  "entries": [
    {
      "verseKey": "9:1",
      "surahNumber": 9,
      "ayahNumber": 1,
      "text": "براءة من الله. . : تبرّؤ و تباعد واصل من الله . .\\nعاهدتم : فنقضوا العهد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:2",
      "surahNumber": 9,
      "ayahNumber": 2,
      "text": "أربعة أشهر : أوّلها عاشر ذي الحجّة\\nغير مُعجزي الله : غير فائتين من عذابه بالهرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:3",
      "surahNumber": 9,
      "ayahNumber": 3,
      "text": "أذانٌ : إعلام و إيذان\\nيوم الحجّ الأكبر : يوم النّحر سنة تسعٍ\\nورسوله : أي بريء أيضا من المشركين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:4",
      "surahNumber": 9,
      "ayahNumber": 4,
      "text": "لم ينقصوكم : لم ينقضوا عهدكم بل وفّوا به\\nلم يُظاهروا : لم يُعاونوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:5",
      "surahNumber": 9,
      "ayahNumber": 5,
      "text": "انسلخ الأشهر : انقضت أشهر العهد الأربعة\\nاحصروهم : احبسوهم ، أو ضيّقوا عليهم و امنعوهم من التّصرّف في البلاد\\nكل مرصد : كلّ طريق و ممرّ و مرقب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:6",
      "surahNumber": 9,
      "ayahNumber": 6,
      "text": "استجارك : بعد انسلاخ أشهر العهد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:7",
      "surahNumber": 9,
      "ayahNumber": 7,
      "text": "فما استقاموا لكم : فما أقاموا على العهد معكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:8",
      "surahNumber": 9,
      "ayahNumber": 8,
      "text": "يظهروا عليكم : يظفروا بكم\\nلا يرقبوا : لا يُراعوا\\nإلاًّ : رحِما و قرابة . أو حلفا و عهدا\\nذمّةً : عهدا . أو أمانا و ضمانا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:12",
      "surahNumber": 9,
      "ayahNumber": 12,
      "text": "نكثوا أيمانهم : نقضوا عهودهم المؤكّدة بالأيمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:15",
      "surahNumber": 9,
      "ayahNumber": 15,
      "text": "غيظ قلوبهم : غضبها ووجدها الشّديد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:16",
      "surahNumber": 9,
      "ayahNumber": 16,
      "text": "وليجةً : بطانة و أصحاب سرّ و أولياء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:17",
      "surahNumber": 9,
      "ayahNumber": 17,
      "text": "حبطت أعمالهم : بطلت و ذهبت أجورها لكفرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:19",
      "surahNumber": 9,
      "ayahNumber": 19,
      "text": "سِقاية الحاجّ : سقيْ الحجيج الماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:23",
      "surahNumber": 9,
      "ayahNumber": 23,
      "text": "استحبّوا الكفر : اختاروه و أقاموا عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:24",
      "surahNumber": 9,
      "ayahNumber": 24,
      "text": "اقترفتموها : اكتسبتموها\\nكسادها : بوارها بفوات أيّام المواسم\\nفتربّصوا : فانتظروا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:25",
      "surahNumber": 9,
      "ayahNumber": 25,
      "text": "بما رحُبت : مع رُحبها و سَعتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:26",
      "surahNumber": 9,
      "ayahNumber": 26,
      "text": "سكينته : طمأنينتهُ و أمنته أو رحمته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:28",
      "surahNumber": 9,
      "ayahNumber": 28,
      "text": "المشركون نجس : شيء قذر أو خبيث لفساد بواطنهم\\nخفتم عيْلةً : فقرا و فاقة بانقطاع تجارتهم عنكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:29",
      "surahNumber": 9,
      "ayahNumber": 29,
      "text": "يُعطوا الجزية : الخراج المقدّر على رؤوسهم\\nعن يدٍ : عن انقياد أو عن قهر و قوّة\\nهم صاغرون : منقادون أذلاء لحكم الإسلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:30",
      "surahNumber": 9,
      "ayahNumber": 30,
      "text": "يُضاهئون : يشابهون في الكفر و الشّناعة\\nأنّى يُأفكون ؟ : كيف يصرفون عن الحقّبعد سطوعه ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:31",
      "surahNumber": 9,
      "ayahNumber": 31,
      "text": "أحبارهم : علماء اليهود\\nرهبانهم : متنسّكي النّصارى\\nأربابًا : أطاعوهم كما يُطاع الربّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:33",
      "surahNumber": 9,
      "ayahNumber": 33,
      "text": "ليُظهره : ليُعليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:36",
      "surahNumber": 9,
      "ayahNumber": 36,
      "text": "أربعة حُرُم : رجب و ذو القعدة و ذو الحجة و المحرّم\\nالدّين القيّم : الدّين المستقيم دين إبراهيم صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:37",
      "surahNumber": 9,
      "ayahNumber": 37,
      "text": "النّسيء : تأخير حُرمة شهر إلى آخر\\nليُواطِئوا : ليوافقوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:38",
      "surahNumber": 9,
      "ayahNumber": 38,
      "text": "انفروا : اخرجوا غزاة ً (لتبوك)\\nاثاقلتم : تباطأتم و أخلدتم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:40",
      "surahNumber": 9,
      "ayahNumber": 40,
      "text": "في الغار : غار جبل ثور قرب مكّة\\nلصاحبه : إبي بكر الصّديق رضي الله عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:41",
      "surahNumber": 9,
      "ayahNumber": 41,
      "text": "خفافًا و ثقالا : على أيّة حالة كنتم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:42",
      "surahNumber": 9,
      "ayahNumber": 42,
      "text": "عرضا قريبا : مغنما سهل المأخذ\\nسفرا قاصدا : مُتوسّطا بين القريب و البعيد\\nالشُّقّة : المسافة التي تقطع بمشقّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:46",
      "surahNumber": 9,
      "ayahNumber": 46,
      "text": "انبعاثهم : نهوضهم للخروج معكم\\nفثبّطهم : فحبسهمو عوّقهم عن الخروج معكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:47",
      "surahNumber": 9,
      "ayahNumber": 47,
      "text": "خبالا : شرّا و فسادا ، أو عجزا و جُبنا\\nلأوضعوا خلالكم : لأسرعوا بينكم بالنّمائم لإفساد ذات البين\\nيبغونكم الفتنة : يطلبون لكم ما تفتنون به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:48",
      "surahNumber": 9,
      "ayahNumber": 48,
      "text": "قلّبوا لك الأمور : دبّروا لك الحيل و المكائد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:49",
      "surahNumber": 9,
      "ayahNumber": 49,
      "text": "إئذن لي : في التّخلف عن الجهاد\\nلا تفتنّي : لا توقعني في الإثم بمخالفة أمرك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:52",
      "surahNumber": 9,
      "ayahNumber": 52,
      "text": "هل تربّصون بنا : ما تنتظرون بنا\\nالحُسنيين : النّصرة و الشّهادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:55",
      "surahNumber": 9,
      "ayahNumber": 55,
      "text": "تزهق أنفسهم : تخرج أرواحهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:56",
      "surahNumber": 9,
      "ayahNumber": 56,
      "text": "قوم يفرقون : يخافون منكم فينافقون تقيّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:57",
      "surahNumber": 9,
      "ayahNumber": 57,
      "text": "ملجأ : حصنا و معقلا يلجئون إليه\\nمغارات : غيرانا في الجبال يختفون فيها\\nمُدّخلا : سربا في الأرض ينجحرون فيه\\nيجمحون : يسرعون في الدّخول فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:58",
      "surahNumber": 9,
      "ayahNumber": 58,
      "text": "يلمزك : يعيبك و يطعن عليك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:59",
      "surahNumber": 9,
      "ayahNumber": 59,
      "text": "حسبنا الله : كافينا فضل الله و قسمته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:60",
      "surahNumber": 9,
      "ayahNumber": 60,
      "text": "العاملين عليها : كالجُباة و الكُتّاب و الحرّاس\\nفي الرّقاب : في فكاك الأرقّاء أو الأسرى\\nالغارمين : المدينين الذين لا يجدون قضاء\\nفي سبيل الله : في الغزو . أو في جميع القُرب\\nابن السّبيل : المسافر المنقطع عن ماله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:61",
      "surahNumber": 9,
      "ayahNumber": 61,
      "text": "هو أذُن : يسمع كل ما يُقال له و يصدّقه\\nأذن خير لكم : يسمع الخير و لا يسمع الشرّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:63",
      "surahNumber": 9,
      "ayahNumber": 63,
      "text": "من يحادد الله . . : من يُخالفه و يعادِه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:65",
      "surahNumber": 9,
      "ayahNumber": 65,
      "text": "نخوض و نلعب : نتلهّى بالحديث قطعا للطّريق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:67",
      "surahNumber": 9,
      "ayahNumber": 67,
      "text": "يقبضون أيديهم : لا يبسطونها في خير و طاعة شُحّا\\nفنسيهم : فتركهم من توفيقه و هدايته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:68",
      "surahNumber": 9,
      "ayahNumber": 68,
      "text": "هي حسبهم : كافيتهم عقابا على كفرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:69",
      "surahNumber": 9,
      "ayahNumber": 69,
      "text": "فاستمتعوا بخلاقهم : فتمتّعوا بنصيبهم من ملاذّ الدّنيا\\nخضتم : دخلتم في الباطل\\nحبطت أعمالهم : بطلت و ذهبت أجورهم لكفرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:70",
      "surahNumber": 9,
      "ayahNumber": 70,
      "text": "المأتفكات : المنقلبات (قرى قوم لوط)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:73",
      "surahNumber": 9,
      "ayahNumber": 73,
      "text": "اغلظ عليهم : شدّد عليهم و لا ترفق بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:74",
      "surahNumber": 9,
      "ayahNumber": 74,
      "text": "ما نقموا : ما كرهوا و ما عابوا شيئا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:78",
      "surahNumber": 9,
      "ayahNumber": 78,
      "text": "يعلم سرّهم : ما أسرّوا في قلوبهم من النّفاق\\nنجواهم : ما يتناجون به من المطاعن في الدّين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:79",
      "surahNumber": 9,
      "ayahNumber": 79,
      "text": "الذين يلمزون : يعيبون (هم المنافقون)\\nجُهدهم : طاقتهم و وسعهم (الفقراء)\\nسخر الله منهم : أهانهم و أذلّهم جزاءً وفاقا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:81",
      "surahNumber": 9,
      "ayahNumber": 81,
      "text": "خلاف رسول الله : بعد خروجه ، أو لأجل مخالفته\\nلا تنفروا : لا تخرجواللجهاد في تبوك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:83",
      "surahNumber": 9,
      "ayahNumber": 83,
      "text": "الخالفين : المتخلّفين عن الجهاد كالنّساء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:85",
      "surahNumber": 9,
      "ayahNumber": 85,
      "text": "تزهق أنفسهم : تخرج أرواحهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:86",
      "surahNumber": 9,
      "ayahNumber": 86,
      "text": "أولوا الطّول منهم : أصحاب الغنى و السّعة من المنافقين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:87",
      "surahNumber": 9,
      "ayahNumber": 87,
      "text": "الخوالف : النّساء المتخلّفات عن الجهاد\\nطُبع : خُتِم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:90",
      "surahNumber": 9,
      "ayahNumber": 90,
      "text": "المعذّرون : المعتذرون بالأعذار الكاذبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:91",
      "surahNumber": 9,
      "ayahNumber": 91,
      "text": "حرج : إثم أو ذنب في التّخلف عن الجهاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:92",
      "surahNumber": 9,
      "ayahNumber": 92,
      "text": "تفيض من الدّمع : تمتلئ به فتصُبّه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:95",
      "surahNumber": 9,
      "ayahNumber": 95,
      "text": "إنهم رجس : قذر باطنا و ظاهرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:97",
      "surahNumber": 9,
      "ayahNumber": 97,
      "text": "أجدر : أحقّ و أحرى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:98",
      "surahNumber": 9,
      "ayahNumber": 98,
      "text": "مغرما : غرامة و خسرانا\\nيتربّص بكم الدوائر : ينتظر بكم مصائب الدّهر\\nعليهم دائرة السّوْء : الضّرر و الشرّ (دعاءٌ عليهم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:99",
      "surahNumber": 9,
      "ayahNumber": 99,
      "text": "صلوات الرّسول : دعواته و استغفاره (للمنفقين)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:101",
      "surahNumber": 9,
      "ayahNumber": 101,
      "text": "مردوا على النّفاق : مرنواعليه و دَربوا به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:103",
      "surahNumber": 9,
      "ayahNumber": 103,
      "text": "تزكّيهم بها : تُنمّي بها حسناتهم و أموالهم\\nصلّ عليهم : ادع لهم و استغفر لهم\\nسكن لهم : طُمأنينةٌ . أو رحمة لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:104",
      "surahNumber": 9,
      "ayahNumber": 104,
      "text": "يأخذ الصّدقات : يقلبها و يثيب عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:106",
      "surahNumber": 9,
      "ayahNumber": 106,
      "text": "مُرجون : مؤخّرون لا يُقطع لهم بتوبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:107",
      "surahNumber": 9,
      "ayahNumber": 107,
      "text": "مسجدا ضرارا : مُضارّة لأهل مسجد قباء\\nإرصادا : ترقّبا و انتظارا، أو إعدادا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:108",
      "surahNumber": 9,
      "ayahNumber": 108,
      "text": "لَمسجد : هو مسجد قُباء أو المسجد النّبوي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:109",
      "surahNumber": 9,
      "ayahNumber": 109,
      "text": "على شفا جرف : على حرف بئر لم تُبن بالحجارة\\nهارٍ : هائر متصدّع أو متهدّم\\nفانهار به : فسط البنيان بالباني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:110",
      "surahNumber": 9,
      "ayahNumber": 110,
      "text": "ريبة في قلوبهم : شكّا و نفاقا في قلوبهم\\nتقطّع قلوبهم : تتقطّع و تتفرّق أجزاء بالموت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:112",
      "surahNumber": 9,
      "ayahNumber": 112,
      "text": "السّائحون : الغزاة المُجاهدون. أو الصّائمون\\nلحدود الله : لأوامره و نواهيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:114",
      "surahNumber": 9,
      "ayahNumber": 114,
      "text": "لأوّاه : لكثير التّأوّه خوفا و شفقا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:117",
      "surahNumber": 9,
      "ayahNumber": 117,
      "text": "ساعة العسرة : وقت الشّدة و الضّيق في تبوك\\nيزيغ : يميل إلى التّخلّف عن الجهاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:118",
      "surahNumber": 9,
      "ayahNumber": 118,
      "text": "بما رحُبت : مع رُحبها و سعتها\\nليتوبوا : ليُداوموا على التّوبة في المستقبل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:120",
      "surahNumber": 9,
      "ayahNumber": 120,
      "text": "لا يرغبوا بأنفسهم : لا يترفّعوا بها و لا يصرفوها\\nنصبٌ : تعبٌ ما\\nمخمصةٌ : مجاعة ما\\nيغيظ الكفّار : يغضبهم و يغمّهم\\nنيلا : شيئا من قتل أو أسر أو غنيمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:122",
      "surahNumber": 9,
      "ayahNumber": 122,
      "text": "لينفروا كافّة : ليخرجوا إلى الجهاد جميعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:123",
      "surahNumber": 9,
      "ayahNumber": 123,
      "text": "غلظةً : شدّة و شجاعة ، و حمية ، و صبرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:125",
      "surahNumber": 9,
      "ayahNumber": 125,
      "text": "رجسا : نفاقا و كفرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:126",
      "surahNumber": 9,
      "ayahNumber": 126,
      "text": "يُفتنون : يُمتحنون بالشّدائد و البلايا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:128",
      "surahNumber": 9,
      "ayahNumber": 128,
      "text": "عزيز عليه : صعب و شاقّ عليه\\nما عندتم : عنتُكُم و مشقّتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "9:129",
      "surahNumber": 9,
      "ayahNumber": 129,
      "text": "حسبي الله : كافيّ الله و معيني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
