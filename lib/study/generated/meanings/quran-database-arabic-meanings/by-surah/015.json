  "surahNumber": 15,
  "entries": [
    {
      "verseKey": "15:2",
      "surahNumber": 15,
      "ayahNumber": 2,
      "text": "رُبَمَا : \\\"\\\"\\\"رُبّ\\\"\\\" للتقليل و \\\"\\\"ما \\\"\\\" زائدة \\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:3",
      "surahNumber": 15,
      "ayahNumber": 3,
      "text": "ذرهم : دعهم و اتركهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:4",
      "surahNumber": 15,
      "ayahNumber": 4,
      "text": "لها كتاب : أجل مقدّر مكتوب في اللّوح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:7",
      "surahNumber": 15,
      "ayahNumber": 7,
      "text": "لو ما تأتينا : هلاّ تأتينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:8",
      "surahNumber": 15,
      "ayahNumber": 8,
      "text": "إلا بالحق : إلا بالوجه الذي تقتضيه الحكمة\\nمُنظرين : مؤخّرين في العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:9",
      "surahNumber": 15,
      "ayahNumber": 9,
      "text": "الذّكر : القرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:10",
      "surahNumber": 15,
      "ayahNumber": 10,
      "text": "شيع الأوّلين : فرق الأمم السّابقين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:12",
      "surahNumber": 15,
      "ayahNumber": 12,
      "text": "نسلكه : ندخل الذّكر مستهزأ به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:13",
      "surahNumber": 15,
      "ayahNumber": 13,
      "text": "خلت سنّة الأوّلين : مضت عادة الله بإهلاك المكذّبين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:14",
      "surahNumber": 15,
      "ayahNumber": 14,
      "text": "يعرجون : يصعدون فيرون الملائكة و العجائب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:15",
      "surahNumber": 15,
      "ayahNumber": 15,
      "text": "سكّرت أبصارهم : سُدّت و مُنعت من الإبصار\\nقوم مسحورون : أصابنا محمّد بسحره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:16",
      "surahNumber": 15,
      "ayahNumber": 16,
      "text": "بروج : منازل للكواكب السيّارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:17",
      "surahNumber": 15,
      "ayahNumber": 17,
      "text": "رجيم : مطرود أو مرجوم بالنّجوم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:18",
      "surahNumber": 15,
      "ayahNumber": 18,
      "text": "استرق السّمع : خطِف المسموع من الملإ الأعلى\\nفأتبعه : أدركه و لحقه\\nشهاب : شُعلة نار منقضّة من السّماء\\nمبين : ظاهر للمبصرين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:19",
      "surahNumber": 15,
      "ayahNumber": 19,
      "text": "الأرض مددناها : بسطناها للانتفاع بها\\nرواسي : جبالاً ثوابت كيلا تميد\\nموزون : مقدّر بميزان الحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:20",
      "surahNumber": 15,
      "ayahNumber": 20,
      "text": "معايش : أرزاقا يُعاش بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:21",
      "surahNumber": 15,
      "ayahNumber": 21,
      "text": "عندنا خزانه : نحن قادرون على إيجاده و تدبيره\\nننزّله : نوجده أو نعطيه\\nبقدر معلوم : بمقدار معيّن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:22",
      "surahNumber": 15,
      "ayahNumber": 22,
      "text": "الرّياح لواقح : حوامل للسّحاب أو للماء تمُجّه فيه أو ملقحات للسّحاب أو للأشجار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:23",
      "surahNumber": 15,
      "ayahNumber": 23,
      "text": "لنحن الوارثون : الباقون بعد فناء الخلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:26",
      "surahNumber": 15,
      "ayahNumber": 26,
      "text": "صلصال : طين يابس كالفخّار\\nحمإ : طين أسود متغيّر\\nمسنون : مصوّر صورة إنسان أجوف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:27",
      "surahNumber": 15,
      "ayahNumber": 27,
      "text": "نار السّموم : الرّيح الحارّة القاتلة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:29",
      "surahNumber": 15,
      "ayahNumber": 29,
      "text": "سوّيته : أتممت خلقه و هيأته لنفخ الروح\\nساجدين : سجود تحية لا سجود عبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:31",
      "surahNumber": 15,
      "ayahNumber": 31,
      "text": "أبى : امتنع تكبّرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:32",
      "surahNumber": 15,
      "ayahNumber": 32,
      "text": "مالك . . : أيّ غرض لك أو ما عذرك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:34",
      "surahNumber": 15,
      "ayahNumber": 34,
      "text": "رجيم : مطرود من الرّحمة أو مرجوم بالشّهب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:35",
      "surahNumber": 15,
      "ayahNumber": 35,
      "text": "اللّعنة : الابعاد على سبيل السّخط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:36",
      "surahNumber": 15,
      "ayahNumber": 36,
      "text": "فأنظرني : أمهلني و لا تُمتني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:38",
      "surahNumber": 15,
      "ayahNumber": 38,
      "text": "الوقت المعلوم : وقت النّفخة الأولى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:39",
      "surahNumber": 15,
      "ayahNumber": 39,
      "text": "لأغوينّهم : لأحملنّهم على الغواية و الضّلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:40",
      "surahNumber": 15,
      "ayahNumber": 40,
      "text": "المخلصين : الذين أخلصتهم لطاعتك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:41",
      "surahNumber": 15,
      "ayahNumber": 41,
      "text": "صراط عليّ : حقّ عليّ مُراعاته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:42",
      "surahNumber": 15,
      "ayahNumber": 42,
      "text": "سلطان : تسلّط و قدرة على الإغواء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:44",
      "surahNumber": 15,
      "ayahNumber": 44,
      "text": "جزء مقسوم : فريق معيّن متميّز عن غيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:47",
      "surahNumber": 15,
      "ayahNumber": 47,
      "text": "غلّ : حقد و ضغينة و عداوة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:48",
      "surahNumber": 15,
      "ayahNumber": 48,
      "text": "نصب : تعب و إعياء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:51",
      "surahNumber": 15,
      "ayahNumber": 51,
      "text": "ضيف ابراهيم : أضيافه و كانوا من الملائكة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:52",
      "surahNumber": 15,
      "ayahNumber": 52,
      "text": "وجلون : خائفون فزعون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:55",
      "surahNumber": 15,
      "ayahNumber": 55,
      "text": "القانطين : الآيسين من الخير أو الولد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:57",
      "surahNumber": 15,
      "ayahNumber": 57,
      "text": "فما خطبكم ؟ : فما شأنكم الخطير ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:60",
      "surahNumber": 15,
      "ayahNumber": 60,
      "text": "قدّرنا : علِمنا أو قضينا و حكمنا\\nغابرين : الباقين في العذاب مع أمثالها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:62",
      "surahNumber": 15,
      "ayahNumber": 62,
      "text": "قوم منكرون : أُنكرُكم و لا أعرفكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:63",
      "surahNumber": 15,
      "ayahNumber": 63,
      "text": "فيه يمترون : يشكّون و يكذّبونك فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:65",
      "surahNumber": 15,
      "ayahNumber": 65,
      "text": "بقطع من اللّيل : بطائفة منه أو من آخره\\nاتبع أدبارهم : سِرْ خلفهم لتطّلع عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:66",
      "surahNumber": 15,
      "ayahNumber": 66,
      "text": "قضينا إليه : أوحينا إليه\\nدابرهؤلاء : آخرهم و المُراد جميعهم\\nمصبحين : داخلين في وقت الصّباح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:70",
      "surahNumber": 15,
      "ayahNumber": 70,
      "text": "عن العالمين : عن إجارة أو ضيافة أحد منهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:72",
      "surahNumber": 15,
      "ayahNumber": 72,
      "text": "لعمرُك : قسم من الله بحياة نبيّنا صلى الله عليه و سلم\\nسكرتهم : غوايتهم و ضلالتهم\\nيعمهون : يعمون عن الرّشد أو يتحيّرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:73",
      "surahNumber": 15,
      "ayahNumber": 73,
      "text": "الصّيحة : صوت مُهلك من السّماء\\nمُشرقين : داخلين في وقت الشّروق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:74",
      "surahNumber": 15,
      "ayahNumber": 74,
      "text": "سجّيل : طين مُتحجّر طُبِخ بالنّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:75",
      "surahNumber": 15,
      "ayahNumber": 75,
      "text": "للمتوسّمين : للمتفرّسين المُتأمّلين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:76",
      "surahNumber": 15,
      "ayahNumber": 76,
      "text": "لبسبيل مقيم : طريق ثابت مُعلم مسلوك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:78",
      "surahNumber": 15,
      "ayahNumber": 78,
      "text": "أصحاب الأيكة : سكّان بُقعة كثيفة الأشجار ملتفّتها (قوم شُعيب)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:79",
      "surahNumber": 15,
      "ayahNumber": 79,
      "text": "و إنهما : قُرى قوم لوط و الأيكة\\nلبإمام مبين : لبطريق واضح يأتمّون به في أسفارهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:80",
      "surahNumber": 15,
      "ayahNumber": 80,
      "text": "الحِجر : ديار ثمود بين المدينة و الشام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:83",
      "surahNumber": 15,
      "ayahNumber": 83,
      "text": "مصبحين : داخلين في وقت الصّباح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "15:87",
      "surahNumber": 15,
      "ayahNumber": 87,
      "text": "سبعا : سبع آيات و هي الفاتحة\\nمن المثاني : التي تثنّى و تكررّ قراءتها في الصّلاة – و من للبيان",
      "kind": "meaning",
