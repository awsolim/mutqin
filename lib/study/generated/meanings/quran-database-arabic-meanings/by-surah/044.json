{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 44,
  "entries": [
    {
      "verseKey": "44:3",
      "surahNumber": 44,
      "ayahNumber": 3,
      "text": "ليلة مباركة : ليلة القدر من شهر رمضان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:4",
      "surahNumber": 44,
      "ayahNumber": 4,
      "text": "فيها يُفرق : يفصّل و يُـبَـيّـن\\nأمرٍحكيم : محْكمٍ مبرم أو ملتبسٍ بالحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:10",
      "surahNumber": 44,
      "ayahNumber": 10,
      "text": "فارتقبْ : انتظر بهؤلاء الشاكّين\\nبدخان : كناية عن إصابتهم بالجَدْب و المجاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:11",
      "surahNumber": 44,
      "ayahNumber": 11,
      "text": "يغشى الناس : يشملهم و يحيط بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:13",
      "surahNumber": 44,
      "ayahNumber": 13,
      "text": "أنّى لهم الذكرى؟ : كيف يتذكّرون و يتـّـعِظون ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:14",
      "surahNumber": 44,
      "ayahNumber": 14,
      "text": "مُعلّم : يعلـّـمه بشر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:16",
      "surahNumber": 44,
      "ayahNumber": 16,
      "text": "يوم نبطش : يوم نأخذ بشدّة و عنف (يوم بدر أو يوم القيامة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:17",
      "surahNumber": 44,
      "ayahNumber": 17,
      "text": "فتنّا : ابتلينا و امتحنّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:18",
      "surahNumber": 44,
      "ayahNumber": 18,
      "text": "أدّوا إليّ عباد الله : سلـّـموا إلي بني إسرائيل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:19",
      "surahNumber": 44,
      "ayahNumber": 19,
      "text": "لا تعلوا : لا تتكبّروا . أو لا تفتروا\\nبسلطان : حجّة و برهان على صدقي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:20",
      "surahNumber": 44,
      "ayahNumber": 20,
      "text": "إنّي عذت بربّي : استجرت به و التجَأت إليه\\nترجمونِ : تؤذوني. أو تقتلوني بالحجارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:23",
      "surahNumber": 44,
      "ayahNumber": 23,
      "text": "فأسر بعبادي ليلا : سِـرْ ليلا ببني إسرائيل\\nإنكم متبعون : يتبعكم فرعون و جنوده",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:24",
      "surahNumber": 44,
      "ayahNumber": 24,
      "text": "البحْرَ رهوا : ساكنـًـا . أو منفرجا مفتوحا\\nجندٌ : جماعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:27",
      "surahNumber": 44,
      "ayahNumber": 27,
      "text": "نعمَةٍ : تنعّم أو نضارة عيشٍ و لذاذتِه\\nفاكهين : ناعمين متفكّهين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:29",
      "surahNumber": 44,
      "ayahNumber": 29,
      "text": "منظرين : ممهلين بالعّذاب إلى وقت آخر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:31",
      "surahNumber": 44,
      "ayahNumber": 31,
      "text": "كان عاليا : متكبّرا جبّارا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:32",
      "surahNumber": 44,
      "ayahNumber": 32,
      "text": "العالمين : عالمي زمانهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:33",
      "surahNumber": 44,
      "ayahNumber": 33,
      "text": "فيه بلاءٌ مبين : اختبار ظاهر أو نعمة ظاهرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:35",
      "surahNumber": 44,
      "ayahNumber": 35,
      "text": "بمُنشرين : بمبعوثين بعد موتتنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:37",
      "surahNumber": 44,
      "ayahNumber": 37,
      "text": "قوم تبّع : أبـِـي كَــِرب الحِمْـيَـــِريّ ملك اليمن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:40",
      "surahNumber": 44,
      "ayahNumber": 40,
      "text": "يوم الفصْل : يوم القيامة و الحساب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:41",
      "surahNumber": 44,
      "ayahNumber": 41,
      "text": "لا يغني مولى . . : لا يدفع قريب. و لا صديق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:43",
      "surahNumber": 44,
      "ayahNumber": 43,
      "text": "شجرة الزقوم : من أخبث الشّجر تنبت في النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:45",
      "surahNumber": 44,
      "ayahNumber": 45,
      "text": "كالمهل : دُرْديّ الزّيت . أو المعدن المُذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:46",
      "surahNumber": 44,
      "ayahNumber": 46,
      "text": "الحميم : الماء البالغ غاية الحرارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:47",
      "surahNumber": 44,
      "ayahNumber": 47,
      "text": "فاعتلوه : فجرّوه بعنف و قهر\\nسواء الجحيم : وَسَط النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:50",
      "surahNumber": 44,
      "ayahNumber": 50,
      "text": "به تمترون : فيه تجادلون و تمارون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:53",
      "surahNumber": 44,
      "ayahNumber": 53,
      "text": "سندس : رقيق الدّيباج\\nإستبرق : غليظه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:54",
      "surahNumber": 44,
      "ayahNumber": 54,
      "text": "زوّجناهم بحور عين : قرنّاهم بنساءٍ بيضٍ مخلوقات في الجنّة واسعات الأعين حِسَانُها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:55",
      "surahNumber": 44,
      "ayahNumber": 55,
      "text": "يدعون فيها : يطلبون فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "44:59",
      "surahNumber": 44,
      "ayahNumber": 59,
      "text": "فارتقب : فانتظر ما يحلّ بهم\\nإنهم مرتقبون : منتظرون ما يحلّ بك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
