  "language": "ar",
  "direction": "rtl",
  "surahNumber": 39,
  "entries": [
    {
      "verseKey": "39:2",
      "surahNumber": 39,
      "ayahNumber": 2,
      "text": "مُـخْـلصا : مُمَحّضًَا له الطاعة و العبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:3",
      "surahNumber": 39,
      "ayahNumber": 3,
      "text": "زلفى : تقريبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:4",
      "surahNumber": 39,
      "ayahNumber": 4,
      "text": "سُبْحانه : تنزيها له عن اتخاذ الولد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:5",
      "surahNumber": 39,
      "ayahNumber": 5,
      "text": "يُكوّر الليل على النّهار : يَلفّه على النهار لفّ اللباس على اللابس فيستره فتظهَر الظلمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:6",
      "surahNumber": 39,
      "ayahNumber": 6,
      "text": "أنزَلَ لكم : أنشأ و أحْدث لأجْلكم\\nمن الأنعام : الإبل و البقر و الضّأن و المعز\\nظلمَات ثلاثٍ : ظلمة البطن و الرّحم و المشيمة\\nفأنّى تـُـصْـرَفون ؟ : فكيف تصرفون عن عبادته ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:7",
      "surahNumber": 39,
      "ayahNumber": 7,
      "text": "لا تزر وازرَةٌ . . : لا تحْمل نـفسٌ آثمة . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:8",
      "surahNumber": 39,
      "ayahNumber": 8,
      "text": "مُـنِـيـبا إليه : راجعا إليه ، مستغيثا به\\nخَوّله نِعْمَة : أعطاه نعمة عظيمة تفضلا و إحسانا\\nأندَادًا : أمثالا يَعبدها من دونه تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:9",
      "surahNumber": 39,
      "ayahNumber": 9,
      "text": "هوَ قـَـانتٌ : مطيع خاضع عابدٌ لله تعالى\\nآناءَ الليل : سَاعاته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:10",
      "surahNumber": 39,
      "ayahNumber": 10,
      "text": "بغَير حِساب : بلا نهاية لما يعطي أو بتوْسعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:16",
      "surahNumber": 39,
      "ayahNumber": 16,
      "text": "ظلـَـلٌ مِنَ النار : أطباق منها أ كثيرة متراكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:17",
      "surahNumber": 39,
      "ayahNumber": 17,
      "text": "اجْـتـنـَبوا الطّـاغوتَ : الأوثان و المعبودات الباطلة\\nأنـَابوا إلى الله : رجعوا إلى عبادته وحده",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:19",
      "surahNumber": 39,
      "ayahNumber": 19,
      "text": "حقّ عَليْه : وَجَبَ و ثبَت عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:20",
      "surahNumber": 39,
      "ayahNumber": 20,
      "text": "لهمْ غرفٌ : منازل رفيعة عالية في الجنة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:21",
      "surahNumber": 39,
      "ayahNumber": 21,
      "text": "فـَـسَـلكَه ينابيعَ : أدخله في عيون و مَجَار\\nيَهيج : يَيبَس في أقصى غايته\\nيَـجْـعَـلهُ حُطامًـا : يصيّره فتاتا هشيما متكسّرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:22",
      "surahNumber": 39,
      "ayahNumber": 22,
      "text": "فويْـلٌ : هلاك أو حسرة أو شدّة عذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:23",
      "surahNumber": 39,
      "ayahNumber": 23,
      "text": "أحسَنَ الحديث : أبلغَه و أصْدقه و أوْفاه (القرآن)\\nكِـتابًا مُـتـَشابها : في إعجازه و هدايته و خصائصه\\nمَـثـانيَ : مكرّرا فيه الأحكام و المواعظ و القـَـصَص و غيرها\\nتـَـقـْـشعرّ منه . . : تضْطرب و ترتعِدْ مِنْ قـَوَارعه . .\\nتـَلين جلودهم : تسكن و تطمئنّ ليّـنة غير مُـنقـَبضة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:26",
      "surahNumber": 39,
      "ayahNumber": 26,
      "text": "الخِـزيَ : الذلّ و الهَوَان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:28",
      "surahNumber": 39,
      "ayahNumber": 28,
      "text": "عِـوَج : اختلاف و اختلال و اضطراب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:29",
      "surahNumber": 39,
      "ayahNumber": 29,
      "text": "شرَكاءُ مُـتـَـشاكِسون : متنازعون شرسوا الطّباع\\nسَلـَـمًا لرَجل : خالصا له مِنَ الشـّرِكَة و المُنازعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:32",
      "surahNumber": 39,
      "ayahNumber": 32,
      "text": "مَـثـوًى للكافرين : مأوًى و مُقامٌ لهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:38",
      "surahNumber": 39,
      "ayahNumber": 38,
      "text": "أفرأيتمْ : أخبروني\\nحَسْبيَ الله : كافيّ في جميع أموري",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:39",
      "surahNumber": 39,
      "ayahNumber": 39,
      "text": "مَكانـَـتِـكمْ : حالتكم المُـتمَـكّـنين منها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:40",
      "surahNumber": 39,
      "ayahNumber": 40,
      "text": "يُخْـزيه : يُذلـّه و يهينه\\nيحلّ عليه : يَجبُ عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:42",
      "surahNumber": 39,
      "ayahNumber": 42,
      "text": "يَتـَـوَفّى الأنفس : يقبضها عن الأبدان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:44",
      "surahNumber": 39,
      "ayahNumber": 44,
      "text": "لله الشـّـفاعة جميعًا : لا يشفع أحدٌ عنده إلا بإذنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:45",
      "surahNumber": 39,
      "ayahNumber": 45,
      "text": "اشمأزّتْ : نـَـفَرتْ و انقبَضتْ عن التوحيد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:46",
      "surahNumber": 39,
      "ayahNumber": 46,
      "text": "فَاطرَ . . : يا مُبْدع ومخترع . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:47",
      "surahNumber": 39,
      "ayahNumber": 47,
      "text": "يَحتـَسِبونَ : يظنّونه و يتوقـّعونه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:48",
      "surahNumber": 39,
      "ayahNumber": 48,
      "text": "حَق بهمْ : نزل أو أحَاط بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:49",
      "surahNumber": 39,
      "ayahNumber": 49,
      "text": "خوّلـنـَاه نِـعْمَة : أعطيناه إيّـاه تـَفضّلا و إحساناً\\nهَيَ فتـْنة : تِلك النّعمة امتحان و ابتلاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:51",
      "surahNumber": 39,
      "ayahNumber": 51,
      "text": "بمعجزين : بفائتين من العَذاب بالهَرَب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:52",
      "surahNumber": 39,
      "ayahNumber": 52,
      "text": "يَقدر : يُضيّـقه على من يشاء بحكمته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:53",
      "surahNumber": 39,
      "ayahNumber": 53,
      "text": "أسْرَفوا : تجاوَزوا الحدّ في المعاصي\\nلا تـَـقـْـنـَـطوا : لا تيْـأسوا\\nالذنوب جَميعا : إلاّ الشّرك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:54",
      "surahNumber": 39,
      "ayahNumber": 54,
      "text": "أنيبوا إلى ربّـكم : ارجعوا إليه بالتـّوبة و الطاعة\\nأسْـلموا له : أخلصوا له عِبَادَتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:55",
      "surahNumber": 39,
      "ayahNumber": 55,
      "text": "بَغتة : فجْـأة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:56",
      "surahNumber": 39,
      "ayahNumber": 56,
      "text": "يا حَسرَتا : يا نـَـدَمِي و يا حُـزْني\\nفرّطت : قصّرْت\\nفي جنب الله : في طاعته و أمره و حَقّه تعالى\\nالسّاخرين : المستهزئين بدينه و كتابه و أهله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:58",
      "surahNumber": 39,
      "ayahNumber": 58,
      "text": "كَرّة : رَجْعة إلى الدنيا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:60",
      "surahNumber": 39,
      "ayahNumber": 60,
      "text": "مَثوًى للمتكبّرين : مَأوًى و مُقامٌ لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:61",
      "surahNumber": 39,
      "ayahNumber": 61,
      "text": "بمفازتهمْ : بفوْزهم و ظفرهِمْ بالبغيَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:63",
      "surahNumber": 39,
      "ayahNumber": 63,
      "text": "له مقاليد. . : مَفاتيح أو خزائن . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:65",
      "surahNumber": 39,
      "ayahNumber": 65,
      "text": "لـيَـحبطنّ عملك : ليبْطلنّ عَمَلك و يَفسدنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:67",
      "surahNumber": 39,
      "ayahNumber": 67,
      "text": "ما قدَروا الله . . : ما عَرَفوه . أو ما عظّـموه . .\\nقبْضته : مِلكه و في مَقدوره و تصرّفه\\nمَطْويات بيمينه : بقدرته كطيّ السّجل للكتب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:68",
      "surahNumber": 39,
      "ayahNumber": 68,
      "text": "الصّور : القرن الذي يَنفخ فيه إسرافيل\\nفصَعِـق : ماتَ. و هي النّـفخة الأولى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:69",
      "surahNumber": 39,
      "ayahNumber": 69,
      "text": "وُضِع الكتاب : أعطيَتْ صحف الأعمال لأربابها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:71",
      "surahNumber": 39,
      "ayahNumber": 71,
      "text": "زمرًا : جَمَاعات متفرقة متتابعة\\nحقـّـتْ : وَجَبَتْ و ثـبَـتـتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:73",
      "surahNumber": 39,
      "ayahNumber": 73,
      "text": "طِبْـتمْ : طَهرتم مِن دنس المعاصي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:74",
      "surahNumber": 39,
      "ayahNumber": 74,
      "text": "صَدَقـَنـَا وَعده : أنجزنا ما وعَدَنا من النّعيم\\nنتبوأ : ننزل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "39:75",
      "surahNumber": 39,
      "ayahNumber": 75,
      "text": "حَافّـين : مُحْدقينَ مُحيطين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
