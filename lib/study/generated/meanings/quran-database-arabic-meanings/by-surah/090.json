{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 90,
  "entries": [
    {
      "verseKey": "90:1",
      "surahNumber": 90,
      "ayahNumber": 1,
      "text": "لا أقسِم : \\\"(أقسِم) و \\\"\\\"لا\\\"\\\" مزيدة \\\"\\nبهذا البلد : بمكّة المكرّمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:2",
      "surahNumber": 90,
      "ayahNumber": 2,
      "text": "حِلّ بهذا البلد : حلالٌ لك ما تـَـصْـنـَـع به يومئذ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:3",
      "surahNumber": 90,
      "ayahNumber": 3,
      "text": "والد و ما وَلد : آدم و جميع ذريّـته أو الصالحين منهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:4",
      "surahNumber": 90,
      "ayahNumber": 4,
      "text": "لقد خلقـنا الإنسان : (جواب القسم)\\nكبد : نـَـصَـب و مشقـّة و مُكابَدة للشّدائد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:6",
      "surahNumber": 90,
      "ayahNumber": 6,
      "text": "أهلكتُ مالا لـُـبَدًا : كثيرا في المَكْرُمات مباهاةً و تـَـعاظما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:10",
      "surahNumber": 90,
      "ayahNumber": 10,
      "text": "هدَيْنـاه النـّـجْدَين : بَـيـَّـنـَّـا له طريقيْ الخيْر و الشرّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:11",
      "surahNumber": 90,
      "ayahNumber": 11,
      "text": "فلا اقـتحم العقبة : فهلاّ جَاهد نفسَـه في أعمال البرّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:13",
      "surahNumber": 90,
      "ayahNumber": 13,
      "text": "فكّ رَقـبَة : تخليصها من الرّق و العبوديّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:14",
      "surahNumber": 90,
      "ayahNumber": 14,
      "text": "ذي مسغبة : مَـجَـاعَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:15",
      "surahNumber": 90,
      "ayahNumber": 15,
      "text": "يتيما ذا مقربة : قرَابَة في الـنّـسَب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:16",
      "surahNumber": 90,
      "ayahNumber": 16,
      "text": "مسكينا ذا متربَة : فاقة شديدة لـَـصِـقَ منها بالتراب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:17",
      "surahNumber": 90,
      "ayahNumber": 17,
      "text": "بالمَرْحمَـة : بالرّحمة فيما بينهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:18",
      "surahNumber": 90,
      "ayahNumber": 18,
      "text": "أصحاب الميمنة : اليُـمْن . أو ناحية اليمين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:19",
      "surahNumber": 90,
      "ayahNumber": 19,
      "text": "أصحاب المشأمة : الشّؤم . أو ناحية الشمال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "90:20",
      "surahNumber": 90,
      "ayahNumber": 20,
      "text": "نارٌ مؤصَدة : مُـطبَقة ٌ مُـغْـلقة أبْوابها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
