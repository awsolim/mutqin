    {
      "verseKey": "99:6",
      "surahNumber": 99,
      "ayahNumber": 6,
      "text": "يومئذ يرجع الناس عن موقف الحساب أصنافًا متفرقين؛ ليريهم الله ما عملوا من السيئات والحسنات، ويجازيهم عليها.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir Al-Muyassar",
      "sourceId": "quran-database-muyassar",
      "language": "ar",
      "direction": "rtl"
