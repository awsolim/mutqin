  "entries": [
    {
      "verseKey": "100:1",
      "surahNumber": 100,
      "ayahNumber": 1,
      "text": "و العاديات : (قسمٌ) بالخيْـل تـَـعْـدو في الغَزْو\\nضَبْـحًا : هُوَ صَوْتُ أنـْـفاسِها إذا عَدَتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "100:2",
      "surahNumber": 100,
      "ayahNumber": 2,
      "text": "فالموريات قـَـدْحا : المُـخْرجات النار بصكّ حَوافِرها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "100:3",
      "surahNumber": 100,
      "ayahNumber": 3,
      "text": "فالمغيرات صُبْحا : المباغِتات للعدوّ وَقـْـتَ الصّباح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "100:4",
      "surahNumber": 100,
      "ayahNumber": 4,
      "text": "فأثرْنَ به نقـْعًـا : هـيّـجْنَ في الصّـبْح غبارًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "100:5",
      "surahNumber": 100,
      "ayahNumber": 5,
      "text": "فَوَسَطنَ به جَمْعا : فـتـَـوَسّـــْطنَ فيه مِنَ الأعداء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "100:6",
      "surahNumber": 100,
      "ayahNumber": 6,
      "text": "إنّ الإنسان : بطبْعِه إلاّ منْ رَحِم الله (جواب القسم)\\nلكـَـنـُـودٌ : لـَـكفورٌ جَحودٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "100:8",
      "surahNumber": 100,
      "ayahNumber": 8,
      "text": "إنّه لحُبّ الخَيْر : لأجْـل حُبّ المال\\nلشديدٌ : لقويّ مُجدّ في تحصيله مُتـهالكٌ عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "100:9",
      "surahNumber": 100,
      "ayahNumber": 9,
      "text": "بُـعْـثِـرَ : أُثير و أُخْرج و نـُـثِرَ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "100:10",
      "surahNumber": 100,
      "ayahNumber": 10,
      "text": "حُصِّـل : جُمِعَ و اُظْهِر أو مُـيّـزَ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
