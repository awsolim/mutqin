{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 114,
  "entries": [
    {
      "verseKey": "114:1",
      "surahNumber": 114,
      "ayahNumber": 1,
      "text": "Say, \"I seek refuge in the Lord of mankind,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "114:2",
      "surahNumber": 114,
      "ayahNumber": 2,
      "text": "The Sovereign of mankind,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "114:3",
      "surahNumber": 114,
      "ayahNumber": 3,
      "text": "The God of mankind,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "114:4",
      "surahNumber": 114,
      "ayahNumber": 4,
      "text": "From the evil of the retreating whisperer -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "114:5",
      "surahNumber": 114,
      "ayahNumber": 5,
      "text": "Who whispers [evil] into the breasts of mankind -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "114:6",
      "surahNumber": 114,
      "ayahNumber": 6,
      "text": "From among the jinn and mankind.\"",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
