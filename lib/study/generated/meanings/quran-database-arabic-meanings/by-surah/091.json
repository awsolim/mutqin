{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 91,
  "entries": [
    {
      "verseKey": "91:1",
      "surahNumber": 91,
      "ayahNumber": 1,
      "text": "و الشمس : (قسمٌ بها و بما بعدها)\\nضُـحاها : ضَوئها إذا أشرقـَتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:2",
      "surahNumber": 91,
      "ayahNumber": 2,
      "text": "تـَـلاها : تـَـبـِعَـها في الإضاءة بَـعْدَ غروبها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:3",
      "surahNumber": 91,
      "ayahNumber": 3,
      "text": "جَـلاّها : أظهَر الشمس للرّائين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:4",
      "surahNumber": 91,
      "ayahNumber": 4,
      "text": "يَـغْـشاها : يُغطّيها حين تغيب فـَـتـُـظلِـم الآفاق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:5",
      "surahNumber": 91,
      "ayahNumber": 5,
      "text": "و ما بناها : و الذي خلقها و هو الله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:6",
      "surahNumber": 91,
      "ayahNumber": 6,
      "text": "و ما طحاها : و الذي بَـسَـطها و وَطّـأها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:7",
      "surahNumber": 91,
      "ayahNumber": 7,
      "text": "و ما سَوّاها : و الذي عدّل أعضاءها و مَنـَـحَها قـُـوَاها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:8",
      "surahNumber": 91,
      "ayahNumber": 8,
      "text": "فـُـجُـورها و تـَـقـْـواها : مَـعْصِـيَتها و طاعتها و خَـيْرَها و شَرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:9",
      "surahNumber": 91,
      "ayahNumber": 9,
      "text": "قدْ أفـلح : فاز بالبغية و ظفَـر(جواب القسم)\\nمنْ زكّـاها : طهّرها و أنماها بالتـّـقوى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:10",
      "surahNumber": 91,
      "ayahNumber": 10,
      "text": "قدْ خاب : خَسر\\nمنْ دسّـاها : نقـّـصها و أخـْـفاها و أخْـمَلها بالفجور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:11",
      "surahNumber": 91,
      "ayahNumber": 11,
      "text": "بطغْواها : بسَبَبِ طغيانِها و عُدْوانِها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:12",
      "surahNumber": 91,
      "ayahNumber": 12,
      "text": "انبعَثَ أشقاها : قام مُسْرعًا يَـعْـقِـرُ النّـاقة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:13",
      "surahNumber": 91,
      "ayahNumber": 13,
      "text": "ناقة الله و سُقياها : احْذروا عـقـْـرَها و نـَـصيـبَها من الماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:14",
      "surahNumber": 91,
      "ayahNumber": 14,
      "text": "فدمدم عليهم : أهْـلـكهمْ و أطبَق العذاب عليهم\\nفسَوّاها : فجَعَل الدمْدمة عليهم سواءً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "91:15",
      "surahNumber": 91,
      "ayahNumber": 15,
      "text": "عُـقـْـبَـاها : عاقِـبة هذه العقـوبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
