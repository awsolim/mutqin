{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 91,
  "entries": [
    {
      "verseKey": "91:1",
      "surahNumber": 91,
      "ayahNumber": 1,
      "text": "By the sun and its brightness",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:2",
      "surahNumber": 91,
      "ayahNumber": 2,
      "text": "And [by] the moon when it follows it",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:3",
      "surahNumber": 91,
      "ayahNumber": 3,
      "text": "And [by] the day when it displays it",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:4",
      "surahNumber": 91,
      "ayahNumber": 4,
      "text": "And [by] the night when it covers [i.e., conceals] it",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:5",
      "surahNumber": 91,
      "ayahNumber": 5,
      "text": "And [by] the sky and He who constructed it",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:6",
      "surahNumber": 91,
      "ayahNumber": 6,
      "text": "And [by] the earth and He who spread it",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:7",
      "surahNumber": 91,
      "ayahNumber": 7,
      "text": "And [by] the soul and He who proportioned it",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:8",
      "surahNumber": 91,
      "ayahNumber": 8,
      "text": "And inspired it [with discernment of] its wickedness and its righteousness,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:9",
      "surahNumber": 91,
      "ayahNumber": 9,
      "text": "He has succeeded who purifies it,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:10",
      "surahNumber": 91,
      "ayahNumber": 10,
      "text": "And he has failed who instills it [with corruption].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:11",
      "surahNumber": 91,
      "ayahNumber": 11,
      "text": "Thamūd denied [their prophet] by reason of their transgression,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:12",
      "surahNumber": 91,
      "ayahNumber": 12,
      "text": "When the most wretched of them was sent forth.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:13",
      "surahNumber": 91,
      "ayahNumber": 13,
      "text": "And the messenger of Allāh [i.e., Ṣāliḥ] said to them, \"[Do not harm] the she-camel of Allāh or [prevent her from] her drink.\"",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:14",
      "surahNumber": 91,
      "ayahNumber": 14,
      "text": "But they denied him and hamstrung her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "91:15",
      "surahNumber": 91,
      "ayahNumber": 15,
      "text": "And He does not fear the consequence thereof.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
