{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 7,
  "entries": [
    {
      "verseKey": "7:2",
      "surahNumber": 7,
      "ayahNumber": 2,
      "text": "حرجٌ منه : ضيقٌ من تبليغه خشية التكذيب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:4",
      "surahNumber": 7,
      "ayahNumber": 4,
      "text": "وكم من قرية : كثيراً من القرى أهكلنا\\nبأسنا : عذابنا\\nبياتاً : بائتين أو ليلاً و هو نائمون\\nهم قآئلون : مستريحون نصف النهار (القيلولة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:5",
      "surahNumber": 7,
      "ayahNumber": 5,
      "text": "دعواهم : دعاؤهم وتضرّعهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:8",
      "surahNumber": 7,
      "ayahNumber": 8,
      "text": "ثقلت موازينه : رجحت حسناته على سيئاته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:9",
      "surahNumber": 7,
      "ayahNumber": 9,
      "text": "خفت موازينه : رجحت سيائته على حسناته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:10",
      "surahNumber": 7,
      "ayahNumber": 10,
      "text": "مكنّاكم : جعلنا لكم مكاناً وقراراً\\nمعايش : ما تعيشون به وتحيون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:12",
      "surahNumber": 7,
      "ayahNumber": 12,
      "text": "ما منعك : ما اضطرك. أو ما دعاك وحملك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:13",
      "surahNumber": 7,
      "ayahNumber": 13,
      "text": "الصاغرين : الأذلاء المهانين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:14",
      "surahNumber": 7,
      "ayahNumber": 14,
      "text": "أنظرني : أخرني وأمهلني في الحياة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:15",
      "surahNumber": 7,
      "ayahNumber": 15,
      "text": "المنظرين : الممهلين إلى وقت النفخة الأولى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:16",
      "surahNumber": 7,
      "ayahNumber": 16,
      "text": "فبما أغويتني : فبما أضللتني\\nلأقعدن لهم : لأترصدنّهم ولأجلسنّ لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:18",
      "surahNumber": 7,
      "ayahNumber": 18,
      "text": "مذءوماً : مذموماً أومعيبا أو محقراً لعيناً\\nمدحوراً : مطروداً مبعداً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:20",
      "surahNumber": 7,
      "ayahNumber": 20,
      "text": "فوسوس لهما : ألقى إليهما الوسوسة\\nما ووري عنهما : ما سُتر واُخفي وغُطّي عنهما\\nسوءاتهما : عوراتهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:21",
      "surahNumber": 7,
      "ayahNumber": 21,
      "text": "وقاسمهما : أقسم وحلف لهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:22",
      "surahNumber": 7,
      "ayahNumber": 22,
      "text": "فدلاهما بغرور : فأنزلهما عن رتبة الطاعة بخداع\\nطفقا يخصفان : شرعا وأخذا يلزقان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:26",
      "surahNumber": 7,
      "ayahNumber": 26,
      "text": "أنزلنا عليكم : أعطيناكم ووهبنا لكم\\nيواري سوءاتكم : يستر ويداري عوراتكم\\nريشا : لباس زينة . أو مالاً\\nلباس التقوى : الإيمان وثمراته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:27",
      "surahNumber": 7,
      "ayahNumber": 27,
      "text": "لا يفتننكم : لا يضلنكم ولا يخدعنكم\\nينزع عنهما : يزيل عنهما، استلاباً بخداعه\\nقبيله : جنوده . أو ذريته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:28",
      "surahNumber": 7,
      "ayahNumber": 28,
      "text": "فعلوا فاحشة : أتوا فعلةً متناهية في القبح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:29",
      "surahNumber": 7,
      "ayahNumber": 29,
      "text": "بالقسط : بالعدل وهو جميع الطاعات والقُرَب\\nاقيموا وجوهكم : توجهوا إلى عبادته مستقيمين\\nعند كل مسجد : في كل وقت سجود أو مكانه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:31",
      "surahNumber": 7,
      "ayahNumber": 31,
      "text": "خذوا زينتكم : البسوا ثيابكم لستر عوراتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:33",
      "surahNumber": 7,
      "ayahNumber": 33,
      "text": "الفواحش : كبائر المعاصي لمزيد قبحها\\nالإثم : ما يوجبه من سائر المعاصي\\nالبغي : الظلم والإستطالة على الناس\\nسُلطاناً : حجةً وبرهاناً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:37",
      "surahNumber": 7,
      "ayahNumber": 37,
      "text": "أين ما كنتم. . : أين الآلهة الذين كنتم. .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:38",
      "surahNumber": 7,
      "ayahNumber": 38,
      "text": "ادّاركوا فيها : تلاحقوا في النّار واجتمعوا فيها\\nأخراهم : منزلةً وهم الأتباع والسّفلة\\nلأولاهم : منزلةً وهم القادة والرؤساء\\nعذابا ضِعفاً : مضاعفاً مزيداً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:40",
      "surahNumber": 7,
      "ayahNumber": 40,
      "text": "يلج الجمل : يدخل الجمل\\nسمّ الخياط : ثقب الإبرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:41",
      "surahNumber": 7,
      "ayahNumber": 41,
      "text": "مِهادٌ : فراشٌ ،أي مستقر\\nغواش : أغطية كاللُّحُف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:42",
      "surahNumber": 7,
      "ayahNumber": 42,
      "text": "وُسعها : طاقتها وما تقدر عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:43",
      "surahNumber": 7,
      "ayahNumber": 43,
      "text": "غِلٍ : حقد ٍ وضغنٍ وعداوة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:44",
      "surahNumber": 7,
      "ayahNumber": 44,
      "text": "فأذّنَ مؤذنٌ : أعلم معلمٌ ونادى منادٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:45",
      "surahNumber": 7,
      "ayahNumber": 45,
      "text": "يبغونها عوجاً : يطلوبنها معوجّة أو ذات إعوجاج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:46",
      "surahNumber": 7,
      "ayahNumber": 46,
      "text": "بينهما حجابٌ : حاجزٌ . وهو سور بينهما\\nالأعراف : أعالي هذا السور وشرفاته\\nبسيماهم : بعلامتهم المميزة لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:50",
      "surahNumber": 7,
      "ayahNumber": 50,
      "text": "أفيضوا علينا : صُبوا أو ألقوا علينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:51",
      "surahNumber": 7,
      "ayahNumber": 51,
      "text": "غرتهم الحياة الدنيا : خدعتهم بزخارفها وزينتها\\nننساهم : نتركهم في العذاب كالمنسيين\\nوما كانوا. . : وكما كانوا. .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:53",
      "surahNumber": 7,
      "ayahNumber": 53,
      "text": "تأويله : عاقبة مواعيد الكتاب (القرآن) و مآلها من البعث و الحساب و الجزاء\\nيفترون : يكذبون من الشركاء وشفاعتهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:54",
      "surahNumber": 7,
      "ayahNumber": 54,
      "text": "استوى على العرش : إستواءً بالمعنى اللائق به سبحانه\\nيُغشي الليل النهار : يُغطي النهار بالليل فيذهب ضوءه\\nيطلبه حثيثاً : يطلب الليل النهار طلباً سريعاً\\nله الخلقُ : إيجاد جميع الأشياء من العدم\\nالأمرُ : التدبير والتصرف فيها كما يشاء\\nتبارك الله : تنزّه أوتعظم أو كثر خيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:55",
      "surahNumber": 7,
      "ayahNumber": 55,
      "text": "ادعوا ربكم : اسألوه واطلبوا منه حوائجكم\\nتضرعاً : مُظهرين الضراعة والذلة والإستكانة والخشوع\\nخُفية : سراً في قلوبكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:56",
      "surahNumber": 7,
      "ayahNumber": 56,
      "text": "رحمة الله : إحسانه وإنعامه أو ثوابه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:57",
      "surahNumber": 7,
      "ayahNumber": 57,
      "text": "بشراً : مبشرات برحمته وهي الغيث\\nأقلت سحاباً : حملته ورفعته\\nثِقالاً : مثقلة بحمل الماء\\nلبلدٍ ميت : مجدب لا ماء فيه ولا نبات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:58",
      "surahNumber": 7,
      "ayahNumber": 58,
      "text": "نكداً : عسراً أو قليلاً لا خير فيه\\nنصرّف الآيات : نكررها بأساليب مختلفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:60",
      "surahNumber": 7,
      "ayahNumber": 60,
      "text": "قال الملأ : السادة والرؤساء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:62",
      "surahNumber": 7,
      "ayahNumber": 62,
      "text": "أنصح لكم : أتحرى ما فيه صلاحكم قولاً وفعلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:64",
      "surahNumber": 7,
      "ayahNumber": 64,
      "text": "قوماً عمين : عُمي القلوب عن الحق والإيمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:66",
      "surahNumber": 7,
      "ayahNumber": 66,
      "text": "سفاهة : خفة عقل وضلالة عن الحق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:69",
      "surahNumber": 7,
      "ayahNumber": 69,
      "text": "بسطة : قوةً وعِظم أجسام\\nآلاء الله : نعمه وفضله الكثير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:71",
      "surahNumber": 7,
      "ayahNumber": 71,
      "text": "رجسٌ : عذابٌ . أو رين على القلوب\\nغضبٌ : لعنٌ وطردٌ أو سُخط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:72",
      "surahNumber": 7,
      "ayahNumber": 72,
      "text": "قطعنا دابر. . : أهلكنا آخر . . و المراد الجميع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:73",
      "surahNumber": 7,
      "ayahNumber": 73,
      "text": "ناقةُ الله : خلقها الله من صخر لا من أبوين\\nآية : معجزة دالة على صدقي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:74",
      "surahNumber": 7,
      "ayahNumber": 74,
      "text": "بوّأكم : أسكنكم و أنزلكم\\nفي الأرض : أرض الحجر و الحجاز و الشّام\\nآلاء الله : نعمه و إحساناته\\nلا تعثوا : لا تفسدوا إفسادا شديدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:77",
      "surahNumber": 7,
      "ayahNumber": 77,
      "text": "عتوْا : استكبروا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:78",
      "surahNumber": 7,
      "ayahNumber": 78,
      "text": "الرّجفة : الزّلزلة الشّديدة . أو الصّيحة\\nجاثمين : هامدين موتى لا حراك بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:82",
      "surahNumber": 7,
      "ayahNumber": 82,
      "text": "يتطهّرون : يدّعون الطّهارة ممّا نأتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:83",
      "surahNumber": 7,
      "ayahNumber": 83,
      "text": "الغابيرن : الباقين في العذاب كأمثالها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:85",
      "surahNumber": 7,
      "ayahNumber": 85,
      "text": "لا تبخسوا : لا تنقصوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:86",
      "surahNumber": 7,
      "ayahNumber": 86,
      "text": "صراط : طريق\\nتبغونها عوجا : تطلبونها معوجّة أو ذات اعوجاج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:89",
      "surahNumber": 7,
      "ayahNumber": 89,
      "text": "ربّنا افتح : احكم و اقض و افصل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:91",
      "surahNumber": 7,
      "ayahNumber": 91,
      "text": "الرّجفة – جاثمين : (آية 78)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:92",
      "surahNumber": 7,
      "ayahNumber": 92,
      "text": "لم يغْنَوْا فيها : لم يقيموا ناعمين في دارهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:93",
      "surahNumber": 7,
      "ayahNumber": 93,
      "text": "آسى : أحزن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:94",
      "surahNumber": 7,
      "ayahNumber": 94,
      "text": "بالبأساء و الضّراء : الفقر و البؤس و السّقم و الألم\\nيضّرّعون : يتذلّلون و يخضعون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:95",
      "surahNumber": 7,
      "ayahNumber": 95,
      "text": "عفوْا : كثُروا و نموا عددا و مالا\\nبغتة : فجأة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:96",
      "surahNumber": 7,
      "ayahNumber": 96,
      "text": "لفتحنا عليهم : ليسّرنا عليهم أو تابعنا عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:97",
      "surahNumber": 7,
      "ayahNumber": 97,
      "text": "يأتيهم بأسنا : ينزل بهم عذابنا\\nبياتا : وقت بيات أي ليلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:99",
      "surahNumber": 7,
      "ayahNumber": 99,
      "text": "مكر الله : عقوبته . أو استدراجه إياهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:100",
      "surahNumber": 7,
      "ayahNumber": 100,
      "text": "لم يهدِ للذين آمنوا : لم يبيّن الله للذين آمنوا\\nأن لو نشاء أصبناهم : إصابتنا إياهم لو شئنا\\nنطبع : نختم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:102",
      "surahNumber": 7,
      "ayahNumber": 102,
      "text": "من عهد : من وفاء بما أوصيناهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:103",
      "surahNumber": 7,
      "ayahNumber": 103,
      "text": "فظلموا بها : فكفروا بالآيات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:105",
      "surahNumber": 7,
      "ayahNumber": 105,
      "text": "حقيق على أن . . : حريص على أن . . أو خليق بأن . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:107",
      "surahNumber": 7,
      "ayahNumber": 107,
      "text": "مُبين : ظاهر أمره لا يشكّ فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:108",
      "surahNumber": 7,
      "ayahNumber": 108,
      "text": "و نزع يده : أخرجها من طوق قميصه\\nبيضاء : غلب شعاعها شعاع الشّمس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:109",
      "surahNumber": 7,
      "ayahNumber": 109,
      "text": "الملأ : أهل المشورة و الرّؤساء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:111",
      "surahNumber": 7,
      "ayahNumber": 111,
      "text": "أرجه و أخاه : أخّر أمر عقوبتهما و لا تعجل\\nحاشرين : جامعين السّحرة و هم الشُّرَط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:116",
      "surahNumber": 7,
      "ayahNumber": 116,
      "text": "سحروا أعين النّاس : خيّلوا لها ما يخالف الحقيقة\\nاسترهبوهم : خوّفوهم تخويفا شديدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:117",
      "surahNumber": 7,
      "ayahNumber": 117,
      "text": "تلقف : تبتلع أو تتناول بسرعة\\nما يأفكون : ما يكذبونه و يُموّهونه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:118",
      "surahNumber": 7,
      "ayahNumber": 118,
      "text": "فوقع الحقّ : ظهر و تبيّن أمر موسى عليه السّلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:126",
      "surahNumber": 7,
      "ayahNumber": 126,
      "text": "ما تنقِم منّا : ما تكره و ما تعيب منّا\\nأفرغ علينا : أفض أو صبّ علينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:127",
      "surahNumber": 7,
      "ayahNumber": 127,
      "text": "نستحيي نساءهم : نستبقي بناتكم – للخدمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:130",
      "surahNumber": 7,
      "ayahNumber": 130,
      "text": "بالسّنين : بالجدوب و القحوط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:131",
      "surahNumber": 7,
      "ayahNumber": 131,
      "text": "يطّيّروا : يتشاءموا\\nطائرهم عند الله : شؤمهم عقابهم الموعود في الآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:133",
      "surahNumber": 7,
      "ayahNumber": 133,
      "text": "الطّوفان : الماء الكثير . أو الموت الجارف\\nالقمّل : الدَّبى أو القراد أو القمل المعروف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:134",
      "surahNumber": 7,
      "ayahNumber": 134,
      "text": "الرّجز : العذاب بما ذكر من الآيات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:135",
      "surahNumber": 7,
      "ayahNumber": 135,
      "text": "ينكثون : ينقضون عهدهم الذي أبرموه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:137",
      "surahNumber": 7,
      "ayahNumber": 137,
      "text": "دمّرنا : أهلكنا و خرّبنا\\nيعرشون : من الجنّات أو يرفعون من الأبنية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:139",
      "surahNumber": 7,
      "ayahNumber": 139,
      "text": "متبّر : مُهلَكٌ مُدمّر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:140",
      "surahNumber": 7,
      "ayahNumber": 140,
      "text": "أبغيكم إلها : أطلب لكم إلها معبودا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:141",
      "surahNumber": 7,
      "ayahNumber": 141,
      "text": "يسومونكم : يذيقونكم أو يكلّفونكم\\nيستحيون نساءكم : يستبقون- بناتكم للخدمة\\nبلاء : ابتلاء و امتحان بالنّعم و النّقم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:143",
      "surahNumber": 7,
      "ayahNumber": 143,
      "text": "تجلّى ربّه للجبل : بدا له شيء من نوره تعالى\\nدكّاً : مدكوكا متفتّتا\\nصعقاً : مغشيّا عليه\\nسبحانك : تنزيها لك من مشابهة خلقك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:145",
      "surahNumber": 7,
      "ayahNumber": 145,
      "text": "الألواح : ألواح التوراة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:146",
      "surahNumber": 7,
      "ayahNumber": 146,
      "text": "سبيل الرّشد : طريق الهدى و السّداد\\nسبيل الغيّ : طريق الضّلال و الفساد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:147",
      "surahNumber": 7,
      "ayahNumber": 147,
      "text": "حبطت أعمالهم : بطلت أعمالهم لكفرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:148",
      "surahNumber": 7,
      "ayahNumber": 148,
      "text": "عجلا جسدا : مُجسّدا أي أحمر من ذهب\\nله خوار : صوت كصوت البقرة\\nاتّخذوه : اتخذوا العجل إلها و عبدوه ضلالاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:149",
      "surahNumber": 7,
      "ayahNumber": 149,
      "text": "سُقِط في أيديهم : نَدِموا أشدّ النّدم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:150",
      "surahNumber": 7,
      "ayahNumber": 150,
      "text": "أسفا : شديد الغضب . أو حزينا\\nأعجِلتم : أسبقتم بعبادة العجل أو أتركتم\\nفلا تُشمت : فلا تسرّهم بما تنال منّي من المكروه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:154",
      "surahNumber": 7,
      "ayahNumber": 154,
      "text": "سكت : سَكَن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:155",
      "surahNumber": 7,
      "ayahNumber": 155,
      "text": "أخذتهم الرّجفة : الزّلزلة الشّديدة أو الصّاعقة\\nفِتنتك : مِحنَتك و ابتلاؤك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:156",
      "surahNumber": 7,
      "ayahNumber": 156,
      "text": "هُدْنا إليك : تبنا و رجعنا إليك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:157",
      "surahNumber": 7,
      "ayahNumber": 157,
      "text": "إصرهم : عهدهم بالعمل بما في التوراة\\nالأغلال : التكاليف الشّاقة في التّوراة\\nعزّروه : وقّروه و عظّموه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:159",
      "surahNumber": 7,
      "ayahNumber": 159,
      "text": "به يعدلون : بالحقّ يحكمون في الخصومات بينهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:160",
      "surahNumber": 7,
      "ayahNumber": 160,
      "text": "قطّعناهم : فرّقناهم أو صيّرناهم\\nأسباطا : جماعات ، كالقبائل في العرب\\nفانبجست : فانفجرت\\nمشربهم : عينهم الخاصّة بهم\\nالغمام : السّحاب الأبيض الرّقيق\\nالمنّ : مادّة صَمغيّة حُلوة كالعسل\\nالسّلوى : الطّائر المعروف بالسّماني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:161",
      "surahNumber": 7,
      "ayahNumber": 161,
      "text": "قولوا حطّة : مسألتنا حطّ ذنوبنا عنّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:162",
      "surahNumber": 7,
      "ayahNumber": 162,
      "text": "رجزا : عذابا (الطّاعون)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:163",
      "surahNumber": 7,
      "ayahNumber": 163,
      "text": "حاضرة البحر : قريبةً من البحر\\nيعدون في السبت : يعتدون بالصّيد المحرّم فيه\\nيوم سبتهم : يوم تعظيمهم أمر السّبت\\nشرّعا : ظاهرة على وجه الماء كثيرة\\nلا يسبتون : لا يُراعون أمر السّبت\\nنبلوهم : نمتحنهم و نختبرهم بالشّدة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:164",
      "surahNumber": 7,
      "ayahNumber": 164,
      "text": "معذرة إلى ربّكم : نعِظهم اعتذارا إليه تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:165",
      "surahNumber": 7,
      "ayahNumber": 165,
      "text": "بعذاب بئيسٍ : شديدٍ وَجيعٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:166",
      "surahNumber": 7,
      "ayahNumber": 166,
      "text": "عتوْا : استكبروا و استعصوا\\nقردةً خاسئين : أذلاّء مُبعدين كالكلاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:167",
      "surahNumber": 7,
      "ayahNumber": 167,
      "text": "تأذّن ربّك : أعلم ، أو عزم و قضى\\nيسومهم : يُذيقهم و يكلّـفهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:168",
      "surahNumber": 7,
      "ayahNumber": 168,
      "text": "بلوناهم : امتحنّاهم و اختبرناهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:169",
      "surahNumber": 7,
      "ayahNumber": 169,
      "text": "خلفٌ : بَدَل سَوءٍ\\nعرض هذا الأدنى : ما يعرض لهم من حُطام الدّنيا\\nدرسوا ما فيه : قرءوا و علموا ما في التوراة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:171",
      "surahNumber": 7,
      "ayahNumber": 171,
      "text": "نتقنا الجبل : رفعناه و قلعناه\\nكأنّه ظلّة : غمامة . أو سقيفة تُـظلّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:175",
      "surahNumber": 7,
      "ayahNumber": 175,
      "text": "فانسلخ منها : فخرج منها بكفره بها\\nفأتبعه الشّيطان : فلحقه و أدركه و صار قرينه\\nالغاوين : الضّالّين الهالكين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:176",
      "surahNumber": 7,
      "ayahNumber": 176,
      "text": "أخلد إلى الأرض : ركن إلى الدّنيا و رضي بها\\nتحمل عليه : تشدُد عليه و تزجزه\\nيلهث : يُخرج لسانه بالنّـفَس الشديد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:179",
      "surahNumber": 7,
      "ayahNumber": 179,
      "text": "ذرأنا : خلقنا و أوجدنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:180",
      "surahNumber": 7,
      "ayahNumber": 180,
      "text": "يُلحدون : يميلون و ينحرفون إلى الباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:181",
      "surahNumber": 7,
      "ayahNumber": 181,
      "text": "به يعدلون : بالحقّ يحكمون في الخصومات بينهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:182",
      "surahNumber": 7,
      "ayahNumber": 182,
      "text": "سنستدرجهم : سنستدنيهم إلى الهلاك بالإنعام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:183",
      "surahNumber": 7,
      "ayahNumber": 183,
      "text": "أُملي لهم : أمهلهم في العقوبة\\nكيدي متين : أخذي شديد قويّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:184",
      "surahNumber": 7,
      "ayahNumber": 184,
      "text": "جِنّة : جُنون كما يزعمون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:185",
      "surahNumber": 7,
      "ayahNumber": 185,
      "text": "ملكوت : هو المُـلك العظيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:186",
      "surahNumber": 7,
      "ayahNumber": 186,
      "text": "طغيانهم : تجاوزهم الحدّ في الكفر\\nيعمهون : يعمون عن الرّشد أو يتحيّرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:187",
      "surahNumber": 7,
      "ayahNumber": 187,
      "text": "أيّان مُرساها ؟ : متى إثباتها و وقوعها ؟\\nلا يجلّيها : لا يُظهرها و لا يكشف عنها\\nثقُلت : عظُمت لشدّتها\\nحفيّ عنها : باحث عنها عالمٌ بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:189",
      "surahNumber": 7,
      "ayahNumber": 189,
      "text": "تغشّاها : واقعها\\nفمرّت به : فاستمرّت به بغير مشقّة\\nأثقلت : صارت ذات ثِقل بكِبر الحمل\\nصالحا : نسلا سويّا أو ولدا سليما مثلنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:190",
      "surahNumber": 7,
      "ayahNumber": 190,
      "text": "جعلا له شركاء : بتسمية ولديهما عبد الحارث بوسوسة\\nعمّا يُشركون : أي العرب بعبادة الأصنام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:195",
      "surahNumber": 7,
      "ayahNumber": 195,
      "text": "فلا تُنظرون : فلا تُمهلوني ساعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:198",
      "surahNumber": 7,
      "ayahNumber": 198,
      "text": "لا يبصرون : لعدم قدرتهم على الإبصار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:199",
      "surahNumber": 7,
      "ayahNumber": 199,
      "text": "خذ العفو : ما عفا و تيسّر من أخلاق النّاس\\nو أمر بالعرف : بالمعروف حُسنُـه في الشّرع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:200",
      "surahNumber": 7,
      "ayahNumber": 200,
      "text": "ينزغنّك : يُصيبنّك . أو يصرفنّك\\nنزغ : وسوسة . أو صارف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:201",
      "surahNumber": 7,
      "ayahNumber": 201,
      "text": "مسّهم طائف : أصابتهم لمّة أي وسوسة ما\\nتذكّروا : أمر الله و نهيه و عداوة الشّيطان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:202",
      "surahNumber": 7,
      "ayahNumber": 202,
      "text": "يمدّونهم في الغيّ : تُعاونهم الشّياطين في الضّلال\\nلا يُقصِرون : لا يكفّون عن إغوائهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:203",
      "surahNumber": 7,
      "ayahNumber": 203,
      "text": "اجتبيتها : اختلقتها و اخترعتها من عندك\\nهذا بصائر : القرآن حجج بيّنة و براهين نيّرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:205",
      "surahNumber": 7,
      "ayahNumber": 205,
      "text": "تضرّعا : مُظهرا الضَّراعة و الذلة\\nخيفة : خائفا من عقابه\\nبالغدوّ و الآصال : أوائل النّهار و أواخره . أي في كلّ وقت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "7:206",
      "surahNumber": 7,
      "ayahNumber": 206,
      "text": "له يسجدون : يُصلّون و يعبدون (آية سجدة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
