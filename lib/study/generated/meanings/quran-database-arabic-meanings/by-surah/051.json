{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 51,
  "entries": [
    {
      "verseKey": "51:1",
      "surahNumber": 51,
      "ayahNumber": 1,
      "text": "و الذاريات ذروا : (قسَمٌ) بالرياح تذرو و تفرّق التراب و غيره ذروا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:2",
      "surahNumber": 51,
      "ayahNumber": 2,
      "text": "فالحاملات وقرا : السّحب تحمل الأمطار حَمْلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:3",
      "surahNumber": 51,
      "ayahNumber": 3,
      "text": "فالجاريات يُسرا : السّـفن تجري على الماء جَرْيا سهلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:4",
      "surahNumber": 51,
      "ayahNumber": 4,
      "text": "فالمقسمات أمرا : الملائكة تقسّم المقدّرات الرّبانيّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:5",
      "surahNumber": 51,
      "ayahNumber": 5,
      "text": "إن ما توعدون : مِنَ البعث (جواب القسم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:6",
      "surahNumber": 51,
      "ayahNumber": 6,
      "text": "إن الدين : الجزاء بعد الحساب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:7",
      "surahNumber": 51,
      "ayahNumber": 7,
      "text": "ذات الحُبك : الطرق التي تسير فيها الكواكب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:8",
      "surahNumber": 51,
      "ayahNumber": 8,
      "text": "قوْل مختلف : متناقضٍ فينا كلـّـفتم الإيمان به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:9",
      "surahNumber": 51,
      "ayahNumber": 9,
      "text": "يؤفك عنه : يُصْرَف عن الحقّ الآتي به الرسول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:10",
      "surahNumber": 51,
      "ayahNumber": 10,
      "text": "قتل الخرّاصون : لـُعِنَ و قُــبّـح الكذابون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:11",
      "surahNumber": 51,
      "ayahNumber": 11,
      "text": "غمرة : جهالة غامرة بأمور الآخرة\\nساهون : غافلون عمّا أمروا به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:12",
      "surahNumber": 51,
      "ayahNumber": 12,
      "text": "أيّـان يوم الدّين ؟ : متى يوم الجزاء ؟ (إنكارٌ له)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:13",
      "surahNumber": 51,
      "ayahNumber": 13,
      "text": "يُـفـتـنون : يُحْرَقونو يعذبون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:17",
      "surahNumber": 51,
      "ayahNumber": 17,
      "text": "يَهجعون : يَنامون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:18",
      "surahNumber": 51,
      "ayahNumber": 18,
      "text": "بالأسحار : أواخر الليل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:19",
      "surahNumber": 51,
      "ayahNumber": 19,
      "text": "المحروم : الذي حُرم الصدقة لتعفّـفه عن السؤال مع حاجته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:24",
      "surahNumber": 51,
      "ayahNumber": 24,
      "text": "ضيف إبراهيم : أضيافه من الملائكة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:25",
      "surahNumber": 51,
      "ayahNumber": 25,
      "text": "قوم منكرون : قاله في نفسه لغرابَتهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:26",
      "surahNumber": 51,
      "ayahNumber": 26,
      "text": "فراغ إلى أهله : ذهَبَ إليهم في خِفـيَة من ضَيفه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:28",
      "surahNumber": 51,
      "ayahNumber": 28,
      "text": "فأوجس منهم : فأحسّ في نفسه منهم\\nبغلام عليم : هو هنا إسحاق عند الجمهور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:29",
      "surahNumber": 51,
      "ayahNumber": 29,
      "text": "صرّة : صَيْحة و ضَجّـة\\nفصكّت وجهها : لطمته بيدها تعجّبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:31",
      "surahNumber": 51,
      "ayahNumber": 31,
      "text": "فما خطبكم ؟ : فما شأنكم الخطير ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:34",
      "surahNumber": 51,
      "ayahNumber": 34,
      "text": "مسَوّمة : مُعْـلـَـمَة بأنّها حجارة عذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:38",
      "surahNumber": 51,
      "ayahNumber": 38,
      "text": "و في موسى : و جعلنا في قصّة موسى آية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:39",
      "surahNumber": 51,
      "ayahNumber": 39,
      "text": "فتولـّـى بركنه : فأعرض فرعون بقـوّتِه و سلطانه عن الإيمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:40",
      "surahNumber": 51,
      "ayahNumber": 40,
      "text": "هو مليم : آتٍ بما يُلام عليه الكُـفْـر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:41",
      "surahNumber": 51,
      "ayahNumber": 41,
      "text": "الريح العقيم : المُهلكة لهمْ، القاطعة لنـَـسْـلهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:42",
      "surahNumber": 51,
      "ayahNumber": 42,
      "text": "كالرّميم : كالشيء البالي المفـتـّـت الهالك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:44",
      "surahNumber": 51,
      "ayahNumber": 44,
      "text": "فعَتوْا : فاستكبروا\\nفأخذتهم الصّاعقة : فأهلكتهم صيحة أو نارٌ من السماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:47",
      "surahNumber": 51,
      "ayahNumber": 47,
      "text": "بنيْناها بأيدٍ : بقوّة و قدْرَة\\nإنّـا لموسعون : لقادرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:48",
      "surahNumber": 51,
      "ayahNumber": 48,
      "text": "الأرض فرشناها : مهّدناها و بَسَطناها كالفراش للاستقـرار عليها\\nفنِعْمَ الماهدون : المسَوّون المُصلحون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:49",
      "surahNumber": 51,
      "ayahNumber": 49,
      "text": "خلقنا زوجين : صِنـفَـيْـن و نوعين مختلفين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:50",
      "surahNumber": 51,
      "ayahNumber": 50,
      "text": "فـفـرّوا إلى الله : فاهربوا من عقابه إلى ثوابه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:53",
      "surahNumber": 51,
      "ayahNumber": 53,
      "text": "طاغون : متجاوزون الحدّ في الكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:56",
      "surahNumber": 51,
      "ayahNumber": 56,
      "text": "ليَعْبدون ِ : ليعرفوني أو ليخْـضعوا لي و يتذلـّـلوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:59",
      "surahNumber": 51,
      "ayahNumber": 59,
      "text": "ذنوبًا : نـَـصيبًـا مِنَ العَذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "51:60",
      "surahNumber": 51,
      "ayahNumber": 60,
      "text": "فوَيْـلٌ : هلاكٌ . أو حسْرَةٌ أو شدّة عَـذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
