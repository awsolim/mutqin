  "surahNumber": 104,
  "entries": [
    {
      "verseKey": "104:1",
      "surahNumber": 104,
      "ayahNumber": 1,
      "text": "{ وَيْلٌ } أي: وعيد، ووبال، وشدة عذاب { لِكُلِّ هُمَزَةٍ لُمَزَةٍ } الذي يهمز الناس بفعله، ويلمزهم بقوله، فالهماز: الذي يعيب الناس، ويطعن عليهم بالإشارة والفعل، واللماز: الذي يعيبهم بقوله.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "104:2",
      "surahNumber": 104,
      "ayahNumber": 2,
      "text": "ومن صفة هذا الهماز اللماز، أنه لا هم له سوى جمع المال وتعديده والغبطة به، وليس له رغبة في إنفاقه في طرق الخيرات وصلة الأرحام، ونحو ذلك،",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "104:3",
      "surahNumber": 104,
      "ayahNumber": 3,
      "text": "{ يَحْسَبُ } بجهله { أَنَّ مَالَهُ أَخْلَدَهُ } في الدنيا، فلذلك كان كده وسعيه كله في تنمية ماله، الذي يظن أنه ينمي عمره، ولم يدر أن البخل يقصف الأعمار، ويخرب الديار، وأن البر يزيد في العمر.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "104:4",
      "surahNumber": 104,
      "ayahNumber": 4,
      "text": "{ كَلَّا لَيُنْبَذَنَّ } أي: ليطرحن { فِي الْحُطَمَةِ}",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "104:5",
      "surahNumber": 104,
      "ayahNumber": 5,
      "text": "[وَمَا أَدْرَاكَ مَا الْحُطَمَةُ } تعظيم لها، وتهويل لشأنها.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "104:6",
      "surahNumber": 104,
      "ayahNumber": 6,
      "text": "{ نَارُ اللَّهِ الْمُوقَدَةُ } التي وقودها الناس والحجارة",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "104:7",
      "surahNumber": 104,
      "ayahNumber": 7,
      "text": "{ الَّتِي } من شدتها { تَطَّلِعُ عَلَى الْأَفْئِدَةِ } أي: تنفذ من الأجسام إلى القلوب.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "104:8",
      "surahNumber": 104,
      "ayahNumber": 8,
      "text": "ومع هذه الحرارة البليغة هم محبوسون فيها، قد أيسوا من الخروج منها، ولهذا قال: { إِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌ } أي: مغلقة",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "104:9",
      "surahNumber": 104,
      "ayahNumber": 9,
      "text": "{ فِي عَمَدٍ } من خلف الأبواب { مُمَدَّدَةٍ } لئلا يخرجوا منها { كُلَّمَا أَرَادُوا أَنْ يَخْرُجُوا مِنْهَا أُعِيدُوا فِيهَا } .\n\n[نعوذ بالله من ذلك، ونسأله العفو والعافية].",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
