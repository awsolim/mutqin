      "surahNumber": 82,
      "ayahNumber": 1,
      "text": "السماء انفطرت : انشقـّـتْ عند قِـيَـام الساعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "82:2",
      "surahNumber": 82,
      "ayahNumber": 2,
      "text": "الكواكب انتثرت : تساقطتْ مُـتـفـرقة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "82:3",
      "surahNumber": 82,
      "ayahNumber": 3,
      "text": "البحار فجّرت : شقـّـقتْ جَوانِبـُـها فصارتْ بَحْرًا واحِدًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "82:4",
      "surahNumber": 82,
      "ayahNumber": 4,
      "text": "القبور بُعثرت : قـُـلِبَ ترابُها ، و أخْــِرج موتاها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "82:6",
      "surahNumber": 82,
      "ayahNumber": 6,
      "text": "ما غَرّك بربّك ؟ : ما خدعَك و جَرّأك على عِصْيانه ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "82:7",
      "surahNumber": 82,
      "ayahNumber": 7,
      "text": "فسوّاك : جَعَل أعْضاءَك سَويّة سليمة\\nفعَدَلك : جَـعَلك معتدلا متناسب الخَـلـْق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "82:9",
      "surahNumber": 82,
      "ayahNumber": 9,
      "text": "تكذبون بالدّين : بالبعث أو الجزاء أو بالإسلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "82:13",
      "surahNumber": 82,
      "ayahNumber": 13,
      "text": "الأبرار : الذين بَرّوا و صدقوا في إيمانهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "82:15",
      "surahNumber": 82,
      "ayahNumber": 15,
      "text": "يصْـلونها : يَدْخُـلونـَـها ، أو يُـقـاسونَ حَرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
