  "surahNumber": 23,
  "entries": [
    {
      "verseKey": "23:1",
      "surahNumber": 23,
      "ayahNumber": 1,
      "text": "أفلح المؤمنون : فازوا وسعِدوا ونجَوْا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:2",
      "surahNumber": 23,
      "ayahNumber": 2,
      "text": "خاشعون : متُذللون خائفون ساكنون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:3",
      "surahNumber": 23,
      "ayahNumber": 3,
      "text": "اللغو : مالا يَجْمُـلُ من القول والفعل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:7",
      "surahNumber": 23,
      "ayahNumber": 7,
      "text": "العادُون : المُجاوزون الحلال إلى الحرام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:11",
      "surahNumber": 23,
      "ayahNumber": 11,
      "text": "الفردوس : أعلى الجنان و أوسطها و أفضلها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:12",
      "surahNumber": 23,
      "ayahNumber": 12,
      "text": "سُلالة : خُلاصة ( مائية مكونة من الغذاء )",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:13",
      "surahNumber": 23,
      "ayahNumber": 13,
      "text": "قرار مكين : مستقر مُـتمكن وهو الرحم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:14",
      "surahNumber": 23,
      "ayahNumber": 14,
      "text": "علقة : دما متجمدا\\nمُضغة : قطعة لحم قـَـدْر ما يُمضغ\\nخلقا آخر : مباينا للأول بنفخ الروح فيه\\nفتبارك الله : فتعالى . أو تكاثر خيره وإحسانه\\nأحسن الخالقين : أتقن الصانعين . أو المصورين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:17",
      "surahNumber": 23,
      "ayahNumber": 17,
      "text": "سبع طرائق : سبع سموات طباقا أو طُرُقا للملائكة أو للكواكب في مسيرها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:18",
      "surahNumber": 23,
      "ayahNumber": 18,
      "text": "بقدَر : بمقدار الحاجة والمصلحة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:20",
      "surahNumber": 23,
      "ayahNumber": 20,
      "text": "شجرة : هي شجرة الزيتون\\nبالدهن : مُـلتبسًا ثمرها بالزيت\\nصبغ للآكلين : إدام لهم يغمس فيه الخبز",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:21",
      "surahNumber": 23,
      "ayahNumber": 21,
      "text": "الأنعام : الإبل والبقر والضأن والمعز\\nلعبرة : لعظة وآية على القدْرَة والرّحمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:22",
      "surahNumber": 23,
      "ayahNumber": 22,
      "text": "وعليها : وعلى الإبل منها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:24",
      "surahNumber": 23,
      "ayahNumber": 24,
      "text": "الملأ : وُجوه القوْم و سَادَتهم\\nيتفضل عليكم : يترأس ويَشْرُف عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:25",
      "surahNumber": 23,
      "ayahNumber": 25,
      "text": "به جـِـنّة : به جنون أو جنّ يَخْـبَـلونه\\nفتربصوا به : انتظروا و اصبروا عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:27",
      "surahNumber": 23,
      "ayahNumber": 27,
      "text": "بأعْـيُـننا : برعايتنا وكلاءَتِنا\\nفار التنور : نبع الماء من التنور المعروف\\nفاسْلك فيها : فأدخل في الفلك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:29",
      "surahNumber": 23,
      "ayahNumber": 29,
      "text": "مُنزلا : إنزالا . أو مكان إنزال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:30",
      "surahNumber": 23,
      "ayahNumber": 30,
      "text": "لمُبتلين : لمُختبرين عبادنا بهذه الآيات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:31",
      "surahNumber": 23,
      "ayahNumber": 31,
      "text": "قرنا آخرين : هم عادٌ الأولى قوم هود",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:33",
      "surahNumber": 23,
      "ayahNumber": 33,
      "text": "أتـْـرفـناهم : نعمناهم و وَسّعْـنا عليهم فبَطِـروا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:36",
      "surahNumber": 23,
      "ayahNumber": 36,
      "text": "هيهات : بعُد وقوع ذلك الموعود",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:41",
      "surahNumber": 23,
      "ayahNumber": 41,
      "text": "فأخذتهم الصيحة : صيحة جبريل أو العذاب المُصْــــَطـلِـم\\nفجعلناهم غثاء : هالكين كغثاء السيل ( حَمِيله )\\nفبُعدا : هلاكا .. أو بُعدا من الرحمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:42",
      "surahNumber": 23,
      "ayahNumber": 42,
      "text": "قرونا آخرين : أمَمًا أخرى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:44",
      "surahNumber": 23,
      "ayahNumber": 44,
      "text": "تتـْـرى : متتابعين على فترات\\nجعلناهم أحاديث : مجرد أخبار للتعَجّب والتلهّي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:45",
      "surahNumber": 23,
      "ayahNumber": 45,
      "text": "سُلطان مبين : برهان بَيّن ٍ مُظهر للحق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:46",
      "surahNumber": 23,
      "ayahNumber": 46,
      "text": "قوْما عالين : متكبرين أو متطاولين بالظلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:50",
      "surahNumber": 23,
      "ayahNumber": 50,
      "text": "آويناهُما : صيّرناهُما وأوْصَـلناهُما\\nإلى رَبوة : إلى مكان مرتفع من البلاد\\nمعين : ماءٍ جَار ٍ ظاهر للعيون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:52",
      "surahNumber": 23,
      "ayahNumber": 52,
      "text": "أمتكم : مِلـّـتكم وشريعتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:53",
      "surahNumber": 23,
      "ayahNumber": 53,
      "text": "فتقطعوا أمرهم : تفرقوا في أمْر دينهم\\nزبُرا : قطعا وفرقا وأحزابا مختلفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:54",
      "surahNumber": 23,
      "ayahNumber": 54,
      "text": "غَمْرَتِهم : جَهالتهم وضلالتهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:55",
      "surahNumber": 23,
      "ayahNumber": 55,
      "text": "أنّ ما نمدهم به : ما نجعله مدَدا لهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:57",
      "surahNumber": 23,
      "ayahNumber": 57,
      "text": "مُشفقون : خائفون حَذِرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:60",
      "surahNumber": 23,
      "ayahNumber": 60,
      "text": "يُؤتون ما آتوْا : يُعطون ما أعْـــَطوْا من الصّدقات\\nقلوبهم وجلة : خائفة ألا تقبل أعمالهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:62",
      "surahNumber": 23,
      "ayahNumber": 62,
      "text": "وسعها : قدر طاقتها من الأعمال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:63",
      "surahNumber": 23,
      "ayahNumber": 63,
      "text": "غمرة : جهالة وغفلة وغطاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:64",
      "surahNumber": 23,
      "ayahNumber": 64,
      "text": "مترفيهم : مُنعّميهم الذين أبْطرَتـْـهم النِّعَم\\nيجأرون : يصرُخون مستغيثين بربّهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:66",
      "surahNumber": 23,
      "ayahNumber": 66,
      "text": "تنكِصون : ترجعون معرضين عن سماعها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:67",
      "surahNumber": 23,
      "ayahNumber": 67,
      "text": "مستكبرين به : مستعظمين بالبيت الحرام\\nسامرا : سُمّارًا حوْله بالليل\\nتهجرون : تهْذون بالطعن في القرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:70",
      "surahNumber": 23,
      "ayahNumber": 70,
      "text": "به جـِـنَّة : به جنون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:71",
      "surahNumber": 23,
      "ayahNumber": 71,
      "text": "بذِكرهم : بفخرهم وشرفهم وهو القرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:72",
      "surahNumber": 23,
      "ayahNumber": 72,
      "text": "خَرْجا : جُعلا و أجْرًا من المال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:74",
      "surahNumber": 23,
      "ayahNumber": 74,
      "text": "لناكبون : لعادِلون عن الحق زائغون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:75",
      "surahNumber": 23,
      "ayahNumber": 75,
      "text": "للجّوا في طغيانهمْ : لتمادوْا في ضلالهم وكفرهم\\nيعمهون : يعمون عن الرشد أو يتحيرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:76",
      "surahNumber": 23,
      "ayahNumber": 76,
      "text": "فما استكانوا : فما خضعوا وأظهروا المسكنة\\nما يتضرعون : ما يتذللون له تعالى بالدعاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:77",
      "surahNumber": 23,
      "ayahNumber": 77,
      "text": "مُبلسون : مُتحيرون آيسون من كل خير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:79",
      "surahNumber": 23,
      "ayahNumber": 79,
      "text": "ذرأكم : خلقكم وبثكم بالتناسل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:83",
      "surahNumber": 23,
      "ayahNumber": 83,
      "text": "أساطير الأولين : أكاذيبهم المسطورة في كتبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:88",
      "surahNumber": 23,
      "ayahNumber": 88,
      "text": "ملكوت : هو الملك الواسع العظيم\\nهو يجير : يُغيث ويحمى من يشاءُ ويمنع\\nلا يُجار عليه : لا يُغاث أحد منه ولا يُمنع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:89",
      "surahNumber": 23,
      "ayahNumber": 89,
      "text": "فأنى تـُـسحرون : فكيف تـُـخدعون عن توحيده؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:97",
      "surahNumber": 23,
      "ayahNumber": 97,
      "text": "أعوذ بك : أعتصم وأمتنع بك\\nهمزات الشياطين : نزغاتِهم و وَساوسهم المُغْرية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:100",
      "surahNumber": 23,
      "ayahNumber": 100,
      "text": "من ورائهم : أمامهم\\nبرزخ : حاجزٌ دون الرّجعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:104",
      "surahNumber": 23,
      "ayahNumber": 104,
      "text": "تلفح : تحرق\\nكالِحون : عابسون أو متقـلـّـصو الشفاه عن الأسنان من أثر اللفح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "23:106",
      "surahNumber": 23,
