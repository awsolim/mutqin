{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 41,
  "entries": [
    {
      "verseKey": "41:3",
      "surahNumber": 41,
      "ayahNumber": 3,
      "text": "فصّـلتْ آياته : مُـيّـزَتْ و نوّعَتْ. أو بُـيّـنتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:5",
      "surahNumber": 41,
      "ayahNumber": 5,
      "text": "أكنّة : أغطية خِلقـيّة تمنع الفَهم\\nوَقـْـرٌ : صَممٌ و ثقـلٌ يمنعُ السّمع\\nحِجاب : سِتـْـرٌ غليظ يمنع التـّواصل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:6",
      "surahNumber": 41,
      "ayahNumber": 6,
      "text": "فاستقيموا إليه : تـَوجّهوا إليه بطاعته و عبادته\\nوَيْـل للمشركين : هلاكٌ أو حَسْرَةٌ أو شدة عذاب لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:8",
      "surahNumber": 41,
      "ayahNumber": 8,
      "text": "غير ممنون : غير مقطوع عنهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:9",
      "surahNumber": 41,
      "ayahNumber": 9,
      "text": "أندادًا : أمْثالا مِنَ مَخـْـلوقاته تـَعبدونها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:10",
      "surahNumber": 41,
      "ayahNumber": 10,
      "text": "رَواسيَ : جبالاً ثوابتَ تمنعُها المَـيَـدَان\\nبارك فيها : كثـّرَ خَيْرها و مَنافعها\\nأقواتها : أرزاق أهلها و ما يصلح لمعايشهمْ\\nفي أربعة أيام : في تتمّة أربعة أيّـام\\nسَوَاءً : اسْتوت الأربعة اسْتِواءً (تـمّتْ)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:11",
      "surahNumber": 41,
      "ayahNumber": 11,
      "text": "استوى : عَمَدَ و قصَدَ قصدا سويّـا . .\\nهي دُخان : مُكونة مما يُشبه الدّخان\\nائتيا : افعَلا ما أمرتكما به و جيئا به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:12",
      "surahNumber": 41,
      "ayahNumber": 12,
      "text": "فقضاهنّ : أحْكَمَ و أبْدَعَ خلقهنّ\\nأوْحى : كوّن ، أو دَبّرَ في اليومين\\nحفظا : حفِظناها حِفظا من الآفات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:13",
      "surahNumber": 41,
      "ayahNumber": 13,
      "text": "أنذرْتكم صاعقة : خوّفتكمْ عَذاباً شديدا مهلكا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:16",
      "surahNumber": 41,
      "ayahNumber": 16,
      "text": "ريحا صرصرا : شديدة السّموم ، أو البَرْد، أو الصّوت\\nأيّـام نحِسات : مشـْـئوماتٍ ، أو ذوات غبار و تراب\\nأخزَى : أشدّ إذلالاً و إهانة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:17",
      "surahNumber": 41,
      "ayahNumber": 17,
      "text": "فهديْناهمْ : بيّـنّـا لهم طريقي الضلالة و الهُدَى\\nالعَذاب الهون : المهين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:19",
      "surahNumber": 41,
      "ayahNumber": 19,
      "text": "فهم يوزعون : يُـحـْـبَـسُ سَوَابقهم ليلحقهم تواليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:22",
      "surahNumber": 41,
      "ayahNumber": 22,
      "text": "تستترون : تستخفونَ عند ارتكابكم الفواحش\\nأنْ يشهد . . : مَخافة أن يَشهد . .\\nظنـَـنـْـتمْ : اعتقدْتم عند استتاركم من الناس\\nكثيرا مما تعملون : و هو ما عمِلتم خِفْية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:23",
      "surahNumber": 41,
      "ayahNumber": 23,
      "text": "أرداكمْ : أهْـلكَكُمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:24",
      "surahNumber": 41,
      "ayahNumber": 24,
      "text": "مَثوًى لهمْ : مَحَلّ ثوّاء و إقامة أبديّة لهم\\nإنْ يَستعتبوا : يَطلبوا رضاءَ ربهم يومئذ\\nمن المعتبينَ : منَ المجَابين إلى ما طَلبوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:25",
      "surahNumber": 41,
      "ayahNumber": 25,
      "text": "قيّضنا لَهمْ : سبّـبنا و هَـيّـأنا لهمْ\\nحقّ عليهم القول : وَجَبَ و ثـَبَـتَ عليهم وَعيد العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:26",
      "surahNumber": 41,
      "ayahNumber": 26,
      "text": "الغوْا فيه : ائـْتوا باللّغو و الباطل عند قراءته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:29",
      "surahNumber": 41,
      "ayahNumber": 29,
      "text": "الأسْـفـلين : في الدّرك الأسفل من النار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:30",
      "surahNumber": 41,
      "ayahNumber": 30,
      "text": "استقاموا : على الحقّ اعتقادا و عملا و إخلاصا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:31",
      "surahNumber": 41,
      "ayahNumber": 31,
      "text": "ما تدّعون : ما تتمنّونه و تطلبونه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:32",
      "surahNumber": 41,
      "ayahNumber": 32,
      "text": "نزلاً : رزقا أو ضِـيافةو تكرمة ، أو منّـا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:34",
      "surahNumber": 41,
      "ayahNumber": 34,
      "text": "وليّ حميمٌ : صَديقٌ قريبٌ يَهتمّ لأمركَ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:35",
      "surahNumber": 41,
      "ayahNumber": 35,
      "text": "ما يلقـّـاها : ما يُؤتـَى هذه الخصلة الشريفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:36",
      "surahNumber": 41,
      "ayahNumber": 36,
      "text": "ينزغـنـّـك : يُصيبنّـك. أو يَصرفـنّـك\\nنزْغٌ : وَسْوَسة . أو صارفٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:38",
      "surahNumber": 41,
      "ayahNumber": 38,
      "text": "لا يسأمون : لا يَمَـلـّـون التـّـسبيح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:39",
      "surahNumber": 41,
      "ayahNumber": 39,
      "text": "الأرض خاشعة : يَابسة مُـتطامِنـَـة جَدْبَة\\nاهتزّت : تحرّكتْ بالنّبات\\nرَبَتْ : انتفختْ و عَلَتْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:40",
      "surahNumber": 41,
      "ayahNumber": 40,
      "text": "يُـلْحِدونَ : يَميلون عن الحقّ و الاستقامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:41",
      "surahNumber": 41,
      "ayahNumber": 41,
      "text": "إنّ الذين كَـفَـروا : \\\"خَبَر \\\"\\\"إنّ\\\"\\\" تقديره \\\"\\\"لا يَخْـفَوْنَ علينا\\\"\\\" أو \\\"\\\"هالِكون\\\"\\\"\\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:44",
      "surahNumber": 41,
      "ayahNumber": 44,
      "text": "قرآنا أعجميـّـا : بـِـلغَة العجَم كما اقترحوا\\nلولا فصّـلت آياته : هلاّ بُـيّـنـَـتْ آياته بلسان نعرفه\\nأأعجميّ و عربيّ : أقرآنٌ أعجميّ و رَسولٌ عرَبيّ\\nفي آذانهم وَقـْـرٌ : صَمَمٌ مانعٌ من سماعه\\nهو عليهم عمًى : ظلمَة و شبْـهَة مُسْتولِـيَة عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:45",
      "surahNumber": 41,
      "ayahNumber": 45,
      "text": "مريب : مُوقِع في الرّيبة و القلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:47",
      "surahNumber": 41,
      "ayahNumber": 47,
      "text": "أكمامِها : أوْعِـيَـتها\\nآذنـّاك : أخبَرناك و أعْـلمناك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:48",
      "surahNumber": 41,
      "ayahNumber": 48,
      "text": "ظنـّوا : أيقـنوا\\nمحيص : مَهرب و مفرّ من العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:49",
      "surahNumber": 41,
      "ayahNumber": 49,
      "text": "لا يسأم الإنسان : لا يملّ و لا يفـتر\\nدعاء الخير : طَلبه العافية و السّعَة في النّعمة\\nفَـيَـئوس قنوط : من فضل الله و رحمته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:50",
      "surahNumber": 41,
      "ayahNumber": 50,
      "text": "هذا لي : هذا حقـّـي أستحقـّـه بعملي\\nعذاب غليظ : شديد لا يُـفـَـتـّـرُ عنهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:51",
      "surahNumber": 41,
      "ayahNumber": 51,
      "text": "نأى بجانبه : تباعد عن الشكر بكـلـّـيَـتِه تكَـبّرًا\\nدُعَاءٍ عريض : كثيرٍ مسْـتـَـمرّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:52",
      "surahNumber": 41,
      "ayahNumber": 52,
      "text": "أرأيتمْ : أخبروني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:53",
      "surahNumber": 41,
      "ayahNumber": 53,
      "text": "الآفاق : أقطار السّموات و الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "41:54",
      "surahNumber": 41,
      "ayahNumber": 54,
      "text": "مِرْية : شكّ ٍ عَظيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
