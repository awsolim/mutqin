{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 90,
  "entries": [
    {
      "verseKey": "90:1",
      "surahNumber": 90,
      "ayahNumber": 1,
      "text": "I swear by this city [i.e., Makkah] –",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:2",
      "surahNumber": 90,
      "ayahNumber": 2,
      "text": "And you, [O Muḥammad], are free of restriction in this city –",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:3",
      "surahNumber": 90,
      "ayahNumber": 3,
      "text": "And [by] the father and that which was born [of him],",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:4",
      "surahNumber": 90,
      "ayahNumber": 4,
      "text": "We have certainly created man into hardship.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:5",
      "surahNumber": 90,
      "ayahNumber": 5,
      "text": "Does he think that never will anyone overcome him?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:6",
      "surahNumber": 90,
      "ayahNumber": 6,
      "text": "He says, \"I have spent wealth in abundance.\"",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:7",
      "surahNumber": 90,
      "ayahNumber": 7,
      "text": "Does he think that no one has seen him?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:8",
      "surahNumber": 90,
      "ayahNumber": 8,
      "text": "Have We not made for him two eyes?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:9",
      "surahNumber": 90,
      "ayahNumber": 9,
      "text": "And a tongue and two lips?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:10",
      "surahNumber": 90,
      "ayahNumber": 10,
      "text": "And have shown him the two ways?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:11",
      "surahNumber": 90,
      "ayahNumber": 11,
      "text": "But he has not broken through the difficult pass.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:12",
      "surahNumber": 90,
      "ayahNumber": 12,
      "text": "And what can make you know what is [breaking through] the difficult pass?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:13",
      "surahNumber": 90,
      "ayahNumber": 13,
      "text": "It is the freeing of a slave",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:14",
      "surahNumber": 90,
      "ayahNumber": 14,
      "text": "Or feeding on a day of severe hunger",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:15",
      "surahNumber": 90,
      "ayahNumber": 15,
      "text": "An orphan of near relationship",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:16",
      "surahNumber": 90,
      "ayahNumber": 16,
      "text": "Or a needy person in misery",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:17",
      "surahNumber": 90,
      "ayahNumber": 17,
      "text": "And then being among those who believed and advised one another to patience and advised one another to compassion.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:18",
      "surahNumber": 90,
      "ayahNumber": 18,
      "text": "Those are the companions of the right.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:19",
      "surahNumber": 90,
      "ayahNumber": 19,
      "text": "But they who disbelieved in Our signs - those are the companions of the left.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "90:20",
      "surahNumber": 90,
      "ayahNumber": 20,
      "text": "Over them will be fire closed in.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
