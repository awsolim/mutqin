  "language": "ar",
  "direction": "rtl",
  "surahNumber": 59,
  "entries": [
    {
      "verseKey": "59:1",
      "surahNumber": 59,
      "ayahNumber": 1,
      "text": "سبّـح لله : نزّهَه و مَجّـدَهُ تعالى و دلّ عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:2",
      "surahNumber": 59,
      "ayahNumber": 2,
      "text": "الذين كفروا : هو يهود بني النضير قرب المدينة\\nلأوّل الحَشر : في أول إخراج و إجلاء إلى الشام\\nفأتاهم الله : فأتاهم أمره و عقابه\\nلمْ يحتسِبوا : لم يظنوا و لم يخطر لهم ببَال\\nقذف : ألقى و أنزل إنزالا شديدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:3",
      "surahNumber": 59,
      "ayahNumber": 3,
      "text": "الجَلاء : الخروج من الوَطن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:4",
      "surahNumber": 59,
      "ayahNumber": 4,
      "text": "شاقّوا : عادَوْا و عَصَوْا و حادّوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:5",
      "surahNumber": 59,
      "ayahNumber": 5,
      "text": "لِـينة : نخلة . أو نخلة كريمة\\nعلى أصولها : على سوقها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:6",
      "surahNumber": 59,
      "ayahNumber": 6,
      "text": "و ما أفاء الله : و ما ردّ و ما أعادَ\\nفما أوْجَفتم عليه : فما أجْرَيتم على تحصيله\\nركاب : ما يُركب ن الإبل خاصّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:7",
      "surahNumber": 59,
      "ayahNumber": 7,
      "text": "دُولة بين الأغنياء : مِلكا مُتداولا بينهم خاصة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:9",
      "surahNumber": 59,
      "ayahNumber": 9,
      "text": "تـبَـوّءوا الدار و الإيمام : تـَـوَطّـنوا المدينة و أخلصوا الإيمان\\nحاجَة : حَزَازَةً و حَسَدًا\\nخصاصة : فقـْـرٌ و احتياج\\nمنْ يوق : منْ يُجَنّبْ و يُـكْـفَ\\nشحّ نفسه : بُخْـلها مع الحرص على المنع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:10",
      "surahNumber": 59,
      "ayahNumber": 10,
      "text": "غِلاّ : حِقـدًا و بُـغـضـا و غِـشّـا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:14",
      "surahNumber": 59,
      "ayahNumber": 14,
      "text": "بَأسهم بينهم : قتالهم فيما بينهم\\nقلوبهم شتـّـى : متفرقة لتـَـعَاديهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:15",
      "surahNumber": 59,
      "ayahNumber": 15,
      "text": "وَبال أمرهم : سوء عاقبة كفرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:19",
      "surahNumber": 59,
      "ayahNumber": 19,
      "text": "نسوا الله : لمْ يراعوا أوامره و نـَـواهيه\\nفأنـْـساهمْ أنفسهم : فلم يُقـدّموا لها ما ينفعها عنده",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:21",
      "surahNumber": 59,
      "ayahNumber": 21,
      "text": "خاشِعًا : ذليلا خاضعا\\nمتصدّعًا : مُـتـشـقـّــقـا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:23",
      "surahNumber": 59,
      "ayahNumber": 23,
      "text": "المَلِك : المالك لكل شيء المتصرف فيه\\nالقدوس : البَليغ في النـّـزاهة عن الـنّـقائص\\nالسلام : ذو السّـلامة منْ كل عيّب و نقـْص\\nالمؤمن : المصَدّق لرسلِه بالمعجزات\\nالمهيمن : الرقيب على كلّ شيء\\nالعزيز : القوّي الغالب\\nالجبّار : القهار . أو العظيم\\nالمتكبّر : البَليغ الكبرياء و العظمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "59:24",
      "surahNumber": 59,
      "ayahNumber": 24,
      "text": "البارئ : المبدع المخترع\\nالمصوّر : خالق الصّور على ما يريد\\nالأسماء الحسنى : الدّالة على محاسن المعاني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
