{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 84,
  "entries": [
    {
      "verseKey": "84:1",
      "surahNumber": 84,
      "ayahNumber": 1,
      "text": "السماء انشقّـت : انصَدعت عند قيام القيامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:2",
      "surahNumber": 84,
      "ayahNumber": 2,
      "text": "أذنت لربها : اسْـتـمَـعَتْ و انـْـقادَتْ له تعالى\\nحُـقـّـتْ : حَقّ الله عليها الاستماع و الانقـياد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:3",
      "surahNumber": 84,
      "ayahNumber": 3,
      "text": "الأرْض مُدّتْ : بُـسِطتْ و سُـوّيَتْ كمَـدّ الأديم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:4",
      "surahNumber": 84,
      "ayahNumber": 4,
      "text": "ألـْـقـَت ما فـيها : لـَـفـَـظتْ ما في جَوْفِها منَ الموتى\\nتخلـّـتْ : خَـلـت عنه غاية الخُـلـُـوّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:6",
      "surahNumber": 84,
      "ayahNumber": 6,
      "text": "كادِح إلى ربّـك : جاهدٌ في عملك إلى لقاء ربّـك\\nفـمُلاقـيه : فمُـلاقٍ لا محالة جزاء عملك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:11",
      "surahNumber": 84,
      "ayahNumber": 11,
      "text": "يَدْعو ثبورا : يُنادي هَـلاكًـا قائلا يَاثـُـبُـراه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:12",
      "surahNumber": 84,
      "ayahNumber": 12,
      "text": "يَصلى سعيرا : يدْخلها أو يُـقاسي حرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:14",
      "surahNumber": 84,
      "ayahNumber": 14,
      "text": "لنْ يَحور : لن يرْجع إلى ربّـه تكْذيبا بالبَعْث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:16",
      "surahNumber": 84,
      "ayahNumber": 16,
      "text": "فلا أقسِم : \\\"أقسِم و \\\"\\\"لا\\\"\\\" مزيدة \\\"\\nبالشّـفـق : بالحُمْرَة في الأفق بعد الغروب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:17",
      "surahNumber": 84,
      "ayahNumber": 17,
      "text": "ما وَسَق : ما صَمّ و جَمَـعَ ما انتشر بالنـّهار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:18",
      "surahNumber": 84,
      "ayahNumber": 18,
      "text": "اتـّـسق : اجْـتـمَعَ و تكامل و تمّ نوره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:19",
      "surahNumber": 84,
      "ayahNumber": 19,
      "text": "لتـركبنّ : لتـُـلاقُـنّ أيّها النـّاس ( جواب القسم)\\nطبَـقـًـا : أحْوَالا بَعْدَ أحْوَال مُتطابقة في الشّدة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:23",
      "surahNumber": 84,
      "ayahNumber": 23,
      "text": "يوعـون : يُضمِرونه أو يَجمعونه من السّيئات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "84:25",
      "surahNumber": 84,
      "ayahNumber": 25,
      "text": "غيْرُ مَمْـنون : غير مقطوع عنهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
