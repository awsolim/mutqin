  "surahNumber": 83,
  "entries": [
    {
      "verseKey": "83:1",
      "surahNumber": 83,
      "ayahNumber": 1,
      "text": "وَيْـل : عَذابٌ أوْ هَلاك أو وادٍ في جهـنـّـم\\nللمطـفـفين : المُـنقـِـصين في الكـيْـل ، و مثله الوزن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:2",
      "surahNumber": 83,
      "ayahNumber": 2,
      "text": "اكتالوا : اشْتروْا بالكيل ، و مثله الوزن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:3",
      "surahNumber": 83,
      "ayahNumber": 3,
      "text": "كالوهمْ : أعطَوْا غـيرهم بالكيل\\nوَزنوهمْ : أعْطَوْا غـيرهم\\nيُـخْـسِرون : يَنـقـصون الكيل و الوَزن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:6",
      "surahNumber": 83,
      "ayahNumber": 6,
      "text": "لربّ العالمين : لأمره و حكمه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:7",
      "surahNumber": 83,
      "ayahNumber": 7,
      "text": "كَـتاب الفجّـار : ما يُـكتب من أعمالهم\\nلفي سجين : لمُـثـبَـتٌ في ديوان الشّر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:9",
      "surahNumber": 83,
      "ayahNumber": 9,
      "text": "كتابٌ مَرقوم : بَـيّـن الكتابة أو معلـّـم بعلامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:12",
      "surahNumber": 83,
      "ayahNumber": 12,
      "text": "مُعْـتدٍ : فاجر مُتجاوز عن نـَـهْج الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:13",
      "surahNumber": 83,
      "ayahNumber": 13,
      "text": "أساطير الأوّلين : أباطيلهم المسَـــّطرة في كتبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:14",
      "surahNumber": 83,
      "ayahNumber": 14,
      "text": "كلاّ : رَدْعٌ و زجْرٌ عن قولهم الباطل\\nرانَ على قـلوبهم : غَـلبَ و غَـــّطى عليها أو طبع عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:16",
      "surahNumber": 83,
      "ayahNumber": 16,
      "text": "لصالوا الجحيم : لداخِلوها أو لمقاسو حَرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:18",
      "surahNumber": 83,
      "ayahNumber": 18,
      "text": "كتاب الأبرار : ما يُكتب من أعمالهم\\nلفي عليين : لمُثبت في ديوان الخيْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:23",
      "surahNumber": 83,
      "ayahNumber": 23,
      "text": "الأرائك : الأسِرّة في الحجال(جمع حجلة محركة – بيت يزيّن بالقباب و الأسرة و الستور)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:24",
      "surahNumber": 83,
      "ayahNumber": 24,
      "text": "نضْرة النّعيم : بهجته و رونقه و بَهاءَه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:25",
      "surahNumber": 83,
      "ayahNumber": 25,
      "text": "رَحيق : أجْوَد الخَمْر و أصْـفاه\\nمَختوم : إناؤه حتى يَفـكّه الأبرار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:26",
      "surahNumber": 83,
      "ayahNumber": 26,
      "text": "خِـتامه مسْـك : ختام إنائه المِسْـك بَدَل الــّطين\\nفلـيـتنافس : فـلـيَـتـَـسارعْ . أو فـلـيَسْـتـَـبـِـقْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:27",
      "surahNumber": 83,
      "ayahNumber": 27,
      "text": "مِزَاجُه : ما يُـمْـزَجَ بهِ و يُـخْـلـَـط\\nتسْـنيم : عَـيْـن ٍ عاليةٍ شَرابُـها أشرف شراب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:28",
      "surahNumber": 83,
      "ayahNumber": 28,
      "text": "يَشرَب بها : يَشرَب منها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:30",
      "surahNumber": 83,
      "ayahNumber": 30,
      "text": "يَغامَـزون : يُشيرون إليهم بلأعين استهزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:31",
      "surahNumber": 83,
      "ayahNumber": 31,
      "text": "فـكهين : مُـتـلذذين باستِخفافهم بالمؤمنين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "83:36",
      "surahNumber": 83,
      "ayahNumber": 36,
      "text": "ثـُـوّب الكـفار : جُوزُوا بسُخريّـتهم بالمؤمنين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
