{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 79,
  "entries": [
    {
      "verseKey": "79:1",
      "surahNumber": 79,
      "ayahNumber": 1,
      "text": "و النازعات : (أقسم) الله بالملائكة تنزع أرواح الكفار من أقاصي أجسامهم\\nغرْقا : نـَزعا شديدا مُؤْلما بالغ الغاية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:2",
      "surahNumber": 79,
      "ayahNumber": 2,
      "text": "و الناشطات نشطا : الملائكة تـَـسُـلّ أرواح المؤمنين برفق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:3",
      "surahNumber": 79,
      "ayahNumber": 3,
      "text": "و السابحات سبْـحا : الملائكة تنزل مسرعة لما أمِرتْ به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:4",
      "surahNumber": 79,
      "ayahNumber": 4,
      "text": "فالسابقات سبقا : الملائكة تسبق بالأرواح إلى مستقرّها نارًا أو جَـنّـة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:5",
      "surahNumber": 79,
      "ayahNumber": 5,
      "text": "فالمدبرات أمرا : الملائكة تنزل بالتدبير المأمور به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:6",
      "surahNumber": 79,
      "ayahNumber": 6,
      "text": "يوم ترجف الراجفة : لتبعثنّ (جواب القسم) يَوم تضطرب الأجْرَام بالصيحة الهائلة (نفخة الموت)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:7",
      "surahNumber": 79,
      "ayahNumber": 7,
      "text": "تتبعها الرادفة : نفخة البعث التي تردف الأولى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:8",
      "surahNumber": 79,
      "ayahNumber": 8,
      "text": "واجفة : مُضطربة . أو خائفة وَجلة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:9",
      "surahNumber": 79,
      "ayahNumber": 9,
      "text": "أبصارها خاشعة : ذليلة مُنكسِرة من الفزَع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:10",
      "surahNumber": 79,
      "ayahNumber": 10,
      "text": "في الحافرة : إلى الحالة الأولى (الحياة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:11",
      "surahNumber": 79,
      "ayahNumber": 11,
      "text": "كنا عظاما نخِرة : باليَة مُـتـفـتـّـتة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:12",
      "surahNumber": 79,
      "ayahNumber": 12,
      "text": "كرّة خاسِرة : رَجْعة غابـِـنة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:13",
      "surahNumber": 79,
      "ayahNumber": 13,
      "text": "زجْرة واحدة : صيحة واحدة (نفخة البَعْث)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:14",
      "surahNumber": 79,
      "ayahNumber": 14,
      "text": "همْ بالساهرة : هم أحياءٌ على وجه الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:16",
      "surahNumber": 79,
      "ayahNumber": 16,
      "text": "طوى : اسم الوادى المقـدّس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:17",
      "surahNumber": 79,
      "ayahNumber": 17,
      "text": "طغى : عـتا و تجبّر و كَـفـَر و الطغيان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:18",
      "surahNumber": 79,
      "ayahNumber": 18,
      "text": "تـزكى : تطهّر من الكفر و الطغيان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:20",
      "surahNumber": 79,
      "ayahNumber": 20,
      "text": "الآية الكبرى : معجزة العصا و اليد البيضاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:22",
      "surahNumber": 79,
      "ayahNumber": 22,
      "text": "يَسعى : يَــجـِدّ في الإفساد و المعارضة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:23",
      "surahNumber": 79,
      "ayahNumber": 23,
      "text": "فحَشر : جَمَعَ السّـحَرَة . أو الجُـنـْـد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:25",
      "surahNumber": 79,
      "ayahNumber": 25,
      "text": "نكال . . : عُقوبة . أو بعقوبَة . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:28",
      "surahNumber": 79,
      "ayahNumber": 28,
      "text": "رفع سمكها : جعل ثِـخَـنـَـها مُرْتـَـفِعًـا جهة العلوّ\\nفسوّاها : فجَعَلها مُسْـتـَـوية الخلـْـق بلا عَيْب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:29",
      "surahNumber": 79,
      "ayahNumber": 29,
      "text": "أغطش ليلها : أظلمه\\nأخرج ضحاها : أبْرز نهارها المضيء بالشمس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:30",
      "surahNumber": 79,
      "ayahNumber": 30,
      "text": "دحاها : بَسَطها و أوْسَعها لسُكنى أهلها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:31",
      "surahNumber": 79,
      "ayahNumber": 31,
      "text": "مَرْعاها : أقواتَ الناس و الدّواب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:32",
      "surahNumber": 79,
      "ayahNumber": 32,
      "text": "الجبال أرساها : أثبَتها في الأرض ، كالأوتاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:34",
      "surahNumber": 79,
      "ayahNumber": 34,
      "text": "الطامة الكبرى : الدّاهـية العظمى (القيامة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:36",
      "surahNumber": 79,
      "ayahNumber": 36,
      "text": "بُرزت الجحيم : أظْهِرَتْ إظهارًا بَيّـنـًـا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:39",
      "surahNumber": 79,
      "ayahNumber": 39,
      "text": "هي المأوى : هي المرْجع و المُقام له لا غيرها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "79:42",
      "surahNumber": 79,
      "ayahNumber": 42,
      "text": "أيان مرساها؟ : متى يقيمها الله و يُثبتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
