{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 18,
  "entries": [
    {
      "verseKey": "18:1",
      "surahNumber": 18,
      "ayahNumber": 1,
      "text": "لم يجعل له عوجا : اختلالا و لا اختلافا و لا انحرافاعن الحقّ و لا خروجا عن الحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:2",
      "surahNumber": 18,
      "ayahNumber": 2,
      "text": "قيِّما : مُستقيما معتدلا أو بمصالح العباد\\nبأسا : عذابًا آجلا أو عاجلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:5",
      "surahNumber": 18,
      "ayahNumber": 5,
      "text": "كبُرت كلمة : ما أعْظمَها في القُبح كلمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:6",
      "surahNumber": 18,
      "ayahNumber": 6,
      "text": "باخع نفسك : قاتِلها و مُهلِكها أو مُجهدُها\\nأسفا : غصبا. و حُزنا عليهم أو غيظا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:7",
      "surahNumber": 18,
      "ayahNumber": 7,
      "text": "لِنبلوهم : لِنختبرَهم مع علمنا بحالهم\\nأحسن عملا : أزهد فيها و أسرع في طاعتِنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:8",
      "surahNumber": 18,
      "ayahNumber": 8,
      "text": "صعيدا جُرزا : تُرابا أجْرَد لا نبات فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:9",
      "surahNumber": 18,
      "ayahNumber": 9,
      "text": "أم حسبت : بل أظنَنْـتَ\\nأصحاب الكهف : النّقب المُتسع في الجبل\\nالرّقيم : اللوح فيه أسماؤهم و قصّتهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:10",
      "surahNumber": 18,
      "ayahNumber": 10,
      "text": "أوى الفتية : التجئوا هَرَبا بِدِينهم . .\\nرشدا : اهتداءً إلى طريق الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:11",
      "surahNumber": 18,
      "ayahNumber": 11,
      "text": "فضربنا على آذانهم : أنمناهم إنامة ثقيلةً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:12",
      "surahNumber": 18,
      "ayahNumber": 12,
      "text": "بعثناهم : أيقظناهم من نومهم\\nأمدا : مدّة و عدد سِنين أو غاية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:14",
      "surahNumber": 18,
      "ayahNumber": 14,
      "text": "ربطنا : شدَدْنا و قوّينا بالصّبر\\nشططا : قولا مُفرطافي البعد عن الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:16",
      "surahNumber": 18,
      "ayahNumber": 16,
      "text": "مرفقا : ما تنتفعون به في عيشكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:17",
      "surahNumber": 18,
      "ayahNumber": 17,
      "text": "تزاور : تميل و تعدل\\nتقرضهم : تعدِلُ عنهم و تبتعد\\nفجوة منه : مُتسع من الكهف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:18",
      "surahNumber": 18,
      "ayahNumber": 18,
      "text": "بالوصيد : بفِناء الكهف أو عتبة بابه\\nرُعبا : خوفا و فزعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:19",
      "surahNumber": 18,
      "ayahNumber": 19,
      "text": "بعثناهم : أيقظناهم من نومتهم الطّويلة\\nبوَرقكم : بدارهمكم المضروبة\\nأزكى طعاما : أحلّ، أو أجود طعاما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:20",
      "surahNumber": 18,
      "ayahNumber": 20,
      "text": "يظهروا عليكم : يطّلعوا عليكم أو يغلبوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:21",
      "surahNumber": 18,
      "ayahNumber": 21,
      "text": "أعثرنا عليهم : أطلَعنا النّاس عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:22",
      "surahNumber": 18,
      "ayahNumber": 22,
      "text": "رجما بالغيب : قذفًا بالظّن غير يقين\\nفلا تمارفيهم : فلا تُجادل في عدّتهم و شأنهم\\nإلا مراء ظاهرا : بمجرّد تلاوة ما أوحي إليك في أمرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:24",
      "surahNumber": 18,
      "ayahNumber": 24,
      "text": "رشدا : هداية و إرشادًا للنّاس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:26",
      "surahNumber": 18,
      "ayahNumber": 26,
      "text": "أبصر به : ما أبصر الله بكلّ موجود",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:27",
      "surahNumber": 18,
      "ayahNumber": 27,
      "text": "مُلتحدا : مَلجأ و مَوْئلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:28",
      "surahNumber": 18,
      "ayahNumber": 28,
      "text": "اصبر نفسك : احبسْها و ثبّتها\\nلا تعد عيناك عنهم : لا تصرف عيناك النّظر عنهم\\nأغفلنا قلبه : جعلناه غافلا ساهيًا\\nفرُطا : إسرافًا . أو تضْييعا و هلاكا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:29",
      "surahNumber": 18,
      "ayahNumber": 29,
      "text": "سُرادقها : فُسْطاطُها . أو لهبُها و دُخانها\\nكَالمهل : كدُرديّ الزّيت أو كالمُذاب من المعادن\\nساءت مُرتفقا : متّكأ أو مقرّا (النّار)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:31",
      "surahNumber": 18,
      "ayahNumber": 31,
      "text": "جنات عَدْن : جنات إقامة و إستقرار\\nسُندس : رقيق الدّيباج (الحرير)\\nإستبرق : غليظ الدّيباج\\nالأرائك : السّرُر في الحجال (جمع حجلة محركة – بيت يزين بالثياب و الأسرّة و الستور)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:32",
      "surahNumber": 18,
      "ayahNumber": 32,
      "text": "جنّتين : بُستانين\\nحففناهُما : أحطناهما و أطفناهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:33",
      "surahNumber": 18,
      "ayahNumber": 33,
      "text": "أُكُلها : ثمرها الذي يُؤكل\\nلم تظلم منه : لم تنقص من أُكُلها\\nفجّرنا خِلالهما : شقـَقـْنا و أجْرَينا وسَطهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:34",
      "surahNumber": 18,
      "ayahNumber": 34,
      "text": "ثمرٌ : أموالٌ كثيرة مُثمّرة\\nأعزّ نفرا : أقوى أعوانا أو عشيرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:35",
      "surahNumber": 18,
      "ayahNumber": 35,
      "text": "تبيد : تهلك و تفنى و تخرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:36",
      "surahNumber": 18,
      "ayahNumber": 36,
      "text": "مُنقلبا : مرْجعا و عاقِيةً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:38",
      "surahNumber": 18,
      "ayahNumber": 38,
      "text": "لكنّا هو الله ربّي : لكنْ أنا أقول: هو الله ربّي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:40",
      "surahNumber": 18,
      "ayahNumber": 40,
      "text": "حُسبانا : عذابا كالصّواعق و الآفات\\nفتُصبح صعيدا زلقا : رمْلا هائلا أو أرضا جُرُزا لا نبات فيها يُزلق عليها لِملاسَتِها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:41",
      "surahNumber": 18,
      "ayahNumber": 41,
      "text": "غورا : غائرا ذاهبا في الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:42",
      "surahNumber": 18,
      "ayahNumber": 42,
      "text": "أحيط بثمره : أُهلكت أمواله مع جنّــتـيْه\\nيُقلّب كفّيه : كِماية عن النّدم و التّحسّر\\nخاوية على عُرُوشها : ساقطة على سُقوفها التي سَقطت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:44",
      "surahNumber": 18,
      "ayahNumber": 44,
      "text": "الولاية لله : النّصرة له تعالى وحده\\nخيرٌ عقبا : عاقبة لأوليائه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:45",
      "surahNumber": 18,
      "ayahNumber": 45,
      "text": "هشيما : يابسا متفتّتا بعد نضارته\\nتذروه الرّياح : تُفرّقه و تنسِفه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:47",
      "surahNumber": 18,
      "ayahNumber": 47,
      "text": "بارزة : ظاهرة لا يسترها شيء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:48",
      "surahNumber": 18,
      "ayahNumber": 48,
      "text": "موعدا : وقتا لإنجازنا الوعد بالبعث و الجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:49",
      "surahNumber": 18,
      "ayahNumber": 49,
      "text": "وُضع الكتاب : صُحُف الأعمال في أيدي أصحابها\\nمُشفقين : خائفين وَجلين\\nيا ويلتنا : يا هلاكنا\\nلا يُغادر : لا يترُك و لا يُبقي\\nأحصاها : عدّها و ضبطها و أثبتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:50",
      "surahNumber": 18,
      "ayahNumber": 50,
      "text": "اسجدوا لآدم : سجود تحية و تعظيم لا عبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:51",
      "surahNumber": 18,
      "ayahNumber": 51,
      "text": "عضُدا : أعوانا و أنصارا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:52",
      "surahNumber": 18,
      "ayahNumber": 52,
      "text": "مَوْبقا : مهلِكا يشتركون فيه و هو النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:53",
      "surahNumber": 18,
      "ayahNumber": 53,
      "text": "مُواقعوها : واقعون فيها أو داخلون فيها\\nمصرفا : معدلا و مكانا ينصرفون إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:54",
      "surahNumber": 18,
      "ayahNumber": 54,
      "text": "صرّفنا : كرّرنا بأساليب مُختلفة\\nكلّ مثل : معنى غريب بديع كالمثل في غرابته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:55",
      "surahNumber": 18,
      "ayahNumber": 55,
      "text": "سنّة الأوّلين : عذاب الاستئصال إذا لم يُؤمنوا\\nقُبُلا : أنواعا و ألوانا أو عيانا و مقابلة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:56",
      "surahNumber": 18,
      "ayahNumber": 56,
      "text": "لِيدخضوا : لِيبطلوا و يُـزيلوا\\nهُـزوا : استهزاء و سُخريّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:57",
      "surahNumber": 18,
      "ayahNumber": 57,
      "text": "أكنّة . . : أغطية كثيرة مانعة . .\\nوقرا : صممًا و ثقلا في السّمع عظيما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:58",
      "surahNumber": 18,
      "ayahNumber": 58,
      "text": "موئِلا : منجى و ملجأ و مخلصا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:59",
      "surahNumber": 18,
      "ayahNumber": 59,
      "text": "لمَهلِكهم : لهلاكهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:60",
      "surahNumber": 18,
      "ayahNumber": 60,
      "text": "لِفتاه : يوشع بن نون\\nمجمع البحرين : مُلتقاهما\\nأمضي حُقبا : أَسيرَ زمانا طويلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:61",
      "surahNumber": 18,
      "ayahNumber": 61,
      "text": "سَربا : مسلكا و منفذا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:62",
      "surahNumber": 18,
      "ayahNumber": 62,
      "text": "نصَبا : تعبا و شدّة و إعياءً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:63",
      "surahNumber": 18,
      "ayahNumber": 63,
      "text": "أرأيت : أخبرني . أو تنبّه و تذكّرْ\\nأوينا : إلتجأنا\\nعجبا : سبيلا أو اتّخاذا يُتعجّب منه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:64",
      "surahNumber": 18,
      "ayahNumber": 64,
      "text": "ماكنّا نبغِ : الذي كنّا نطلُبُه و نَلتمسه\\nفارتدّا على آثارهما : رجعا على طريقهما الذي جاءا منه\\nقصصا : يقصّان آثارهما و يتّبعانها اتّباعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:65",
      "surahNumber": 18,
      "ayahNumber": 65,
      "text": "عبْدا : الخضر عليه السّلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:66",
      "surahNumber": 18,
      "ayahNumber": 66,
      "text": "رُشدا : صوابا . أو إصابة خيْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:68",
      "surahNumber": 18,
      "ayahNumber": 68,
      "text": "خُبرا : علما و معرفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:71",
      "surahNumber": 18,
      "ayahNumber": 71,
      "text": "شيئا إمرا : أمرا عظيما مُنكرا أو عجبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:73",
      "surahNumber": 18,
      "ayahNumber": 73,
      "text": "لا تُرهقني : لا تغشني و لا تُحمّلني\\nعُسرا : صُعوبة و مشقّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:74",
      "surahNumber": 18,
      "ayahNumber": 74,
      "text": "شيئا نُكرا : مُنكرا فظيعا جدّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:77",
      "surahNumber": 18,
      "ayahNumber": 77,
      "text": "فأبوْا : فامتنعوا\\nينْقضّ : ينهدم و يسقط بسرعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:78",
      "surahNumber": 18,
      "ayahNumber": 78,
      "text": "بتأويل . . : بمآل و عاقبة . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:79",
      "surahNumber": 18,
      "ayahNumber": 79,
      "text": "وراءهم : أمامهم و بين أيديهم\\nغَصبا : استلابا بغير حق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:80",
      "surahNumber": 18,
      "ayahNumber": 80,
      "text": "يُرهقهما : يُكلّفهما أو يُغشيهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:81",
      "surahNumber": 18,
      "ayahNumber": 81,
      "text": "زكاة : طهارة من السّوء أو دينا و صلاحا\\nأقرب رُحما : رحمة عليهما و برّا بهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:82",
      "surahNumber": 18,
      "ayahNumber": 82,
      "text": "يبلغا أشدّهما : قوّتهما و شدّتهما و كمال عقلهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:83",
      "surahNumber": 18,
      "ayahNumber": 83,
      "text": "ذي القرنين : ملك صالح أُعطي العلم و الحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:84",
      "surahNumber": 18,
      "ayahNumber": 84,
      "text": "سببا : علما و طريقا يُوصّله إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:85",
      "surahNumber": 18,
      "ayahNumber": 85,
      "text": "فأتبَعَ سببا : سلك طريقا يُوَصّله إلى المغرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:86",
      "surahNumber": 18,
      "ayahNumber": 86,
      "text": "تغرُب في عين : بحسب رأي العين\\nحَمِئة : ذات حمأة (الطّين الأسود)\\nحسنا : هو الدّعوة إلى الحقّ و الهدى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:87",
      "surahNumber": 18,
      "ayahNumber": 87,
      "text": "عذابا نكرا : منكرا فظيعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:90",
      "surahNumber": 18,
      "ayahNumber": 90,
      "text": "سِترا : ساترا من اللّباس و البناء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:91",
      "surahNumber": 18,
      "ayahNumber": 91,
      "text": "خُبرا : علما شاملا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:93",
      "surahNumber": 18,
      "ayahNumber": 93,
      "text": "السّدّين : جبلين مُنيفين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:94",
      "surahNumber": 18,
      "ayahNumber": 94,
      "text": "يأجوج و مأجوج : قبيلتين من ذرية يافث بن نوح\\nخَرْجَا : جُعلا من المال تستعين به في البناء\\nسدّا : حاجزا فلا يصلون إلينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:95",
      "surahNumber": 18,
      "ayahNumber": 95,
      "text": "ردْمَا : حاجزا حصينا متينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:96",
      "surahNumber": 18,
      "ayahNumber": 96,
      "text": "زُبر الحديد : قِطعه العظيمة الضخمة\\nالصّدفين : جانبي الجبلين\\nقِطرا : نُحاسًا مُذابا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:97",
      "surahNumber": 18,
      "ayahNumber": 97,
      "text": "يظْهروه : يعلوا على ظهره لارتفاعه\\nنقبا : خرقا و ثقبا لصلابته و ثخانته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:98",
      "surahNumber": 18,
      "ayahNumber": 98,
      "text": "جعله دكّاء : مدكوكا مُسوّى بالأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:99",
      "surahNumber": 18,
      "ayahNumber": 99,
      "text": "يموج : يختلط و يضطرب\\nنُفِخ في الصّور : نفخة البعث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:101",
      "surahNumber": 18,
      "ayahNumber": 101,
      "text": "غِطاء : غشاء غليظ و ستر كثيف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:102",
      "surahNumber": 18,
      "ayahNumber": 102,
      "text": "نُـزلا : منزلا أو شيئا يتمتّعون به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:105",
      "surahNumber": 18,
      "ayahNumber": 105,
      "text": "وزنا : مقدرا و اعتبارا لحبوط أعمالهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:107",
      "surahNumber": 18,
      "ayahNumber": 107,
      "text": "الفردوس : أعلى الجنّة و أوسطها و أفضلها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:108",
      "surahNumber": 18,
      "ayahNumber": 108,
      "text": "حِوَلا : تحوّلا و انتقالا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "18:109",
      "surahNumber": 18,
      "ayahNumber": 109,
      "text": "مِدادًا : هو المّادة التي يكتب بها\\nلِكلِمات ربّي : معلوماته و حكمته تعالى\\nلَنَفِدَ البحر : فنيَ و فَزع\\nمَدَدًا : عونا و زيادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
