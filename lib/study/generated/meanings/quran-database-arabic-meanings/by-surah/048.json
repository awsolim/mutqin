  "language": "ar",
  "direction": "rtl",
  "surahNumber": 48,
  "entries": [
    {
      "verseKey": "48:1",
      "surahNumber": 48,
      "ayahNumber": 1,
      "text": "فتحا مبينا : هو صُـلح الحديبية عام 6 هـ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:4",
      "surahNumber": 48,
      "ayahNumber": 4,
      "text": "السكينة : السكون و الطمأنينة و الثبات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:6",
      "surahNumber": 48,
      "ayahNumber": 6,
      "text": "ظن السوْء : ظنّ الأمر الفاسد المذموم\\nعليهم دائرة السّوْء : دعاءٌ عليهم بالهلاك و الدّمار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:9",
      "surahNumber": 48,
      "ayahNumber": 9,
      "text": "تعزروه : تـَـنصروه تعالى بنصْرَة دينه\\nتوقّـروه : تعظّموه تعالى و تبجّـلوه\\nتسبّحوه : تنزّهوه عما لا يليق بجلاله\\nبكرة و أصيلا : غدوة و عشيّـا، أو جميع النّهار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:10",
      "surahNumber": 48,
      "ayahNumber": 10,
      "text": "نـَـكثَ : نـَـقـَـض البيعة و العَهْد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:11",
      "surahNumber": 48,
      "ayahNumber": 11,
      "text": "المخلـّـفون : عن صحْبتك في عمرة الحديبية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:12",
      "surahNumber": 48,
      "ayahNumber": 12,
      "text": "لنْ يَنـْقلب : لن يعود إلى المدينة\\nقوْمًا بُورا : هالكين أو فاسدين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:15",
      "surahNumber": 48,
      "ayahNumber": 15,
      "text": "ذرونا نتـّبعكم : اتـْركونا نخرجْ معكم لخيْـبَـر\\nكلام الله : حُكمَهُ باختصاص أهل الحديبية بالمغانم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:16",
      "surahNumber": 48,
      "ayahNumber": 16,
      "text": "أولي بأس شديد : أصحاب شدّة و قوّة في الحَرْب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:17",
      "surahNumber": 48,
      "ayahNumber": 17,
      "text": "حَرَجٌ : إثم في التخلّـف عن الجهاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:18",
      "surahNumber": 48,
      "ayahNumber": 18,
      "text": "يبايعونك : بَيْعة الرضوان بالحديبيّة\\nفتحا قريبا : فتح خيبر عام سبع ٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:21",
      "surahNumber": 48,
      "ayahNumber": 21,
      "text": "أحاط الله بها : أعدّها لكم أو حَفظها لكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:24",
      "surahNumber": 48,
      "ayahNumber": 24,
      "text": "ببطن مكّة : بالحديبية قرب مكّة\\nأظفركم عليهم : أظهركم عليهم و أعلاكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:25",
      "surahNumber": 48,
      "ayahNumber": 25,
      "text": "الهدْيَ : البُدْن التي سَاقها الرسول صلى الله عليه و سلم\\nمَعْكوفا : مَحْبوسًا\\nمَحلـّـه : المكان الذي يحلّ فيه نحرُه\\nتطئوهم : تـُـهلكوهمْ مَعَ الكفـار\\nمَعَرّة : مَكروهٌ و مشقّة، أو سُـبّـة\\nتزيّـلوا : تميّـزوا من الكفارفي مكة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:26",
      "surahNumber": 48,
      "ayahNumber": 26,
      "text": "الحميّة : الأنفة و الغضب الشديد\\nسكينته : الإطمئنان و الوقار\\nكلمة التقوى : كلمة التوحيد و الإخلاص",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:27",
      "surahNumber": 48,
      "ayahNumber": 27,
      "text": "فتحا قريبا : صلح الحديبية أو فتح خيبر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:28",
      "surahNumber": 48,
      "ayahNumber": 28,
      "text": "ليُظهرَه : لِـيعليَه و يُقوّيَه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "48:29",
      "surahNumber": 48,
      "ayahNumber": 29,
      "text": "سِـماهم : علامَتهُمْ\\nمَثـلهمْ : وَصْـفهم العجيب\\nأخرَج شطـْـأه : فِرَاخه المتفرّعة في جوانبه\\nفآزره : فقوّى ذلك الشّطء الزّرع\\nفاسْتغلظ : فصار غليظا\\nفاستوى على سوقه : فاستقام على أصوله و جُذوعِه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
