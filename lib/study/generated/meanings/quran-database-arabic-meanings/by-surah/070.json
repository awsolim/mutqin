{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 70,
  "entries": [
    {
      "verseKey": "70:1",
      "surahNumber": 70,
      "ayahNumber": 1,
      "text": "سَأل سائل : دَعَـا دَاع على نـَـفـسِه و قوْمِه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:3",
      "surahNumber": 70,
      "ayahNumber": 3,
      "text": "ذي المعارج : ذي السّمـوات مَصَـاعِـد الملائكة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:4",
      "surahNumber": 70,
      "ayahNumber": 4,
      "text": "تعرُج الملائكة : تصْعَـدُ في تلك المعارج\\nالرّوح : جبريل عليه السلام\\nفي يوم : هو يوم القيامة\\nمِقداره : في حقّ الكفار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:5",
      "surahNumber": 70,
      "ayahNumber": 5,
      "text": "صَبْرًَا جميلا : لا شكوى فيه لغيْره تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:8",
      "surahNumber": 70,
      "ayahNumber": 8,
      "text": "السّماء كالمُهل : كالمعدن المُذاب أو دُرْدُريّ الزّيت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:9",
      "surahNumber": 70,
      "ayahNumber": 9,
      "text": "الجبال كالعِهن : كالصّوف المصبوغ ألوانا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:10",
      "surahNumber": 70,
      "ayahNumber": 10,
      "text": "حَميم : قريبٌ مُشْـفـقٌ لِشدّة الهَوْل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:11",
      "surahNumber": 70,
      "ayahNumber": 11,
      "text": "يُـبـَصّرونهم : يُعَرَّف الأحْماء أحْمَاءَهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:13",
      "surahNumber": 70,
      "ayahNumber": 13,
      "text": "فَصيلته : عشيرته الأقربين المنفصل عنهم\\nتـُـؤويه : تـَـضمّه في النّسَـب . أو عِـند الشدّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:15",
      "surahNumber": 70,
      "ayahNumber": 15,
      "text": "إنّها لظى : جَهنّم . أو الدركة الثانية مِنـْـها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:16",
      "surahNumber": 70,
      "ayahNumber": 16,
      "text": "نـَـزّاعة للشّوى : قلاّعة للأطراف أوْ جلدِ الرّأس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:18",
      "surahNumber": 70,
      "ayahNumber": 18,
      "text": "فأوْعى : أمْسَك ما له في وعاءٍ حرصًـا و تأميلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:19",
      "surahNumber": 70,
      "ayahNumber": 19,
      "text": "هلوعًـا : كثيرَ الجَزَعَ ، شديد الحِرْص",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:20",
      "surahNumber": 70,
      "ayahNumber": 20,
      "text": "جَزوعًـا : كثيرَ الجَزَعِ و الأسَى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:21",
      "surahNumber": 70,
      "ayahNumber": 21,
      "text": "مَنوعًا : كثيرَ المَنـْـعِ و الإمساك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:25",
      "surahNumber": 70,
      "ayahNumber": 25,
      "text": "المَحْروم : مِنَ العَطاء لتعفـّـفهِ عَنِ السّؤال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:27",
      "surahNumber": 70,
      "ayahNumber": 27,
      "text": "مُشفِـقـون : خائفون اسْـتِعظامًا لله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:31",
      "surahNumber": 70,
      "ayahNumber": 31,
      "text": "العادون : المُـجَاوزون الحلال إلى الحَرَام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:36",
      "surahNumber": 70,
      "ayahNumber": 36,
      "text": "مُهطِعين : مُسْرعين ، مادّي أعْناقِهم إليك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:37",
      "surahNumber": 70,
      "ayahNumber": 37,
      "text": "عِزين : جماعات مُتفرقين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:39",
      "surahNumber": 70,
      "ayahNumber": 39,
      "text": "ممّا يعلمون : مِنْ نُطفٍ مَهينـَـة مَذِرَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:40",
      "surahNumber": 70,
      "ayahNumber": 40,
      "text": "فلا أقسمُ : \\\"أقْـسِم . و \\\"\\\"لا\\\"\\\" مزيدة \\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:41",
      "surahNumber": 70,
      "ayahNumber": 41,
      "text": "بمَسْبوقين : مَغْـلوبين عاجزين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:42",
      "surahNumber": 70,
      "ayahNumber": 42,
      "text": "فَـذرْهُم : فدعْهُم و خَـلّـهمْ غير مُـكْـترثٍ بهم\\nيَخوضوا : يَنغمِسُوا في باطلِهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:43",
      "surahNumber": 70,
      "ayahNumber": 43,
      "text": "مِنَ الأجداث : مِنَ القـبُور\\nسِراعًـا : مُسْرعـين إلى الدّاعي\\nنُصُب : أحْجَار عَـــّظموها في الجاهلية\\nيوفِضون : يُسْرعون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "70:44",
      "surahNumber": 70,
      "ayahNumber": 44,
      "text": "خاشِعة أبْصارُهم : ذليلة مُنـْـكسِرة لا يَرْفَعونها\\nترْهَقهم ذلـّـة : تغْـشاهمْ مَهَانة شديدة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
