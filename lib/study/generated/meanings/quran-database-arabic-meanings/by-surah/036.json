{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 36,
  "entries": [
    {
      "verseKey": "36:7",
      "surahNumber": 36,
      "ayahNumber": 7,
      "text": "لقد حقّ القول : و اللهِ لقد ثبت ووجب العقاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:8",
      "surahNumber": 36,
      "ayahNumber": 8,
      "text": "أغلالا : قيودا تشدّ أيديهم إلى أعناقهم\\nغهم مقمحون : رافعوا الرّءوس غاضّوا الأبصار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:9",
      "surahNumber": 36,
      "ayahNumber": 9,
      "text": "سدّا : حاجزا و مانِعا\\nفأغشيناهم : فألبسنا أبصارهم غشاوة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:12",
      "surahNumber": 36,
      "ayahNumber": 12,
      "text": "آثارهم : ما سنّوه من حسن أو سيّء\\nأحصيناه : أثبتناه و حفظناه\\nإمام مبين : أصل بيّن (اللوح المحفوظ)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:13",
      "surahNumber": 36,
      "ayahNumber": 13,
      "text": "القرية : أنطاكية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:14",
      "surahNumber": 36,
      "ayahNumber": 14,
      "text": "فعززنا بثالث : فقوّيناهما و شددناهما به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:18",
      "surahNumber": 36,
      "ayahNumber": 18,
      "text": "تطيّرنا بكم : تشاءمنا بكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:19",
      "surahNumber": 36,
      "ayahNumber": 19,
      "text": "طائركم معكم : شؤمكم كُفركم المصاحب لكم\\nأئن ذكّرتم : أئن وُعِـظتم تطيّرتم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:20",
      "surahNumber": 36,
      "ayahNumber": 20,
      "text": "يسعى : يُسرع في مشيه لنصح قومه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:22",
      "surahNumber": 36,
      "ayahNumber": 22,
      "text": "فطرني : خلقني و أبدعني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:23",
      "surahNumber": 36,
      "ayahNumber": 23,
      "text": "لا تغن عنّي : لا تدفع عنّي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:29",
      "surahNumber": 36,
      "ayahNumber": 29,
      "text": "صيحة واحدة : صوتـًا مُهلكًا من السّماء\\nخامدون : مَيّـتون كما تخمد النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:30",
      "surahNumber": 36,
      "ayahNumber": 30,
      "text": "يا حسرة : يا وَيْلاً . أو يا تـَـنـَـدّماً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:31",
      "surahNumber": 36,
      "ayahNumber": 31,
      "text": "كم أهلكنا : كثيرا أهلكنا\\nالقرون : الأمم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:32",
      "surahNumber": 36,
      "ayahNumber": 32,
      "text": "لمّا جميع : إلا مجموعون\\nمُحضرون : نحضرهم للحساب و الجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:34",
      "surahNumber": 36,
      "ayahNumber": 34,
      "text": "فجّرنا فيها : شققنا في الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:36",
      "surahNumber": 36,
      "ayahNumber": 36,
      "text": "خلق الأزواج : الأصناف و الأنواع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:37",
      "surahNumber": 36,
      "ayahNumber": 37,
      "text": "نسلخ منه النّهار : ننزع من مكانه الضّوْء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:39",
      "surahNumber": 36,
      "ayahNumber": 39,
      "text": "قدّرناه منازل : قـدّرنا سيره في منازل و مسافات\\nكالعرجون القديم : كعود عِـذ ْق النّخلة العتيق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:40",
      "surahNumber": 36,
      "ayahNumber": 40,
      "text": "ولا اللّيل : و لا آية الليل (القمر)\\nسابق النّهار : سابق آية النهار (الشمس)\\nيسبحون : يسيرون بانبساط أو يدورون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:41",
      "surahNumber": 36,
      "ayahNumber": 41,
      "text": "ذرّيّتهم : أولادهم و ضعفاءَهم\\nالمشحون : المملوءِ المُوقر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:43",
      "surahNumber": 36,
      "ayahNumber": 43,
      "text": "فلا صريخ لهم : فلا مغيث لهم من الغَرَق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:49",
      "surahNumber": 36,
      "ayahNumber": 49,
      "text": "صيحة واحدة : نفخة الموت\\nهم يخِصّمون : يخْتصِمون في أمورهم غافلين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:51",
      "surahNumber": 36,
      "ayahNumber": 51,
      "text": "نفخ في الصّور : نفخة البَعْث\\nالأجداث : القبور . .\\nينسلون : يُسرعون في الخروج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:53",
      "surahNumber": 36,
      "ayahNumber": 53,
      "text": "صيحة واحدة : نفخة البعث\\nمُحضرون : نحضِرُهم للحساب و الجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:55",
      "surahNumber": 36,
      "ayahNumber": 55,
      "text": "شُغُلٍ : نعيم عظيم يُلهيهمْ عمّا سواه\\nفاكهون : مُتلذذون. أو فَرحون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:56",
      "surahNumber": 36,
      "ayahNumber": 56,
      "text": "الأرائك : السّرر في الحِجال (جمع حجلة محركة- بيت يزين بالثياب و الأسرّة و الستور)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:57",
      "surahNumber": 36,
      "ayahNumber": 57,
      "text": "لهم ما يدّعون : ما يتمنّونه أو ما يطلبونه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:59",
      "surahNumber": 36,
      "ayahNumber": 59,
      "text": "امتازوا : تميّزوا و انفردوا عن المؤمنين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:60",
      "surahNumber": 36,
      "ayahNumber": 60,
      "text": "أعْهَدْ إليكم : أوصِكمْ. أو أكلـّـفكمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:62",
      "surahNumber": 36,
      "ayahNumber": 62,
      "text": "جـِــبـِـلاّ : خلقـًـا . أو جماعة عظيمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:64",
      "surahNumber": 36,
      "ayahNumber": 64,
      "text": "اصلوها : ادخلوها . أو قاسوا حرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:66",
      "surahNumber": 36,
      "ayahNumber": 66,
      "text": "لطمسنا : لصيّرناها ممسوحة لا يُرى لها شق\\nفاستبقوا الصّراط : ابْتـَـدروا الطّريق ليَجوزوه\\nفأنّى يبصرون ؟ : فكيف يُبصرون الطريق؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:67",
      "surahNumber": 36,
      "ayahNumber": 67,
      "text": "على مكانتهم : في مكان معاصيهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:68",
      "surahNumber": 36,
      "ayahNumber": 68,
      "text": "من نعمّره : نطِلْ عُمُرَه\\nننكّسه في الخلق : نرُدّه إلى أرذل العمر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:72",
      "surahNumber": 36,
      "ayahNumber": 72,
      "text": "ذلـّـلناها لهم : صيّرناها مسخّرة مُنقادة لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:75",
      "surahNumber": 36,
      "ayahNumber": 75,
      "text": "و هم لهم جند مُحضرون : و الأصنام جُندٌ مُعَدّون للكفار نحضِرْهم معهم في النّار لعذابهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:77",
      "surahNumber": 36,
      "ayahNumber": 77,
      "text": "هو خصيم : مُبالغ في الخصومة بالباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:78",
      "surahNumber": 36,
      "ayahNumber": 78,
      "text": "هي رميم : بالية أشدّ البلى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:81",
      "surahNumber": 36,
      "ayahNumber": 81,
      "text": "بلى : هو قادر على خلق مثلهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "36:83",
      "surahNumber": 36,
      "ayahNumber": 83,
      "text": "ملكوت : هو المُـلـْـك التـّـام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
