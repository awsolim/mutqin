  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 76,
  "entries": [
    {
      "verseKey": "76:2",
      "surahNumber": 76,
      "ayahNumber": 2,
      "text": "أمشاج : أخلاط ممتزجة مُتباينـَـة الصّـفات\\nنبتليه : مُتبَلين له بالتّكاليف فيما بعد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:3",
      "surahNumber": 76,
      "ayahNumber": 3,
      "text": "هديناه السّبيل : بيّـنا له طريق الهداية و الضّلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:4",
      "surahNumber": 76,
      "ayahNumber": 4,
      "text": "سلاسل : بها يُقادون و في النّار يُسحبون\\nأغلالا : بها تـُـجْمَع أيديهم إلى أعناقهم و يُقـيّدون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:5",
      "surahNumber": 76,
      "ayahNumber": 5,
      "text": "كأس : خَمْر أو زُجاجة فيها خَمر\\nمزاجُها : ما تـُمـْـزَج الكأس به و تـُخْـلـَط\\nكافورا : ماءً كالكافور في أحسن أوصافه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:6",
      "surahNumber": 76,
      "ayahNumber": 6,
      "text": "عيْنا : ماءَ عَـيْن أو خَمْر عيْن\\nيَشرب بها : يَشرب منها . أو يَرتوي بها\\nيُـفجّرونها : يُجْرونها حيث شاءوا من منازلهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:7",
      "surahNumber": 76,
      "ayahNumber": 7,
      "text": "مستطِرا : فاشِيًـا مُنتشِرًا غاية الإنتشار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:10",
      "surahNumber": 76,
      "ayahNumber": 10,
      "text": "يوما عبوسا : تـَـكْـلـَحُ فيه الوُجُوه لِهَوْله\\nقمطريرا : شديد العُبوس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:11",
      "surahNumber": 76,
      "ayahNumber": 11,
      "text": "لقـّـاهم نضرة : أعطاهُم حُسْـنـًا و بَهْجَة في الوُجوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:13",
      "surahNumber": 76,
      "ayahNumber": 13,
      "text": "الأرائك : السّرُر في الحِجال(جمع حِجلة مُحرّكة- بيت يُزيّن بالقـِباب و الأسِرّة و السّـتور)\\nزمهريرا : بَرْدًا شديدا . أو قَمَرًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:14",
      "surahNumber": 76,
      "ayahNumber": 14,
      "text": "دانِية عليهم ظلالها : قريبة منهم ظلال أشجارها\\nذلـّلتْ قطوفها : قُرّبت ثِمارُها لمتناولِها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:15",
      "surahNumber": 76,
      "ayahNumber": 15,
      "text": "أكواب : أقداح بلا عرى و خراطيم\\nقوارير : كالزّجاجات في الصّـفاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:16",
      "surahNumber": 76,
      "ayahNumber": 16,
      "text": "قدّروها : جَعَلوا شرابَها على قدْر الرِّيّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:17",
      "surahNumber": 76,
      "ayahNumber": 17,
      "text": "كأسًا : خَمْرًا أو زجاجة فيها خَمْر\\nمزاجُها : ما تـُـمزَج به و تـُخْـلط\\nزنجبيلا : ماءً كالزنجبيل في أحْسَن أوصافه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:18",
      "surahNumber": 76,
      "ayahNumber": 18,
      "text": "تُسَمّى سلسبيلا : يُوصَف شرابُها بالسّلاسة في الإنسياغ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:19",
      "surahNumber": 76,
      "ayahNumber": 19,
      "text": "ولدان مُخَلـّدون : مُـبَقـَّـوْن على هيْئة الولدان في البَهاء\\nلؤلؤا منثورا : اللؤلؤ المُـفـرّق في الحُـسْن و الصّـفاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:21",
      "surahNumber": 76,
      "ayahNumber": 21,
      "text": "ثياب سندس : ثِـيَاب من ديباج رقيق\\nإستبرق : ديباج غليظ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:25",
      "surahNumber": 76,
      "ayahNumber": 25,
      "text": "بكرة و أصيلا : أوّل النّهار و آخِره . أو دائِما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:27",
      "surahNumber": 76,
      "ayahNumber": 27,
      "text": "يوما ثقيلا : شديد الأهوال (يوم القيامة )",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "76:28",
      "surahNumber": 76,
      "ayahNumber": 28,
      "text": "شددنا أسرهم : أحْكَمْـنا خلقهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
