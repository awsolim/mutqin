  "surahNumber": 80,
  "entries": [
    {
      "verseKey": "80:1",
      "surahNumber": 80,
      "ayahNumber": 1,
      "text": "عَـبَس : قطّـبَ وَجْهه الشريف صلى الله عليه و سلم\\nتوَلـّـى : أعرَض بوجهه الشريف صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:3",
      "surahNumber": 80,
      "ayahNumber": 3,
      "text": "لعَلـّـه يَزكّى : يَـتطهّر بتـَـعليمِك مِنْ دَنـَـس الجهْل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:4",
      "surahNumber": 80,
      "ayahNumber": 4,
      "text": "يَذكّـر : يـتـّـعِـظ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:6",
      "surahNumber": 80,
      "ayahNumber": 6,
      "text": "له تـَـصدّى : تتعرّض له بالإقـبال عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:8",
      "surahNumber": 80,
      "ayahNumber": 8,
      "text": "جَاءك يَسْعى : وَصَـل إليك مُـسْرعا ليَتـَـعلـّـم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:10",
      "surahNumber": 80,
      "ayahNumber": 10,
      "text": "عنه تـَـلـهّـى : تتلهـّى- تتشاغَـل و تـُـعْرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:11",
      "surahNumber": 80,
      "ayahNumber": 11,
      "text": "كلاّ : حقـّـا أو إرْشادٌ ، بليغٌ لترْك المُـعاوَدَة\\nإنـّـها تذكِرَة : إنّ آيات القرآن مَوْعِـظة و تذكيرٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:13",
      "surahNumber": 80,
      "ayahNumber": 13,
      "text": "في صُحف : منتسخةٍ من اللوح المحفوظ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:14",
      "surahNumber": 80,
      "ayahNumber": 14,
      "text": "مَرْفوعة : رَفيعة الـقـَـدْر و المَنزلة عنده تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:15",
      "surahNumber": 80,
      "ayahNumber": 15,
      "text": "بأيدي سَفـرة : ملائكة ينسخونها من اللوح المحفوظ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:16",
      "surahNumber": 80,
      "ayahNumber": 16,
      "text": "بَرَرة : مُطيعين له تعالى أو صادقين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:17",
      "surahNumber": 80,
      "ayahNumber": 17,
      "text": "قـُـتِل الإنسان : لُعِن الكافـر . أو عُـذب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:19",
      "surahNumber": 80,
      "ayahNumber": 19,
      "text": "فـَـقـدّره : أطوارا أو هيّـأه لما يَصْـلـُـح له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:20",
      "surahNumber": 80,
      "ayahNumber": 20,
      "text": "السّبيل يسّره : سَهّـل له طريقي الهدى و الضّلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:21",
      "surahNumber": 80,
      "ayahNumber": 21,
      "text": "فأقـبَرَه : أمَرَ بدفـنِه في قـبْر تكْرمة ً له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:22",
      "surahNumber": 80,
      "ayahNumber": 22,
      "text": "أنـْـشَـره : أحْـيـَاه بَعْد موته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:23",
      "surahNumber": 80,
      "ayahNumber": 23,
      "text": "لمّـا يَقـْـضِ ما أمره : لمْ يفعَلْ ما أمَرَه الله به بَلْ قـَـصّـر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:26",
      "surahNumber": 80,
      "ayahNumber": 26,
      "text": "شقـقـنا الأرض : بالنّـبات أو بالحَرْث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:28",
      "surahNumber": 80,
      "ayahNumber": 28,
      "text": "قضْـبًـا : عَـلفـًـا رَطْـبًـا للدّوابّ كالبَـرْسِيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:30",
      "surahNumber": 80,
      "ayahNumber": 30,
      "text": "حَدائق غُـلْـبا : بَساتين عِظامًـا مُتكاثفة الأشجار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:31",
      "surahNumber": 80,
      "ayahNumber": 31,
      "text": "أبّـا : كلأ و عُـشْـبًا . أو هُوَ التـِّـبْن خاصّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:33",
      "surahNumber": 80,
      "ayahNumber": 33,
      "text": "جاءت الصاخّة : الصّـيْحَـة تـُـصِمّ الآذان لشِدتِها (النفخة الثانية)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:38",
      "surahNumber": 80,
      "ayahNumber": 38,
      "text": "مُسْـفـِرَة : مُـشـْـرقة مُـضيئة (وجوه المؤمنين)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:40",
      "surahNumber": 80,
      "ayahNumber": 40,
      "text": "غَـبَـرَة : غبارٌ وَ كُـدُورَة (وجوه الكافرين)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "80:41",
      "surahNumber": 80,
      "ayahNumber": 41,
      "text": "تَرْهَـقها قـترة : تـَـغْـشاها ظُـلـْـمَـة و سواد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
