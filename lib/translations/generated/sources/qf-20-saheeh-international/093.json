{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 93,
  "entries": [
    {
      "verseKey": "93:1",
      "surahNumber": 93,
      "ayahNumber": 1,
      "text": "By the morning brightness",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:2",
      "surahNumber": 93,
      "ayahNumber": 2,
      "text": "And [by] the night when it covers with darkness,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:3",
      "surahNumber": 93,
      "ayahNumber": 3,
      "text": "Your Lord has not taken leave of you, [O Muḥammad], nor has He detested [you].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:4",
      "surahNumber": 93,
      "ayahNumber": 4,
      "text": "And the Hereafter is better for you than the first [life].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:5",
      "surahNumber": 93,
      "ayahNumber": 5,
      "text": "And your Lord is going to give you, and you will be satisfied.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:6",
      "surahNumber": 93,
      "ayahNumber": 6,
      "text": "Did He not find you an orphan and give [you] refuge?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:7",
      "surahNumber": 93,
      "ayahNumber": 7,
      "text": "And He found you lost and guided [you],",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:8",
      "surahNumber": 93,
      "ayahNumber": 8,
      "text": "And He found you poor and made [you] self-sufficient.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:9",
      "surahNumber": 93,
      "ayahNumber": 9,
      "text": "So as for the orphan, do not oppress [him].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:10",
      "surahNumber": 93,
      "ayahNumber": 10,
      "text": "And as for the petitioner, do not repel [him].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "93:11",
      "surahNumber": 93,
      "ayahNumber": 11,
      "text": "But as for the favor of your Lord, report [it].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
