{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 92,
  "entries": [
    {
      "verseKey": "92:1",
      "surahNumber": 92,
      "ayahNumber": 1,
      "text": "By the night when it covers",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:2",
      "surahNumber": 92,
      "ayahNumber": 2,
      "text": "And [by] the day when it appears",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:3",
      "surahNumber": 92,
      "ayahNumber": 3,
      "text": "And [by] He who created the male and female,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:4",
      "surahNumber": 92,
      "ayahNumber": 4,
      "text": "Indeed, your efforts are diverse.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:5",
      "surahNumber": 92,
      "ayahNumber": 5,
      "text": "As for he who gives and fears Allāh",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:6",
      "surahNumber": 92,
      "ayahNumber": 6,
      "text": "And believes in the best [reward].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:7",
      "surahNumber": 92,
      "ayahNumber": 7,
      "text": "We will ease him toward ease.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:8",
      "surahNumber": 92,
      "ayahNumber": 8,
      "text": "But as for he who withholds and considers himself free of need",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:9",
      "surahNumber": 92,
      "ayahNumber": 9,
      "text": "And denies the best [reward],",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:10",
      "surahNumber": 92,
      "ayahNumber": 10,
      "text": "We will ease him toward difficulty.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:11",
      "surahNumber": 92,
      "ayahNumber": 11,
      "text": "And what will his wealth avail him when he falls?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:12",
      "surahNumber": 92,
      "ayahNumber": 12,
      "text": "Indeed, [incumbent] upon Us is guidance.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:13",
      "surahNumber": 92,
      "ayahNumber": 13,
      "text": "And indeed, to us belongs the Hereafter and the first [life].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:14",
      "surahNumber": 92,
      "ayahNumber": 14,
      "text": "So I have warned you of a Fire which is blazing.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:15",
      "surahNumber": 92,
      "ayahNumber": 15,
      "text": "None will [enter to] burn therein except the most wretched one",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:16",
      "surahNumber": 92,
      "ayahNumber": 16,
      "text": "Who had denied and turned away.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:17",
      "surahNumber": 92,
      "ayahNumber": 17,
      "text": "But the righteous one will avoid it –",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:18",
      "surahNumber": 92,
      "ayahNumber": 18,
      "text": "[He] who gives [from] his wealth to purify himself",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:19",
      "surahNumber": 92,
      "ayahNumber": 19,
      "text": "And not [giving] for anyone who has [done him] a favor to be rewarded –",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:20",
      "surahNumber": 92,
      "ayahNumber": 20,
      "text": "But only seeking the face [i.e., acceptance] of his Lord, Most High.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "92:21",
      "surahNumber": 92,
      "ayahNumber": 21,
      "text": "And he is going to be satisfied.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
