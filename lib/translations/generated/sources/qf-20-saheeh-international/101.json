{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 101,
  "entries": [
    {
      "verseKey": "101:1",
      "surahNumber": 101,
      "ayahNumber": 1,
      "text": "The Striking Calamity -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:2",
      "surahNumber": 101,
      "ayahNumber": 2,
      "text": "What is the Striking Calamity?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:3",
      "surahNumber": 101,
      "ayahNumber": 3,
      "text": "And what can make you know what is the Striking Calamity?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:4",
      "surahNumber": 101,
      "ayahNumber": 4,
      "text": "It is the Day when people will be like moths, dispersed,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:5",
      "surahNumber": 101,
      "ayahNumber": 5,
      "text": "And the mountains will be like wool, fluffed up.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:6",
      "surahNumber": 101,
      "ayahNumber": 6,
      "text": "Then as for one whose scales are heavy [with good deeds],",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:7",
      "surahNumber": 101,
      "ayahNumber": 7,
      "text": "He will be in a pleasant life.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:8",
      "surahNumber": 101,
      "ayahNumber": 8,
      "text": "But as for one whose scales are light,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:9",
      "surahNumber": 101,
      "ayahNumber": 9,
      "text": "His refuge will be an abyss.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:10",
      "surahNumber": 101,
      "ayahNumber": 10,
      "text": "And what can make you know what that is?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "101:11",
      "surahNumber": 101,
      "ayahNumber": 11,
      "text": "It is a Fire, intensely hot.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
