{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 107,
  "entries": [
    {
      "verseKey": "107:1",
      "surahNumber": 107,
      "ayahNumber": 1,
      "text": "Have you seen the one who denies the Recompense?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "107:2",
      "surahNumber": 107,
      "ayahNumber": 2,
      "text": "For that is the one who drives away the orphan",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "107:3",
      "surahNumber": 107,
      "ayahNumber": 3,
      "text": "And does not encourage the feeding of the poor.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "107:4",
      "surahNumber": 107,
      "ayahNumber": 4,
      "text": "So woe to those who pray",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "107:5",
      "surahNumber": 107,
      "ayahNumber": 5,
      "text": "[But] who are heedless of their prayer -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "107:6",
      "surahNumber": 107,
      "ayahNumber": 6,
      "text": "Those who make show [of their deeds]",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "107:7",
      "surahNumber": 107,
      "ayahNumber": 7,
      "text": "And withhold [simple] assistance.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
