{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 24,
  "entries": [
    {
      "verseKey": "24:1",
      "surahNumber": 24,
      "ayahNumber": 1,
      "text": "فرضناها : أوجبنا أحكامها عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:2",
      "surahNumber": 24,
      "ayahNumber": 2,
      "text": "كلّ واحد : إذا كان حُرّا غير مُحصن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:4",
      "surahNumber": 24,
      "ayahNumber": 4,
      "text": "يرمون المحصنات : يقذفون العفيفات بالزّنى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:8",
      "surahNumber": 24,
      "ayahNumber": 8,
      "text": "يدرأ عنها العذاب : يدفع عنها العقوبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:11",
      "surahNumber": 24,
      "ayahNumber": 11,
      "text": "بالإفك : أقبح الكذب و أفحشه\\nعصبة منكم : جماعة منكم\\nتولّى كبره : تحمّل معظمه (رأس المنافقين)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:14",
      "surahNumber": 24,
      "ayahNumber": 14,
      "text": "أفضتم فيه : خضتم فيه من حديث الإفك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:15",
      "surahNumber": 24,
      "ayahNumber": 15,
      "text": "تحسبونه هيّـنا : تظنونه سهلا لا تبعة له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:16",
      "surahNumber": 24,
      "ayahNumber": 16,
      "text": "سبحانك : تعجّب من شناعة هذا الإفك\\nبهتان : كذب يُحيّر سامعه لفظاعته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:21",
      "surahNumber": 24,
      "ayahNumber": 21,
      "text": "خطوات الشيطان : طرقه و أثاره و مذاهبه\\nبالفحشاء : ما عَظُم قبحه من الذنوب\\nالمنكر : ما ينكره الشّرع و يكرهه الله\\nما زكى : ما تطهّر من دنس الذنوب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:22",
      "surahNumber": 24,
      "ayahNumber": 22,
      "text": "لا يأتـلِ : لا يحلف أو لا يُقصّر\\nأولوا الفضل : أصحاب الزيادة في الدّين\\nالسّعة : الغنى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:23",
      "surahNumber": 24,
      "ayahNumber": 23,
      "text": "المحصنات : العفائف ، و مثلهن المحصنون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:25",
      "surahNumber": 24,
      "ayahNumber": 25,
      "text": "دينهم الحقّ : جزاءهم الثابت لهم بالعدل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:27",
      "surahNumber": 24,
      "ayahNumber": 27,
      "text": "تستأنسوا : تستأذنوا ممن يملك الإذن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:28",
      "surahNumber": 24,
      "ayahNumber": 28,
      "text": "أزكى لكم : أطهر لكم من دنس الريبة و الدّناءة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:29",
      "surahNumber": 24,
      "ayahNumber": 29,
      "text": "جناح : إثم\\nمتاع لكم : منفعة و مصلحة لكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:30",
      "surahNumber": 24,
      "ayahNumber": 30,
      "text": "يغضوا من أبصارهم : يكفوا نظرهم عن المحرّمات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:31",
      "surahNumber": 24,
      "ayahNumber": 31,
      "text": "زينتهن : مواضع زينتهن من الجسد\\nما ظهر منها : الوجه و الكفين و القدمين\\nو ليضربن : و ليلقين و يسدلن\\nبخمورهن : أغطية رؤوسهن ( المقانع)\\nعلى جيوبهن : على مواضعها (صدورهن و ما حواليها)\\nلبعولتهن : لأزواجهن\\nنسائهن : المختصّات بهن بالصحبة أو الخدمة\\nأولي الإربة : أصحاب الحاجة إلى النساء\\nلم يظهروا : لم يبلغوا حد الشهوة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:32",
      "surahNumber": 24,
      "ayahNumber": 32,
      "text": "انكحوا الأيامى : من لا زوج لها ، و من لا زوجة له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:33",
      "surahNumber": 24,
      "ayahNumber": 33,
      "text": "يبتغون الكتاب : يطلبون عقد المكاتبة المعروف\\nفتياتكم : إماءكم\\nالبغاء : الزّنى\\nتحصّـنا : تعفّــفا و تصوّنا عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:35",
      "surahNumber": 24,
      "ayahNumber": 35,
      "text": "الله نور السّمـوات : منوّرهما أو هادي أهلهما أو موجدهما\\nكمشكاة : كنور كوّة غير نافذة\\nمصباح : سراج ضخم ثاقب\\nزجاجة : قنديل من الزجاج صاف أزهر\\nكوكب درّي : مضيء متلألئ صافٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:36",
      "surahNumber": 24,
      "ayahNumber": 36,
      "text": "بيوت : هي المساجد كلّها\\nأن ترفع : أن تُعظّم و تـُطهّر\\nبالغدوّ و الآصال : أول النهار و آخره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:38",
      "surahNumber": 24,
      "ayahNumber": 38,
      "text": "بغير حساب : بلا نهاية لما يُعطي ، أو بتوسّع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:39",
      "surahNumber": 24,
      "ayahNumber": 39,
      "text": "كسراب : شعاع يُرى ظهرا في البرّ عند اشتداد الحرّ كالماء السارب\\nبقيعة : في منبسطة من الأرض متـسع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:40",
      "surahNumber": 24,
      "ayahNumber": 40,
      "text": "بحر لجّي : عميق كثير الماء\\nيغشاه : يعلوه و يغطّيه\\nسحاب : غيم يحجب أنوار السّماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:41",
      "surahNumber": 24,
      "ayahNumber": 41,
      "text": "صافات : باسطات أجنحتهن في الهواء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:43",
      "surahNumber": 24,
      "ayahNumber": 43,
      "text": "يُزجي سحابا : يسوقه برفق إلى حيث يريد\\nيجعله ركاما : مجتمعا بعضه فوق بعض\\nالودق : المطر\\nمن خلاله : من فتوقه و مخارجه\\nسنا برقه : ضوء برقه و لمعانه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:49",
      "surahNumber": 24,
      "ayahNumber": 49,
      "text": "مذعنين : منقادين مُطيعين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:50",
      "surahNumber": 24,
      "ayahNumber": 50,
      "text": "أن يحيف : أن يجور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:53",
      "surahNumber": 24,
      "ayahNumber": 53,
      "text": "جهد أيمانهم : مجتهدين في الحلف بأغلظها و أوكدها\\nطاعة معروفة : طاعتكم طاعة معروفة باللسان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:54",
      "surahNumber": 24,
      "ayahNumber": 54,
      "text": "ما حُمّل : ما أمر به من التبليغ\\nما حُمّلتم : ما أمرتم به من الطاعة و الإنقياد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:57",
      "surahNumber": 24,
      "ayahNumber": 57,
      "text": "مُعجزين : فائتين من عذابنا بالهرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:58",
      "surahNumber": 24,
      "ayahNumber": 58,
      "text": "جناح : حرج في الدخول بلا استئذان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:60",
      "surahNumber": 24,
      "ayahNumber": 60,
      "text": "القواعد من النساء : العجائز اللاتي قعدن عن الحيض\\nمتبرجات بزينة : مظهرات للزينة الخفيّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:61",
      "surahNumber": 24,
      "ayahNumber": 61,
      "text": "ما ملكتم مفاتحه : مما في تصرّفكم وكالة أو حفظا\\nأشتاتا : متفرّقين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:62",
      "surahNumber": 24,
      "ayahNumber": 62,
      "text": "أمر جامع : أمر مهمّ يجب اجتماعهم له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "24:63",
      "surahNumber": 24,
      "ayahNumber": 63,
      "text": "دعاء الرّسول : دعوته لكم للاجتماع أو نداءكم له\\nيتسلّلون منكم : يخرجون منكم تدريجا في خفية\\nلِواذا : يستتر بعضهم ببعض في الخروج\\nيخالفون عن أمره : يعرضون أو يصدون عنه\\nفتنة : بلاء و محنة في الدنيا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
