{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 94,
  "entries": [
    {
      "verseKey": "94:1",
      "surahNumber": 94,
      "ayahNumber": 1,
      "text": "Did We not expand for you, [O Muḥammad], your breast?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "94:2",
      "surahNumber": 94,
      "ayahNumber": 2,
      "text": "And We removed from you your burden",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "94:3",
      "surahNumber": 94,
      "ayahNumber": 3,
      "text": "Which had weighed upon your back",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "94:4",
      "surahNumber": 94,
      "ayahNumber": 4,
      "text": "And raised high for you your repute.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "94:5",
      "surahNumber": 94,
      "ayahNumber": 5,
      "text": "For indeed, with hardship [will be] ease [i.e., relief].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "94:6",
      "surahNumber": 94,
      "ayahNumber": 6,
      "text": "Indeed, with hardship [will be] ease.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "94:7",
      "surahNumber": 94,
      "ayahNumber": 7,
      "text": "So when you have finished [your duties], then stand up [for worship].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "94:8",
      "surahNumber": 94,
      "ayahNumber": 8,
      "text": "And to your Lord direct [your] longing.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
