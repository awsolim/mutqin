{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 13,
  "entries": [
    {
      "verseKey": "13:2",
      "surahNumber": 13,
      "ayahNumber": 2,
      "text": "بغير عمدٍ : بغير دعائم و أساطين تُقيمُها\\nاستوى على العرش : استواءً يليق به سبحانه\\nيدبِّر الأمر : يصرّف العوالم كلها بقدرته و حكمته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:3",
      "surahNumber": 13,
      "ayahNumber": 3,
      "text": "مدّ الأرض : بسطها في رأي العين\\nرواسي : جبالا ثوابتا كي لا تميد\\nزوجين : نوعين و ضربين\\nيغشي الليل النهار : يُلبس النّهار ظلمة اللّيل أو العكس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:4",
      "surahNumber": 13,
      "ayahNumber": 4,
      "text": "قِطَع : بقاع مختلفة الطباع و الصفات\\nنخيل صنوان : نخلات يجمعها أصل واحد\\nالأُكُل : كا يُؤكل ، و هو الثمر و الحب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:5",
      "surahNumber": 13,
      "ayahNumber": 5,
      "text": "الأغلال : الأطواق من الحديد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:6",
      "surahNumber": 13,
      "ayahNumber": 6,
      "text": "المَثُلات : العقوبات الفاضحات لأمثالهم\\nمغفرة للناس : ستر و إمهال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:8",
      "surahNumber": 13,
      "ayahNumber": 8,
      "text": "ما تغيض الأرحام : ما تنقصه . أو تُسقطه\\nبمقدار : بقدْرٍ و حدّ لا يتعداه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:9",
      "surahNumber": 13,
      "ayahNumber": 9,
      "text": "الكبير : العظيم الذي كلّ شيء دونه\\nالمتعالِ : المستعلي على كلّ شيء بقدرته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:10",
      "surahNumber": 13,
      "ayahNumber": 10,
      "text": "ساربٌ : ذاهبٌ في سرْبِه و طريقهِ ظاهرًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:11",
      "surahNumber": 13,
      "ayahNumber": 11,
      "text": "له معقّبات : ملائكة تعتقب في حِفظه\\nمن أمر الله : بأمره تعالى بحفظه\\nمن وال : من ناصر أو وال يلي أمورهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:12",
      "surahNumber": 13,
      "ayahNumber": 12,
      "text": "السّحاب الثّقال : الموقرة بالماء المثقلة به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:13",
      "surahNumber": 13,
      "ayahNumber": 13,
      "text": "شديد المِحال : المكايدة أو القوّة أو العقوبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:14",
      "surahNumber": 13,
      "ayahNumber": 14,
      "text": "له دعوة الحقّ : \\\"لله الدّعوة الحق \\\"\\\"كلمة التوحيد\\\"\\\"\\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:15",
      "surahNumber": 13,
      "ayahNumber": 15,
      "text": "لله يسجد : لأمره تعالى ينقاد و يخضع\\nظلالهم : تنقاد لأمره تعالى و تخضع\\nبالغدوّ : جمع غداة – أوّل النّهار\\nالآصال : جمع أصيل – آخر النّهار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:17",
      "surahNumber": 13,
      "ayahNumber": 17,
      "text": "بقدَرها : بمقدارها الذي اقتضته الحكمة\\nزبدًا : هو الغُثاء (الرّغوة) الطّافي فوق الماء\\nرابيًا : مرتفعا منتفخا\\nزبَدٌ : هو الخبث الطافي عند إذابة المعادن\\nجُفاء : مرميّا به مطروحا أو متفرّقا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:18",
      "surahNumber": 13,
      "ayahNumber": 18,
      "text": "بئس المهاد : بئس الفراش و المستقر جهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:22",
      "surahNumber": 13,
      "ayahNumber": 22,
      "text": "يدرءون : يدفعون و يُجازون\\nعقبى الدار : عاقبتها المحمودة ، و هي الجنّات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:25",
      "surahNumber": 13,
      "ayahNumber": 25,
      "text": "سوء الدار : عاقبتها سيّئة و هي النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:26",
      "surahNumber": 13,
      "ayahNumber": 26,
      "text": "يقدِر : يُضيّقه على من يشاء لحكمة\\nمتاع : شيء قليل ذاهب زائل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:27",
      "surahNumber": 13,
      "ayahNumber": 27,
      "text": "أناب : رجع بقلبه إلى الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:29",
      "surahNumber": 13,
      "ayahNumber": 29,
      "text": "طوبى لهم : عيش طيّب لهم في الآخرة\\nحُسن مآب : حسن مرجع و منقلب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:30",
      "surahNumber": 13,
      "ayahNumber": 30,
      "text": "إليه متاب : إلى الله وحدهمرجعي و توبتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:31",
      "surahNumber": 13,
      "ayahNumber": 31,
      "text": "أفلم ييأس . . : أفلم يعلم و يتبيّن ..\\nقارعة : داهية تقرعهم بصنوف البلايا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:32",
      "surahNumber": 13,
      "ayahNumber": 32,
      "text": "فأمليتُ... : أمهلت و أطلت في أمن و الدّعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:34",
      "surahNumber": 13,
      "ayahNumber": 34,
      "text": "واق : حافظ و عاصم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:35",
      "surahNumber": 13,
      "ayahNumber": 35,
      "text": "أكُلُها دائم : ثمرها الّذي يؤكل لا ينقطع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:36",
      "surahNumber": 13,
      "ayahNumber": 36,
      "text": "إليه مآب : إلى الله وحده مرجعي للجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:37",
      "surahNumber": 13,
      "ayahNumber": 37,
      "text": "لكلّ أجل كتاب : لكلّ وقت حكم معيّن بالحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:39",
      "surahNumber": 13,
      "ayahNumber": 39,
      "text": "أمّ الكتاب : اللّوح المحفوظ أو العلم الإلهي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "13:41",
      "surahNumber": 13,
      "ayahNumber": 41,
      "text": "لا مُعقِّب لحكمه : لا رادّ و لا مُبطل له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
