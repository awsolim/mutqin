  "entries": [
    {
      "verseKey": "88:1",
      "surahNumber": 88,
      "ayahNumber": 1,
      "text": "الغاشية : القيامةِ تَغشى الناسَ بأهوالِها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:2",
      "surahNumber": 88,
      "ayahNumber": 2,
      "text": "خاشعة : ذَليلةٌ خاضِعةٌ من الخِزْي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:3",
      "surahNumber": 88,
      "ayahNumber": 3,
      "text": "عامِلة : تَجُرُّ السلاسلَ والأغلالَ فى النار\\nناصبة : تـَعِبَة ٌ ممَّا تـُلاقِيه فيها من العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:4",
      "surahNumber": 88,
      "ayahNumber": 4,
      "text": "تصلى نارًا حامية : تدخُلُ أو تـُقاسِي نارًا تـَناهَى حَرُّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:5",
      "surahNumber": 88,
      "ayahNumber": 5,
      "text": "عيْن آنـيَـة : بَلَغَت أنـَاهَا (غايَـتـَها) فى الحرارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:6",
      "surahNumber": 88,
      "ayahNumber": 6,
      "text": "ضريع : شيءٍ فى النار ، كالشَّوكِ مُرّّ مُنـْتـِنٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:7",
      "surahNumber": 88,
      "ayahNumber": 7,
      "text": "لا يُغْـني منْ جوع : لا يَدفَعُ عـنهم جُوعًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:8",
      "surahNumber": 88,
      "ayahNumber": 8,
      "text": "ناعمة : ذاتُ بهجةٍ وحُسنٍ ونَضارةٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:11",
      "surahNumber": 88,
      "ayahNumber": 11,
      "text": "لاغِية : لَغوًا وباطِلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:13",
      "surahNumber": 88,
      "ayahNumber": 13,
      "text": "سُرُرٌ مرفوعة : مُرتـَفعةُ السَّمكِ أو رفيعة ُ القـَدْرِ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:14",
      "surahNumber": 88,
      "ayahNumber": 14,
      "text": "أكواب مَوْضوعة : أقداحٌ بين أيديهم للشرب منها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:15",
      "surahNumber": 88,
      "ayahNumber": 15,
      "text": "نـَـمارق مَصْـفوفة : وسائدُ ومَرافقُ يَـتـَّـكِأُ عليها مَوضُوعٌ بَعضُها إلى جَنـْبِ بعض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:16",
      "surahNumber": 88,
      "ayahNumber": 16,
      "text": "زرابيّ مَبْـثوثة : بُسطٌ فاخِرةٌ مُـفـَرّقة فى المجالس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:17",
      "surahNumber": 88,
      "ayahNumber": 17,
      "text": "يَـنظرون : يَتأمَّـلـُـون فيُدْركُون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:22",
      "surahNumber": 88,
      "ayahNumber": 22,
      "text": "بمُـسيْـطر : بِمُـتـَـسـلّـِطٍ جبَّـارٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "88:25",
      "surahNumber": 88,
      "ayahNumber": 25,
      "text": "إيابَـهم : رجُوعَهم بعد الموت بالبعث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
