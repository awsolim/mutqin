{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 29,
  "entries": [
    {
      "verseKey": "29:2",
      "surahNumber": 29,
      "ayahNumber": 2,
      "text": "لا يُفتنون : لا يُمتحنون بالمشاقّ و الشّدائد ليتميّز المُخلص من المنافق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:4",
      "surahNumber": 29,
      "ayahNumber": 4,
      "text": "أن يسبقونا : أن يُعجزونا و يفوتونا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:5",
      "surahNumber": 29,
      "ayahNumber": 5,
      "text": "أجل الله : الوقت المعيّن للبعث و الجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:8",
      "surahNumber": 29,
      "ayahNumber": 8,
      "text": "وصّينا الإنسان : أمرناه\\nحسنا : برّا بهما و عطفا عليهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:10",
      "surahNumber": 29,
      "ayahNumber": 10,
      "text": "فتنة النّاس : ما يُصيبه من أذاهم و عذابهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:12",
      "surahNumber": 29,
      "ayahNumber": 12,
      "text": "خطاياكم : أوزاركم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:13",
      "surahNumber": 29,
      "ayahNumber": 13,
      "text": "أثقالهم : خطاياهم الفادحة\\nيفترون : يختلقونه من الأباطيل و الأكاذيب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:17",
      "surahNumber": 29,
      "ayahNumber": 17,
      "text": "تخلقون إفكا : تكذبون أو تنحتون كذبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:21",
      "surahNumber": 29,
      "ayahNumber": 21,
      "text": "إليه تُقلبون : تـُــردّون و ترجعون لا إلى غيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:22",
      "surahNumber": 29,
      "ayahNumber": 22,
      "text": "بمعجزين : فائتين من عذابه بالهرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:25",
      "surahNumber": 29,
      "ayahNumber": 25,
      "text": "مودّة بينكم : للتوادّ و التّواصل بينكم لاجماعكم على عبادتها\\nمأواكم النّار : منزلكم الذي تأوون إليه النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:29",
      "surahNumber": 29,
      "ayahNumber": 29,
      "text": "تقطعون السّبيل : بمقارفة المعاصي و القبائح\\nناديكم : مجلسكم الذي تجتمعون فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:32",
      "surahNumber": 29,
      "ayahNumber": 32,
      "text": "من الغابرين : من الباقين في العذاب كأمثالها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:33",
      "surahNumber": 29,
      "ayahNumber": 33,
      "text": "سيء بهم : اعتراه الغمّ بمجيئهم خوفا عليهم\\nضاق بهم ذرعا : ضعُـفـتْ طاقته عن تدبير خلاصهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:34",
      "surahNumber": 29,
      "ayahNumber": 34,
      "text": "رجزا : عذابا شديدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:36",
      "surahNumber": 29,
      "ayahNumber": 36,
      "text": "لا تعثوْا : لا تُفسِدوا أشدّ الإفساد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:37",
      "surahNumber": 29,
      "ayahNumber": 37,
      "text": "فأخذتهم الرّجفة : الزلزلة الشديدة بسبب الصّيحة\\nجاثمين : هامدين ميّـتين لا حراك بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:38",
      "surahNumber": 29,
      "ayahNumber": 38,
      "text": "كانوا مستبصرين : عقلاء متمكّنين من التدبّر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:39",
      "surahNumber": 29,
      "ayahNumber": 39,
      "text": "سابقين : فائتين من عذابه تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:40",
      "surahNumber": 29,
      "ayahNumber": 40,
      "text": "حاصبا : ريحا عاصفا ترميهم بالحصباء\\nأخذته الصّيحة : صوتٌ من السّماء مُهلك مُرجف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:41",
      "surahNumber": 29,
      "ayahNumber": 41,
      "text": "العنكبوت : حشرة معروفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:53",
      "surahNumber": 29,
      "ayahNumber": 53,
      "text": "أجل مسمّى : هُو يوم القيامة\\nبغتة : فجأة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:55",
      "surahNumber": 29,
      "ayahNumber": 55,
      "text": "يغشاهم العذاب : يُـجلـّـلهم و يُحيط بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:58",
      "surahNumber": 29,
      "ayahNumber": 58,
      "text": "لنبوأنّهم : لنُنزلنّهم على وجه الإقامة\\nغرفا : منازل رفيعة عالية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:60",
      "surahNumber": 29,
      "ayahNumber": 60,
      "text": "كأيّ من دابّة : كثيرٌ من الدّواب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:61",
      "surahNumber": 29,
      "ayahNumber": 61,
      "text": "فأنى يُؤفكون؟ : فكيف يُصرفون عن توحيده ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:62",
      "surahNumber": 29,
      "ayahNumber": 62,
      "text": "يقدر له : يُضيّـقه على من يشاء لحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:64",
      "surahNumber": 29,
      "ayahNumber": 64,
      "text": "لهو و لعب : لذائد مُتصرّمة ، و عبث باطل\\nلَهي الحيوان : لَهِيَ دار الحياة الدّائمة الخالدة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:65",
      "surahNumber": 29,
      "ayahNumber": 65,
      "text": "الدّين : العبادة و الطّاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:67",
      "surahNumber": 29,
      "ayahNumber": 67,
      "text": "يُتخطـّــف النّاس : يُسلبون قتـْـلا و أسرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "29:68",
      "surahNumber": 29,
      "ayahNumber": 68,
      "text": "مثوا للكافرين : مكانٌ يَثـْوُون فيه و يقيمون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
