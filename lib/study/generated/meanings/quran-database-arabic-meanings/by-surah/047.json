{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 47,
  "entries": [
    {
      "verseKey": "47:1",
      "surahNumber": 47,
      "ayahNumber": 1,
      "text": "أضلّ أعمالهم : أحبطها و أبطلها فلا نفع لها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:2",
      "surahNumber": 47,
      "ayahNumber": 2,
      "text": "كفّر عنهمْ : أزال و مَحَا عنهم\\nأصلحَ بالهمْ : حالهمْ و شأنـَـهمْ في الدّين و الدنيا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:4",
      "surahNumber": 47,
      "ayahNumber": 4,
      "text": "فضرْبَ الرقاب : فاضْربوا الرقاب ضَرْبـًـا\\nأثخنتموهمْ : أوْسعتموهمْ قتلا و جراحا و أسرا\\nفشدّوا الوَثاق : فأحكموا قـيْد الأسارى منهم\\nمَنّــًا : بإطلاق الأسرى بغير عِـوَض\\nفِدَاءً : بالمال أو بأسارى المسلمين\\nحتى تضعَ الحَرْب أوزارها : آلاتها و أثقالها ، و المراد حتى تنقضي الحرب\\nلـِـيَبْـلـُــوَ. . : لِـيَخْـتبر . . فيمحّص المؤمنين و يمحق الكافرين\\nفلن يضلّ أعمالهمْ : فلن يبطلها بل يوفّـيهم ثوابها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:8",
      "surahNumber": 47,
      "ayahNumber": 8,
      "text": "فتـَـعْسًـا لهمْ : فَهَلاكا . أو عِـثـَارًا أو شقاءً لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:9",
      "surahNumber": 47,
      "ayahNumber": 9,
      "text": "فأحْـبَـط أعمالهم : فأبْطلها لكراهتهم القرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:10",
      "surahNumber": 47,
      "ayahNumber": 10,
      "text": "دمّر الله عليهم : أطبق الهلاك عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:11",
      "surahNumber": 47,
      "ayahNumber": 11,
      "text": "مولى . . : وليّ و ناصر . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:12",
      "surahNumber": 47,
      "ayahNumber": 12,
      "text": "مثوًى لهم : موْضع ثواء و إقامة لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:13",
      "surahNumber": 47,
      "ayahNumber": 13,
      "text": "كأين من قرية : كثيرٌ من القرى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:15",
      "surahNumber": 47,
      "ayahNumber": 15,
      "text": "مَثل الجَنة : وصفها – ما تسمعون\\nغير آسِـن : غير متغيّر و لا منـْتن\\nعسل مصفّى : مُـنـَـقّى من جميع الشوائب\\nماءً حميما : بالغا الغاية في الحرارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:16",
      "surahNumber": 47,
      "ayahNumber": 16,
      "text": "ماذا قال آنفا : ماذا قال الآن ، أو الساعة القريبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:18",
      "surahNumber": 47,
      "ayahNumber": 18,
      "text": "جاء أشراطها : علاماتها و منها مبعثه صلى الله عليه و سلم\\nفأنى لهم ؟ : فكيف . أو منْ أين لهم ؟\\nذِكراهم : تذكّرهم ما ضيعوا من طاعة الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:19",
      "surahNumber": 47,
      "ayahNumber": 19,
      "text": "يعلم متقلبكم : متصرّفكم حيث تتحركون\\nمثواكم : مقامكم حيث تستقرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:20",
      "surahNumber": 47,
      "ayahNumber": 20,
      "text": "المغشيّ عليه : منْ أصابته الغشْـيَـة و السّـكرة\\nفأولى لهم : قاربهمْ ما يهلكهم و اللام مزيدةٌ أو العقاب أحقّ و أوْلى لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:21",
      "surahNumber": 47,
      "ayahNumber": 21,
      "text": "طاعة : خيرٌ لهم أو أمرنا طاعة ٌ\\nعزم الأمر : جدّ و لزم الجهاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:22",
      "surahNumber": 47,
      "ayahNumber": 22,
      "text": "فهل عسيتمْ : فهل يُتوقّع منكم ؟ (أي يُتوقّع)\\nتوليتم : الحُكم و كنتم ولاة أمر الأمّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:24",
      "surahNumber": 47,
      "ayahNumber": 24,
      "text": "أقفالها : مَغاليقها التي لا تفتح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:25",
      "surahNumber": 47,
      "ayahNumber": 25,
      "text": "سوّل لهم : زيّن و سهّـل لهم خطاياهم و منّـاهم\\nأملي لهم : مدّ لهمْ في الأماني الباطلة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:26",
      "surahNumber": 47,
      "ayahNumber": 26,
      "text": "يعلم إسرارهم : إخفاءهم كل قبيح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:29",
      "surahNumber": 47,
      "ayahNumber": 29,
      "text": "أضغانـَـهم : أحقادهم الشديدة الكامنة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:30",
      "surahNumber": 47,
      "ayahNumber": 30,
      "text": "بسماهمْ : بعلامات نسِمهم بها\\nفي لحن القول : بفحوَى و أسلوب كلامهم الملتوي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:31",
      "surahNumber": 47,
      "ayahNumber": 31,
      "text": "لنبلونّـكم : لنختبرنّكم بالتكاليف الشاقة\\nنبْـلوَ أخباركمْ : نظهرها و نكشفها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:35",
      "surahNumber": 47,
      "ayahNumber": 35,
      "text": "فلا تهنوا : فلا تضعفوا عن مقالتة الكفار\\nالسّـلم : الصّـلح و المُـوَادَعَة\\nيَتركم أعمالكم : ينـْقـصكم أجورَها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "47:37",
      "surahNumber": 47,
      "ayahNumber": 37,
      "text": "فـيُـحْـفكم : يجْهدكم بالطلب كلّ المال\\nأضغانـَكم : أحقادكم الشديدة على الإسلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
