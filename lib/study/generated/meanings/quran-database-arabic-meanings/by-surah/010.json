{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 10,
  "entries": [
    {
      "verseKey": "10:2",
      "surahNumber": 10,
      "ayahNumber": 2,
      "text": "قَدَم صدق : سابقَةَ فضل ، و منزلة رفيعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:3",
      "surahNumber": 10,
      "ayahNumber": 3,
      "text": "استوى على العرش : استواءً يليق به سبحانه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:4",
      "surahNumber": 10,
      "ayahNumber": 4,
      "text": "بالقسط : بالعدل\\nحميم : ماءٍ بالغ غاية الحرارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:5",
      "surahNumber": 10,
      "ayahNumber": 5,
      "text": "قدّره منازل : صيّر القمر ذا منازل يسير فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:7",
      "surahNumber": 10,
      "ayahNumber": 7,
      "text": "لا يرجون لقاءنا : لا يتوقّعونه لإنكارهم البعث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:10",
      "surahNumber": 10,
      "ayahNumber": 10,
      "text": "دعواهم : دُعاؤهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:11",
      "surahNumber": 10,
      "ayahNumber": 11,
      "text": "لَقُضي إليهم أجلهم : لأُهلِكوا و أبيدوا\\nفي طُغيانهم : في تجاوزهم الحدّ في الكفر\\nيعهمون : يعمون عن الرّشد أو يتحيّرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:12",
      "surahNumber": 10,
      "ayahNumber": 12,
      "text": "الضّرّ : الجهد و البلاء و الشّدّة\\nدعانا لجنبه : استغاث بنا لكشفه ملقى لجنبه\\nمرّ : استمرّ على كُفره و لم يتّعظ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:13",
      "surahNumber": 10,
      "ayahNumber": 13,
      "text": "القرون : الأمم كقوم نوح و عاد و ثمود\\nظلموا : بالكفر و تكذيب الرّسل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:14",
      "surahNumber": 10,
      "ayahNumber": 14,
      "text": "جعلناكم خلائف : استخلفناكم بعد اهلاك أولئك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:16",
      "surahNumber": 10,
      "ayahNumber": 16,
      "text": "لا أدراكم به : لا أعلمكم الله به بواسطتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:17",
      "surahNumber": 10,
      "ayahNumber": 17,
      "text": "لا يُفلح المجرمون : لا يفوزون بمطلوب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:18",
      "surahNumber": 10,
      "ayahNumber": 18,
      "text": "سبحانه : تنزيها له تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:21",
      "surahNumber": 10,
      "ayahNumber": 21,
      "text": "ضرّاء مسّتهم : نائبة أصابتهم (الجوع و القحط)\\nلهم مكر : دفع و طعن و استهزاء\\nالله أسرع مكرا : أعجلُ جزاءً و عقوبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:22",
      "surahNumber": 10,
      "ayahNumber": 22,
      "text": "ريح عاصف : شديدة الهبوب\\nأحيط بهم : أحدق بهم الهلاك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:23",
      "surahNumber": 10,
      "ayahNumber": 23,
      "text": "يبغون : يُفسدون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:24",
      "surahNumber": 10,
      "ayahNumber": 24,
      "text": "مثل الحياة الدّنيا : حالها في سرعة تقضيها و زوالها\\nزخرفها : نظارتها و بهجتها بألوان النّبات\\nأمرُنا : ما يجتاحها من الآفات و العاهات\\nحصيدا : كالنّبات المحصود بالمناجل\\nلم تغْنَ : لم تمكث زروعها و لم تُقم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:26",
      "surahNumber": 10,
      "ayahNumber": 26,
      "text": "الحسنى : المنزلة الحُسنى (الجنّة)\\nزيادة : النّظر إلى وجه الله الكريم فيها\\nلا يرهق وجوههم : لا يغشى وجوههم و لا يعلوها\\nقتر : غُبار ما فيه سواد\\nذلّة : أثر هوان ما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:27",
      "surahNumber": 10,
      "ayahNumber": 27,
      "text": "عاصم : مانع يمنع سُخطه و عذابه\\nأغشيت وجوههم : كُسيت و ألبست",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:28",
      "surahNumber": 10,
      "ayahNumber": 28,
      "text": "مكانكم : الزموا مكانكم و اثبتوا فيه\\nفزيّلنا بينهم : فرّقنا بينهم و قطعنا وُصَلَهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:30",
      "surahNumber": 10,
      "ayahNumber": 30,
      "text": "تبلو : تخبُر . أو تعلم . أو تُعاين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:32",
      "surahNumber": 10,
      "ayahNumber": 32,
      "text": "ربّكم الحقّ : الثابتة ربوبيّته بالبرهان ثبوتا لا ريب فيه\\nفأنّى تُصرفون؟ : فكيف تستجيزون العدول عن الحقّ إلى الكفر و الضّلال ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:33",
      "surahNumber": 10,
      "ayahNumber": 33,
      "text": "حقّت : ثبتت و وجبت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:34",
      "surahNumber": 10,
      "ayahNumber": 34,
      "text": "فأنّى تؤفكون ؟ : فكيف تُصرفون عن طريق الرّشد ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:35",
      "surahNumber": 10,
      "ayahNumber": 35,
      "text": "لا يهِدّي : لا يهتدي بنفسه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:39",
      "surahNumber": 10,
      "ayahNumber": 39,
      "text": "يأتهم تأويله : يتبيّن لهم عاقبته و مآل وعيده",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:43",
      "surahNumber": 10,
      "ayahNumber": 43,
      "text": "ينظر إليك : يُعاين دلائل نبوّته الواضحة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:47",
      "surahNumber": 10,
      "ayahNumber": 47,
      "text": "بالقسط : بالعدل في الدّنيا أو يوم الجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:50",
      "surahNumber": 10,
      "ayahNumber": 50,
      "text": "أرأيتم : أخبروني عن عذاب الله\\nبياتاً : وقت بيات أي ليلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:51",
      "surahNumber": 10,
      "ayahNumber": 51,
      "text": "آلآن ؟ : آلآن تُؤمنون بوقوع عذابه ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:53",
      "surahNumber": 10,
      "ayahNumber": 53,
      "text": "يستنبئونك : يستخبرونك مُستهزئين عن العذاب\\nإي و ربّي : نعم و ربّي\\nو ما أنتم بمعجزين : بفائتين من عذاب الله بالهرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:54",
      "surahNumber": 10,
      "ayahNumber": 54,
      "text": "أسرّوا النّدامة : أخفوا الغمّ و الحسرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:59",
      "surahNumber": 10,
      "ayahNumber": 59,
      "text": "أرأيتم : أخبروني\\nأذِن لكم : أعلمكم بهذا التحليل و التّحريم\\nتفترون : تكذبون في نسبة ذلك إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:61",
      "surahNumber": 10,
      "ayahNumber": 61,
      "text": "تكون في شأن : في أمر هامّ مُعتنى به\\nتُفيضون فيه : تشرعون و تخوضون فيه\\nما يعزب : ما يبعُد و ما يغيب\\nمثقال ذرّة : وزن أصغر نملة أو هباءة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:65",
      "surahNumber": 10,
      "ayahNumber": 65,
      "text": "إنّ العزّة لله : إن القهر و الغلبة له تعالى في مُلكه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:66",
      "surahNumber": 10,
      "ayahNumber": 66,
      "text": "يخرصون : يكذبون فيها ينسبونه إليه تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:68",
      "surahNumber": 10,
      "ayahNumber": 68,
      "text": "سبحانه : تنزيها له تعالى عما نسبوه إليه\\nسلطان : حجّة و برهان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:71",
      "surahNumber": 10,
      "ayahNumber": 71,
      "text": "كبُر عليكم : عظُم و شقّ عليكم\\nمقامي : اقامتي بينكم دهرا طويلا\\nفأجمعوا أمركم : اعزموا و صمّموا على كيدكم\\nو شُركاءكم : مع شركائكم\\nغمّة : ضيقا شديدا . أو مُبهما مُلتبِسا\\nاقضوا إليّ : أدّوا إليّ ما تُريدونه\\nلا تُنظرون : لا تُمهلوني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:73",
      "surahNumber": 10,
      "ayahNumber": 73,
      "text": "جعلناهم خلائف : يخلُفون المُغرقين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:74",
      "surahNumber": 10,
      "ayahNumber": 74,
      "text": "نطبع : نختم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:78",
      "surahNumber": 10,
      "ayahNumber": 78,
      "text": "لتلفتنا : لِتلوينا و تصرفنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:83",
      "surahNumber": 10,
      "ayahNumber": 83,
      "text": "أن يفتنهم : أن يبتليهم و يعذّبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:85",
      "surahNumber": 10,
      "ayahNumber": 85,
      "text": "لا تجعلنا فتنة : موضع عذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:87",
      "surahNumber": 10,
      "ayahNumber": 87,
      "text": "تبوّءا لقومكما . . : اتّخذا و اجعلا لهم . .\\nقبلة : مساجد نحو الكعبة أو مُصلّى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:88",
      "surahNumber": 10,
      "ayahNumber": 88,
      "text": "اطمس على أموالهم : أهلكها و أذهِبها . أو أتلِفها\\nاشدد على قلوبهم : اطبع عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:90",
      "surahNumber": 10,
      "ayahNumber": 90,
      "text": "بغيا و عدوا : ظلما و اعتداءًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:91",
      "surahNumber": 10,
      "ayahNumber": 91,
      "text": "آلآن ؟ : آلآن تؤمنوا حين أيقنت بالهلاك ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:92",
      "surahNumber": 10,
      "ayahNumber": 92,
      "text": "آية : عبرة و نكالا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:93",
      "surahNumber": 10,
      "ayahNumber": 93,
      "text": "بوّأنا : أنزلنا و أسكنّا\\nمُبوّأ صدق : منزلا صالحا مرضيّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:94",
      "surahNumber": 10,
      "ayahNumber": 94,
      "text": "الممترين : الشّاكّين المتزلزلين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "10:98",
      "surahNumber": 10,
      "ayahNumber": 98,
      "text": "عذاب الخزي : الذّلّ و الهوان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
