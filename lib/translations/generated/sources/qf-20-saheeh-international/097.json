{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 97,
  "entries": [
    {
      "verseKey": "97:1",
      "surahNumber": 97,
      "ayahNumber": 1,
      "text": "Indeed, We sent it [i.e., the Qur’ān] down during the Night of Decree.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "97:2",
      "surahNumber": 97,
      "ayahNumber": 2,
      "text": "And what can make you know what is the Night of Decree?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "97:3",
      "surahNumber": 97,
      "ayahNumber": 3,
      "text": "The Night of Decree is better than a thousand months.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "97:4",
      "surahNumber": 97,
      "ayahNumber": 4,
      "text": "The angels and the Spirit [i.e., Gabriel] descend therein by permission of their Lord for every matter.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "97:5",
      "surahNumber": 97,
      "ayahNumber": 5,
      "text": "Peace it is until the emergence of dawn.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
