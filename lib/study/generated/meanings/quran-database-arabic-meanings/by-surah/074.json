{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 74,
  "entries": [
    {
      "verseKey": "74:1",
      "surahNumber": 74,
      "ayahNumber": 1,
      "text": "المدثر : المتغشّى بثيابه (النبي صلى الله عليه و سلم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:3",
      "surahNumber": 74,
      "ayahNumber": 3,
      "text": "رَبّـك فكبر : اخصصْ رَبّـك بالتكبير و التعظيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:4",
      "surahNumber": 74,
      "ayahNumber": 4,
      "text": "ثيابك فطهّر : كناية عن تطهير النفس من المذامّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:5",
      "surahNumber": 74,
      "ayahNumber": 5,
      "text": "الرجْز فاهجر : اهجرْ المآثم الموجبة للعذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:6",
      "surahNumber": 74,
      "ayahNumber": 6,
      "text": "لا تمنن تستكثر : لا تـُـعْـطِ طالبا الكثير عِوَضا عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:8",
      "surahNumber": 74,
      "ayahNumber": 8,
      "text": "نقِـر في النّـاقور : نـُـفخ في الصّور للبعث و النّشور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:11",
      "surahNumber": 74,
      "ayahNumber": 11,
      "text": "ذرني : دَعْـنِي و خَـلـّـني (تهديد و وعيد)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:12",
      "surahNumber": 74,
      "ayahNumber": 12,
      "text": "ملا ممْدودا : كثيرا دائما غير منقطع عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:13",
      "surahNumber": 74,
      "ayahNumber": 13,
      "text": "بنين شهودًا : حضورا معه ، لا يُفارقونه للتكسّب لِغناهم عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:14",
      "surahNumber": 74,
      "ayahNumber": 14,
      "text": "مهّدت له : بَسَطتُ له النّعمة و الرّياسة و الجَاه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:16",
      "surahNumber": 74,
      "ayahNumber": 16,
      "text": "كلاّ : كلمة رَدْع و زجر عن الطمع الفارغ\\nلآياتنا عنيدا : معاندا جَاحِدًا أو مُـجانيا للحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:17",
      "surahNumber": 74,
      "ayahNumber": 17,
      "text": "سأرهقه صعودا : سَأكلـّـفه عَذابا شاقّـا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:18",
      "surahNumber": 74,
      "ayahNumber": 18,
      "text": "قدّر : هيّـأ في نفسِه قَـوْلاً طاعِـنـًـا في القرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:19",
      "surahNumber": 74,
      "ayahNumber": 19,
      "text": "فقتل : لُعِنَ و عُذب أو قُـبِّـح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:21",
      "surahNumber": 74,
      "ayahNumber": 21,
      "text": "نظر : تأمّل فيما قدّرَ و هيّـأ من الــّطـعْن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:22",
      "surahNumber": 74,
      "ayahNumber": 22,
      "text": "عَبَس : قـَــّطبَ وَجْهَه لمّا ضاقـَـتْ عليه الحِيَل\\nبَسَر : اشتدّ في العبوس و كُـلـُـوح الوَجْه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:24",
      "surahNumber": 74,
      "ayahNumber": 24,
      "text": "سِحْرٌ يُؤثر : يُرْوَى و يُـتـَـعـلـّـمُ من السَّحَرَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:26",
      "surahNumber": 74,
      "ayahNumber": 26,
      "text": "سأصليه سَقـَـر : سأدْخِلـُـه جهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:29",
      "surahNumber": 74,
      "ayahNumber": 29,
      "text": "لوّاحة للبشر : مُسودّة للجلود ، مُحْـرقَة لها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:31",
      "surahNumber": 74,
      "ayahNumber": 31,
      "text": "فتنة : سبب فتنة و ضلال\\nو ما هي : و ما سَقـَـر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:33",
      "surahNumber": 74,
      "ayahNumber": 33,
      "text": "و الليل إذ أدبَر : وَلـّـى و ذهَب (قسم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:34",
      "surahNumber": 74,
      "ayahNumber": 34,
      "text": "و الصبح إذا أسْـفَر : أضاء و انكشف (قسَم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:35",
      "surahNumber": 74,
      "ayahNumber": 35,
      "text": "إنها لإحدى الكُـبـَر : لإحدى الدّواهي العظيمة (جوابه)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:37",
      "surahNumber": 74,
      "ayahNumber": 37,
      "text": "أنْ يتقـدّم : إلى الخيْر و الطاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:38",
      "surahNumber": 74,
      "ayahNumber": 38,
      "text": "بما كَسَبَتْ رَهينة : مَرْهونة عنده تعالى بعَمَلِـها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:42",
      "surahNumber": 74,
      "ayahNumber": 42,
      "text": "ما سَلكَكم ؟ : أيّ شيء أدْخَلكمْ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:45",
      "surahNumber": 74,
      "ayahNumber": 45,
      "text": "كنّـا نخوض : نـَـشْرعُ في الباطل لا نُـبالي به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:46",
      "surahNumber": 74,
      "ayahNumber": 46,
      "text": "بيوم الدّين : بيَوْمِ البعْثِ و الحِسَاب و الجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:50",
      "surahNumber": 74,
      "ayahNumber": 50,
      "text": "حُمُرٌ مُـسْـتـَـنفِـرَة : حُمُـرٌ وَحْشِـيّة ، شديدة الـِنّـفَار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:51",
      "surahNumber": 74,
      "ayahNumber": 51,
      "text": "قـَـسْورة : أسدٍ . أو الرّماة القـنّـص",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "74:56",
      "surahNumber": 74,
      "ayahNumber": 56,
      "text": "أهل التقوَى : أهل أو يَـتـّـقِـيَهُ عبادُه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
