{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 66,
  "entries": [
    {
      "verseKey": "66:1",
      "surahNumber": 66,
      "ayahNumber": 1,
      "text": "ما أحلّ الله لك : شرب العسل\\nتبْـتغي : تـَـطلب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "66:2",
      "surahNumber": 66,
      "ayahNumber": 2,
      "text": "تحلّة أيْمانكمْ : تحليلها بالكفّارة\\nالله مولاكمْ : ناصِركم و متولّي أموركم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "66:3",
      "surahNumber": 66,
      "ayahNumber": 3,
      "text": "نبّـأت به : أخْـبَرَتْ به غيرها\\nأظهَرَه الله عليه : أطلعه الله تعالى على إفشائه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "66:4",
      "surahNumber": 66,
      "ayahNumber": 4,
      "text": "صَغَتْ قلوبكما : مَالتْ عن حَقـّه صلى الله عليه و سلم عليكما\\nتظاهَرَا عليه : تتعاونـَا عليه بما يسوءُه\\nهو مولاه : وَليّـه و ناصِره\\nظهير : فوْجٌ مُظاهر معينٌ له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "66:5",
      "surahNumber": 66,
      "ayahNumber": 5,
      "text": "قانتات : مطيعات خاضعاتٍ لله\\nسائحات : مهاجرَاتٍ . أو صائمات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "66:6",
      "surahNumber": 66,
      "ayahNumber": 6,
      "text": "قوا أنفسكم : جَـنّـبوها بالطاعات\\nغِلاظ شِداد : قساةٌ أقوياء و هم الزبانية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "66:8",
      "surahNumber": 66,
      "ayahNumber": 8,
      "text": "توبة نـَـصوحا : خالصة . أو صادقة . أو مقبولة\\nلا يُخزي الله النبي : لا يُـذلّه بل يُعزّه و يكرمه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "66:9",
      "surahNumber": 66,
      "ayahNumber": 9,
      "text": "اغلظ عليهم : شدِّدْ. أو اقـْـسُ عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "66:10",
      "surahNumber": 66,
      "ayahNumber": 10,
      "text": "فخانتاهما : بالنّـفاق أو بالنميمة\\nفلم يغنيا عنهما : فـلمْ يَدْفَعا و لم يمْنعاعنهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "66:12",
      "surahNumber": 66,
      "ayahNumber": 12,
      "text": "أحصنت فرجها : عَـفّـتْ و صانته من الرّجال\\nمن روحنا : روحًا مِنْ خَلقِـنـَـا بلا توسّط أبٍ (عيسى عليه السلام)\\nمن القانتين : من القوم المطيعين لربّهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
