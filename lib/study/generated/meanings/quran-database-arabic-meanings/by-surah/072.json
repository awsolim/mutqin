{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 72,
  "entries": [
    {
      "verseKey": "72:1",
      "surahNumber": 72,
      "ayahNumber": 1,
      "text": "قرآنا عَجَـبا : عجبًـا بديعا في بلاغته و فصاحته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:2",
      "surahNumber": 72,
      "ayahNumber": 2,
      "text": "الرّشد : الحقّ و الصّــواب . أو التوحيد و الإيمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:3",
      "surahNumber": 72,
      "ayahNumber": 3,
      "text": "تعالى : ارتفعَ و عَــُظمَ\\nجدّ ربّـنا : جلاله . أو سلطانه . أو غِـنـَـاه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:4",
      "surahNumber": 72,
      "ayahNumber": 4,
      "text": "يَقول سَفـيهُـنا : جَـاهِـلنا (إبليس اللعين)\\nشططا : قوْلاً مُـفرطًـا في الكذب و الضّـلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:6",
      "surahNumber": 72,
      "ayahNumber": 6,
      "text": "يَعوذون : يَسْـتعيذون و يَتحيّـرون\\nفزادوهمْ رَهَـقـا : إثما . أو طغيانا و سَفَها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:8",
      "surahNumber": 72,
      "ayahNumber": 8,
      "text": "حَرَسًـا شديدا : حُرّاسا أقوياء من الملائكة\\nشُهُـبًـا : شُعل نار تـَـنـْـقـَـضّ كالكواكب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:9",
      "surahNumber": 72,
      "ayahNumber": 9,
      "text": "شِـهابًـا رَصَدًا : راصِدًا ، مُـترقّـبا يَرْجُمه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:10",
      "surahNumber": 72,
      "ayahNumber": 10,
      "text": "رَشَـدًا : خَيْرًا و صَلاحًا و رحمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:11",
      "surahNumber": 72,
      "ayahNumber": 11,
      "text": "طرائق قِدَدًا : ذوي مذاهب مُتفرقة مُختلِفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:12",
      "surahNumber": 72,
      "ayahNumber": 12,
      "text": "ظنـنّـا : عَـلِـمْـنا و أيقـنّـا الآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:13",
      "surahNumber": 72,
      "ayahNumber": 13,
      "text": "فلا يَخاف بخسا : فلا يَخشى نـَـقـْصًـا منْ ثوَابه\\nو لا رهقا : غَـشَيَـان ذِلـّـة له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:14",
      "surahNumber": 72,
      "ayahNumber": 14,
      "text": "منّـا القاسطون : الجَـائرون بكفرهم العادلون عنْ طريق الحقّ\\nتـَـحرّوا رشدا : قـَـصَـدوا خَيرًا و صلاحا و هُـدًى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:15",
      "surahNumber": 72,
      "ayahNumber": 15,
      "text": "لجهنّم حطبا : للنّـار وقودًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:16",
      "surahNumber": 72,
      "ayahNumber": 16,
      "text": "على الطريقة : \\\"طريقة الهدى \\\"\\\"ملـّة الإسلام\\\"\\\"\\\"\\nماءً غَدَقـًـا : كثيرًا يتـّـسِع بع العيش",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:17",
      "surahNumber": 72,
      "ayahNumber": 17,
      "text": "لنفـتِنـَهم فيه : لِنـَـخْـتـَـبرَهم فيما أعْطيناهم\\nيَـسْـلكه : يُدخلـْـه\\nعَذابًا صَعَدًا : شاقّـا يعلوه و يَغلبُـه فلا يُطيقه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:19",
      "surahNumber": 72,
      "ayahNumber": 19,
      "text": "عَـبْدُ الله يَدْعـوه : هو النبي صلى الله عليه و سلم\\nعَـليْه لِبَدًا : مُـتـَـراكِمِين من ازدحامهم عليه تعجّـبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:21",
      "surahNumber": 72,
      "ayahNumber": 21,
      "text": "رَشَدًا : نفعا أو هداية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:22",
      "surahNumber": 72,
      "ayahNumber": 22,
      "text": "لنْ يجيرني من الله : لنْ يمنعَني من عذابه إنْ عَصَـيتـُـه\\nمُلتـَـحَـدا : مَلْجَـأ أوْ حِرْزًا أرْكَنُ إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:25",
      "surahNumber": 72,
      "ayahNumber": 25,
      "text": "أمَدًا : زمنا بعيدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:27",
      "surahNumber": 72,
      "ayahNumber": 27,
      "text": "رَصَدًا : حَرَسا من الملائكة يحرسونه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "72:28",
      "surahNumber": 72,
      "ayahNumber": 28,
      "text": "أحاط : عَلِمَ عِـلمًـا تامّـا\\nأحْصَى : ضَـبَـط ضبطا كاملا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
