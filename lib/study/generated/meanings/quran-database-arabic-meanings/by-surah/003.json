{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 3,
  "entries": [
    {
      "verseKey": "3:2",
      "surahNumber": 3,
      "ayahNumber": 2,
      "text": "الحيّ : الدائم الحياة بلا زوال\\nالقيوم : الدائم القيام بتدبير خلقه و حفظهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:4",
      "surahNumber": 3,
      "ayahNumber": 4,
      "text": "أنزل الفرقان : ما فرق به بين الحق و الباطل\\nالله عزيز : غالب قوي ، منيع الجانب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:7",
      "surahNumber": 3,
      "ayahNumber": 7,
      "text": "آيات محكمات : واضحات لا احتمال فيها و لا اشباه\\nأم الكتاب : أصله يُردّ إليها غيرها\\nمتشابهات : خفيات استأثر الله بعلمها، أو لا تتضح إلابنظر دقيق\\nزيغ : مَيْلٌ وانحرَافٌ عن الحق\\nتأويله : تَفسيرِه بما يُوافِق أَهواءهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:8",
      "surahNumber": 3,
      "ayahNumber": 8,
      "text": "لا تزغ قلوبنا : لا تُمِلْها عن الحق والهُدَى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:11",
      "surahNumber": 3,
      "ayahNumber": 11,
      "text": "كدأب .. : كعادة و شأن ..",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:12",
      "surahNumber": 3,
      "ayahNumber": 12,
      "text": "بئس المهاد : بئس الفراش ، و المضجع جهنم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:13",
      "surahNumber": 3,
      "ayahNumber": 13,
      "text": "لعبرة .. : لعظة و دلالة ..",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:14",
      "surahNumber": 3,
      "ayahNumber": 14,
      "text": "حب الشهوات : المشتهيات بالطبع\\nالمقنطرة : المضاعفة ، أو المحكة المحصنة\\nالمسوّمة : المُعْلمة . أو المطهّمة الحِسان\\nالأنعام : الإبل و البقر و الضّأن و المعْز\\nالحرث : المزروعات\\nحسن المآب : المرجع : أي المرجع الحسن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:17",
      "surahNumber": 3,
      "ayahNumber": 17,
      "text": "القانتين : المطيعين الخاضعين لله تعالى\\nبالأسحار : في أواخر اللّيل إلى طلوع الفجر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:18",
      "surahNumber": 3,
      "ayahNumber": 18,
      "text": "قائما بالقسط : مقيما للعدل في كلّ أمر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:19",
      "surahNumber": 3,
      "ayahNumber": 19,
      "text": "الدّين : الطّاعة و الانقياد لله , أو الملّة\\nالإسلام : الإقرار بالتّوحيد مع التّصديق و العمل بشريعته تعالى\\nبغيا : حسدا و طلبا للرياسة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:20",
      "surahNumber": 3,
      "ayahNumber": 20,
      "text": "أسلمت وجهي لله : أخلصت نفسي أو عبادتي لله\\nالأمّيين : مشركي العرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:22",
      "surahNumber": 3,
      "ayahNumber": 22,
      "text": "حبطت أعمالهم : بطلت أعمالهم و خلت عن ثمراتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:24",
      "surahNumber": 3,
      "ayahNumber": 24,
      "text": "غرّهم : خدعهم و أطمعهم في غير مطمع\\nيفترون : يكذبون على الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:27",
      "surahNumber": 3,
      "ayahNumber": 27,
      "text": "تولج : تُدخل\\nبغير حساب : بلا نهاية لما تعطي أو بتوسعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:28",
      "surahNumber": 3,
      "ayahNumber": 28,
      "text": "أولياء : بطانة أودّاء و أعوانا و أنصارا\\nتتقوا منهم تقاة : تخافوا من جهتهم أمرا يجب اتِّقاؤه\\nيحذركم الله نفسه : يخوفكم الله عضبه و عقابه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:30",
      "surahNumber": 3,
      "ayahNumber": 30,
      "text": "مُحضرا : مشاهدا لها في صحف الأعمال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:33",
      "surahNumber": 3,
      "ayahNumber": 33,
      "text": "آل عمران : عيسى و أمه مريم بنت عمران",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:35",
      "surahNumber": 3,
      "ayahNumber": 35,
      "text": "محرّرا : عتيقا مفرّغا لعبادتك و خدمة بيت المقدس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:36",
      "surahNumber": 3,
      "ayahNumber": 36,
      "text": "أعيذها بك : أجيرها بحفظك و أحصنها بك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:37",
      "surahNumber": 3,
      "ayahNumber": 37,
      "text": "كفّلها زكريا : جعله كافلا لها و ضامنا لمصالحها\\nالمحراب : غرفة عبادتها في بيت المقدس\\nأنّى لك هذا : كيف أو من أين لك هذا ؟\\nبغير حساب : بلا نهاية لما يعطى أو بتوسعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:39",
      "surahNumber": 3,
      "ayahNumber": 39,
      "text": "بكلمةٍ : \\\"بعيسى – خلق بِـ\\\"\\\"كُنْ\\\"\\\" بلا أب\\\"\\nحصورا : لا يأتي النساء مع القدرة على إتيانهن تعففا و زهدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:40",
      "surahNumber": 3,
      "ayahNumber": 40,
      "text": "أنّى يكون؟ : كيف أو منْ أين يكون ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:41",
      "surahNumber": 3,
      "ayahNumber": 41,
      "text": "آية : علامة على حمل زوجتي لأشكرك\\nأن لا تكلّم النّاس : أن تعجز عن تكليمهم بغير آفة\\nإلاّ رمزا : إلا إيماءً و إشارةً\\nسبِّح بالعشيِّ : صلِّ من الزّوال إلى الغروب\\nالإبكار : من طلوع الفجر إلى الضّحى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:43",
      "surahNumber": 3,
      "ayahNumber": 43,
      "text": "اقنتي : أخلصي العبادة و أديمي الطاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:44",
      "surahNumber": 3,
      "ayahNumber": 44,
      "text": "يُلقون أقلامهم : يطرحون سهامهم للاقتراع بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:45",
      "surahNumber": 3,
      "ayahNumber": 45,
      "text": "بكلمة منه : \\\"بقول \\\"\\\" كنْ\\\"\\\" مُبتدِإٍ من الله\\\"\\nوجيها : ذا جاهٍ و قدْرٍ و شرف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:46",
      "surahNumber": 3,
      "ayahNumber": 46,
      "text": "في المهْد : في مقرِّه زمن رضاعِه قبل أوان الكلام\\nكهلاً : حال اكتمال قُوَّتِه (بعد نزوله)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:47",
      "surahNumber": 3,
      "ayahNumber": 47,
      "text": "قضى أمرًا : أراد شيئًا . أو أحكمهُ و حتَّمه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:48",
      "surahNumber": 3,
      "ayahNumber": 48,
      "text": "الكتاب : الخط باليد كأحسن ما يكون\\nالحكمة : الفقه أو الصَّواب قولا و عملا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:49",
      "surahNumber": 3,
      "ayahNumber": 49,
      "text": "أخْلقُ لكم : أُصوِّر لكم و أقدِّر لردِّ إنكاركم\\nأُبرئُ الأكمه : أخلِّص الأعمى خِلقةً من العمى\\nما تدّخِرون : ما تخبئونه للأكل فيما بعد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:52",
      "surahNumber": 3,
      "ayahNumber": 52,
      "text": "أحسَّ : عَلِمَ بِلا شُبهةٍ\\nالحواريّون : أصدقاء عيسى و خواصُّه و أنصاره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:54",
      "surahNumber": 3,
      "ayahNumber": 54,
      "text": "مكروا : أي الكفار فدبّروا اغتياله\\nمَكَرَ الله : دبّر تدبيرا مُحكما أبطل مكرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:55",
      "surahNumber": 3,
      "ayahNumber": 55,
      "text": "مُتوفِّيك : آخِذُك وافيًا بروحك و بدنك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:59",
      "surahNumber": 3,
      "ayahNumber": 59,
      "text": "مثل عيسى : حاله و صفته العجيبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:60",
      "surahNumber": 3,
      "ayahNumber": 60,
      "text": "الممْترين : الشّاكِّين في أنه الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:61",
      "surahNumber": 3,
      "ayahNumber": 61,
      "text": "تعالوا : هلمُّوا ، أقبِلوا بالعزم و الرأْي\\nنبْتهل : ندْع باللّعنة على الكاذب منّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:64",
      "surahNumber": 3,
      "ayahNumber": 64,
      "text": "كلمة سواءٍ : كلامٍ عدل أولا تختلف فيه الشرائع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:67",
      "surahNumber": 3,
      "ayahNumber": 67,
      "text": "كان حنيفًا : مائلاً عن الباطل إلى الدِّن الحق\\nمُسلما : موحّدا . أو منقادا لله مطيعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:68",
      "surahNumber": 3,
      "ayahNumber": 68,
      "text": "وليّ المؤمنين : ناصرهم و مجازيهم بالحسنى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:71",
      "surahNumber": 3,
      "ayahNumber": 71,
      "text": "تلبِسون : تخلِطون أو تستُرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:75",
      "surahNumber": 3,
      "ayahNumber": 75,
      "text": "عليه قائما : ملازما له تطالبهُ و تُقاضيه\\nفي الأمٍّيِّين : فيما أصبنا من أمول العرب\\nسبيل : عِتاب و ذمٌّ أو إثمٌ و حرجٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:77",
      "surahNumber": 3,
      "ayahNumber": 77,
      "text": "لا خلاق لهم : لا نصيب من الخير أو لا قدْر لهم\\nلا ينظُر إليهم : لا يُحسن إليهم و لا يرحمهم\\nلا يزكّيهم : لا يطهِّرُهم أو لا يُثني عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:78",
      "surahNumber": 3,
      "ayahNumber": 78,
      "text": "يلوون ألسنتهم : يُميلونها عن الصحيح إلى المحرَّف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:79",
      "surahNumber": 3,
      "ayahNumber": 79,
      "text": "الحُكْمَ : الحِكمة أو الفهم و العِلم\\nكونوا ربَّانيِّين : علماء مُعلِّمين فقهاء في الدِّين\\nتدْرسون : تقْرؤون الكِتاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:81",
      "surahNumber": 3,
      "ayahNumber": 81,
      "text": "إِصري : عهدي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:83",
      "surahNumber": 3,
      "ayahNumber": 83,
      "text": "له أسلم : له انقاد و خضع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:84",
      "surahNumber": 3,
      "ayahNumber": 84,
      "text": "الأسباط : أولاد يعقوب أو أحفاده",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:85",
      "surahNumber": 3,
      "ayahNumber": 85,
      "text": "الإسلام : التوحيد أو شريعة نبينا صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:88",
      "surahNumber": 3,
      "ayahNumber": 88,
      "text": "يُنْظَرون : يؤخّرون عن العذاب لحظة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:92",
      "surahNumber": 3,
      "ayahNumber": 92,
      "text": "البِرّ : الإحسان و كمال الخير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:93",
      "surahNumber": 3,
      "ayahNumber": 93,
      "text": "إسرائيل : يعقوب بن إسحاق عليهما السلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:95",
      "surahNumber": 3,
      "ayahNumber": 95,
      "text": "حنيفا : مائلاً عن الباطل إلى الدِّين الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:96",
      "surahNumber": 3,
      "ayahNumber": 96,
      "text": "بِبكّة : مكة المكرمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:99",
      "surahNumber": 3,
      "ayahNumber": 99,
      "text": "تبغونها عِوجاً : تطلبونها مُعْوجّة أو ذات اعوجاج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:101",
      "surahNumber": 3,
      "ayahNumber": 101,
      "text": "من يعتصِم بالله : يلتجِئ إليه أو يستمسك بدينه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:102",
      "surahNumber": 3,
      "ayahNumber": 102,
      "text": "حقّ تُقاتِه : حقّ تقواه : أي اتقاءً حقًّا واجبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:103",
      "surahNumber": 3,
      "ayahNumber": 103,
      "text": "اعتصموا بحبل الله : تمسّكوا بعهده أو دينه أو كتابه\\nشفا حُفرة : طرف حفرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:111",
      "surahNumber": 3,
      "ayahNumber": 111,
      "text": "أذى : ضررًا يسيرا بالكذِب أو التهديد\\nُيولّوكم الأدبار : ينهزموا و يُخْذلوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:112",
      "surahNumber": 3,
      "ayahNumber": 112,
      "text": "ضُرِبت عليهم : أحاطت بهم أو ألصقت بهم\\nالذِلة : الذلّ و الصَّغار و الهوان\\nثُقِفوا : وُجٍدوا أو أُدْرِكوا\\nبحبلٍ من الله : بعهدٍ منه تعالى و هو الإسلام\\nحبل من الناّس : عهدٍ من المسلمين\\nباءُوا بغضب : رجعوا به مستحِقّين له\\nالمَسْكنة : فقر النفس و شُحُّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:113",
      "surahNumber": 3,
      "ayahNumber": 113,
      "text": "ليسوا سواءً : ليس أهل الكتاب بمُستوين\\nأُمّة قائمة : طائفةٌ مستقيمة ثابتة على الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:116",
      "surahNumber": 3,
      "ayahNumber": 116,
      "text": "لنْ تغني عنهم : لنْ تدفع عنهم أو تجزي عنهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:117",
      "surahNumber": 3,
      "ayahNumber": 117,
      "text": "فيها صِرٌّ : بردٌ شديد أو سمومٌ حارّة\\nحرث قوم : زرعهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:118",
      "surahNumber": 3,
      "ayahNumber": 118,
      "text": "بِطانة : خواصَّ يستبطنون أمركم\\nلا يألونكم خبالا : لا يقصِّرون في فساد دينكم\\nودُّوا ما عنتُّم : أحبّوا مشقّتكم الشديدة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:119",
      "surahNumber": 3,
      "ayahNumber": 119,
      "text": "خَلوْا : مَضَوْا . أو انفرد بعضهم ببعض\\nمن الغيظ : أشدّ الغضب و الحَنَق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:121",
      "surahNumber": 3,
      "ayahNumber": 121,
      "text": "غدوت : خرجت أوّل النهار من المدينة\\nتبوّئُ : تُنزِلُ و تُوطّن\\nمقاعدَ للقتال : مواطن و مواقف له يوم أُحُد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:122",
      "surahNumber": 3,
      "ayahNumber": 122,
      "text": "أن تفشلا : تجْبُنا و تضْعُفا عن القتال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:123",
      "surahNumber": 3,
      "ayahNumber": 123,
      "text": "أذلّةٌ : بقلّة العدد و العُدّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:124",
      "surahNumber": 3,
      "ayahNumber": 124,
      "text": "أن يمِدّكم : يقوّيكم و يعينكم يوم بدر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:125",
      "surahNumber": 3,
      "ayahNumber": 125,
      "text": "يأتوكم : أي المشركون\\nفورهم هذا : ساعتهم هذه بلا إبطاء\\nمسوّمين : مُعلنين أنفسهم أو خيلهم بعلامات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:127",
      "surahNumber": 3,
      "ayahNumber": 127,
      "text": "ليقطع طرفا : ليُهلِك طائفة\\nيكبِتهم : يُخزيهم و يغمّهم بالهزيمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:130",
      "surahNumber": 3,
      "ayahNumber": 130,
      "text": "مضاعفة : كثيرة و قليل الرّبا ككثيره حرام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:134",
      "surahNumber": 3,
      "ayahNumber": 134,
      "text": "السرّاء و الضرّاء : اليسر و العسر\\nالكاظمين الغيظ : الحابسين غيظهم في قلوبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:135",
      "surahNumber": 3,
      "ayahNumber": 135,
      "text": "فعلوا فاحشة : معصية كبيرة متناهية في القُبح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:137",
      "surahNumber": 3,
      "ayahNumber": 137,
      "text": "خلت : مضت و انْقضت\\nسننٌ : وقائع في الأمم المُكذّبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:139",
      "surahNumber": 3,
      "ayahNumber": 139,
      "text": "لا تهِنوا : لا تضعفوا عن قتال أعدائكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:140",
      "surahNumber": 3,
      "ayahNumber": 140,
      "text": "قرْحٌ : جراحة يوم أُحُدْ\\nقرحٌ مثله : يوم بدر\\nنداولُها : نصرّفُها بأحوالٍ مُختلفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:141",
      "surahNumber": 3,
      "ayahNumber": 141,
      "text": "لمحِّص : ليُصفي و يُطهّر من الذنوب\\nيمحق : يُهلك و يستأصل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:145",
      "surahNumber": 3,
      "ayahNumber": 145,
      "text": "كتابا مُؤجلاً : مؤقتا بوقت معلوم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:146",
      "surahNumber": 3,
      "ayahNumber": 146,
      "text": "كأيّن من نبيّ : كم من نبيّ – كثير من الأنبياء\\nرِبّيون : علماء فقهاء أو جموع كثيرة\\nفما وهنوا : فما عجزوا أو فما جبُنوا\\nما استكانوا : ما خضعوا أو ذلّوا لعدوّهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:150",
      "surahNumber": 3,
      "ayahNumber": 150,
      "text": "الله مولاكم : الله ناصركم لا غيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:151",
      "surahNumber": 3,
      "ayahNumber": 151,
      "text": "الرّعب : الخوف و الفزع\\nسُلطانا : حُجّةً و برهانا\\nمثوى الظّالمين : مأواهم و مُقامُهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:152",
      "surahNumber": 3,
      "ayahNumber": 152,
      "text": "تحُسّونهم : تقتلونهم قتلاً ذريعاً\\nفشِلتم : فزعتم و جبُنتُم عن عدوّكم\\nليبتلِيكم : ليمتحِن صبركم و ثباتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:153",
      "surahNumber": 3,
      "ayahNumber": 153,
      "text": "تُصعِدون : تذهبون في الوادي هربا\\nلا تلوون : لا تُعرّجون\\nفأثابكم : فجازاكم الله بما عصيتم\\nغمّا بغم : حزنا متّصلا بحزن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:154",
      "surahNumber": 3,
      "ayahNumber": 154,
      "text": "أمنةً : أمنا و عدم حوف\\nنُعاسا : سكونا و هدوءًا أو مُقاربة للنّوم\\nيغشى : يُلابس كالغشاء\\nلبرز : لخرج\\nمضاجعهم : مصارعهم المقدّرة لهم أزلا\\nلبتلِي : ليختبر و ليمتحِن و هو العليم الخبير\\nليُمحّص : ليخلّص و يزيل أو ليكشف و يميز",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:155",
      "surahNumber": 3,
      "ayahNumber": 155,
      "text": "استزلّهم الشّيطان : حملهم على الزّلة بوسوسته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:156",
      "surahNumber": 3,
      "ayahNumber": 156,
      "text": "ضربوا : سافروا لتجارة أو غيرها فماتوا\\nغزًّى : غُزاةً مجاهدين فاستشهدوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:159",
      "surahNumber": 3,
      "ayahNumber": 159,
      "text": "فبما رحمة : فبرحمة عظيمة\\nلِنْتَ لهم : سهّلْتَ لهم أخلاقكَ و لم تُعنِّفهم\\nفظّا : جافيا في المُعاشرة قولا و فعلا\\nلانفضّوا : لتفرّقوا و نفروا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:160",
      "surahNumber": 3,
      "ayahNumber": 160,
      "text": "فلا غالب لكم : فلا قاهر و لا خاذل لكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:161",
      "surahNumber": 3,
      "ayahNumber": 161,
      "text": "يغُلّ : يخون في الغنيمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:162",
      "surahNumber": 3,
      "ayahNumber": 162,
      "text": "باء بسخطٍ : رجع متلبِّسا بعضب شديد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:164",
      "surahNumber": 3,
      "ayahNumber": 164,
      "text": "يُزكّيهم : يُطهّرهم من أدناس الجاهلية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:165",
      "surahNumber": 3,
      "ayahNumber": 165,
      "text": "أنّى هذا ؟ : من أين لنا هذا الخذلان ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:168",
      "surahNumber": 3,
      "ayahNumber": 168,
      "text": "فادْرءُوا : فادفعوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:172",
      "surahNumber": 3,
      "ayahNumber": 172,
      "text": "أصابهم القرح : نالتهم الجراح يوم أُحُدْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:178",
      "surahNumber": 3,
      "ayahNumber": 178,
      "text": "أنّما نُملي لهم : أنّ إمهالنا لهم مع كفرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:179",
      "surahNumber": 3,
      "ayahNumber": 179,
      "text": "يجتبي : يصطفي و يختار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "3:180",
      "surahNumber": 3,
      "ayahNumber": 180,
      "text": "سيُطوّقون : سيُجعل طوقا في أعناقهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
