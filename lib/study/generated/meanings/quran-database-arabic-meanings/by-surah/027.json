{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 27,
  "entries": [
    {
      "verseKey": "27:2",
      "surahNumber": 27,
      "ayahNumber": 2,
      "text": "هدًى : هادٍ من الضّلالة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:4",
      "surahNumber": 27,
      "ayahNumber": 4,
      "text": "فهم يعمهون : يعمون عن الرّشد أو يتحيّرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:7",
      "surahNumber": 27,
      "ayahNumber": 7,
      "text": "آنستُ نارًا : أبصرتها إبصارا بيـّــنا\\nبشهاب قبس : بشُعلة نار ساطعة مقبوسة من أصلها\\nتصطلون : تستدفئون بها من البرد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:8",
      "surahNumber": 27,
      "ayahNumber": 8,
      "text": "بُورك : قدّس و طُهّرَ و زيد خيرا\\nمن في النار و من حولها : الذين في ذلك الوادي الذي بدا فيه النور و هم موسى و الملائكة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:10",
      "surahNumber": 27,
      "ayahNumber": 10,
      "text": "تهتزّ : تتحرّك بشدة و اضطراب\\nكأنّها جانّ : حيّة خفيفة في سرعة حركتها\\nلم يُعقّب : لم يرجع على عقِبه أو لم يلتفت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:12",
      "surahNumber": 27,
      "ayahNumber": 12,
      "text": "في جيبك : فتحة القميص حيث يُدخل الرّأس\\nبيضاء : نيّرة يغلب نورها نور الشمس\\nغير سوء : غير داء برص و نحوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:13",
      "surahNumber": 27,
      "ayahNumber": 13,
      "text": "مبصرة : واضحة بيّـنة هادية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:14",
      "surahNumber": 27,
      "ayahNumber": 14,
      "text": "عُلوّا : ترفّعا و استكبارا عن الإيمان بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:16",
      "surahNumber": 27,
      "ayahNumber": 16,
      "text": "منطِق الطّير : فهم أغراضه كلّها من أصواته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:17",
      "surahNumber": 27,
      "ayahNumber": 17,
      "text": "فهم يوزعون : يوقف أوائلهم لتلحقهم أواخرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:18",
      "surahNumber": 27,
      "ayahNumber": 18,
      "text": "لا يحطمنّكم : لا يكسرنّكم و يُهلِكنّكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:19",
      "surahNumber": 27,
      "ayahNumber": 19,
      "text": "أوزعني . . : ألهمني و حرّضني و اجعلني . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:21",
      "surahNumber": 27,
      "ayahNumber": 21,
      "text": "بسلطانٍ مبين : بحجّة تبيّن عُذره في غيبته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:25",
      "surahNumber": 27,
      "ayahNumber": 25,
      "text": "يُخرج الخبء : يُظهر المخبوء المستور أيّا كان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:28",
      "surahNumber": 27,
      "ayahNumber": 28,
      "text": "تولّى عنهم : تنحّ عنهم قليلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:31",
      "surahNumber": 27,
      "ayahNumber": 31,
      "text": "لا تعلو عليّ : لا تتكبّروا عليّ\\nمُسلمين : مؤمنين . أو مُنقادين مستسلمين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:32",
      "surahNumber": 27,
      "ayahNumber": 32,
      "text": "تشهدونِ : تحضرون . أو تشيروا عليّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:33",
      "surahNumber": 27,
      "ayahNumber": 33,
      "text": "أولوا بأس : أصحاب نجدة و بلاءٍ في الحرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:37",
      "surahNumber": 27,
      "ayahNumber": 37,
      "text": "لا قِبَل لهم بها : لا طاقة لهم بمقاومتها\\nهم صاغرون : ذليلون بالأسر و الإستعباد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:40",
      "surahNumber": 27,
      "ayahNumber": 40,
      "text": "الذي عنده علم : آصَـفُ أو جبريل أو ملك آخر\\nطرْفك : نظرك . أو جفن عينك بعد فتحه\\nليبلُوَني : لِيخْـتبرني و يمتحنني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:41",
      "surahNumber": 27,
      "ayahNumber": 41,
      "text": "نكّروا : غيّروا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:44",
      "surahNumber": 27,
      "ayahNumber": 44,
      "text": "ادخلي الصّرح : القصر . أو ساحته أو بركته\\nحسبته لُجّة : ظنّـتـه ماءً غزيرا\\nصرح ممرّد : مُمَـلّس مُسوّى\\nمن قوارير : زجاج شفّاف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:47",
      "surahNumber": 27,
      "ayahNumber": 47,
      "text": "اطّيّرنا : تشاءمنا حيث أصبنا بالشّداد\\nطائركم عند الله : شؤمكم عملكم المكتوب عليكم عنده تعالى\\nقوم تُفتنون : يفتنكم الشّيطان بوسوسته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:48",
      "surahNumber": 27,
      "ayahNumber": 48,
      "text": "تسعة رهط : أشخاص من الرّؤساء مع كلّ رهط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:49",
      "surahNumber": 27,
      "ayahNumber": 49,
      "text": "تقاسموا بالله : تحالفوا بالله . أو احلِفوا به\\nلنُبيّـتـنّه و أهلَه : لنقتلنّهم ليلا بغتة\\nمهْلِك أهله : هلاكهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:51",
      "surahNumber": 27,
      "ayahNumber": 51,
      "text": "دمّرناهم : أهلكناهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:52",
      "surahNumber": 27,
      "ayahNumber": 52,
      "text": "خاوية : خالية خربَة أو ساقطة متهدّمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:54",
      "surahNumber": 27,
      "ayahNumber": 54,
      "text": "أنتم تُبصرون : لا تبالون إظهارها مَجَانَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:56",
      "surahNumber": 27,
      "ayahNumber": 56,
      "text": "يتطهّرون : يزعمون التـّـنـزّه عمّا نفعل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:57",
      "surahNumber": 27,
      "ayahNumber": 57,
      "text": "قدّرناها : حكمنا عليها\\nمن الغابرين : بجعلها من الباقين في العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:58",
      "surahNumber": 27,
      "ayahNumber": 58,
      "text": "مطرا : حجارة من السّماء مُهلِكَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:60",
      "surahNumber": 27,
      "ayahNumber": 60,
      "text": "حدائق ذات بهجة : بساتين ذات حُسن و رونق\\nقوم يعدِلون : ينحرفون عن الحقّ إلى الباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:61",
      "surahNumber": 27,
      "ayahNumber": 61,
      "text": "الأرض قرارا : مستقرّا بالدّحو و التـّسوية\\nرواسي : جبالا ثوابت لئلاّ تميد\\nحاجزا : فاصلا يمنع اختلاطهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:63",
      "surahNumber": 27,
      "ayahNumber": 63,
      "text": "رحمته : المطر الذي به تـَحـْيَى الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:66",
      "surahNumber": 27,
      "ayahNumber": 66,
      "text": "إدّارك علمهم في الآخرة : تكامل و استحكم علمهم بأحوالها و هو تهكّم بهم لفرْط جهلهم بها\\nعمون : عُمي البصائر عن دلائلها البيّـنة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:68",
      "surahNumber": 27,
      "ayahNumber": 68,
      "text": "أساطير الأوّلين : أكاذيبهم المُسطّر في كتبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:70",
      "surahNumber": 27,
      "ayahNumber": 70,
      "text": "ضيق : حرج و ضيق صدر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:72",
      "surahNumber": 27,
      "ayahNumber": 72,
      "text": "ردِف لكم : لحقكم و وصل إليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:74",
      "surahNumber": 27,
      "ayahNumber": 74,
      "text": "ما تكنّ صدورهم : ما تُخفي و تستر من الأسرار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:75",
      "surahNumber": 27,
      "ayahNumber": 75,
      "text": "غائبة : شيء يغيب و يخفى عن الخلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:82",
      "surahNumber": 27,
      "ayahNumber": 82,
      "text": "وقع القول : دنت الساعة و أهوالها الموعودة\\nدابّة : هي من أشراط السّاعة الكبرى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:83",
      "surahNumber": 27,
      "ayahNumber": 83,
      "text": "فوجا : جماعة و زمرة\\nفهم يوزعون : يُوقف أوائلُهم لتلحقهم أواخرهم ثمّ يُساقون جميعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:87",
      "surahNumber": 27,
      "ayahNumber": 87,
      "text": "ففزع : خاف خوفا يستتبع الموت\\nداخرين : صاغرين أذلاّء بعد البعث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "27:90",
      "surahNumber": 27,
      "ayahNumber": 90,
      "text": "فكُـبـّـت وجوههم : ألقوا منكوسين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
