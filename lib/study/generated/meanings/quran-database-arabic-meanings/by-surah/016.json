{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 16,
  "entries": [
    {
      "verseKey": "16:1",
      "surahNumber": 16,
      "ayahNumber": 1,
      "text": "تعالى : تعاظم بذاته و صفاته الجليلة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:2",
      "surahNumber": 16,
      "ayahNumber": 2,
      "text": "بالرّوح : بالوحي و منه القرآن العظيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:4",
      "surahNumber": 16,
      "ayahNumber": 4,
      "text": "نطفة : ماء مهين\\nهو خصيمٌ : شديد الخصومة بالباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:5",
      "surahNumber": 16,
      "ayahNumber": 5,
      "text": "الأنعام : الإبل و البقر و الضّأن و المعز\\nفيها دفءٌ : ما تتدفّئون به من البرد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:6",
      "surahNumber": 16,
      "ayahNumber": 6,
      "text": "فيها جمال : تجمّل و تزيّن و وجاهة\\nحين تريحون : تردّونها بالعشيّ إلى المُراح\\nحين تسرحون : تخرجونها بالغداة إلى المسرح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:7",
      "surahNumber": 16,
      "ayahNumber": 7,
      "text": "تحمل أثقالكم : أمتعتكم الثقيلة الحمل\\nبشقّ الأنفس : بمشقّتها و تعبها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:9",
      "surahNumber": 16,
      "ayahNumber": 9,
      "text": "قصد السّبيل : بيان الطريق القاصد المستقيم\\nمنها جائر : من السّبيل مائل عن الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:10",
      "surahNumber": 16,
      "ayahNumber": 10,
      "text": "فيع تُسيمون : فيه ترعون دوابّكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:13",
      "surahNumber": 16,
      "ayahNumber": 13,
      "text": "درأ لكم : خلق و أبدع لمنافعكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:14",
      "surahNumber": 16,
      "ayahNumber": 14,
      "text": "تستخرجوا منه : من البحر الملح خاصّة\\nمواخر فيه : جواري فيه تشقّ الماء شقّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:15",
      "surahNumber": 16,
      "ayahNumber": 15,
      "text": "رواسي : جبالا ثوابت\\nأن تميد بكم : لئلا تتحرّك و تضطرب بكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:16",
      "surahNumber": 16,
      "ayahNumber": 16,
      "text": "علامات : معالم للطرق تهتدون بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:18",
      "surahNumber": 16,
      "ayahNumber": 18,
      "text": "لا تُحصوها : لا تطيقوا حصرها لعدم تناهيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:23",
      "surahNumber": 16,
      "ayahNumber": 23,
      "text": "لا جَرَم : حقّ و ثبت ، أو لا محالة أو حقّاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:24",
      "surahNumber": 16,
      "ayahNumber": 24,
      "text": "أساطير الأوّلين : أباطيلهم المسطّرة في كتبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:25",
      "surahNumber": 16,
      "ayahNumber": 25,
      "text": "أوزارهم : آثامهم و ذنوبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:26",
      "surahNumber": 16,
      "ayahNumber": 26,
      "text": "القواعد : الدعائم و العمد . أو الأساس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:27",
      "surahNumber": 16,
      "ayahNumber": 27,
      "text": "يُخزيهم : يُذلّهم و يهينهم بالعذاب\\nتُشاقّون فيه : تُخاصمون و تعادون الأنيباء فيهم\\nالخزي : الذلّ و الهوان\\nالسّوء : العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:28",
      "surahNumber": 16,
      "ayahNumber": 28,
      "text": "فألقوا السّلم : أظهروا الإستسلام و الخضوع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:29",
      "surahNumber": 16,
      "ayahNumber": 29,
      "text": "مثوى المُتكبّرين : مأواهم و مقامُهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:32",
      "surahNumber": 16,
      "ayahNumber": 32,
      "text": "طيّبين : طاهرين من دنسالشّرك و المعاصي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:34",
      "surahNumber": 16,
      "ayahNumber": 34,
      "text": "حاق بهم : أحاط . أو نزل بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:36",
      "surahNumber": 16,
      "ayahNumber": 36,
      "text": "اجتنبوا الطّاغوت : كلّ معبود باطل و كلّ داع إلى ضلالة\\nحقّت : ثبتت و وجبت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:38",
      "surahNumber": 16,
      "ayahNumber": 38,
      "text": "جهد أيمانهم : مجتهدين في الحلف بأغلظها و أوكدها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:41",
      "surahNumber": 16,
      "ayahNumber": 41,
      "text": "لنُبوّئنّهم : لننزلنّهم\\nحسنةً : مباءة أو داراً أو عطيّة حسنة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:44",
      "surahNumber": 16,
      "ayahNumber": 44,
      "text": "بالبيّنات : أرسلناهم بالمعجزات\\nالزّبُر : كتب الشّرائع و التكاليف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:45",
      "surahNumber": 16,
      "ayahNumber": 45,
      "text": "يخسف. . : يُغيّب . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:46",
      "surahNumber": 16,
      "ayahNumber": 46,
      "text": "تقلّبهم : أسفارهم و متاجرهم\\nبمُعجزين : فائتين من عذاب الله بالهرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:47",
      "surahNumber": 16,
      "ayahNumber": 47,
      "text": "تخوّف : مخافة من العذاب . أو تَنَقُّص",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:48",
      "surahNumber": 16,
      "ayahNumber": 48,
      "text": "من شيء : من جسم قائم له ظلّ\\nيتفيّأ ضلاله : تميل و تنتقل من جانب إلى آخر\\nسُجّدًا لله : منقادة لِحُكمه و تسخيره تعالى\\nو هم داخرون : و الظِلال صاغرون منقادون كأصحابها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:52",
      "surahNumber": 16,
      "ayahNumber": 52,
      "text": "له الدّين : الطّاعة و الإنقياد لله تعالى وحده\\nواصبا : دائما واجبا لازما أو خالصا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:53",
      "surahNumber": 16,
      "ayahNumber": 53,
      "text": "تجأرون : تضِجّون بالإستغاثة و التّضرّع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:56",
      "surahNumber": 16,
      "ayahNumber": 56,
      "text": "تفترون : تكذبونه على الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:58",
      "surahNumber": 16,
      "ayahNumber": 58,
      "text": "هو كظيم : ممتلئ غمّا و غيظا في قرارة نفسه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:59",
      "surahNumber": 16,
      "ayahNumber": 59,
      "text": "يتوارى : يستخفي و يتغيّب\\nهون : هوان و ذلّ\\nيدسّه : يُخفيه بالوأد فيدفنه حيّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:60",
      "surahNumber": 16,
      "ayahNumber": 60,
      "text": "مثل السّوء : صفته القبيحة من الجهل و الكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:62",
      "surahNumber": 16,
      "ayahNumber": 62,
      "text": "لا جرَمَ : حقّ و ثبت . أو لا محالة أو حقّا\\nمُفرطون : مُقدّمون معجّلٌ بهم إلى النار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:66",
      "surahNumber": 16,
      "ayahNumber": 66,
      "text": "لعبرةً : لعظة عظيمة و دلالة على قدرتنا\\nفرث : ما في الكَرش من الثُّــفْـلِ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:67",
      "surahNumber": 16,
      "ayahNumber": 67,
      "text": "سكرًا : خمرا (ثمّ حُرّمت بالمدينة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:68",
      "surahNumber": 16,
      "ayahNumber": 68,
      "text": "أوحى ربّك : الإيحاء هنا الإلهام و الإرشاد أو التسخير\\nبيوتًا : أوكارا تبنيها لِتعسِل فيها\\nيعرشون : يَبني الناس من الخلايا للنّحل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:69",
      "surahNumber": 16,
      "ayahNumber": 69,
      "text": "ذللا : مذلّلة مُسهّلة لك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:70",
      "surahNumber": 16,
      "ayahNumber": 70,
      "text": "أرذل العمر : أردئه و أخسِّه (الخَرَف و الهرَم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:71",
      "surahNumber": 16,
      "ayahNumber": 71,
      "text": "فهم فيه سواء ؟ : أفهم في الرّزق مُستوون ؟ ؟ لاَ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:72",
      "surahNumber": 16,
      "ayahNumber": 72,
      "text": "حفدة : خدمًا و أعوانًا ، أو أولاد أولاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:76",
      "surahNumber": 16,
      "ayahNumber": 76,
      "text": "أحدهما أبكم : أخرس خِلقة\\nهو كلٌّ : عبءٌ و عِيال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:77",
      "surahNumber": 16,
      "ayahNumber": 77,
      "text": "كلمح البصر : كخطفة بالبصر و اختلاس بالنّظر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:80",
      "surahNumber": 16,
      "ayahNumber": 80,
      "text": "تستخفونها : تجدونها خفيفة الحمل\\nيوم ظعنكم : وقت ترحالكم\\nأثاثا : متاعا لبُيوتكم كالفرش\\nمتاعا : تنتفعون به في معايشكم و متاجركم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:81",
      "surahNumber": 16,
      "ayahNumber": 81,
      "text": "ظلالا : أشياء تستظلون بها كالأشجار\\nأكنانا : مواضع تستكِنّون فيها (الغيران)\\nسرابيل : ما يُلبس من ثياب أو دروع\\nتقيكم بأسكم : الضّرب و الطّعن في حروبكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:84",
      "surahNumber": 16,
      "ayahNumber": 84,
      "text": "لا هو يستعتبون : لا يُطلب منهم إرضاءُ ربّهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:85",
      "surahNumber": 16,
      "ayahNumber": 85,
      "text": "يُنظرون : يُمهَلون و يؤخّرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:87",
      "surahNumber": 16,
      "ayahNumber": 87,
      "text": "السّلَم : الإستسلام و الإنقياد لحكمه تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:90",
      "surahNumber": 16,
      "ayahNumber": 90,
      "text": "يأمر بالعدل : بالإعتدال و التّوسّط في الأمور اعتقادا و عملا و خُلُقا\\nالإحسان : إتقان العمل . أو نفعِ الخلق\\nالفحشاء : الذنوب المفرطة في القُبح\\nالبغي : التّطاول و التّجبّر على النّاس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:91",
      "surahNumber": 16,
      "ayahNumber": 91,
      "text": "كفيلا : شاهدا . رقيبا . ضامِنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:92",
      "surahNumber": 16,
      "ayahNumber": 92,
      "text": "قوّة : إبرام و إحكام\\nأنكاثا : أنقاضا محلول الفتل\\nدخلا بينكم : مفسدة و خيانة و خديعة بينكم\\nأن تكون أمّة : بأن تكون جماعة\\nهي أربى : أكثر و أعزّ و أوفر مالا\\nيبلوكم الله به : يختبركم به هل تفون بعهدكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:94",
      "surahNumber": 16,
      "ayahNumber": 94,
      "text": "فتزلّ قدم : فتزلّ أقدامُكم عن محجّة الإسلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:96",
      "surahNumber": 16,
      "ayahNumber": 96,
      "text": "ينفد : ينقضي و يفنى و يزول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:98",
      "surahNumber": 16,
      "ayahNumber": 98,
      "text": "فاستعذ بالله : فاعتصم به تعالى و الجأ إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:99",
      "surahNumber": 16,
      "ayahNumber": 99,
      "text": "سلطان : تَسلّطٌ و ولاية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:100",
      "surahNumber": 16,
      "ayahNumber": 100,
      "text": "يتولّونه : يتّخذونه وليّا مُطاعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:102",
      "surahNumber": 16,
      "ayahNumber": 102,
      "text": "روح القدس : الرّوح المطهّر جبريل عليه السلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:103",
      "surahNumber": 16,
      "ayahNumber": 103,
      "text": "يُلحدون إليه : يُميلون و ينسُبُون إليه أنّه يُعلّمه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:107",
      "surahNumber": 16,
      "ayahNumber": 107,
      "text": "استحبّوا : اختاروا و آثَروا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:108",
      "surahNumber": 16,
      "ayahNumber": 108,
      "text": "طبع : ختم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:109",
      "surahNumber": 16,
      "ayahNumber": 109,
      "text": "لا جرَمَ : حقّ و ثبت أو لا مَحالة أو حقّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:110",
      "surahNumber": 16,
      "ayahNumber": 110,
      "text": "للذين هاجروا : لهم بالولاية و النّصر لا عليهم\\nفُتنوا : ابتُلوا و عُذّبوا لإسلامهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:112",
      "surahNumber": 16,
      "ayahNumber": 112,
      "text": "رغدا : طيّبا واسعا أو هنيئا لا عناء فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:115",
      "surahNumber": 16,
      "ayahNumber": 115,
      "text": "الدّم : المسفوح و هو السائل\\nلحم الخنزير : أي الخنزير بجميع أجزائه\\nأهلّ بغير الله به : ذكِر عند ذبحه اسم غيره تعالى\\nاضطر : دعته الضّرورة إلى التّناول منه\\nغير باغ : غير طالب للمُحرّم للَذة إو استئثار\\nو لا عاد : و لا مُجاوز ما يسدّ الرّمق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:119",
      "surahNumber": 16,
      "ayahNumber": 119,
      "text": "بجهالة : بتعدّي الطّور و ركوب الرّأس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:120",
      "surahNumber": 16,
      "ayahNumber": 120,
      "text": "كان أمّة : معلِّما للخير ، أو مؤمنا وحده\\nقانتا لله : مُطيعا خاضعا له تعالى\\nحنيفا : مائلا عن الباطل إلى الدّين الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:121",
      "surahNumber": 16,
      "ayahNumber": 121,
      "text": "اجتباه : اصطفاه و اختاره للنُّبوّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:123",
      "surahNumber": 16,
      "ayahNumber": 123,
      "text": "ملّة إبراهيم : شريعته ، و هي التّوحيد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:124",
      "surahNumber": 16,
      "ayahNumber": 124,
      "text": "جُعِل السّبت : فُرض تعظيمُه و التّخلّي فيه للعبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "16:127",
      "surahNumber": 16,
      "ayahNumber": 127,
      "text": "ضيْق : ضيق صدر و حَرَج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
