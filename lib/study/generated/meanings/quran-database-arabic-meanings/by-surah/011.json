{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 11,
  "entries": [
    {
      "verseKey": "11:1",
      "surahNumber": 11,
      "ayahNumber": 1,
      "text": "أُحكمت آياته : نُظمت نظما مُحكما رصينا\\nفصّلت : فرّقت في التّنزيل نجوما بالحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:5",
      "surahNumber": 11,
      "ayahNumber": 5,
      "text": "يثنون صدورهم : يطوونها على الكفر و العداوة\\nليستخفوا منه : من الله تعالى جهلا منهم\\nيستغشون ثيابهم : يتغطّون بها مُبالغة في الاستخفاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:6",
      "surahNumber": 11,
      "ayahNumber": 6,
      "text": "يعلم مُستقرّها : موضع استقرارها في الأصلاب ، أو في الأرحام و نحوها\\nمستودعها : موضع استيداعها في الأرحام و نحوها ، أو في الأصلاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:7",
      "surahNumber": 11,
      "ayahNumber": 7,
      "text": "ليبلُوكم : ليختبركم و هو أعلم بأمركم\\nأحسن عملا : أطوع لله و أروع عن محارمه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:8",
      "surahNumber": 11,
      "ayahNumber": 8,
      "text": "أمّة معدودة : طائفة من الأيّام قليلة\\nحاق بهم : نزل أو أحاط بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:9",
      "surahNumber": 11,
      "ayahNumber": 9,
      "text": "إنّه ليئوس : شديد اليأس و القنوط\\nكفور : كثير الكفران للنّعم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:10",
      "surahNumber": 11,
      "ayahNumber": 10,
      "text": "ضرّاء مسّته : نائبة و نكبة أصابته\\nإنه لفرح : لَبَطِرٌ بالنّعمة ، مغترّ بها\\nفخور : على النّاس بما أوتي من النعماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:12",
      "surahNumber": 11,
      "ayahNumber": 12,
      "text": "وكيل : قائمٌ به حافظ له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:15",
      "surahNumber": 11,
      "ayahNumber": 15,
      "text": "لا يُبخسون : لا يُنقصون شيئا من أُجور أعمالهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:16",
      "surahNumber": 11,
      "ayahNumber": 16,
      "text": "حبط : بَطَلَ في الآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:17",
      "surahNumber": 11,
      "ayahNumber": 17,
      "text": "بيّنة : يقين و برهان واضح و هو القرآن\\nشاهد : على تنزيله و هو اعجاز نظمه\\nمرية منه : شكّ من تنزيله من عند الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:18",
      "surahNumber": 11,
      "ayahNumber": 18,
      "text": "الأشهاد : الملائكة و النّبيّون و الجوارح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:19",
      "surahNumber": 11,
      "ayahNumber": 19,
      "text": "يبغونها عوجا : يطلبونها معوجّة أو ذات اعوجاج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:20",
      "surahNumber": 11,
      "ayahNumber": 20,
      "text": "مُعجزين : فائتين من عذاب الله بالهرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:22",
      "surahNumber": 11,
      "ayahNumber": 22,
      "text": "لا جرَمَ : حقّ و ثبت أو لا محالة أو حقّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:23",
      "surahNumber": 11,
      "ayahNumber": 23,
      "text": "أخبتوا إلى ربّهم : اطمأنّوا على وعده أو خشعوا له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:27",
      "surahNumber": 11,
      "ayahNumber": 27,
      "text": "الملأُ : السادة و الرّؤساء\\nبادي الرأي : ظاهره دون تعمّق و تثبّت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:28",
      "surahNumber": 11,
      "ayahNumber": 28,
      "text": "أرأيتم : أخبروني\\nفعُمّيت عليكم : أُخفيت عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:31",
      "surahNumber": 11,
      "ayahNumber": 31,
      "text": "خزائن الله : خزائن رزقه و ماله\\nتزدري أعينكم : تستحقرهم و تستهين بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:33",
      "surahNumber": 11,
      "ayahNumber": 33,
      "text": "ما أنتم بمُعجزين : بفائتين من عذاب الله بالهرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:34",
      "surahNumber": 11,
      "ayahNumber": 34,
      "text": "أن يُغويكم : يضلّكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:35",
      "surahNumber": 11,
      "ayahNumber": 35,
      "text": "فعليّ إجرامي : عقاب اكتساب ذنبي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:36",
      "surahNumber": 11,
      "ayahNumber": 36,
      "text": "فلا تبتئس : فلا تحزن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:37",
      "surahNumber": 11,
      "ayahNumber": 37,
      "text": "بأعيننا : بحفظنا و كلاءتنا الكاملين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:39",
      "surahNumber": 11,
      "ayahNumber": 39,
      "text": "يُخزيه : يذلّه و يُهينه\\nيحلّ عليه : يجب عليه و ينزل به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:40",
      "surahNumber": 11,
      "ayahNumber": 40,
      "text": "فار التّنّور : نبع الماء و جاش بشدّة من تنّور الخبز المعروف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:41",
      "surahNumber": 11,
      "ayahNumber": 41,
      "text": "مجريها : وقت إجرائها\\nمُرساها : وقت إرسائها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:43",
      "surahNumber": 11,
      "ayahNumber": 43,
      "text": "سآوي : سألتجئُ و أستندُ\\nلا عاصم : لا مانع و لا حافظ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:44",
      "surahNumber": 11,
      "ayahNumber": 44,
      "text": "أقلعي : أمسكي عن إنزال المطر\\nغيظ الماء : نقص و ذهب في الأرض\\nاستوت على الجوديّ : استقرّت على جبل بقُرب الموصل\\nبُعدا : هلاكا و سُحقا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:48",
      "surahNumber": 11,
      "ayahNumber": 48,
      "text": "بركات : خيرات ثابتة نامية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:51",
      "surahNumber": 11,
      "ayahNumber": 51,
      "text": "فطرني : خلقني و أبدعني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:52",
      "surahNumber": 11,
      "ayahNumber": 52,
      "text": "السّماء : المطر\\nمدرارا : غزيرا ممتابعا بلا إضرار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:54",
      "surahNumber": 11,
      "ayahNumber": 54,
      "text": "اعتراك : أصابك\\nبسوء : بجنون و خَبَل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:55",
      "surahNumber": 11,
      "ayahNumber": 55,
      "text": "فكيدوني : فاحتالوا في كيدي و ضرّي\\nلا تُنظرون : لا تمهلوني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:56",
      "surahNumber": 11,
      "ayahNumber": 56,
      "text": "آخذ بناصيتها : مالكها و قادر عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:57",
      "surahNumber": 11,
      "ayahNumber": 57,
      "text": "حفيظ : رقيب مُهيمن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:58",
      "surahNumber": 11,
      "ayahNumber": 58,
      "text": "غليظ : شديد مُضاعف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:59",
      "surahNumber": 11,
      "ayahNumber": 59,
      "text": "جبّار : مُتعاظم مُتكبّر\\nعنيد : طاغٍ معاند للحقّ مُجانب له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:60",
      "surahNumber": 11,
      "ayahNumber": 60,
      "text": "بُعدا لعاد : هلاكا و سُحقا لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:61",
      "surahNumber": 11,
      "ayahNumber": 61,
      "text": "استعمركم فيها : جعلكم عُمّارها و سُكاّنها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:62",
      "surahNumber": 11,
      "ayahNumber": 62,
      "text": "مُريب : موقع في الرّيبة و القلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:63",
      "surahNumber": 11,
      "ayahNumber": 63,
      "text": "أرأيتم : أخبروني\\nبيّنة : يقين و برهان و بصيرة\\nتخسير : خسرانٍ إن عصيته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:64",
      "surahNumber": 11,
      "ayahNumber": 64,
      "text": "آية : مُعجزة دالّة على صدق نبوّتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:67",
      "surahNumber": 11,
      "ayahNumber": 67,
      "text": "الصّيحة : صوت من السّماء مُهلك\\nجاثمين : هامدين ميّتين لا يتحرّكون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:68",
      "surahNumber": 11,
      "ayahNumber": 68,
      "text": "لم يغنوا فيها : لم يُقيموا فيها طويلا في رغدٍ\\nبُعدا لثمود : هلاكا و سُحقا لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:69",
      "surahNumber": 11,
      "ayahNumber": 69,
      "text": "بعجل حنيذٍ : مشويّ بالحجارة المحمّاة في حُفرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:70",
      "surahNumber": 11,
      "ayahNumber": 70,
      "text": "نكِرهم : أنكرهم و نفر منهم\\nأوجس منهم خيفة : أحسّ في قلبه منهم خوفا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:72",
      "surahNumber": 11,
      "ayahNumber": 72,
      "text": "يا ويلتا : كلمة تعجّب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:73",
      "surahNumber": 11,
      "ayahNumber": 73,
      "text": "مجيد : كثير الخير و الإحسان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:74",
      "surahNumber": 11,
      "ayahNumber": 74,
      "text": "الرّوع : الخوف و الفزع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:75",
      "surahNumber": 11,
      "ayahNumber": 75,
      "text": "لحليم : مُتأنّ غير عجول\\nأوّاه : كثير التّأوّه من خوف الله\\nمنيب : راجع إلى الله سبحانه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:77",
      "surahNumber": 11,
      "ayahNumber": 77,
      "text": "سيء بهم : نالته المساءة يمجيئهم خوفا عليهم\\nضاق بهم ذرعا : ضعُفت طاقته عن تدبير خلاصهم\\nيوم عصيب : شديد شرّه و بلاؤه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:78",
      "surahNumber": 11,
      "ayahNumber": 78,
      "text": "يُهرعون إليه : يُسرعون إليه كأنّهم يُدفعون\\nلا تُخزون : لا تفضحوني و لا تُهينوني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:79",
      "surahNumber": 11,
      "ayahNumber": 79,
      "text": "من حقّ : من حاجة و أَرَب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:80",
      "surahNumber": 11,
      "ayahNumber": 80,
      "text": "آوي إلى ركن : أنضمّ إلى قويّ أنتصر به عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:81",
      "surahNumber": 11,
      "ayahNumber": 81,
      "text": "بقطعٍ من الليل : بطائفة منه أو من آخره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:82",
      "surahNumber": 11,
      "ayahNumber": 82,
      "text": "سجيل : طين طُبخ بالنّار كالفخّار\\nمنضود : متتابع أو مجموع معدّ للعذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:83",
      "surahNumber": 11,
      "ayahNumber": 83,
      "text": "مسوّمةً : معلمة العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:84",
      "surahNumber": 11,
      "ayahNumber": 84,
      "text": "أراكم بخير : بسعة نُغنيكم عن التطفيف\\nيوم مُحيط : مُهلك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:85",
      "surahNumber": 11,
      "ayahNumber": 85,
      "text": "بالقسط : بالعدل بلا زيادة و لا نُقصان\\nلا تبخسوا : لا تنقصوا\\nلا تعثوا : لا تُفسدوا أشدّ الإفساد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:86",
      "surahNumber": 11,
      "ayahNumber": 86,
      "text": "بقيّة الله : ما أبقاه لكم من الحلال\\nبحفيظ : برقيب فأجازيكم بأعمالكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:88",
      "surahNumber": 11,
      "ayahNumber": 88,
      "text": "أرأيتم : أخبروني\\nبيّنة : هداية و بصيرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:89",
      "surahNumber": 11,
      "ayahNumber": 89,
      "text": "لا يجرمنّكم : لا يكسبنّكم أو لا يحملنّكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:91",
      "surahNumber": 11,
      "ayahNumber": 91,
      "text": "رهطك : جماعتك و عشيرتك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:92",
      "surahNumber": 11,
      "ayahNumber": 92,
      "text": "وراءكم ظهريّا : منبوذا وراء ظهوركم منسيّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:93",
      "surahNumber": 11,
      "ayahNumber": 93,
      "text": "مكانتكم : غاية تمكّنكم من أمركم\\nارتقبوا : انتظروا العاقبة و المآل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:94",
      "surahNumber": 11,
      "ayahNumber": 94,
      "text": "الصّيحة : صوت من السّماء مُهلكٌ مُرجفٌ\\nجاثمين : هامدين ميّتين لا يتحرّكون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:95",
      "surahNumber": 11,
      "ayahNumber": 95,
      "text": "لم يغنوا فيها : لن يُقيموا فيها طويلا في رغد\\nبُعدا لمدين : هلاكا و سُحقا لهم\\nبَعدت ثمود : هلكت من قبل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:96",
      "surahNumber": 11,
      "ayahNumber": 96,
      "text": "سُلطان ميبن : بُرهان بيّن على صدق رسالته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:98",
      "surahNumber": 11,
      "ayahNumber": 98,
      "text": "يقدُم قومه : يتقدّمهم كما يتقدّم الوارد\\nفأوردهم النّار : أدخلهم فيها بكفره و كفرهم\\nالورد المورود : المدخل المدخول فيه و هو النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:99",
      "surahNumber": 11,
      "ayahNumber": 99,
      "text": "الرّفد المرفود : العطاء المُعطى لهم و هو اللّعنة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:100",
      "surahNumber": 11,
      "ayahNumber": 100,
      "text": "حصيد : عافي الأثر ، كالزّرع المحصود",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:101",
      "surahNumber": 11,
      "ayahNumber": 101,
      "text": "غير تتبيب : غير تخسير و إهلاك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:106",
      "surahNumber": 11,
      "ayahNumber": 106,
      "text": "زفير : إخراج شديد للنّفس من الصّدر\\nشهيق : ردّ النّفس إلى الصّدر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:108",
      "surahNumber": 11,
      "ayahNumber": 108,
      "text": "غير مجذوذ : غير مقطوع عنهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:110",
      "surahNumber": 11,
      "ayahNumber": 110,
      "text": "مُريب : موقع في الرّيبة و قلق النّفس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:112",
      "surahNumber": 11,
      "ayahNumber": 112,
      "text": "لا تطغوا : لا تُجاوزوا ما حدّه الله لكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:113",
      "surahNumber": 11,
      "ayahNumber": 113,
      "text": "لا تركنوا . . : لا تَمِلْ قلوبكم بالمحبّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:114",
      "surahNumber": 11,
      "ayahNumber": 114,
      "text": "زُلفا من الليل : ساعات منه قريبة من النّهار\\nذكرا للذّاكرين : عِظة للمتّعظين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:116",
      "surahNumber": 11,
      "ayahNumber": 116,
      "text": "القرون : الأمم\\nأولوا بقية : أصحاب فضل و خير\\nما أُترفوا فيه : ما أنعموا فيه من الخصب و السّعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:119",
      "surahNumber": 11,
      "ayahNumber": 119,
      "text": "تمّت : وجبت و ثبتت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "11:121",
