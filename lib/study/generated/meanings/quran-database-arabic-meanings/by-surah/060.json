  "entries": [
    {
      "verseKey": "60:1",
      "surahNumber": 60,
      "ayahNumber": 1,
      "text": "أولياء : أعوانا توادونهم و تناصحونهم\\nأن تؤمنوا : لإيمانكم أو كراهة إيمانكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "60:2",
      "surahNumber": 60,
      "ayahNumber": 2,
      "text": "يثقفوكم : يَظفروا بكم . أو يصادفوكم\\nيبسطوا إليكم : يمدّوا إليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "60:4",
      "surahNumber": 60,
      "ayahNumber": 4,
      "text": "أسوة حسنة : قدوة حميدة في التـَّـبَـرّي من الضالين\\nبُرَآءُ منكم : أبرياء منكم\\nإليك أنـَــبْنا : إليك رَجَعْنا تائبين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "60:5",
      "surahNumber": 60,
      "ayahNumber": 5,
      "text": "لا تجعلنا فـتنة : مفتونين بهم معذبين بأيديهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "60:8",
      "surahNumber": 60,
      "ayahNumber": 8,
      "text": "تبرّوهم : تحْسنوا إليهم و تكرموهم\\nتـُـقسِطوا إليهم : تـُـفـضوا إليهم بالقسْط و العدل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "60:9",
      "surahNumber": 60,
      "ayahNumber": 9,
      "text": "ظاهروا : عاوَنوا الذين قاتلوكم و أخرجوكم\\nأن توَلّوْهمْ : أن تتخذوهم أولياء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "60:10",
      "surahNumber": 60,
      "ayahNumber": 10,
      "text": "فامْتـَـحنوهنّ : فاختبروهن و كان ذلك بالتحْـليف\\nأجورهنّ : مُهورهنّ\\nبعِصم الكوافر : بعقود نكاح المشركات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "60:11",
      "surahNumber": 60,
      "ayahNumber": 11,
      "text": "فاتكم شيء : انفلتَ أحدٌ بردّة\\nفعاقبتمْ : فَغَزوتم فغَنمتم منهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "60:12",
      "surahNumber": 60,
      "ayahNumber": 12,
      "text": "ببُـهتان : بإلصاق اللّـقـطاء بالأزواج\\nيفترينه : يَختـَـلِقـنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "60:13",
      "surahNumber": 60,
      "ayahNumber": 13,
      "text": "لا تتولوْا : لا تتخذوا أولياء\\nقوْمًـا : هم اليَهود ، أو الكفار عامّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
