  "entries": [
    {
      "verseKey": "32:3",
      "surahNumber": 32,
      "ayahNumber": 3,
      "text": "افتراه : اختلق القرآن من تِلقاء نفسه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:4",
      "surahNumber": 32,
      "ayahNumber": 4,
      "text": "استوى على العرش : استواءً يليق بكماله و جلاله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:5",
      "surahNumber": 32,
      "ayahNumber": 5,
      "text": "يعرُج إليه : يصعد الأمر و يرتفع إليه بعد تدبيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:7",
      "surahNumber": 32,
      "ayahNumber": 7,
      "text": "أحسَن كلّ شيء : أحكمه و أتقنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:8",
      "surahNumber": 32,
      "ayahNumber": 8,
      "text": "سلالة : خُلاصة\\nماءٍ مهين : منيّ ضعيف حقير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:9",
      "surahNumber": 32,
      "ayahNumber": 9,
      "text": "سوّاه : قوّمه بتصوير أعضائه و تكميلها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:10",
      "surahNumber": 32,
      "ayahNumber": 10,
      "text": "ضللنا في الأرض : ضِعنا فيها و صرنا ترابا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:12",
      "surahNumber": 32,
      "ayahNumber": 12,
      "text": "ناكِسوا رءوسهم : مُطْرقُها خِزياً و حياءً و ندماً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:13",
      "surahNumber": 32,
      "ayahNumber": 13,
      "text": "حقّ القول : ثبت و تحقّق و نفذ القضاء\\nالجـِـنّة : الجنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:16",
      "surahNumber": 32,
      "ayahNumber": 16,
      "text": "تتجافى جنوبهم : ترتفع و تتنحّى للعبادة\\nعن المضاجع : الفُرُش التي يُضطجع عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:17",
      "surahNumber": 32,
      "ayahNumber": 17,
      "text": "من قرّة أعين : من موجـِــبات المسرّة و الفرح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:19",
      "surahNumber": 32,
      "ayahNumber": 19,
      "text": "نـزُلاً : ضِيافة . و عطاءً. و تكرمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:23",
      "surahNumber": 32,
      "ayahNumber": 23,
      "text": "في مِريَة : في شكّ\\nمن لقائه : تلقّيه إياه بالرّضا و القبول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:26",
      "surahNumber": 32,
      "ayahNumber": 26,
      "text": "أوَ لم يهدِ لهم ؟ : أغفلوا و لم يُبيّن لهم مآلهم ؟\\nكم أهلكنا . . : كثرة إهلاكنا الأمم قبلهم\\nالقرون : الأمم الخالية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:27",
      "surahNumber": 32,
      "ayahNumber": 27,
      "text": "الأرض الجُرز : اليابسة الجرداء التي قُطِعَ نباتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:28",
      "surahNumber": 32,
      "ayahNumber": 28,
      "text": "هذا الفتح : النّصْرُ علينا ، أو الفصل للخصومة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "32:29",
      "surahNumber": 32,
      "ayahNumber": 29,
      "text": "يُنظَرون : يُمهَلون ليُؤمنوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
