  "surahNumber": 49,
  "entries": [
    {
      "verseKey": "49:1",
      "surahNumber": 49,
      "ayahNumber": 1,
      "text": "لا تقدّموا : لا تقطعوا أمرا و تجزموا به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "49:2",
      "surahNumber": 49,
      "ayahNumber": 2,
      "text": "أن تحبط أعمالكم : كراهة أن تبطل أعمالكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "49:3",
      "surahNumber": 49,
      "ayahNumber": 3,
      "text": "يغضون أصواتهمْ : يَخفضونها و يُخافتون بها\\nامتحن الله قلوبَهم : أخلصها و صفّـاها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "49:4",
      "surahNumber": 49,
      "ayahNumber": 4,
      "text": "الحجرات : حجرات زوجاته صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "49:7",
      "surahNumber": 49,
      "ayahNumber": 7,
      "text": "لعَنتـّـمْ : لأثمْتم و هَلـَـكتمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "49:9",
      "surahNumber": 49,
      "ayahNumber": 9,
      "text": "بَغَتْ : اعتدت و اسْتطالت و أبَتِ الصلح\\nتفيء : تَرْجع\\nأقسطوا : اعدلوا في كل أموركم\\nالمقسطين : العادلين فيُـحْسِنُ جزاءَهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "49:11",
      "surahNumber": 49,
      "ayahNumber": 11,
      "text": "لا يسْخرْ : لا يهْـزأ و لا ينتقصْ\\nلا تلمزوا أنفسكم : لا يَعِبْ و لا يَطعَن بعضكم بعضا\\nلا تنابزوا بالألقاب : لا تداعوْا بالألقاب المستكرَهة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "49:12",
      "surahNumber": 49,
      "ayahNumber": 12,
      "text": "كثيرًا من الظنّ : هو ظنّ السوء بأهل الخير\\nلا تجسّـسوا : لا تتبعوا عوْرات المسلمين\\nفكرهتموه : فقد كرهتموه فلا تفعلوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "49:14",
      "surahNumber": 49,
      "ayahNumber": 14,
      "text": "آمنّـا : صدقنا بقلوبنا و ألسنتنا\\nلمْ تؤمنوا : لمْ تصدقوا بقلوبكم\\nأسْلمْـنـَـا : استسلمنا خَوفا و طمعًا\\nلا يَلتكمْ : لا ينْقصكمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "49:16",
      "surahNumber": 49,
      "ayahNumber": 16,
      "text": "أتعلـّـمون الله بدينكم : أتخبرونه بقوْلكم آمنّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
