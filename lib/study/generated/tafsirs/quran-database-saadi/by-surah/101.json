  "entries": [
    {
      "verseKey": "101:1",
      "surahNumber": 101,
      "ayahNumber": 1,
      "text": "{ الْقَارِعَةُ } من أسماء يوم القيامة، سميت بذلك، لأنها تقرع الناس وتزعجهم بأهوالها، ولهذا عظم أمرها وفخمه .",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:2",
      "surahNumber": 101,
      "ayahNumber": 2,
      "text": "مَا الْقَارِعَةُ",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:3",
      "surahNumber": 101,
      "ayahNumber": 3,
      "text": "وَمَا أَدْرَاكَ مَا الْقَارِعَةُ",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:4",
      "surahNumber": 101,
      "ayahNumber": 4,
      "text": "{ يَوْمَ يَكُونُ النَّاسُ } من شدة الفزع والهول، { كَالْفَرَاشِ الْمَبْثُوث } أي: كالجراد المنتشر، الذي يموج بعضه في بعض، والفراش: هي الحيوانات التي تكون في الليل، يموج بعضها ببعض لا تدري أين توجه، فإذا أوقد لها نار تهافتت إليها لضعف إدراكها، فهذه حال الناس أهل العقول،",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:5",
      "surahNumber": 101,
      "ayahNumber": 5,
      "text": "وأما الجبال الصم الصلاب، فتكون { كَالْعِهْنِ الْمَنْفُوشِ } أي: كالصوف المنفوش، الذي بقي ضعيفًا جدًا، تطير به أدنى ريح، قال تعالى: { وَتَرَى الْجِبَالَ تَحْسَبُهَا جَامِدَةً وَهِيَ تَمُرُّ مَرَّ السَّحَابِ } ثم بعد ذلك، تكون هباء منثورًا، فتضمحل ولا يبقى منها شيء يشاهد، فحينئذ تنصب الموازين، وينقسم الناس قسمين: سعداء وأشقياء،",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:6",
      "surahNumber": 101,
      "ayahNumber": 6,
      "text": "{ فَأَمَّا مَنْ ثَقُلَتْ مَوَازِينُهُ } أي: رجحت حسناته على سيئاته",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:7",
      "surahNumber": 101,
      "ayahNumber": 7,
      "text": "{ فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ } في جنات النعيم.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:8",
      "surahNumber": 101,
      "ayahNumber": 8,
      "text": "{ وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ } بأن لم تكن له حسنات تقاوم سيئاته.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:9",
      "surahNumber": 101,
      "ayahNumber": 9,
      "text": "{ فَأُمُّهُ هَاوِيَةٌ } أي: مأواه ومسكنه النار، التي من أسمائها الهاوية، تكون له بمنزلة الأم الملازمة كما قال تعالى: { إِنَّ عَذَابَهَا كَانَ غَرَامًا } .\n\nوقيل: إن معنى ذلك، فأم دماغه هاوية في النار، أي: يلقى في النار على رأسه.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:10",
      "surahNumber": 101,
      "ayahNumber": 10,
      "text": "{ وَمَا أَدْرَاكَ مَاهِيَهْ } وهذا تعظيم لأمرها،",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "101:11",
      "surahNumber": 101,
      "ayahNumber": 11,
      "text": "{ نَارٌ حَامِيَةٌ } أي: شديدة الحرارة، قد زادت حرارتها على حرارة نار الدنيا سبعين ضعفًا. نستجير بالله منها.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
