  "surahNumber": 46,
  "entries": [
    {
      "verseKey": "46:3",
      "surahNumber": 46,
      "ayahNumber": 3,
      "text": "أجل مسمّى : بتقدير أجل مسمّى و هو يوم القيامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:4",
      "surahNumber": 46,
      "ayahNumber": 4,
      "text": "أرأيتم : أخبروني\\nلهم شرك : شركة و نـَـصيبٌ مع الله تعالى\\nأثارةٍ من علم : بَقيّة من علم عندكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:8",
      "surahNumber": 46,
      "ayahNumber": 8,
      "text": "تفيضون فيه : تندفعون فيه طعنا و تكذيبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:9",
      "surahNumber": 46,
      "ayahNumber": 9,
      "text": "بدْعًا : بديعا منفردًا فيما جئتُ به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:10",
      "surahNumber": 46,
      "ayahNumber": 10,
      "text": "أرأيتم : أخبروني ماذا حالكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:11",
      "surahNumber": 46,
      "ayahNumber": 11,
      "text": "إفكٌ قديم : كذبٌ متقادمٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:15",
      "surahNumber": 46,
      "ayahNumber": 15,
      "text": "وصّينا الإنسان : أمرناه و ألزمناه\\nكُرْها : ذات كرْهٍ و مشقة\\nحمله و فِصاله : مدّة حمله و فطامه من الرّضاع\\nبَلغ أشدّه : بَلـَغ َ كمال قوته و عقله\\nربّي أوزعني : ألهمني ووفقني و رغّبني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:17",
      "surahNumber": 46,
      "ayahNumber": 17,
      "text": "أفّ لكما : كلمة تضجّرٍ و تبرّمٍ و كراهيّة\\nأن أخرَج : أُبْعَثَ من القبر بعد الموت\\nخلـَـتْ القرون : مضتِ الأمم و لم تبعَث\\nويلكَ : هلكتَ و المراد حثـّه على الإيمان\\nآمنْ : صدّقْ بالله و بالبعْث\\nأساطير الأوّلين : أباطيلهم المسطّرة في كتبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:18",
      "surahNumber": 46,
      "ayahNumber": 18,
      "text": "حقّ عليهم القول : وَجَبَ عليهم وعيد العذاب\\nقد خَلـَتْ : مَضتْ و تقدّمت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:20",
      "surahNumber": 46,
      "ayahNumber": 20,
      "text": "عذاب الهون : الهوان و الذلّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:21",
      "surahNumber": 46,
      "ayahNumber": 21,
      "text": "أخا عاد : هودا عليه السّلام\\nبالأحقاف : وادٍ بين عُمان و أرض مَهْرَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:22",
      "surahNumber": 46,
      "ayahNumber": 22,
      "text": "لتأفكنا : لتصرفنا . أو لتزيلنا بالإفك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:24",
      "surahNumber": 46,
      "ayahNumber": 24,
      "text": "عارضا : سحابا يعرض في الأفق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:25",
      "surahNumber": 46,
      "ayahNumber": 25,
      "text": "تـُدمّر : تـُهلِك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:26",
      "surahNumber": 46,
      "ayahNumber": 26,
      "text": "مكّـنّاهم : أقدرناهم و بسطنا لهم\\nفيما إن مكّـنّـاكم فيه : في الذي ما مكّـنّـاكم فيه\\nفما أغنى عنهم : فما دفع عنهم\\nحاق بهم : أحاط أو نزل بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:27",
      "surahNumber": 46,
      "ayahNumber": 27,
      "text": "صرّفنا الآيات : كررناها بأساليب مُختلفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:28",
      "surahNumber": 46,
      "ayahNumber": 28,
      "text": "قربانـًا آلهة ً : متقرّبـًـا بهم إلى الله\\nإفكُهُمْ : أثر كذبهم في اتخاذها آلهة\\nيفترون : يختلقونه في قوْلهم إنها آلهة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:29",
      "surahNumber": 46,
      "ayahNumber": 29,
      "text": "صرفنا إليك : أمَلْـنا ووجهنا نَحْوَك\\nأنصتوا : اسكتوا و اصغوا لنسمعه\\nقضِيَ : أتمّ و فُــِرغ من قراءة القرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:32",
      "surahNumber": 46,
      "ayahNumber": 32,
      "text": "فليس بمعجزٍ : لله فائت منه بالهَرَب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:33",
      "surahNumber": 46,
      "ayahNumber": 33,
      "text": "لم يعيَ بخلقِهنّ : لم يتعب به أو لم يعجز عنه\\nبلى : هو قادر على إحياء الموتى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "46:35",
      "surahNumber": 46,
      "ayahNumber": 35,
      "text": "أولوا العزم : ذوو الجـِــدّ و الثبات و الصّبر\\nبلاغ : هذا تبليغ من رسولنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
