{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 54,
  "entries": [
    {
      "verseKey": "54:1",
      "surahNumber": 54,
      "ayahNumber": 1,
      "text": "انشقّ القمَر : قدِ انفلق فَـلـْـقـتيْن مُعْجزة له صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:2",
      "surahNumber": 54,
      "ayahNumber": 2,
      "text": "سِـحْـرٌ : دائمٌ . أوْ مُـحْـكمٌ أو ذاهبٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:3",
      "surahNumber": 54,
      "ayahNumber": 3,
      "text": "مسْـتـَقِـرّ : مُـنـْــتـهٍ إلى غاية يستقـرّ عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:4",
      "surahNumber": 54,
      "ayahNumber": 4,
      "text": "مُزدجَرٌ : ازدجار و انتِهارٌ و ردْعٌ عمّا هم فيه من الكفر و الضلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:5",
      "surahNumber": 54,
      "ayahNumber": 5,
      "text": "النّذر : الرّسل أو الأمور المُـخَـوِّفـَـة لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:6",
      "surahNumber": 54,
      "ayahNumber": 6,
      "text": "شيءٍ نُـكُـر : منكر فظيع (هوْل يوم القيامة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:7",
      "surahNumber": 54,
      "ayahNumber": 7,
      "text": "خشّعا أبصارُهمْ : ذليلة خاضِعة من شدة الهوْل\\nالأجْدَاث : القبور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:8",
      "surahNumber": 54,
      "ayahNumber": 8,
      "text": "مُهْطعين : مسْرعين ، مادِّي أعناقهمْ\\nيومٌ عَسِر : صعْب شديدٌ لِعِظم أهْواله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:9",
      "surahNumber": 54,
      "ayahNumber": 9,
      "text": "ازدجـِـر : زُجـِـرَ عن تبليغ رسالته بالسّبّ و غيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:10",
      "surahNumber": 54,
      "ayahNumber": 10,
      "text": "مَـغلوبٌ فانتصِرْ : مَقـْـهورٌ فانـْـتـَـقِم لي منهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:11",
      "surahNumber": 54,
      "ayahNumber": 11,
      "text": "أبْْواب السماء : السّحاب\\nبماءٍ منهمِر : مُنـْـصبّ بشدّة و غزارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:12",
      "surahNumber": 54,
      "ayahNumber": 12,
      "text": "فجّرنا الأرض : شققناها\\nأمْــٍر قدْ قـُـدِرَ : قدّرْناه أزَلاً (هلاكهم بالطوفان)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:13",
      "surahNumber": 54,
      "ayahNumber": 13,
      "text": "دُسُــٍر : مَسَاميرَ تـُـشدّ بها الألواح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:14",
      "surahNumber": 54,
      "ayahNumber": 14,
      "text": "تجْري بأعْـيُـننا : بـِـحِـفـْـظِنا أو بمرأى منّا أو بأمْرنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:15",
      "surahNumber": 54,
      "ayahNumber": 15,
      "text": "تـَركْناها آية : أبْقـينا ذكْرَها عِـبرة و عِـظة\\nمُـدّكِر : مُعتبر، متـّـعِظٍ بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:16",
      "surahNumber": 54,
      "ayahNumber": 16,
      "text": "نُـذر : إنذاري",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:19",
      "surahNumber": 54,
      "ayahNumber": 19,
      "text": "ريحًا صَرْصَرا : شديدة السّموم أو البرْدأو الصّوت\\nيَوْم نحْس : شؤْم عليهم\\nمستمرّ : دائم نحسُهُ. أو مُحكمٍ . أو بَشِع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:20",
      "surahNumber": 54,
      "ayahNumber": 20,
      "text": "تنزع النّاس : تقـلعهم منْ أماكنهم و ترمي بهم\\nأعجاز نخل : أصوله بلا رُءوس\\nمنقعِر : منـْـقلع عن قعْره و مَغرسِه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:24",
      "surahNumber": 54,
      "ayahNumber": 24,
      "text": "سُعُر : شدّة عذاب و نار أو جنون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:25",
      "surahNumber": 54,
      "ayahNumber": 25,
      "text": "كذاب أشر : بَطِرٌ مُـتكبّرْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:27",
      "surahNumber": 54,
      "ayahNumber": 27,
      "text": "فتنة لهم ْ : امتحانا و ابتلاءً لهم\\nاصْـطبـِـرْ : اصبرْ على أذاهمْ و لا تعجَلْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:28",
      "surahNumber": 54,
      "ayahNumber": 28,
      "text": "قِـسْمَة بينهم : مَقـسومٌ بَـيـْـنهم و بين النـّـاقة\\nكلّ شِرْب : كلّ نصيب و حصّة من الماء\\nمُحْـتـَـضرٌ : يحْضره صاحبه في نـَوبته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:29",
      "surahNumber": 54,
      "ayahNumber": 29,
      "text": "فَتـَـعاطى : فتناول النّـاقة بسيْـفِه اجْتراءً منه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:31",
      "surahNumber": 54,
      "ayahNumber": 31,
      "text": "كهشيم : كاليابس المُـتـفـتـّـت من شجر الحظيرة\\nالمُحتظِر : صانع الحظيرة (الزّريبة) لمواشيه من هذا الشجر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:34",
      "surahNumber": 54,
      "ayahNumber": 34,
      "text": "حاصبًا : ريحًا ترميهم بالحصباء\\nنجّـيناهم بسَحَر : عـند اصداع الفجْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:36",
      "surahNumber": 54,
      "ayahNumber": 36,
      "text": "أنذرهم بَطْـشتنا : أخْذتـَـنـَـا الشديدة بالعذاب\\nفتمارَوْا بالنّـذر : فكَذبوا بها مُتشاكّين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:37",
      "surahNumber": 54,
      "ayahNumber": 37,
      "text": "راوَدوه عنْ ضيـْـفه : طَلـَـبوا منه تمكينهم منهم\\nفطمسْنا أعينهم : أعميْناهم أو أزلنا أثرَها بمَسْحِها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:38",
      "surahNumber": 54,
      "ayahNumber": 38,
      "text": "بكرةً : أوّل النهار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:43",
      "surahNumber": 54,
      "ayahNumber": 43,
      "text": "في الزّبر : في الكتب السّماويّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:44",
      "surahNumber": 54,
      "ayahNumber": 44,
      "text": "نحن جميعٌ : جماعة ، مجتمعٌ أمْرنا\\nمُنتصر : مُـمْـتـَـنِعٌ ، لا نُغلب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:46",
      "surahNumber": 54,
      "ayahNumber": 46,
      "text": "السّاعة أدْهى : أعظم داهية و أفظع\\nأمَرّ : أشدّ مرارة منْ عذاب الدنيا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:47",
      "surahNumber": 54,
      "ayahNumber": 47,
      "text": "سُعُر : نيران مسعّرة أو جُـنـُـون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:49",
      "surahNumber": 54,
      "ayahNumber": 49,
      "text": "خلقـناه بقـَـدَر : بتقدير سابق أو مُـقدّرًا مُحْكَما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:50",
      "surahNumber": 54,
      "ayahNumber": 50,
      "text": "إلا واحدة : \\\"كلمة واحدة ، هي \\\"\\\"كُـنْ\\\"\\\"\\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:51",
      "surahNumber": 54,
      "ayahNumber": 51,
      "text": "أشياعكمْ : أمثالهم في الكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:52",
      "surahNumber": 54,
      "ayahNumber": 52,
      "text": "الزبر : كتب الحفظة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:53",
      "surahNumber": 54,
      "ayahNumber": 53,
      "text": "مستطَر : مسطور مكتوب في اللوح المحفوظ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:54",
      "surahNumber": 54,
      "ayahNumber": 54,
      "text": "نـهَر : أنهار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "54:55",
      "surahNumber": 54,
      "ayahNumber": 55,
      "text": "مقعد صدْق : مَكانٍ مَرْضى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
