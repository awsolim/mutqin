{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 4,
  "entries": [
    {
      "verseKey": "4:1",
      "surahNumber": 4,
      "ayahNumber": 1,
      "text": "بثّ منهما : نشر و فرّق منهما بالتناسل\\nو الأرحام : و اتّقوا أن تقطعوها\\nرقيباً : مُطّلعًا. أو حافظا لأعمالكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:2",
      "surahNumber": 4,
      "ayahNumber": 2,
      "text": "حُوبًا كبيرًا : إثما أو ذنبا أو ظلما- عظيمًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:3",
      "surahNumber": 4,
      "ayahNumber": 3,
      "text": "ألاّ تُقسطوا : أن تعدلوا و لا تُنصفوا\\nما طاب لكم : ما حلّ لكم\\nرباع : فتحرُم الزّيادة على أربع\\nألاّ تعولوا : في النَّفقة و سائر الحقوق\\nذلك أدنى ألاّ تعولوا : ذلك أقرب إن لا تجوروا، أو أنْ لا تكثُر عيالكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:4",
      "surahNumber": 4,
      "ayahNumber": 4,
      "text": "صَدُقاتِهِنَّ : مُهُورهنّ\\nنِحْلة : فريضةً أو عطيّة بطيب نفس\\nهنيئًا مريئا : طيِّبا سائغا حميد المغبّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:5",
      "surahNumber": 4,
      "ayahNumber": 5,
      "text": "قِياما : قوام معايِشِكم و صلاحِ أموركم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:6",
      "surahNumber": 4,
      "ayahNumber": 6,
      "text": "ابْتلوا اليتامى : اختبروهم في الإهتداء لِحُسن التّصرّف في أموالهم قبل البلوغ\\nآنسْتُم : علِمتم و تبيّنتم\\nرُشدا : اهتداءً لِحُسن التّصرف في الأموال\\nبدارًا أن يكبَروا : مُبادرين كبرَهم و رُشدهم\\nفليستعفف : فليكفّ عن أكل أموالهم\\nحسيبًا : مُحاسبا لكم أو شهيدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:7",
      "surahNumber": 4,
      "ayahNumber": 7,
      "text": "مفروضا : واجبًا . أو مُقْتَطعا محدودا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:9",
      "surahNumber": 4,
      "ayahNumber": 9,
      "text": "قولاً سديدا : جميلاً . أو صوابًا و عدْلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:10",
      "surahNumber": 4,
      "ayahNumber": 10,
      "text": "سيصْلوْن سعيرا : سيدخُلون نارًا موقدةً هائلةً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:11",
      "surahNumber": 4,
      "ayahNumber": 11,
      "text": "يوصيكم الله : يأمركم و يفرض عليكم\\nفريضةً : مفروضةً عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:12",
      "surahNumber": 4,
      "ayahNumber": 12,
      "text": "كلالةً : ميِّتا لا ولد له و لا والد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:13",
      "surahNumber": 4,
      "ayahNumber": 13,
      "text": "حُدودُ الله : شرائعه و أحكامه المفروضة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:17",
      "surahNumber": 4,
      "ayahNumber": 17,
      "text": "بِجهالةٍ : بِسفهٍ، و كلّ من عصى جاهلٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:19",
      "surahNumber": 4,
      "ayahNumber": 19,
      "text": "كرهًا : مكروهين لهنّ أو مكروهات عليه\\nلا تعضلوهنّ : لا تمسكوهنّ مُضارّةً لهنّ\\nبفاحشةٍ مبيّنةٍ : الشُوز و سُوء الخُلق أو الزِّنى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:20",
      "surahNumber": 4,
      "ayahNumber": 20,
      "text": "بُهتانًا : باطلاً و ظلمًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:21",
      "surahNumber": 4,
      "ayahNumber": 21,
      "text": "أفضى بعضكم .. : وصل، بالوقاع أو الخلْوة الصحيحة\\nمثيقا غليظا : عهدًا وثيقا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:22",
      "surahNumber": 4,
      "ayahNumber": 22,
      "text": "مقْتًا : مبغوضًا مستحقرًا جدًّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:23",
      "surahNumber": 4,
      "ayahNumber": 23,
      "text": "ربائبكم : بنات زوجاتكم من غيركم\\nفلا جُناح عليكم : فلا إثم عليكم\\nحلائل أبنائكم : زوجاتُهُم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:24",
      "surahNumber": 4,
      "ayahNumber": 24,
      "text": "المُحصنات : ذوات الأزواج\\nمُحصنين : أعفّاء عن الحرام\\nغير مسافحين : غير زانين\\nأجورهنّ : مهورهنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:25",
      "surahNumber": 4,
      "ayahNumber": 25,
      "text": "طَوْلاً : غِنًى و سعَةً\\nالمُحصنات : الحرائر\\nفتياتكم : إمائكم\\nمُحصنات : عفائف\\nغير مُسافحاتٍ : غير مجاهراتٍ بالزّنى سِرًّا\\nمتّخِذات أخدان : مُصاحبات أصدقاء الزّنى سرًّا\\nخشِيَ العنتَ : خاف الزّنى. أو الإثم به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:26",
      "surahNumber": 4,
      "ayahNumber": 26,
      "text": "سُنن . . : طرائق و مناهج . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:29",
      "surahNumber": 4,
      "ayahNumber": 29,
      "text": "بالباطل : بما يُخالف حكم الله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:30",
      "surahNumber": 4,
      "ayahNumber": 30,
      "text": "نُصليه نارًا : نُدخله إيّاها و نَحرِقُه بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:31",
      "surahNumber": 4,
      "ayahNumber": 31,
      "text": "سيِّئاتكم : ذنوبكم الصّغائر\\nمُدْخلاً كريمًا : مكانًا حسنًا شريفًا و هو الجنَّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:33",
      "surahNumber": 4,
      "ayahNumber": 33,
      "text": "جعلنا مواليَ ممّا ترك : ورثةً عصبةً يرثون ممّا ترك\\nالّذين عقدت أيمانكم : حالفتموهم و عاهدتموهم على التّوارث (و هو منسوخ عند الجمهور)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:34",
      "surahNumber": 4,
      "ayahNumber": 34,
      "text": "قوّامون على النّساء : قِيام الولاة المُصلحين على الرّعية\\nقانتاتٌ : مطيعاتٌ لله و لأزواجهنّ\\nحافظات للغيب : صائنات للعرض و المال في غيبة أزواجهنّ\\nبما حفظ الله : لهن من حقوقهنّ على أزواجهنّ\\nنشوزهنّ : ترفعهنّ عن مطاوعتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:36",
      "surahNumber": 4,
      "ayahNumber": 36,
      "text": "الجار الجُنُب : البعيد سكنًا أو نسبًا\\nالصّاحب بالجَنْب : الرّفيق في أمرٍ حسنٍ\\nابن السّبيل : المُسافر الغريب . أو الضّيف\\nمُختالاً : مُتكبِّرًا مُعجبًا بنفسهِ\\nفخورًا : كثير التّطاول و التّعاظُم بالمناقب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:38",
      "surahNumber": 4,
      "ayahNumber": 38,
      "text": "رِئاء النّاس : مُراءةً لهم و سُمعة لا لِوجه الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:40",
      "surahNumber": 4,
      "ayahNumber": 40,
      "text": "مثقال ذرّة : مقدار أصغر نملةٍ ، أو هباءَةٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:42",
      "surahNumber": 4,
      "ayahNumber": 42,
      "text": "لو تُسوّى بهم الأرض : لو كانوا و الأرض سواءً فلا يُبعثون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:43",
      "surahNumber": 4,
      "ayahNumber": 43,
      "text": "عابري سبيل : مسافرين فقدوا الماء فيتيمّمون\\nالغائط : مكان قضاء الحاجة (كِناية عن الحدث)\\nلامستُمُ النّساء : واقعتموهنّ أو مسستم بشرتهنّ\\nصعيدًا طيبا : تُرابًا ، أو وجه الأرض – طاهرًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:46",
      "surahNumber": 4,
      "ayahNumber": 46,
      "text": "يُحرّفون الكلِم : يُغيّرونه أو يتأوّلونه بالباطل\\nاسْمَع غير مُسْمَعٍ : قصدَ به اليهود الدعاء عليه صلّى الله عليه و سلم\\nراعِنا : قصدوا به سبّه و تنْقيصه صلى الله عليه و سلّم\\nليًّا بألسنتِهم : انْنحرافًا إلى جانب السّوء في القول\\nأقوم : أعدل و أصوب و أسدّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:47",
      "surahNumber": 4,
      "ayahNumber": 47,
      "text": "نطمس وُجُوها : نمحوها أو نترُكَهم في الضّلالة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:49",
      "surahNumber": 4,
      "ayahNumber": 49,
      "text": "يُزكّون أنفسهم : يمدحونها بالبراءة من الذّنوب\\nفتيلاً : قدْر الخيْط الرقيق في شِقّ النواة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:51",
      "surahNumber": 4,
      "ayahNumber": 51,
      "text": "بالجِبت و الطّاغوت : بكلِّ معبود أو مُطاع من دون الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:53",
      "surahNumber": 4,
      "ayahNumber": 53,
      "text": "نقِيرًا : قدْر النُّقرة في ظهر النّواة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:56",
      "surahNumber": 4,
      "ayahNumber": 56,
      "text": "نُصليهم نارًا : نُدْخِلُهم نارًا هائلةً نشْويهم فيها\\nنَضِجت جلودهم : احترقت و تهرَّت و تلاشت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:57",
      "surahNumber": 4,
      "ayahNumber": 57,
      "text": "ظليلا : دائمًا لا حرّ فيه و لا قرّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:58",
      "surahNumber": 4,
      "ayahNumber": 58,
      "text": "تُؤدّواالأمانات : جميع حقوق الله و حقوق العِباد\\nنِعمّا يعِظكم به : نِعم الّذي يعِظكم به ما ذُكر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:59",
      "surahNumber": 4,
      "ayahNumber": 59,
      "text": "أحسنُ تأويلا : أجمل عاقبةً و أحمد مآلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:60",
      "surahNumber": 4,
      "ayahNumber": 60,
      "text": "الطّاغوت : الضّليل كعب بن الأشرف اليهودي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:61",
      "surahNumber": 4,
      "ayahNumber": 61,
      "text": "يصُدّون عنك : يُعرضون عنك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:65",
      "surahNumber": 4,
      "ayahNumber": 65,
      "text": "شجر بينهم : أشكل و التبس عليهم من الأمور\\nحَرَجاً : ضيقًا أو شكًّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:66",
      "surahNumber": 4,
      "ayahNumber": 66,
      "text": "أشدَّ تثبيتًا : أقرب إلى ثبات إيمانكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:71",
      "surahNumber": 4,
      "ayahNumber": 71,
      "text": "خُذوا حِذركم : خذوا سلاحكم أو تيقّظوا لعدوّكم\\nفانفروا ثُباتٍ : اخرجوا للجهاد جماعت مُتفرّقين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:72",
      "surahNumber": 4,
      "ayahNumber": 72,
      "text": "ليُبطِّئنّ : لتنثاقلنَّ أو لَيُثبّطنّ عن الجهاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:74",
      "surahNumber": 4,
      "ayahNumber": 74,
      "text": "يشْرُون : يبيعون (و هم المؤمنون)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:76",
      "surahNumber": 4,
      "ayahNumber": 76,
      "text": "الطّاغوت : الشّيطان و سبيله الكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:78",
      "surahNumber": 4,
      "ayahNumber": 78,
      "text": "فتيلاً : قدر الخيط الرّقيق في شقّ النواة\\nبروج : حصون و قلاع . أو قصور\\nمُشيّدة : مُحكمة أو مُطوّلة مُرتفعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:80",
      "surahNumber": 4,
      "ayahNumber": 80,
      "text": "حفيظًا : حافظًا مُهيمنا و رقيبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:81",
      "surahNumber": 4,
      "ayahNumber": 81,
      "text": "برزوا : خرجوا\\nبَيّت طائفة : دبّرت بليل ، أو زوّرت و سوّت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:83",
      "surahNumber": 4,
      "ayahNumber": 83,
      "text": "أذاعوا به : أفشوه و أشاعوه و ذلك مفسدة\\nيستنبطونه : يستخرجون تدبيره ، أو عِلمه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:84",
      "surahNumber": 4,
      "ayahNumber": 84,
      "text": "بَأس . . : نكاية و بطْش و شِدّة . .\\nأشدُّ بأسا : أعظم قوّةً و صولةً\\nأشدّ تنكيلا : أشدّ تعذيبا و عقابا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:85",
      "surahNumber": 4,
      "ayahNumber": 85,
      "text": "كِفلٌ منْها : نصيبٌ و حظٌّ من وِزْرِها\\nمُقيتًا : مُقْتدرًا . أو حفيظًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:86",
      "surahNumber": 4,
      "ayahNumber": 86,
      "text": "حسيبًا : مُحاسبًا و مُجازيًا ، أو شهيدًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:88",
      "surahNumber": 4,
      "ayahNumber": 88,
      "text": "أركسهم : نكَّسهم و ردّهم إلى حُكم الكُفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:90",
      "surahNumber": 4,
      "ayahNumber": 90,
      "text": "حصِرت صدُورُهم : ضاقت و انْقبَضت\\nالسَّلَمَ : الاستسلام و الانقياد للصُّلح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:91",
      "surahNumber": 4,
      "ayahNumber": 91,
      "text": "أُرْكِسوا فيها : قُلِبُوا في الفتنة أشنع قلبٍ\\nثقِفتموهم : وجدتموهم أو تمكّنتم منهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:94",
      "surahNumber": 4,
      "ayahNumber": 94,
      "text": "ضربتم : سافرتم و ذهبتم\\nالسّلام : الاستسلام أو تحيّة الإسلام\\nعرض الحياة الدّنيا : الغنيمة و هي مال الزائل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:95",
      "surahNumber": 4,
      "ayahNumber": 95,
      "text": "أُولِى الضَّرر : أرباب العذر المانع من الجهاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:100",
      "surahNumber": 4,
      "ayahNumber": 100,
      "text": "مراغمًا : مُهاجَرًا و مُتحوَّلاً يَنْتَقِل إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:101",
      "surahNumber": 4,
      "ayahNumber": 101,
      "text": "يفتِنكم : ينالكم بمكروه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:102",
      "surahNumber": 4,
      "ayahNumber": 102,
      "text": "حِذرهم : احترازَهم من عدوِّهم\\nتغْفُلون : تسْهون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:103",
      "surahNumber": 4,
      "ayahNumber": 103,
      "text": "كتابًا موقوتًا : مكتوبا محدود الأوقات مقدّرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:104",
      "surahNumber": 4,
      "ayahNumber": 104,
      "text": "لا تهِنوا : لا تضْعُفوا و لا تتوانوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:105",
      "surahNumber": 4,
      "ayahNumber": 105,
      "text": "خصيمًا : مخاصِمًا مُدافِعًا عنهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:107",
      "surahNumber": 4,
      "ayahNumber": 107,
      "text": "يختانون أنفسهم : يخونونها بارتكاب المعاصي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:108",
      "surahNumber": 4,
      "ayahNumber": 108,
      "text": "يُبيّتون : يُدبّرون بليل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:109",
      "surahNumber": 4,
      "ayahNumber": 109,
      "text": "وكيلاً : حافظا و مُحاميًا من بأس الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:112",
      "surahNumber": 4,
      "ayahNumber": 112,
      "text": "بُهتانًا : كذِبًا فظيعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:114",
      "surahNumber": 4,
      "ayahNumber": 114,
      "text": "نجواهم : ما يتناجى به النّاس و يتحدّثون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:115",
      "surahNumber": 4,
      "ayahNumber": 115,
      "text": "يُشاقق الرّسول : يُخالفه\\nنُولّهِ ما تولّى : نخلّي بينه و بين ما اختاره لنفسه\\nنصله جهنّم : نُدخله إياها فيُشوى بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:117",
      "surahNumber": 4,
      "ayahNumber": 117,
      "text": "إناثا : أصناما يُزيّنونها كالنّساء\\nشيطانًا مريدًا : مُتمرّدا مُتجرّدا من الخير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:118",
      "surahNumber": 4,
      "ayahNumber": 118,
      "text": "مفروضًا : مقطوعًا لي به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:119",
      "surahNumber": 4,
      "ayahNumber": 119,
      "text": "فليُبتِّكُنّ : فليُقطّعُنّ أو فليشقّنّ\\nخلق الله : فطرت الله و هي دين الإسلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:120",
      "surahNumber": 4,
      "ayahNumber": 120,
      "text": "غرورًا : خداعا و باطلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:121",
      "surahNumber": 4,
      "ayahNumber": 121,
      "text": "محيصًا : محيدصا و مهربا و معدِلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:122",
      "surahNumber": 4,
      "ayahNumber": 122,
      "text": "قيلا : قولا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:124",
      "surahNumber": 4,
      "ayahNumber": 124,
      "text": "نقيرًا : قدْر النُقرة في ظهر النّواة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:125",
      "surahNumber": 4,
      "ayahNumber": 125,
      "text": "أسلم وجهه لله : أخلص نفسه أو توجّهه و عبادته لله\\nحنيفًا : مائلا عن الباطل إلى الدّين الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:127",
      "surahNumber": 4,
      "ayahNumber": 127,
      "text": "بالقسط : بالعدل في الميراث و الأموال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:128",
      "surahNumber": 4,
      "ayahNumber": 128,
      "text": "بعلِها : زوجِها\\nنشوزًا : تجافيًا عنها ظُلما\\nالشّحّ : البُخل مع الحِرص",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:129",
      "surahNumber": 4,
      "ayahNumber": 129,
      "text": "أن تعدِلوا : في المحبّة و ميل القلب و المُؤانسة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:130",
      "surahNumber": 4,
      "ayahNumber": 130,
      "text": "سعتِه : فضلِه و غناه و رزقه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:132",
      "surahNumber": 4,
      "ayahNumber": 132,
      "text": "و كيلا : شهيدا أو دافعا و مُجيرًا أو قيّما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:135",
      "surahNumber": 4,
      "ayahNumber": 135,
      "text": "أن تعدِلوا : كراهة العدول عن الحقّ\\nتلووا : تُحرّفوا في الشّهادة\\nتُعرِضوا : تتركوا إقامتها رأسا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:139",
      "surahNumber": 4,
      "ayahNumber": 139,
      "text": "العزّة : المَنَعة و القوّة و النُصرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:141",
      "surahNumber": 4,
      "ayahNumber": 141,
      "text": "يتربّصون بكم : ينتظرون بكم ما يحدثُ لكم\\nفتحٌ : نصرٌ و ظفر و غنيمة\\nألمْ نسْتَحْوذ عليكم : ألم نغلبكم فأبقينا عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:143",
      "surahNumber": 4,
      "ayahNumber": 143,
      "text": "مذبْذبين بين ذلك : مُردّدين بين الكُفر و الإيمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:144",
      "surahNumber": 4,
      "ayahNumber": 144,
      "text": "سُلطانا مُبينًا : حُجّةً ظاهرة في العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:145",
      "surahNumber": 4,
      "ayahNumber": 145,
      "text": "الدّرك الأسفل : الطّبق الذي في قعر جهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:153",
      "surahNumber": 4,
      "ayahNumber": 153,
      "text": "جهرةً : عيانًا بالبصر\\nالصّاعقة : نارٌ من السّماء أو صيحة منها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:154",
      "surahNumber": 4,
      "ayahNumber": 154,
      "text": "لا تعدوا في السبت : لا تعتدوا باصطياد الحيتان فيه\\nميثاقًا غليظا : عهدًا وثيقا بطاعة الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:155",
      "surahNumber": 4,
      "ayahNumber": 155,
      "text": "قلوبُنا غلف : مغشّاة بأغطية خِلقية فلا تعي\\nطبع الله عليها : ختم عليها فحجبها عن العِلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:156",
      "surahNumber": 4,
      "ayahNumber": 156,
      "text": "بُهتانًا عظيما : كذيبًا و باطلا فاحشا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:157",
      "surahNumber": 4,
      "ayahNumber": 157,
      "text": "شُبِّه لهم : أُلقِي على المقتول شبه عيسى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "4:162",
      "surahNumber": 4,
      "ayahNumber": 162,
