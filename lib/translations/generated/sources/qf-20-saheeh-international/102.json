{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 102,
  "entries": [
    {
      "verseKey": "102:1",
      "surahNumber": 102,
      "ayahNumber": 1,
      "text": "Competition in [worldly] increase diverts you",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "102:2",
      "surahNumber": 102,
      "ayahNumber": 2,
      "text": "Until you visit the graveyards.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "102:3",
      "surahNumber": 102,
      "ayahNumber": 3,
      "text": "No! You are going to know.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "102:4",
      "surahNumber": 102,
      "ayahNumber": 4,
      "text": "Then, no! You are going to know.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "102:5",
      "surahNumber": 102,
      "ayahNumber": 5,
      "text": "No! If you only knew with knowledge of certainty...",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "102:6",
      "surahNumber": 102,
      "ayahNumber": 6,
      "text": "You will surely see the Hellfire.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "102:7",
      "surahNumber": 102,
      "ayahNumber": 7,
      "text": "Then you will surely see it with the eye of certainty.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "102:8",
      "surahNumber": 102,
      "ayahNumber": 8,
      "text": "Then you will surely be asked that Day about pleasure.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
