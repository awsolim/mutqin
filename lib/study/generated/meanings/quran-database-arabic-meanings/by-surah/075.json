{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 75,
  "entries": [
    {
      "verseKey": "75:1",
      "surahNumber": 75,
      "ayahNumber": 1,
      "text": "لا أقسِم : \\\"أقْـسِم . و \\\"\\\"لا\\\"\\\" مزيدة \\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:2",
      "surahNumber": 75,
      "ayahNumber": 2,
      "text": "بالنـّـفس الـلـّـوّامة : كثيرة الـلـّـوْم و النّـدَم على ما فات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:4",
      "surahNumber": 75,
      "ayahNumber": 4,
      "text": "بَلـَـى : نجمَعُهَا بَعْدَ التـّـفـرّق و البـِـلـَـى\\nنُسوّي بَنـَـانه : أطراف أصابعه فنـَرُدّ عِظامَها كما كانت على صِغَرها بقـُـدْرَتنا فكيف بكِبارها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:5",
      "surahNumber": 75,
      "ayahNumber": 5,
      "text": "لِـيَـفْجُر أمامه : لِيَـدزم على فجوره مُدّة عُـمْره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:7",
      "surahNumber": 75,
      "ayahNumber": 7,
      "text": "بَرقَ البَصر : دَهِشَ و تـَـحَـيّرَ فَزَعًا مما رأى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:8",
      "surahNumber": 75,
      "ayahNumber": 8,
      "text": "خَسَف القمَر : ذهَب ضوءُه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:9",
      "surahNumber": 75,
      "ayahNumber": 9,
      "text": "جُمِعَ الشّمس و القمَر : في الطلوع من المغْرب مُظلمَيْن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:10",
      "surahNumber": 75,
      "ayahNumber": 10,
      "text": "أيْنَ المَـفـرّ ؟ : المَهْرَب مِن العذاب أو الهَوْل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:11",
      "surahNumber": 75,
      "ayahNumber": 11,
      "text": "لا وَزَر : لا مَلْجَأ و لا مَنـْـجَى له مِنَ الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:14",
      "surahNumber": 75,
      "ayahNumber": 14,
      "text": "بَصيرَة : حُجّة بَيّـنـَـة أو عَيْنٌ بَصيرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:15",
      "surahNumber": 75,
      "ayahNumber": 15,
      "text": "لوْ ألقى مَعَـاذيرَه : لوْ جاءَ بكلّ عُذر لم يَنفعْه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:17",
      "surahNumber": 75,
      "ayahNumber": 17,
      "text": "جَـمَـعَه : في صَدْرك و حِفْـظِكَ إيّـاه\\nقرآنه : أنْ تـَقـْرَأه بلسانِك مَتى شِئت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:18",
      "surahNumber": 75,
      "ayahNumber": 18,
      "text": "قرأناه : أتمَمْنا قراءَته عليك بلسام جبريل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:19",
      "surahNumber": 75,
      "ayahNumber": 19,
      "text": "بَيَانه : تـَـفـْـسير ما أشكل مِنْ مَعانيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:22",
      "surahNumber": 75,
      "ayahNumber": 22,
      "text": "ناضِـرَة : حَسَنة مُشْرقة مُتهلـّـلة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:24",
      "surahNumber": 75,
      "ayahNumber": 24,
      "text": "باسِـرَة : شديدة الكلوحَة و العُبُوس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:25",
      "surahNumber": 75,
      "ayahNumber": 25,
      "text": "فَاقِـرَة : داهية عظيمة تـقـْـصِم فَـقـَــار الظهْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:26",
      "surahNumber": 75,
      "ayahNumber": 26,
      "text": "بَلغَتِ التـّـراقي : وَصَلتِ الرّوح لأعلى الصّـدْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:27",
      "surahNumber": 75,
      "ayahNumber": 27,
      "text": "منْ راق ؟ : مَنْ يُـداويه و ينجيه من الموت؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:29",
      "surahNumber": 75,
      "ayahNumber": 29,
      "text": "التفّـت. . : الـْتـَـوَتْ. أو الْـتـَـصَقت . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:30",
      "surahNumber": 75,
      "ayahNumber": 30,
      "text": "المَساق : سَوْق العِبَـاد للجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:33",
      "surahNumber": 75,
      "ayahNumber": 33,
      "text": "يَتمَطى : يَـتبَختر في مِشيَـتِه اخْتِـيالا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:34",
      "surahNumber": 75,
      "ayahNumber": 34,
      "text": "أوْلى لك : قارَبَك ما يُهْـلِـكُـك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:36",
      "surahNumber": 75,
      "ayahNumber": 36,
      "text": "يُـتـْـرَك سُـدًى : مُهْمَلا فلا يُكلـّـف و لا يُجَـازَى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:37",
      "surahNumber": 75,
      "ayahNumber": 37,
      "text": "مَنِيّ يُمْـنـَى : يُصَبّ في الرّحم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "75:38",
      "surahNumber": 75,
      "ayahNumber": 38,
      "text": "فَسَوّى : فعَدّله و كَمّـله و نـَـفَخَ فـيه الرّوح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
