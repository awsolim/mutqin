{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 21,
  "entries": [
    {
      "verseKey": "21:1",
      "surahNumber": 21,
      "ayahNumber": 1,
      "text": "اقترب : قرُب و دنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:2",
      "surahNumber": 21,
      "ayahNumber": 2,
      "text": "مُحدَث : تنزيله بالوحي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:3",
      "surahNumber": 21,
      "ayahNumber": 3,
      "text": "أسرّوا النجوى : بالغوا في إخفاء تناجيهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:5",
      "surahNumber": 21,
      "ayahNumber": 5,
      "text": "أضغاث أحلام : تخاليط أحلام رآها في نومه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:8",
      "surahNumber": 21,
      "ayahNumber": 8,
      "text": "جسدا : أجسادا ، أو ذوي جسد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:10",
      "surahNumber": 21,
      "ayahNumber": 10,
      "text": "فيه ذكركم : موعظتكم أو شرفكم و صيتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:11",
      "surahNumber": 21,
      "ayahNumber": 11,
      "text": "كم قصمنا : كثيرا أهلكنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:12",
      "surahNumber": 21,
      "ayahNumber": 12,
      "text": "أحسّوا بأسنا : أدركوا بحاسّتهم عذابنا الشديد\\nيركضون : يهربون مسرعين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:13",
      "surahNumber": 21,
      "ayahNumber": 13,
      "text": "أترفتم فيه : نعّمتم فيه فبَطِرتم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:15",
      "surahNumber": 21,
      "ayahNumber": 15,
      "text": "حصيدا : كالنّبات المحصود بالمناجل\\nخامدين : ميّتين كانّار التي سكن لهبها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:17",
      "surahNumber": 21,
      "ayahNumber": 17,
      "text": "نتّخذ لهوا : ما يُـتـَـلهّى به من صاحبة أو ولد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:18",
      "surahNumber": 21,
      "ayahNumber": 18,
      "text": "نقذف بالحق : نرمي به و نورده\\nفيدمغه : يمحقه و يدحضه\\nزاهق : ذاهب مُضمحلٌ\\nالويل : الهلاك أو الخزي أو وادٍ بجهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:19",
      "surahNumber": 21,
      "ayahNumber": 19,
      "text": "لا يستحسرون : لا يكلّون و لا يعيوْن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:20",
      "surahNumber": 21,
      "ayahNumber": 20,
      "text": "لا يفترون : لا يسكنون عن نشاطهم في التسبيح و العبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:21",
      "surahNumber": 21,
      "ayahNumber": 21,
      "text": "هم ينشرون : هم يُحيون الموتى – كلاّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:22",
      "surahNumber": 21,
      "ayahNumber": 22,
      "text": "لفسدتا : لأختلّ نظامهما و خربتا بالتـّـنازع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:26",
      "surahNumber": 21,
      "ayahNumber": 26,
      "text": "ولدا : قالوا الملائكة بنات الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:28",
      "surahNumber": 21,
      "ayahNumber": 28,
      "text": "مُشفقون : خائفون حذرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:30",
      "surahNumber": 21,
      "ayahNumber": 30,
      "text": "كانتا رتقا : كانتا مُلتصِقتين بلا فصْـلٍ\\nففتقناهما : ففصلنا بينهما بالهواء\\nكلّ شيء حيّ : كل شيء نامٍ حيوانا أو نباتا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:31",
      "surahNumber": 21,
      "ayahNumber": 31,
      "text": "رواسي : جبالا ثوابت\\nأن تميد بهم : لئلاّ تضطرب بهم فلا تثبُت\\nفِجاجا سُبُلا : طُرُقا واسعة مسلوكة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:32",
      "surahNumber": 21,
      "ayahNumber": 32,
      "text": "سقفا محفوظا : مصونا من الوُقوع أو التّغيّر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:33",
      "surahNumber": 21,
      "ayahNumber": 33,
      "text": "كلّ : من الشّمس و القمر\\nفي فلك يسبحون : يدورون . أو يجرون في السّماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:35",
      "surahNumber": 21,
      "ayahNumber": 35,
      "text": "نبلوكم : نختبركم مع علمِنا بحالكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:39",
      "surahNumber": 21,
      "ayahNumber": 39,
      "text": "لا يكفّون : لا يمنعون و لا يدفعون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:40",
      "surahNumber": 21,
      "ayahNumber": 40,
      "text": "بغتة : فجأة\\nفتبهتهم : تحيّرُهم و تدهشهم\\nيُنظرون : يُمهلون و يُؤخّرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:41",
      "surahNumber": 21,
      "ayahNumber": 41,
      "text": "فحاق : أحاط . أو نزل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:42",
      "surahNumber": 21,
      "ayahNumber": 42,
      "text": "يأكلؤكم : يحفظكم و يحرسكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:43",
      "surahNumber": 21,
      "ayahNumber": 43,
      "text": "يُصحَبون : يُجارون و يمنعون أو يُنصرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:46",
      "surahNumber": 21,
      "ayahNumber": 46,
      "text": "نفحة : دُفعة يسيرة . أو نصيب يسير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:47",
      "surahNumber": 21,
      "ayahNumber": 47,
      "text": "القسط : العدل . أو ذوات العدل\\nمثقال حبّة : وزن أقلّ شيء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:49",
      "surahNumber": 21,
      "ayahNumber": 49,
      "text": "مُشفقون : خائفون خذرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:52",
      "surahNumber": 21,
      "ayahNumber": 52,
      "text": "التّماثيل : الأصنام المصنوعة بأيديكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:56",
      "surahNumber": 21,
      "ayahNumber": 56,
      "text": "فطرهنّ : خلقهنّ و أبدعهنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:58",
      "surahNumber": 21,
      "ayahNumber": 58,
      "text": "جُذاذا : قِطعا و كِسرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:61",
      "surahNumber": 21,
      "ayahNumber": 61,
      "text": "على أعين النّاس : ظاهرا بمرأى من النّاس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:65",
      "surahNumber": 21,
      "ayahNumber": 65,
      "text": "نُكِسوا على رءوسهم : رجعوا إلى الباطل و العناد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:67",
      "surahNumber": 21,
      "ayahNumber": 67,
      "text": "أفٍ لكم . . : كلمة تضجّر و كراهيّة و تبرّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:71",
      "surahNumber": 21,
      "ayahNumber": 71,
      "text": "إلى الأرض : مُنهيا إلى أرض الشّـام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:72",
      "surahNumber": 21,
      "ayahNumber": 72,
      "text": "نافلة : عطيّة أو زيادة عمّا سأل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:74",
      "surahNumber": 21,
      "ayahNumber": 74,
      "text": "قوم سوْء : فساد و فعلٍ مكروه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:78",
      "surahNumber": 21,
      "ayahNumber": 78,
      "text": "الحرث : الزّرع . أو الكرم\\nنفشت فيه : انتشرت فيه ليلا بلا راعٍ فرعته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:80",
      "surahNumber": 21,
      "ayahNumber": 80,
      "text": "صنعة لَبوس : عمل الدّروع تلبس في الحرب\\nلِتُحصنكم : لتحفظكم و تقيكم\\nبأسكم : حرب عدوّكم و إصابتكم بسلاحه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:81",
      "surahNumber": 21,
      "ayahNumber": 81,
      "text": "عاصفة : شديدة الهبوب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:82",
      "surahNumber": 21,
      "ayahNumber": 82,
      "text": "يغوصون له : في البحار لاستخراج نفائسها\\nلهم حافظين : من الزّيغ عن أمره أو الإفساد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:85",
      "surahNumber": 21,
      "ayahNumber": 85,
      "text": "ذا الكفل : قيل هو إلياس عليه السّلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:87",
      "surahNumber": 21,
      "ayahNumber": 87,
      "text": "ذا النّون : صاحب الحوت يونس عليه السّلام\\nمُغاضبا : غضبان على قومه لكُـفرهم\\nلم نقدِر عليه : لن نضيّق عليه بحبس و نحوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:90",
      "surahNumber": 21,
      "ayahNumber": 90,
      "text": "رغبا و رهبا : رجاءً في الثّواب و خوفا من العِقاب\\nخاشعين : متذلّلين خاضعين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:91",
      "surahNumber": 21,
      "ayahNumber": 91,
      "text": "أحصنت فرجها : حفظته من الحلال و الحرام\\nمن روحنا : من جهة روحنا و هو جبريل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:92",
      "surahNumber": 21,
      "ayahNumber": 92,
      "text": "أمّتكم : ملّـتكم (الإسلام)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:93",
      "surahNumber": 21,
      "ayahNumber": 93,
      "text": "تقطّعوا أمرهم : تفرّقوا في دينهم فِرقا و أحزابا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:95",
      "surahNumber": 21,
      "ayahNumber": 95,
      "text": "حرام على قرية : مُمتنِعٌ البتـّة على أهل قرية\\nأنّهم لا يرجعون : إلينا بالبعث للجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:96",
      "surahNumber": 21,
      "ayahNumber": 96,
      "text": "حَدَبٍ : مرتفع من الأرض\\nينسِلون : يُسرعون المشي في الخروج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:97",
      "surahNumber": 21,
      "ayahNumber": 97,
      "text": "الوعد الحقّ : البعث و الحساب و الجزاء\\nشاخصة أبصار . . : مُرتفعة لا تكاد تطرف أبصار . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:98",
      "surahNumber": 21,
      "ayahNumber": 98,
      "text": "حصب جهنّم : حطبها ووقودها الذي به تهيَّج\\nلها واردون : فيها داخلون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "21:100",
