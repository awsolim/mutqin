{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 69,
  "entries": [
    {
      "verseKey": "69:1",
      "surahNumber": 69,
      "ayahNumber": 1,
      "text": "الحاقّة : السّاعة يَتحقـّـق فيها ما أنكَرُوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:2",
      "surahNumber": 69,
      "ayahNumber": 2,
      "text": "ما الحاقّة : أيّ شيءٍ هِيَ في أهْوَالها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:4",
      "surahNumber": 69,
      "ayahNumber": 4,
      "text": "بالقارعة : بالقيامة تـقـْـرَع القـلوب بأفزَاعِها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:5",
      "surahNumber": 69,
      "ayahNumber": 5,
      "text": "بالطاغية : بالصّـيْحَة المُجَاوزة للحدّ في الشّدة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:6",
      "surahNumber": 69,
      "ayahNumber": 6,
      "text": "بريح صرصر : شديدة السّموم أو البرْد أو الصّوْت\\nعاتِـيَة : شديدة العصْف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:7",
      "surahNumber": 69,
      "ayahNumber": 7,
      "text": "سَخّرها عليهم : سَلـّـطها عليهم بقدْرتِه تعالى\\nحُسُوما : مُـتـتـَـابعَاتٍ . أو مَشئوماتٍ\\nأعْجَاز نخل : جُذوع نـَخل بلا رُءُوس\\nخاوية : ساقِطة أو فارغة أو بالِيَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:9",
      "surahNumber": 69,
      "ayahNumber": 9,
      "text": "المؤتـفـكات : قرى قوم لوط (أهلها)\\nبالخاطئة : بالفَعَلات ذات الخَطَـأ الجَسيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:10",
      "surahNumber": 69,
      "ayahNumber": 10,
      "text": "أخذة رَابيَة : زَائدة في الشدّة على الأخذات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:11",
      "surahNumber": 69,
      "ayahNumber": 11,
      "text": "الجَاريَة : سَفينة نوح عليه السّـلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:12",
      "surahNumber": 69,
      "ayahNumber": 12,
      "text": "تـَـذكِرة : عِـبْرَة و عِظة\\nوَتـَـعِـيَها : و لِتحْـفَـظها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:13",
      "surahNumber": 69,
      "ayahNumber": 13,
      "text": "نـَـفـْـخة ٌ واحدة : النّـفخة الأولى لخراب العالم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:14",
      "surahNumber": 69,
      "ayahNumber": 14,
      "text": "حُـمِلتِ الأرض : رُفِعَت من أماكنها بأمْرنا\\nفدُكّـتـا : فدقّـتا و كُسِرَتا . أو فسُوِّيتا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:15",
      "surahNumber": 69,
      "ayahNumber": 15,
      "text": "وَقَعَت الواقِعة : قامت القيامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:16",
      "surahNumber": 69,
      "ayahNumber": 16,
      "text": "انشَقّـت السّماء : تـفَـــّطرَتْْ و تـَـصدّعَتْ من الهَوْل\\nوَاهـية : ضعيفة مُتداعِـيَة بعد الإحْكام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:17",
      "surahNumber": 69,
      "ayahNumber": 17,
      "text": "على أرْجائها : جَوانبها و أطرافها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:18",
      "surahNumber": 69,
      "ayahNumber": 18,
      "text": "يَـوْمـَـئِـذ تـُـعْـرَضون : بعد النّـفخة الثانية للحساب و الجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:19",
      "surahNumber": 69,
      "ayahNumber": 19,
      "text": "هاؤم : خُذوا أو تعالـَـوْا\\nكِـتـَـابيَهْ : كتابي ، و الهاء للسّـكـت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:21",
      "surahNumber": 69,
      "ayahNumber": 21,
      "text": "راضِـية : مَرْضِيّة لا مكروهة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:23",
      "surahNumber": 69,
      "ayahNumber": 23,
      "text": "قطوفها دانية : ثمارها قريبة التـّـناول إذ تـُـجْـنى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:24",
      "surahNumber": 69,
      "ayahNumber": 24,
      "text": "هنيئا : أكْلاً غيْر مُنغّص و لا مكَدّر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:27",
      "surahNumber": 69,
      "ayahNumber": 27,
      "text": "كانت القاضية : الموْتة القاطعة لأمْري و لم أبْعَث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:28",
      "surahNumber": 69,
      "ayahNumber": 28,
      "text": "ما أغنى عـنّي : ما دَفَعَ العَذاب عَنّي\\nمَالـِـيَهْ : الذي كان لي مِنْ مالٍ و نحوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:29",
      "surahNumber": 69,
      "ayahNumber": 29,
      "text": "سُـلْـطانِيَهْ : حُجّـتِي أو تسلـّـطي و قـوّتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:30",
      "surahNumber": 69,
      "ayahNumber": 30,
      "text": "فَغـلـّـوه : اجْعلوا الغلّ في يَدَيْه و عُنقِه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:31",
      "surahNumber": 69,
      "ayahNumber": 31,
      "text": "الجَحيم صَـلـّـوه : أدْخِلوه . أو احرقوه فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:32",
      "surahNumber": 69,
      "ayahNumber": 32,
      "text": "فاسْـلكوه : فأدخِلوا فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:34",
      "surahNumber": 69,
      "ayahNumber": 34,
      "text": "لا يَحُضّ : لا يَحُثّ و لا يُحَرّض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:35",
      "surahNumber": 69,
      "ayahNumber": 35,
      "text": "حَمـِـيمٌ : قريبٌ مُشفـِـق يَحْميه مِنَ العَذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:36",
      "surahNumber": 69,
      "ayahNumber": 36,
      "text": "غِسلين : صَديد أهْل النّـار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:37",
      "surahNumber": 69,
      "ayahNumber": 37,
      "text": "الخاطِـئون : الكافرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:38",
      "surahNumber": 69,
      "ayahNumber": 38,
      "text": "فَلاَ أقـْـسِـم : \\\"أقسِمُ. و \\\"\\\"لا\\\"\\\" مزيدة \\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:40",
      "surahNumber": 69,
      "ayahNumber": 40,
      "text": "إنّه لَقوْل رَسول : يُـبَـلـّـغُهُ عن الله أوحِيَ إليْه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:44",
      "surahNumber": 69,
      "ayahNumber": 44,
      "text": "تقوّلَ عَـلـيْـنا : اخْتـَـلقَ و افترى علينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:45",
      "surahNumber": 69,
      "ayahNumber": 45,
      "text": "باليَمين : بيَمينه . أوْ بالقـُـوّة و القُـدْرَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:46",
      "surahNumber": 69,
      "ayahNumber": 46,
      "text": "الوَتين : نِيَاط القـَـلب . أو نُخاع الظهر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:47",
      "surahNumber": 69,
      "ayahNumber": 47,
      "text": "عـنه حَاجزين : مانِعين الهلاك عَـنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:50",
      "surahNumber": 69,
      "ayahNumber": 50,
      "text": "لَحَسْرَةٌ : نـَـدامَة عظيمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "69:52",
      "surahNumber": 69,
      "ayahNumber": 52,
      "text": "فسبّح باسم ربّـك : نـَـزّهْهُ عَمّـا لا يَليق به تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
