  "entries": [
    {
      "verseKey": "107:1",
      "surahNumber": 107,
      "ayahNumber": 1,
      "text": "أرأيت حال ذلك الذي يكذِّب بالبعث والجزاء؟",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir Al-Muyassar",
      "sourceId": "quran-database-muyassar",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "107:2",
      "surahNumber": 107,
      "ayahNumber": 2,
      "text": "فذلك الذي يدفع اليتيم بعنف وشدة عن حقه؛ لقساوة قلبه.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir Al-Muyassar",
      "sourceId": "quran-database-muyassar",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "107:3",
      "surahNumber": 107,
      "ayahNumber": 3,
      "text": "ولا يحضُّ غيره على إطعام المسكين، فكيف له أن يطعمه بنفسه؟",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir Al-Muyassar",
      "sourceId": "quran-database-muyassar",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "107:4",
      "surahNumber": 107,
      "ayahNumber": 4,
      "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir Al-Muyassar",
      "sourceId": "quran-database-muyassar",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "107:5",
      "surahNumber": 107,
      "ayahNumber": 5,
      "text": "فعذاب شديد للمصلين الذين هم عن صلاتهم لاهون، لا يقيمونها على وجهها، ولا يؤدونها في وقتها.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir Al-Muyassar",
      "sourceId": "quran-database-muyassar",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "107:6",
      "surahNumber": 107,
      "ayahNumber": 6,
      "text": "الذين هم يتظاهرون بأعمال الخير مراءاة للناس.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir Al-Muyassar",
      "sourceId": "quran-database-muyassar",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "107:7",
      "surahNumber": 107,
      "ayahNumber": 7,
      "text": "ويمنعون إعارة ما لا تضر إعارته من الآنية وغيرها، فلا هم أحسنوا عبادة ربهم، ولا هم أحسنوا إلى خلقه.",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir Al-Muyassar",
      "sourceId": "quran-database-muyassar",
      "language": "ar",
      "direction": "rtl"
    }
  ]
