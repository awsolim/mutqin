      "verseKey": "93:1",
      "surahNumber": 93,
      "ayahNumber": 1,
      "text": "و الضحى : (أقسم) بوَقت ارتفاع الشمس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "93:2",
      "surahNumber": 93,
      "ayahNumber": 2,
      "text": "سجى : سَكنَ أو اشتدّ ظلامه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "93:3",
      "surahNumber": 93,
      "ayahNumber": 3,
      "text": "ما ودّعك ربّـك : ما تـَـرَك منـْـذ اختارَك (جواب القسم)\\nما قـلى : ما أبْغَـضَـك منذ ُ أحبّـك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "93:6",
      "surahNumber": 93,
      "ayahNumber": 6,
      "text": "ألمْ يَجدْك . . : ألمْ يَعْـلمْـك ربّـكَ – قَدْ عَـلِـمَك . .\\nيَـتيما : طِفلاً مات أبوك و أنتَ جنين\\nفآوى : فَـضمّـك إلى مَنْ يَكفـلك و يَرْعاك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "93:7",
      "surahNumber": 93,
      "ayahNumber": 7,
      "text": "ضالاّ : غافِلاً عنْ أحكام الشّرائع\\nفهَدَى : فهَـدَاك إلى مناهجها بما أوحى إليك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "93:8",
      "surahNumber": 93,
      "ayahNumber": 8,
      "text": "عائلا : فقيرا عَديما\\nفأغـنى : فَرضّـاك بما أعطاك و مَنـَـحَك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "93:9",
      "surahNumber": 93,
      "ayahNumber": 9,
      "text": "فلا تـَقـْـهَرْ : فلا تـَـغْـلِـبُه على ماله و لا تسْـتـَـذلـّـه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "93:10",
      "surahNumber": 93,
      "ayahNumber": 10,
      "text": "فلا تـَـنـْـهَرْ : فلا تـَزْجُرْه ، و ارفـُـقْ به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
