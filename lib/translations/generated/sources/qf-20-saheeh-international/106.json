  "surahNumber": 106,
  "entries": [
    {
      "verseKey": "106:1",
      "surahNumber": 106,
      "ayahNumber": 1,
      "text": "For the accustomed security of the Quraysh -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "106:2",
      "surahNumber": 106,
      "ayahNumber": 2,
      "text": "Their accustomed security [in] the caravan of winter and summer -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "106:3",
      "surahNumber": 106,
      "ayahNumber": 3,
      "text": "Let them worship the Lord of this House,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "106:4",
      "surahNumber": 106,
      "ayahNumber": 4,
      "text": "Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
