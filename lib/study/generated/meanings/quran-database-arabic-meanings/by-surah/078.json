{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 78,
  "entries": [
    {
      "verseKey": "78:1",
      "surahNumber": 78,
      "ayahNumber": 1,
      "text": "عمّ ؟ : عن أيّ شيء عظيمِ الشّـأن؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:2",
      "surahNumber": 78,
      "ayahNumber": 2,
      "text": "عن النّبإ العظيم : عن القرآن أو البَعْث",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:4",
      "surahNumber": 78,
      "ayahNumber": 4,
      "text": "كلاّ : رَدْعٌ و زَجْر عن الإختلاف فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:6",
      "surahNumber": 78,
      "ayahNumber": 6,
      "text": "الأرض مِهادًا : فِـرَاشًـا مُوَطّـأ للاستقرار عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:7",
      "surahNumber": 78,
      "ayahNumber": 7,
      "text": "الجبال أوتادًا : كالأوتاد للأرض لئلاّ تميد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:8",
      "surahNumber": 78,
      "ayahNumber": 8,
      "text": "خلقناكم أزواجًا : أصنافا ذكورًا و إناثـا للتـّـناسُـل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:9",
      "surahNumber": 78,
      "ayahNumber": 9,
      "text": "نومَكم سُباتا : قـَـطْعًا لأعمالِكُمْ و راحة لأبْدانِكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:10",
      "surahNumber": 78,
      "ayahNumber": 10,
      "text": "الليل لِباسًا : ساتِرا لكم بظلمتِه كاللـّـباس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:11",
      "surahNumber": 78,
      "ayahNumber": 11,
      "text": "النّـهار معاشا : تحَصّلون فيه ما تعيشون به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:12",
      "surahNumber": 78,
      "ayahNumber": 12,
      "text": "سَبْـعًا شٍـدادًا : سمواتٍ قويّـاتٍ مُحْكَمات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:13",
      "surahNumber": 78,
      "ayahNumber": 13,
      "text": "سِرَاجا وهّاجا : مِصْباحا مُنيرا وقـّـادًا (الشّمس)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:14",
      "surahNumber": 78,
      "ayahNumber": 14,
      "text": "المُعصِرَات : السّحائب التي حان لها أن تـُمْطِر\\nماءً ثجّاجا : مُنـْـصَـبّـا بكثرةٍ مع التـّـتابُع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:16",
      "surahNumber": 78,
      "ayahNumber": 16,
      "text": "جنّاتٍ ألفافا : بساتين مُـلتـَـفّة الأشجار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:18",
      "surahNumber": 78,
      "ayahNumber": 18,
      "text": "فتأتون أفواجا : أمَمًـا أو جماعات مُختلفة الأحوال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:19",
      "surahNumber": 78,
      "ayahNumber": 19,
      "text": "فكانت أبوابا : صارَتْ ذات أبواب و طرُق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:20",
      "surahNumber": 78,
      "ayahNumber": 20,
      "text": "فكانت سرابا : فالسّراب الذي لا حَقيقة له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:21",
      "surahNumber": 78,
      "ayahNumber": 21,
      "text": "كانت مِرْصادًا : مَوْضِعَ ترَصّدٍ و ترقّب للكافرين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:22",
      "surahNumber": 78,
      "ayahNumber": 22,
      "text": "للطاغين مآبًـا : مَرْجـِعًـا و مأوى لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:23",
      "surahNumber": 78,
      "ayahNumber": 23,
      "text": "أحقابـًا : دهورًا ممتابعة لا نهاية لها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:24",
      "surahNumber": 78,
      "ayahNumber": 24,
      "text": "بَرْدًا : نـَوْمًا أو رَوْحًا من حرّ النّـار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:25",
      "surahNumber": 78,
      "ayahNumber": 25,
      "text": "حميما : ماءً بالغا نِهاية الحرارة\\nغسّـاقا : صديدا يسيل من جُـلودِهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:26",
      "surahNumber": 78,
      "ayahNumber": 26,
      "text": "جَزَاءً وفاقـًا : جزَيْنـاهم جَزَاءً مُوافِـقا لأعمالِهِم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:28",
      "surahNumber": 78,
      "ayahNumber": 28,
      "text": "كِذابا : تكذيبًـا شديدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:29",
      "surahNumber": 78,
      "ayahNumber": 29,
      "text": "أحصيْناه كِتابا : حَفِظناه و ضبطناه مكتوبًـا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:31",
      "surahNumber": 78,
      "ayahNumber": 31,
      "text": "مَفازًا : فوْزًا و ظفَـرًا بكلّ محْبوب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:33",
      "surahNumber": 78,
      "ayahNumber": 33,
      "text": "كواعِب : فتيات ناهِدات (نساء الجَنّة)\\nأترابًا : مُسْتـَـوياتٍ في السّن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:34",
      "surahNumber": 78,
      "ayahNumber": 34,
      "text": "كأسًـا دِهاقـا : مُتـْـرَعَة مليئة من خَمْر الجَنّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:35",
      "surahNumber": 78,
      "ayahNumber": 35,
      "text": "لغْوًا : كلاما غير مُعْـتدّ به . أو قبيحًـا\\nكِذابا : تكذيبًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:36",
      "surahNumber": 78,
      "ayahNumber": 36,
      "text": "عَطاءً حِسابا : إحسانا كافِـيا أو كثيرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:37",
      "surahNumber": 78,
      "ayahNumber": 37,
      "text": "خِطابـًا : إلا بإذنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:38",
      "surahNumber": 78,
      "ayahNumber": 38,
      "text": "الرّوح : جبريل عليه السلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:39",
      "surahNumber": 78,
      "ayahNumber": 39,
      "text": "مآبـا : مَرْجـِـعًـا بالإيمان و الطاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "78:40",
      "surahNumber": 78,
      "ayahNumber": 40,
      "text": "كُـنْت تـُـرَابًـا : في هذا اليوم فلا أُعـذ ّب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
