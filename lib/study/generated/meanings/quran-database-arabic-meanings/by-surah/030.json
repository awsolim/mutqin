  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 30,
  "entries": [
    {
      "verseKey": "30:2",
      "surahNumber": 30,
      "ayahNumber": 2,
      "text": "غُلبت الروم : قهرت فارس الرّوم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:3",
      "surahNumber": 30,
      "ayahNumber": 3,
      "text": "أدْنى الأرض : أقرب أرض الرّوم إلى فارس\\nغَلَبهم : كونهم مغلوبين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:8",
      "surahNumber": 30,
      "ayahNumber": 8,
      "text": "أجل مسمّى : وقت مُقدّر أزلا لِبقائها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:9",
      "surahNumber": 30,
      "ayahNumber": 9,
      "text": "أثاروا الأرض : حرَثوها و قلـّـبوها للزّراعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:10",
      "surahNumber": 30,
      "ayahNumber": 10,
      "text": "السّوآى : العقوبة المُتناهية في السّوء (النار)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:12",
      "surahNumber": 30,
      "ayahNumber": 12,
      "text": "يُبلسُ المجرمون : تنقطع حجّتهم . أو يَيْأسون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:15",
      "surahNumber": 30,
      "ayahNumber": 15,
      "text": "يُحبرون : يُسرّون . أو يُكْرَمون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:16",
      "surahNumber": 30,
      "ayahNumber": 16,
      "text": "في العذاب مُحضرون : لا يغيبون عنه أبدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:18",
      "surahNumber": 30,
      "ayahNumber": 18,
      "text": "حين تُظهرون : تدخلون في وقت الظهيرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:20",
      "surahNumber": 30,
      "ayahNumber": 20,
      "text": "تنتشرون : تتصرفون في شؤون معايشِكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:21",
      "surahNumber": 30,
      "ayahNumber": 21,
      "text": "لتسكنوا إليها : لِتميلوا إليها و تألفوها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:26",
      "surahNumber": 30,
      "ayahNumber": 26,
      "text": "له قانتون : مُطيعون مُنقادون لإرادته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:27",
      "surahNumber": 30,
      "ayahNumber": 27,
      "text": "له المثل الأعلى : الوصف الأعلى في الكمال و الجلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:30",
      "surahNumber": 30,
      "ayahNumber": 30,
      "text": "فأقم وجهك : قوّمْهُ و عدّلْهُ\\nللدّين : دين التوحيد و الإسلام\\nحنيفا : مائلا إليه مُستقيما عليه\\nفِطرة الله : الزموها و هي دين الإسلام\\nفطَر النّاس عليها : جبَلهم و طَبَعهم عليها\\nلخلق الله : لدينه الذي فطرهم عليه\\nذلك الدّين القيّم : المُستقيم الذي لا عِوَج فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:31",
      "surahNumber": 30,
      "ayahNumber": 31,
      "text": "مُنيبين إليه : راجعين إليه بالتـّــوبة و الإخلاص",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:32",
      "surahNumber": 30,
      "ayahNumber": 32,
      "text": "كانوا شِـيَعا : فِرقا مُختلفة الأهواء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:35",
      "surahNumber": 30,
      "ayahNumber": 35,
      "text": "سُلطانا : كتابا أو حُجّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:36",
      "surahNumber": 30,
      "ayahNumber": 36,
      "text": "فرحوا بها : بَطِروا و أشِروا\\nهم يقنطون : ييْأسون من رحمة الله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:37",
      "surahNumber": 30,
      "ayahNumber": 37,
      "text": "يقدِر : يُضيّقه على من يشاء لحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:39",
      "surahNumber": 30,
      "ayahNumber": 39,
      "text": "ربًا : هو الرّبا المُحرّم المعروف\\nلِيرْبوَ : لِيزيد ذلك الرّبا\\nفلا يربوَ : فلا يزكو و لا يُبارك فيه\\nالمضعفون : ذوو الأضعاف من الحسنات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:43",
      "surahNumber": 30,
      "ayahNumber": 43,
      "text": "للدّين القيّم : المستقيم (دين الفطرة)\\nلا مردّ له : لا يقدِر أحدٌ على ردّه\\nيصّـدّعون : يتفرّقون إلى الجنّة و إلى النّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:44",
      "surahNumber": 30,
      "ayahNumber": 44,
      "text": "يمهدُون : يُوطِّـئون مواطن النّعيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:47",
      "surahNumber": 30,
      "ayahNumber": 47,
      "text": "فتُثير سحابا : تحرّكُهُ و تنشره\\nيجعله كِسفا : قِطعا مُتفرّقة\\nالودق : المطر\\nمن خلاله : فُـرَجه و وسطه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:49",
      "surahNumber": 30,
      "ayahNumber": 49,
      "text": "لَمبلسين : آيسين من نزوله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:51",
      "surahNumber": 30,
      "ayahNumber": 51,
      "text": "فرأوهُ مُصفرّا : فرَأوُا النّبات مُصفرّا بعد الخُضرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:54",
      "surahNumber": 30,
      "ayahNumber": 54,
      "text": "شيبة : حال الشّيخوخة و الهرم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:55",
      "surahNumber": 30,
      "ayahNumber": 55,
      "text": "يُؤفكون : يُصرفون عن الحقّ و الصّدق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:57",
      "surahNumber": 30,
      "ayahNumber": 57,
      "text": "و لا هم يستعتبون : لا يُطلب منهم إزالة عتـْــبه و غَضَبـِــه تعالى عليهم – بالتّوبة و الطّاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "30:60",
      "surahNumber": 30,
      "ayahNumber": 60,
      "text": "لا يستخفّـنـّـك : لا يحْمِلنّك على الخفّة و القلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
