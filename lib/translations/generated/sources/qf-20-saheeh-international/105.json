{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 105,
  "entries": [
    {
      "verseKey": "105:1",
      "surahNumber": 105,
      "ayahNumber": 1,
      "text": "Have you not considered, [O Muḥammad], how your Lord dealt with the companions of the elephant?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "105:2",
      "surahNumber": 105,
      "ayahNumber": 2,
      "text": "Did He not make their plan into misguidance?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "105:3",
      "surahNumber": 105,
      "ayahNumber": 3,
      "text": "And He sent against them birds in flocks,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "105:4",
      "surahNumber": 105,
      "ayahNumber": 4,
      "text": "Striking them with stones of hard clay,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "105:5",
      "surahNumber": 105,
      "ayahNumber": 5,
      "text": "And He made them like eaten straw.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
