{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 65,
  "entries": [
    {
      "verseKey": "65:1",
      "surahNumber": 65,
      "ayahNumber": 1,
      "text": "فطلّـقوهن لعدتهنّ : مُستقـبلاتٍ لعدتهنّ (الــّطهْر)\\nأحصوا العدّة : اضبطوها و أكمِلوها ثلاثة قروء\\nبفاحشة مبَيّـنة : بمعصيةٍ كبيرةٍ ظاهرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:2",
      "surahNumber": 65,
      "ayahNumber": 2,
      "text": "بَلَغْنَ أجلهنّ : قاربْن انقضاء عدتهنّ\\nمخرجا : من كلّ شدة و ضيق و بلاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:3",
      "surahNumber": 65,
      "ayahNumber": 3,
      "text": "لا يحتسب : لا يَخطر بباله و لا يكون في حسابه\\nفهو حسبه : كافيه ما أهمّه في جميع أموره\\nقـَـدْرًا : أجَلاً ينتهي إليه أو تقديرا أزَلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:4",
      "surahNumber": 65,
      "ayahNumber": 4,
      "text": "يَـئِـسْنَ : انقـطع رَجاؤهنّ لِكِبَرهنّ\\nو اللائي لم يَحِضن : لِصِغرهنّ عدتهن ثلاثة أشهر\\nيُسْرا : تيْسيرا و فَـرَجًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:6",
      "surahNumber": 65,
      "ayahNumber": 6,
      "text": "وُجْدِكم : وُسْعِكم و طاقـَـتِكم\\nائتمِروا بيْنكم : تشاوَروا في الأجرة و الإرضاع\\nتـَـعاسَرتم : تضايَـقـْـتم و تشاحنتم فيهما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:7",
      "surahNumber": 65,
      "ayahNumber": 7,
      "text": "ذو سَعَة : غـنـًى و طاقة\\nقـُـدِرَ عليه : ضُـيّـق عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:8",
      "surahNumber": 65,
      "ayahNumber": 8,
      "text": "كأيّّـنْ مِنْ قـَـرية : كثيرٌ من أهل قرْية\\nعـتـَـتْ : تجبّرت و تكبّرتْ و أعْرَضتْ\\nعذابا نُـكرا : مُـنـْكَرًا شنيعا في الآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:9",
      "surahNumber": 65,
      "ayahNumber": 9,
      "text": "وَبال أمْرها : سوء عَاقـبة عُـتوّها\\nخُـسرا : خسراناً و هَلاكاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:10",
      "surahNumber": 65,
      "ayahNumber": 10,
      "text": "ذِكْرا : قرآنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:11",
      "surahNumber": 65,
      "ayahNumber": 11,
      "text": "رَسولا : أرْسل رسولا ، أو جبريل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "65:12",
      "surahNumber": 65,
      "ayahNumber": 12,
      "text": "يتنزّل الأمر : يَجْري قضاؤه و قـَـدَره أو تدبيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
