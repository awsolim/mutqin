  "surahNumber": 31,
  "entries": [
    {
      "verseKey": "31:6",
      "surahNumber": 31,
      "ayahNumber": 6,
      "text": "لَهْو الحديث : الباطل المُلهي عن الخير و العبادة\\nهُـزوا : سُخريةً – مهزوءًا بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:7",
      "surahNumber": 31,
      "ayahNumber": 7,
      "text": "ولّى مُستكبرا : أعرضَ مُتكبّرا عن تدبّرها\\nوقْرا : صممًا مانعًا من السّماع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:10",
      "surahNumber": 31,
      "ayahNumber": 10,
      "text": "بغير عَمَد : بغير دعائم و أساطينَ تُقيمُها\\nرواسي : جبالا ثوابت\\nأن تميد بكم : لِئلاّ تضطرب بكم\\nبثّ فيها : نَشَرو فرَّق و أظهَرَ فيها\\nزوج كريم : صِـنـْــفٍ حسنٍ كثير المنفعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:12",
      "surahNumber": 31,
      "ayahNumber": 12,
      "text": "لُقمان : كان صالحا حكيما و ليس نبيّا\\nالحكمة : العقل و الفهم و الفطنة و إصابة القول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:14",
      "surahNumber": 31,
      "ayahNumber": 14,
      "text": "وصّينا الإنسان : أمرناه و ألزمناه\\nوهْنا : ضعفا\\nفصاله : فِطامُـه عن الرّضاع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:15",
      "surahNumber": 31,
      "ayahNumber": 15,
      "text": "أناب إليّ : رَجَع إليّ بالإخلاص و الطّاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:16",
      "surahNumber": 31,
      "ayahNumber": 16,
      "text": "مثقال حبّة . . : وزنَ أصغر شيء. .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:18",
      "surahNumber": 31,
      "ayahNumber": 18,
      "text": "لا تُصعّر خدّك للنّاس : لا تُمِلْ وجهَك عنهم كِبْرا و تعاظُما\\nمرَحا : فَرَحا و بَطَرًا و خُيلاء\\nمُختال فخور : مُتكبّرٍ، مُباهٍ متطاول بمناقبه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:19",
      "surahNumber": 31,
      "ayahNumber": 19,
      "text": "اقصِدْ في مَشيك : توسّط فيه بين الإسراع و الإبطاء\\nاغضض : اخفضْ و انقصْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:20",
      "surahNumber": 31,
      "ayahNumber": 20,
      "text": "سخّر لكم : لِمنافعكم و مصالحكم\\nأسْـبَغ : أتمّ و أوسع و أكمل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:22",
      "surahNumber": 31,
      "ayahNumber": 22,
      "text": "يُسْلِم وجهه. . : يُفوّض أمره كلّه . .\\nاستمسك : تمسّك و تعلـّـقَ و اعتصمَ\\nبالعروة الوُثقى : بالعهد الأوثق الذي لا نقْضَ له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:24",
      "surahNumber": 31,
      "ayahNumber": 24,
      "text": "عذاب غليظ : شديد ثقيل (عذاب النّار)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:27",
      "surahNumber": 31,
      "ayahNumber": 27,
      "text": "يمدّه : يَزيده و يَنْصَبُّ إليه\\nسبعة أبحُر : مملوءةٍ ماءً\\nما نفدت : ما فرغَتْ و ما فَنِيتْ\\nكلمات الله : مقدوراته و عجائبه أو معلوماته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:29",
      "surahNumber": 31,
      "ayahNumber": 29,
      "text": "يولج : يُدْخِل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:32",
      "surahNumber": 31,
      "ayahNumber": 32,
      "text": "غَشِيهم موْجٌ : علاهم و غطّاهم\\nكالظـّــلل : كالسّحاب . أو الجبال المظلـّـة\\nفمِنهم مُقتصد : موفٍ بعهده . شاكر لله\\nختـّار كفور : غدّارٍ جَحود للنّعم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "31:33",
      "surahNumber": 31,
      "ayahNumber": 33,
      "text": "يوما لا يجزي. . : لا يقضي فيه شيئا . .\\nفلا تغرنّـكمْ : فلا تخدعنّكم و تُلهينّكم بلذاتها\\nالغَرور : ما يغرّ و يخدع من شيطان و غيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
