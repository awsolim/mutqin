{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 35,
  "entries": [
    {
      "verseKey": "35:1",
      "surahNumber": 35,
      "ayahNumber": 1,
      "text": "فاطر . . : مُبدع و مُخترع . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:2",
      "surahNumber": 35,
      "ayahNumber": 2,
      "text": "ما يفتح الله : ما يُرسل الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:3",
      "surahNumber": 35,
      "ayahNumber": 3,
      "text": "فأنّى تؤفكون ؟ : فكيف تصرفون عن توحيده ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:5",
      "surahNumber": 35,
      "ayahNumber": 5,
      "text": "فلا تغرنّكم : فلا تخدعنّكم و لا تلهينّكم بالزّخارف و الملذات\\nالغرور : ما يغرّ و يخدع من شيطان و غيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:8",
      "surahNumber": 35,
      "ayahNumber": 8,
      "text": "فلا تذهب نفسك عليهم حسرات : فلا تهلك نفسك عليهم غموما و أحزانا لكفرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:9",
      "surahNumber": 35,
      "ayahNumber": 9,
      "text": "فتثير سحابا : تحرّكه و تهيّجه\\nالنشور : بعث الموتى من القبور للجزاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:10",
      "surahNumber": 35,
      "ayahNumber": 10,
      "text": "يريد العزّة : الشّرف و المنعة\\nالكلِم الطيّب : كلمة و التوحيد و جيمع عبادات اللّسان\\nالعمل الصّالح يرفع : يرفع الله العمل الصّالح و يقبله\\nيبور : يفسد و يبطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:11",
      "surahNumber": 35,
      "ayahNumber": 11,
      "text": "أزواجا : ذكورا و إناثا\\nمعمّرٍ : طويل العمر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:12",
      "surahNumber": 35,
      "ayahNumber": 12,
      "text": "عذبٌ فرات : طيّب حُلو شديد العذوبة\\nسائغ شرابه : مريء سهلٌ انحداره\\nملح أجاج : شديد الملوحة أو المرارة\\nحلية : اللؤلؤ و المرجان من الملح\\nمواخر : جواري بريح واحدة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:13",
      "surahNumber": 35,
      "ayahNumber": 13,
      "text": "يولج : يُدْخل\\nلأجل مسمّى : مقدّر لفنائهما (يوم القيامة)\\nقطمير : هو القشرة الرقيقة على النّواة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:18",
      "surahNumber": 35,
      "ayahNumber": 18,
      "text": "لا تزر وازرة . . : لا تحمل نفس آثمة . .\\nمُثقلة : نفس أثقلتها الذنوب\\nحِملها : ذوبها التي أثقلتها\\nتزكّى : تطهّر من الكفر و المعاصي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:21",
      "surahNumber": 35,
      "ayahNumber": 21,
      "text": "الحَرُور : شدّة الحرّ ليلا كالسّموم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:25",
      "surahNumber": 35,
      "ayahNumber": 25,
      "text": "بالزّبر : بالكتب المكتوبة كصحف إبراهيم و موسى عليهما السلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:26",
      "surahNumber": 35,
      "ayahNumber": 26,
      "text": "كان نكير : إنكاري عليهم بالتدمير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:27",
      "surahNumber": 35,
      "ayahNumber": 27,
      "text": "جددٌ : ذات طرائق و خطوط مختلفة الألوان\\nغرابيب سود : متناهية في السّواد كالأغربة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:29",
      "surahNumber": 35,
      "ayahNumber": 29,
      "text": "لن تبور : لم تكسُدَ و تفسُدَ ، أوَ لن تهلِك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:32",
      "surahNumber": 35,
      "ayahNumber": 32,
      "text": "ظالم لنفسه : رجحت سيّـئاته على حسناته\\nمقتصد : استوت حسناته و سيّـئاته\\nسابق بالخيرات : رجحت حسناته على سيّـئاته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:34",
      "surahNumber": 35,
      "ayahNumber": 34,
      "text": "الحَزن : كلّ ما يُحزن و يَغمّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:35",
      "surahNumber": 35,
      "ayahNumber": 35,
      "text": "دار المُقامة : دار الإقامة الدّائمة (الجنّة)\\nنَصَبٌ : تعب و مشقّة\\nلغوبٌ : إعياء من التعب و فتور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:37",
      "surahNumber": 35,
      "ayahNumber": 37,
      "text": "هم يصطرخون : يستغيثون و يصيحون بشدّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:39",
      "surahNumber": 35,
      "ayahNumber": 39,
      "text": "جعلكم خلائف : خلفاء من كان قبلكم\\nمقتا : أشدّ البغض و الغضب و الاحتقار\\nخسارا : هَلاكا و خسرانا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:40",
      "surahNumber": 35,
      "ayahNumber": 40,
      "text": "أرأيتم شركاءكم : أخبروني عن شُركائكم\\nأم لهم شِرك ؟ : بل ألـَـهم شرِكة مع الله تعالى في الخلق؟\\nغرورا : باطلا . أو خداعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:42",
      "surahNumber": 35,
      "ayahNumber": 42,
      "text": "جهد أيمانهم : مجتهدين في الحلف بأغلظها و أوكدها\\nنفورا : تباعدا عن الحقّ و فرارا منه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "35:43",
      "surahNumber": 35,
      "ayahNumber": 43,
      "text": "و مكر السّيّء : و المكر السّيء (الكيد للرّسول)\\nلا يحيق : لا يُحيط أو لا ينزل\\nفهل ينظرون : فما ينتظرون\\nسنّة الأوّلين : سنّة الله فيهم بتعذيبهم بتكذيبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
