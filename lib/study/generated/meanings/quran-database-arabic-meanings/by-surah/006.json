{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 6,
  "entries": [
    {
      "verseKey": "6:1",
      "surahNumber": 6,
      "ayahNumber": 1,
      "text": "جعل . . : أنشأ و أبدع . .\\nبربّهم يعدلون : يسوّون به غيره في العبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:2",
      "surahNumber": 6,
      "ayahNumber": 2,
      "text": "قضى أجلاً : كتب و قدّر زمانًا مُعيّنا للموت\\nأجل مسمّى عنده : زمن مُعيّن للبعث مُستأثر بعلمه\\nتمترون : تشكّون في البعث أو تجحدونه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:3",
      "surahNumber": 6,
      "ayahNumber": 3,
      "text": "و هو الله : أي المعبود أو المتوحّد بالألوهية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:5",
      "surahNumber": 6,
      "ayahNumber": 5,
      "text": "أنباء : أخبار . و هو ما ينالهم من العقوبات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:6",
      "surahNumber": 6,
      "ayahNumber": 6,
      "text": "كم أهلكنا : كثيراً أهلكنا\\nقرن : أمّة من النّاس\\nمكّناهم : أعطيناهم من المكنة و القوّة\\nالسّماء : المطر\\nمدرارا : غزيرا كثير الصبّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:7",
      "surahNumber": 6,
      "ayahNumber": 7,
      "text": "كتابا في قرطاس : مكتوبا في كاغد أو رق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:8",
      "surahNumber": 6,
      "ayahNumber": 8,
      "text": "لا يُنظرون : لا يُمهلون لحظة بعد إنزاله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:9",
      "surahNumber": 6,
      "ayahNumber": 9,
      "text": "للبسنا عليهم ما يلبسون : لخلطنا و أشكلنا عليهم حينئذٍ ما يخلِطون على أنفسهم اليوم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:10",
      "surahNumber": 6,
      "ayahNumber": 10,
      "text": "فحاق . . : أحاط، أو نزل . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:12",
      "surahNumber": 6,
      "ayahNumber": 12,
      "text": "كتب : قضى و أوجب ، تفضّلا و إحسانا\\nخسروا أنفسهم : أهلكوها و غبنوها بالكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:13",
      "surahNumber": 6,
      "ayahNumber": 13,
      "text": "ما سكن : ما استقرّ و حلّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:14",
      "surahNumber": 6,
      "ayahNumber": 14,
      "text": "وليّا : ربّا معبودًا و ناصرًا معينا\\nفاطر . . : مُبدع و مخترع . .\\nهو يُطعم : يرزق عباده\\nمن أسلم : خضع لله بالعبودية و انقاد له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:19",
      "surahNumber": 6,
      "ayahNumber": 19,
      "text": "من بلغ : من بلغه القرآن إلى قيام الساعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:23",
      "surahNumber": 6,
      "ayahNumber": 23,
      "text": "فتنتهم : معذرتهم . أو عاقبة شركهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:24",
      "surahNumber": 6,
      "ayahNumber": 24,
      "text": "ظلّ عنهم : غاب و زال عنهم\\nما كانوا يفترون : يكذبون – الأصنام و شفاعتهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:25",
      "surahNumber": 6,
      "ayahNumber": 25,
      "text": "أكِنّة : أغطية كثيرة\\nوقرا : صمما و ثِقلا في السّمع\\nأساطير الأوّلين : أكاذيبهم المسطّرة في كتبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:26",
      "surahNumber": 6,
      "ayahNumber": 26,
      "text": "ينأون عنه : يتباعدون عن القرآن بأنفسهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:27",
      "surahNumber": 6,
      "ayahNumber": 27,
      "text": "وُقفوا على النّار : عرّفوها ، أو حُبسوا على متنها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:30",
      "surahNumber": 6,
      "ayahNumber": 30,
      "text": "وُقفوا على ربّهم : حُبسوا على حُكمه تعالى للسّؤال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:31",
      "surahNumber": 6,
      "ayahNumber": 31,
      "text": "بغتة : فجأة من غير شعور\\nفرّطنا فيها : قصّرنا و ضيّعنا في الحياة الدّنيا\\nأوزارهم : ذنوبهم و خطاياهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:34",
      "surahNumber": 6,
      "ayahNumber": 34,
      "text": "لكلمات الله : آيات وعده بنصر رسله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:35",
      "surahNumber": 6,
      "ayahNumber": 35,
      "text": "كبُر عليك : شقّ و عظُم عليك\\nنفقا في الأرض : سربا فيها ينفذ إلى ما تحتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:38",
      "surahNumber": 6,
      "ayahNumber": 38,
      "text": "أممٌ أمثالكم : في خلقنا لها و تدبيرنا أمورها\\nما فرّطنا : ما أغفلنا و تركنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:39",
      "surahNumber": 6,
      "ayahNumber": 39,
      "text": "في الظّلمات : ظلمات الجهل و العناد و الكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:40",
      "surahNumber": 6,
      "ayahNumber": 40,
      "text": "أرأيتكم : أخبروني عن عجيب أمركم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:42",
      "surahNumber": 6,
      "ayahNumber": 42,
      "text": "بالبأساء و الضرّاء : البؤس و الفقر و السّقم و الزّمان\\nيتضرّعون : يتذلّلون و يتخشّعون و يتوبون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:43",
      "surahNumber": 6,
      "ayahNumber": 43,
      "text": "جاءهم بأسنا : أتاهم عذابنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:44",
      "surahNumber": 6,
      "ayahNumber": 44,
      "text": "كلّ شيء : من النّعم الكثيرة استدراجا لهم\\nأخذناهم بغتة : أنزلنا بهم العذاب فجأة\\nهم مبلسون : آيسون من الرّحمة أو مُكتئبون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:45",
      "surahNumber": 6,
      "ayahNumber": 45,
      "text": "دابر القوم : آخرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:46",
      "surahNumber": 6,
      "ayahNumber": 46,
      "text": "أرأيتم : أخبروني\\nنصرّف الآيات : نكرّرها على أنحاء مُختلفة\\nهم يصدفون : هم يُعرضون عنها و يعدلون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:47",
      "surahNumber": 6,
      "ayahNumber": 47,
      "text": "أرأيتكم : أخبروني\\nبغتة : فجاءة أو ليلا\\nجهرة : مُعاينة أو نهارا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:50",
      "surahNumber": 6,
      "ayahNumber": 50,
      "text": "خزائن الله : مرزوقاته أو مقدوراته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:52",
      "surahNumber": 6,
      "ayahNumber": 52,
      "text": "بالغداة و العشيّ : في أول النّهار و آخره ، أي دواما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:53",
      "surahNumber": 6,
      "ayahNumber": 53,
      "text": "فتنّا : ابتلينا و امتحنّا و نحن أعلم بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:54",
      "surahNumber": 6,
      "ayahNumber": 54,
      "text": "كتب ربّكم : قضى و أوجب – تفضّلا و إحسانا\\nبجهالة : بسفاهة و كلّ عاص مُسيء جاهل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:57",
      "surahNumber": 6,
      "ayahNumber": 57,
      "text": "يقصّ الحقّ : يتبعه فيما يحكم به أو يُبيّنه بيانا شافيا\\nخير الفاصلين : بين الحقّ و الباطل بحكمه العدل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:59",
      "surahNumber": 6,
      "ayahNumber": 59,
      "text": "كتاب مبين : اللّوح المحفوظ أو علمه تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:60",
      "surahNumber": 6,
      "ayahNumber": 60,
      "text": "جرحتم بالنّهار : كسبتم فيه بجوارحكم من الإثم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:61",
      "surahNumber": 6,
      "ayahNumber": 61,
      "text": "لا يفرّطون : لا يتوانون أو لا يُقصّرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:63",
      "surahNumber": 6,
      "ayahNumber": 63,
      "text": "تضرّعا : مُعلنين الضّراعة و التذلّل له\\nخُفية : مسرّين بالدّعاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:65",
      "surahNumber": 6,
      "ayahNumber": 65,
      "text": "يلبسكم : يخلطكم في ملاحم القتال\\nشيعا : فِرقا مُختلفة الأهواء\\nبأس بعض : شدّة بعض في القتال\\nنصرّف الآيات : نكرّرها بأساليب مختلفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:66",
      "surahNumber": 6,
      "ayahNumber": 66,
      "text": "بوكيل : بحفيظ وكّل إليّ أمركم فأجازيكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:68",
      "surahNumber": 6,
      "ayahNumber": 68,
      "text": "يخوضون : يأخذون في الاستهزاء و الطّعن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:70",
      "surahNumber": 6,
      "ayahNumber": 70,
      "text": "غرّتهم : خدعنهم و أطمعتهم بالباطل\\nأن تُبسل نفس : لئلاّ تحبس في النّار أو تسلم للهلكة\\nتعدل كلّ عدل : تفتد بكلّ فداء\\nأبسلوا : حبسوا في النّار أو أسلموا للهلكة\\nحميم : ماء بالغٍ نهاية الحرارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:71",
      "surahNumber": 6,
      "ayahNumber": 71,
      "text": "استهوته الشّياطين : هوت به في المهمه فأضلّته\\nأُمرنا لنُسلم : أمرنا بأن نسلم و نخلص العبادة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:73",
      "surahNumber": 6,
      "ayahNumber": 73,
      "text": "الصّور : القرن الذي بنفخ فيه إسرافيل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:74",
      "surahNumber": 6,
      "ayahNumber": 74,
      "text": "آزر : لقب والد إبراهيم أو اسم عمّه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:75",
      "surahNumber": 6,
      "ayahNumber": 75,
      "text": "ملكوت . . : مُلك ، أو آيات أو عجائب . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:76",
      "surahNumber": 6,
      "ayahNumber": 76,
      "text": "جنّ عليه اللّيل : ستره بظلامه\\nأفل : غاب و غرب تحت الأفق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:77",
      "surahNumber": 6,
      "ayahNumber": 77,
      "text": "بازغا : طالعا من الأفق مُنتشر الضّوء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:79",
      "surahNumber": 6,
      "ayahNumber": 79,
      "text": "فطر السّماوات : أوجدها و أنشأها\\nحنيفا : مائلا عن الباطل إلى الدّين الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:80",
      "surahNumber": 6,
      "ayahNumber": 80,
      "text": "حاجّه قومه : خاصموه في التوحيد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:81",
      "surahNumber": 6,
      "ayahNumber": 81,
      "text": "سلطانا : حجّة و برهانا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:82",
      "surahNumber": 6,
      "ayahNumber": 82,
      "text": "لم يلبسوا : لم يخلطوا\\nبظلم : بشرك . بكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:87",
      "surahNumber": 6,
      "ayahNumber": 87,
      "text": "اجتبيناهم : اصطفيناهم بالنّبوة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:88",
      "surahNumber": 6,
      "ayahNumber": 88,
      "text": "لحبط : لبطل و سقط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:89",
      "surahNumber": 6,
      "ayahNumber": 89,
      "text": "الحكم : الفصل بين النّاس بالحقّ ، أو الحكمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:90",
      "surahNumber": 6,
      "ayahNumber": 90,
      "text": "اقتده : اقتد ، و الهاء للسكت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:91",
      "surahNumber": 6,
      "ayahNumber": 91,
      "text": "ما قدروا الله : ما عرفوا الله ، أو ما عظّموه\\nقراطيس : أوراقا مكتوبة مفرّقة\\nقل الله : قل الله أنزله (التوراة)\\nخوضهم : باطلهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:92",
      "surahNumber": 6,
      "ayahNumber": 92,
      "text": "مبارك : كثير المنافع و الفوائد (القرآن)\\nأم القرى : مكّة : أي أهلها\\nمن حولها : أهل المشارق و المغارب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:93",
      "surahNumber": 6,
      "ayahNumber": 93,
      "text": "غمرات الموت : سكراته و شدائده\\nأخرجوا أنفسكم : خلّصوها ممّا هي فيه من العذاب\\nعذاب الهون : الهوان الشّديد و الذّل و الخزي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:94",
      "surahNumber": 6,
      "ayahNumber": 94,
      "text": "ما خوّلناكم : ما أعطيناكم من متاع الدّنيا\\nتقطّع بينكم : تفرّق الاتّصال بينكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:95",
      "surahNumber": 6,
      "ayahNumber": 95,
      "text": "فالق الحبّ : شاقّه عن النبات . أو خالقه\\nفأنّا تُؤفكون : فكيف تصرفون عن عبادته ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:96",
      "surahNumber": 6,
      "ayahNumber": 96,
      "text": "فالق الإصباح : شاقّ ظلمته عن بياض النّهار أو خالقه\\nالشّمس و القمر حُسبانا : يجريان في أفلاكهما بحساب مقدّر نيطت به مصالح الخلق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:98",
      "surahNumber": 6,
      "ayahNumber": 98,
      "text": "فمستقرّ : في الأصلاب ، و فقيل في الأرحام و نحوها\\nو مستودع : في الأرحام و نحوها و قيل في الأصلاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:99",
      "surahNumber": 6,
      "ayahNumber": 99,
      "text": "خضرا : شيئا أخضر غضّا\\nحبّا مُتراكبا : متراكما كسنابل الحنطة و نحوها\\nطلعها : هو أوّل ما يخرج من ثمر النّخل في الكيزان\\nألوان : عذوق و عراجين كالعناقيد تنشق عنها الكيزان\\nدانية : متدلّية أو قريبة من المتناول\\nو ينعه : و إلى حال نضجه و إدراكه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:100",
      "surahNumber": 6,
      "ayahNumber": 100,
      "text": "الجنّ : الشّياطين حيث أطاعوهم في الكفر\\nخرقوا له : اختلقوا و افتروا له سبحانه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:101",
      "surahNumber": 6,
      "ayahNumber": 101,
      "text": "بديع . . : مُبدع و مُخترع\\nأنّا يكون : كيف . أو من أين يكون ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:102",
      "surahNumber": 6,
      "ayahNumber": 102,
      "text": "وكيل : رقيب ز متولّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:103",
      "surahNumber": 6,
      "ayahNumber": 103,
      "text": "لا تدركه الأبصار : لا تُحيط به تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:104",
      "surahNumber": 6,
      "ayahNumber": 104,
      "text": "بصائر : آيات و براهين تهدي للحقّ\\nبحفيظ : برقيب أُحصي أعمالكم لمجازاتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:105",
      "surahNumber": 6,
      "ayahNumber": 105,
      "text": "نصرّف الآيات : نكرّرها بأساليب مختلفة\\nدرست : قرأت و تعلّمت من أهل الكتاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:108",
      "surahNumber": 6,
      "ayahNumber": 108,
      "text": "عدوًا : اعتداء و ظلما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:109",
      "surahNumber": 6,
      "ayahNumber": 109,
      "text": "جهد أيمانهم : مجتهدين في الحلف بأغلظها وأوكدها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:110",
      "surahNumber": 6,
      "ayahNumber": 110,
      "text": "نذرهم : نتركهم\\nطُغيانهم : تجاوزهم الحد ّبالكفر\\nيعمهون : يعمون عن الرّشد أو يتحيّرون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:111",
      "surahNumber": 6,
      "ayahNumber": 111,
      "text": "حشرنا : جمعنا\\nقُبُلا : مُقابلة و مواجهة أو جماعة جماعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:112",
      "surahNumber": 6,
      "ayahNumber": 112,
      "text": "زُخرف القول : باطله المُموّه المزوّق\\nغرورا : خداعا و أخذا على الغرّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:113",
      "surahNumber": 6,
      "ayahNumber": 113,
      "text": "لتصغى إليه : لتميل إلى زُخرف القول\\nليقترفوا : ليكتسبوا من الآثام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:114",
      "surahNumber": 6,
      "ayahNumber": 114,
      "text": "الممترين : الشاكّين في أنّهم يعلمون ذلك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:115",
      "surahNumber": 6,
      "ayahNumber": 115,
      "text": "كلمة ربّك : كلامه و هو القرآن العظيم\\nصدقا و عدلا : في مواعيده – و في أحكامه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:116",
      "surahNumber": 6,
      "ayahNumber": 116,
      "text": "يخرُصون : يكذبون فيما ينسُبونه إلى الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:120",
      "surahNumber": 6,
      "ayahNumber": 120,
      "text": "ذروا : اتركوا\\nيقترفون : يكتسبون من الإثم أيّا كان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:121",
      "surahNumber": 6,
      "ayahNumber": 121,
      "text": "إنّه لفسق : خروج عن الطّاعة و معصية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:124",
      "surahNumber": 6,
      "ayahNumber": 124,
      "text": "صغارٌ : ذلّ عظيم و هوان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:125",
      "surahNumber": 6,
      "ayahNumber": 125,
      "text": "حرجًا : شديد الضّيق\\nيصّعد في السّماء : يتكلّف صعودها فلا يستطيع\\nالرّجس : العذاب أو الخذلان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:128",
      "surahNumber": 6,
      "ayahNumber": 128,
      "text": "استكثرتم من الإنس : أكثرتم من دعوتهم للضّلال و الغواية\\nالنّار مثواكم : مأواكم و مستقرّكم و مقامكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:130",
      "surahNumber": 6,
      "ayahNumber": 130,
      "text": "غرّتهم الحياة : خدعتهم ببهرجها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:134",
      "surahNumber": 6,
      "ayahNumber": 134,
      "text": "بمُعجزين : بفائتين من عذاب الله بالهرب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:135",
      "surahNumber": 6,
      "ayahNumber": 135,
      "text": "مكانتكم : غاية تمكّنكم و استطاعتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:136",
      "surahNumber": 6,
      "ayahNumber": 136,
      "text": "ذرأ : خلق على وجه الإختراع\\nالحرث : الزّرع\\nالأنعام : الإبل و البقر و الضّأن و المعز",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:137",
      "surahNumber": 6,
      "ayahNumber": 137,
      "text": "قتل أولادهم : وأد البنات الصّغار أحياءً\\nليُردوهم : ليُهلكوهم بالإغواء\\nليلبِسوا عليهم : ليخلطوا عليهم\\nيفترون : يختلقونه من الكذب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:138",
      "surahNumber": 6,
      "ayahNumber": 138,
      "text": "حرث : زرع\\nحِجر : محجورة مُحرّمة\\nحُرّمت ظهورها : البحائر و السّوائب و الحوامي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:139",
      "surahNumber": 6,
      "ayahNumber": 139,
      "text": "وصفهم : كذبهم على الله بالتحليل و التحريم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:141",
      "surahNumber": 6,
      "ayahNumber": 141,
      "text": "معروشات : مُحتاجة للتعريش كالكرم و نحوه\\nغير معروشات : مُستغنية عنه بإسوائها كالنّخل\\nمختلفا أكله : ثمره المأكول في الهيئة و الكيفية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:142",
      "surahNumber": 6,
      "ayahNumber": 142,
      "text": "حمولة : ما يحمل الأثقال كالإبل\\nفرشا : ما يُفرش للذّبح كالغنم\\nخطُوات الشيطان : طرقه وآثاره تحليلا و تحريما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:144",
      "surahNumber": 6,
      "ayahNumber": 144,
      "text": "وصّاكم الله بهذا : أمركم الله بهذا التّحريم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:145",
      "surahNumber": 6,
      "ayahNumber": 145,
      "text": "طاعمٍ يطعمه : آكل أيّا كان يأكله\\nدما مسفوحا : سائلا مهراقا\\nفإنّه رجس : قذر أو خبيث أو نجس حرام\\nأهلّ لغير الله به : ذكر عند ذبحه اسم غير الله\\nاضطرّ : أُلجئ إلى أكله للضرورة\\nغير باغٍ : غير طالب للمحرّم للذّة أو استئثار\\nو لا عادٍ : و لا متجاوز ما يسدّ الرّمق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:146",
      "surahNumber": 6,
      "ayahNumber": 146,
      "text": "ذي ظفر : ما له اصبع : دابة أو طيرا\\nشحومهما : شحوم الكرش و الكليتين\\nما حملت ظهورهما : ما علق بهما من الشحم فيُحلّ\\nالحوايا : المصارين و الأمعاء فيُحلّ شحمها\\nما اختلط بعظم : إلية الضّأن فتحل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "6:147",
      "surahNumber": 6,
      "ayahNumber": 147,
      "text": "لا يردّ بأسه : لا يُدفع غذابه و نقمته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
