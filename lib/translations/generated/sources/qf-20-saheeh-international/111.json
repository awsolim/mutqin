{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 111,
  "entries": [
    {
      "verseKey": "111:1",
      "surahNumber": 111,
      "ayahNumber": 1,
      "text": "May the hands of Abū Lahab be ruined, and ruined is he.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "111:2",
      "surahNumber": 111,
      "ayahNumber": 2,
      "text": "His wealth will not avail him or that which he gained.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "111:3",
      "surahNumber": 111,
      "ayahNumber": 3,
      "text": "He will [enter to] burn in a Fire of [blazing] flame",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "111:4",
      "surahNumber": 111,
      "ayahNumber": 4,
      "text": "And his wife [as well] - the carrier of firewood.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "111:5",
      "surahNumber": 111,
      "ayahNumber": 5,
      "text": "Around her neck is a rope of [twisted] fiber.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
