{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 55,
  "entries": [
    {
      "verseKey": "55:1",
      "surahNumber": 55,
      "ayahNumber": 1,
      "text": "The Most Merciful",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:2",
      "surahNumber": 55,
      "ayahNumber": 2,
      "text": "Taught the Qur’ān,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:3",
      "surahNumber": 55,
      "ayahNumber": 3,
      "text": "Created man,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:4",
      "surahNumber": 55,
      "ayahNumber": 4,
      "text": "[And] taught him eloquence.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:5",
      "surahNumber": 55,
      "ayahNumber": 5,
      "text": "The sun and the moon [move] by precise calculation,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:6",
      "surahNumber": 55,
      "ayahNumber": 6,
      "text": "And the stars and trees prostrate.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:7",
      "surahNumber": 55,
      "ayahNumber": 7,
      "text": "And the heaven He raised and imposed the balance",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:8",
      "surahNumber": 55,
      "ayahNumber": 8,
      "text": "That you not transgress within the balance.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:9",
      "surahNumber": 55,
      "ayahNumber": 9,
      "text": "And establish weight in justice and do not make deficient the balance.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:10",
      "surahNumber": 55,
      "ayahNumber": 10,
      "text": "And the earth He laid [out] for the creatures.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:11",
      "surahNumber": 55,
      "ayahNumber": 11,
      "text": "Therein is fruit and palm trees having sheaths [of dates]",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:12",
      "surahNumber": 55,
      "ayahNumber": 12,
      "text": "And grain having husks and scented plants.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:13",
      "surahNumber": 55,
      "ayahNumber": 13,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:14",
      "surahNumber": 55,
      "ayahNumber": 14,
      "text": "He created man from clay like [that of] pottery.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:15",
      "surahNumber": 55,
      "ayahNumber": 15,
      "text": "And He created the jinn from a smokeless flame of fire.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:16",
      "surahNumber": 55,
      "ayahNumber": 16,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:17",
      "surahNumber": 55,
      "ayahNumber": 17,
      "text": "[He is] Lord of the two sunrises and Lord of the two sunsets.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:18",
      "surahNumber": 55,
      "ayahNumber": 18,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:19",
      "surahNumber": 55,
      "ayahNumber": 19,
      "text": "He released the two seas, meeting [one another];",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:20",
      "surahNumber": 55,
      "ayahNumber": 20,
      "text": "Between them is a barrier so neither of them transgresses.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:21",
      "surahNumber": 55,
      "ayahNumber": 21,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:22",
      "surahNumber": 55,
      "ayahNumber": 22,
      "text": "From both of them emerge pearl and coral.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:23",
      "surahNumber": 55,
      "ayahNumber": 23,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:24",
      "surahNumber": 55,
      "ayahNumber": 24,
      "text": "And to Him belong the ships [with sails] elevated in the sea like mountains.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:25",
      "surahNumber": 55,
      "ayahNumber": 25,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:26",
      "surahNumber": 55,
      "ayahNumber": 26,
      "text": "Everyone upon it [i.e., the earth] will perish,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:27",
      "surahNumber": 55,
      "ayahNumber": 27,
      "text": "And there will remain the Face of your Lord, Owner of Majesty and Honor.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:28",
      "surahNumber": 55,
      "ayahNumber": 28,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:29",
      "surahNumber": 55,
      "ayahNumber": 29,
      "text": "Whoever is within the heavens and earth asks Him; every day He is in [i.e., bringing about] a matter.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:30",
      "surahNumber": 55,
      "ayahNumber": 30,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:31",
      "surahNumber": 55,
      "ayahNumber": 31,
      "text": "We will attend to you, O prominent beings.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:32",
      "surahNumber": 55,
      "ayahNumber": 32,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:33",
      "surahNumber": 55,
      "ayahNumber": 33,
      "text": "O company of jinn and mankind, if you are able to pass beyond the regions of the heavens and the earth, then pass. You will not pass except by authority [from Allāh].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:34",
      "surahNumber": 55,
      "ayahNumber": 34,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:35",
      "surahNumber": 55,
      "ayahNumber": 35,
      "text": "There will be sent upon you a flame of fire and smoke, and you will not defend yourselves.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:36",
      "surahNumber": 55,
      "ayahNumber": 36,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:37",
      "surahNumber": 55,
      "ayahNumber": 37,
      "text": "And when the heaven is split open and becomes rose-colored like oil -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:38",
      "surahNumber": 55,
      "ayahNumber": 38,
      "text": "So which of the favors of your Lord would you deny? -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:39",
      "surahNumber": 55,
      "ayahNumber": 39,
      "text": "Then on that Day none will be asked about his sin among men or jinn.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:40",
      "surahNumber": 55,
      "ayahNumber": 40,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:41",
      "surahNumber": 55,
      "ayahNumber": 41,
      "text": "The criminals will be known by their marks, and they will be seized by the forelocks and the feet.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:42",
      "surahNumber": 55,
      "ayahNumber": 42,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:43",
      "surahNumber": 55,
      "ayahNumber": 43,
      "text": "This is Hell, which the criminals deny.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:44",
      "surahNumber": 55,
      "ayahNumber": 44,
      "text": "They will circulate between it and scalding water, heated [to the utmost degree].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:45",
      "surahNumber": 55,
      "ayahNumber": 45,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:46",
      "surahNumber": 55,
      "ayahNumber": 46,
      "text": "But for he who has feared the position of his Lord are two gardens -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:47",
      "surahNumber": 55,
      "ayahNumber": 47,
      "text": "So which of the favors of your Lord would you deny? -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:48",
      "surahNumber": 55,
      "ayahNumber": 48,
      "text": "Having [spreading] branches.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:49",
      "surahNumber": 55,
      "ayahNumber": 49,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:50",
      "surahNumber": 55,
      "ayahNumber": 50,
      "text": "In both of them are two springs, flowing.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:51",
      "surahNumber": 55,
      "ayahNumber": 51,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:52",
      "surahNumber": 55,
      "ayahNumber": 52,
      "text": "In both of them are of every fruit, two kinds.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:53",
      "surahNumber": 55,
      "ayahNumber": 53,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:54",
      "surahNumber": 55,
      "ayahNumber": 54,
      "text": "[They are] reclining on beds whose linings are of silk brocade, and the fruit of the two gardens is hanging low.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:55",
      "surahNumber": 55,
      "ayahNumber": 55,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:56",
      "surahNumber": 55,
      "ayahNumber": 56,
      "text": "In them are women limiting [their] glances, untouched before them by man or jinnī -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:57",
      "surahNumber": 55,
      "ayahNumber": 57,
      "text": "So which of the favors of your Lord would you deny? -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:58",
      "surahNumber": 55,
      "ayahNumber": 58,
      "text": "As if they were rubies and coral.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:59",
      "surahNumber": 55,
      "ayahNumber": 59,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:60",
      "surahNumber": 55,
      "ayahNumber": 60,
      "text": "Is the reward for good [anything] but good?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:61",
      "surahNumber": 55,
      "ayahNumber": 61,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:62",
      "surahNumber": 55,
      "ayahNumber": 62,
      "text": "And below them both [in excellence] are two [other] gardens -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:63",
      "surahNumber": 55,
      "ayahNumber": 63,
      "text": "So which of the favors of your Lord would you deny? -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:64",
      "surahNumber": 55,
      "ayahNumber": 64,
      "text": "Dark green [in color].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:65",
      "surahNumber": 55,
      "ayahNumber": 65,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:66",
      "surahNumber": 55,
      "ayahNumber": 66,
      "text": "In both of them are two springs, spouting.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:67",
      "surahNumber": 55,
      "ayahNumber": 67,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:68",
      "surahNumber": 55,
      "ayahNumber": 68,
      "text": "In both of them are fruit and palm trees and pomegranates.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:69",
      "surahNumber": 55,
      "ayahNumber": 69,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:70",
      "surahNumber": 55,
      "ayahNumber": 70,
      "text": "In them are good and beautiful women -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:71",
      "surahNumber": 55,
      "ayahNumber": 71,
      "text": "So which of the favors of your Lord would you deny? -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:72",
      "surahNumber": 55,
      "ayahNumber": 72,
      "text": "Fair ones reserved in pavilions -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:73",
      "surahNumber": 55,
      "ayahNumber": 73,
      "text": "So which of the favors of your Lord would you deny? -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:74",
      "surahNumber": 55,
      "ayahNumber": 74,
      "text": "Untouched before them by man or jinnī -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:75",
      "surahNumber": 55,
      "ayahNumber": 75,
      "text": "So which of the favors of your Lord would you deny? -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:76",
      "surahNumber": 55,
      "ayahNumber": 76,
      "text": "Reclining on green cushions and beautiful fine carpets.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:77",
      "surahNumber": 55,
      "ayahNumber": 77,
      "text": "So which of the favors of your Lord would you deny?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "55:78",
      "surahNumber": 55,
      "ayahNumber": 78,
      "text": "Blessed is the name of your Lord, Owner of Majesty and Honor.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
