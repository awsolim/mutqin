{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 95,
  "entries": [
    {
      "verseKey": "95:1",
      "surahNumber": 95,
      "ayahNumber": 1,
      "text": "By the fig and the olive",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "95:2",
      "surahNumber": 95,
      "ayahNumber": 2,
      "text": "And [by] Mount Sinai",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "95:3",
      "surahNumber": 95,
      "ayahNumber": 3,
      "text": "And [by] this secure city [i.e., Makkah],",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "95:4",
      "surahNumber": 95,
      "ayahNumber": 4,
      "text": "We have certainly created man in the best of stature;",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "95:5",
      "surahNumber": 95,
      "ayahNumber": 5,
      "text": "Then We return him to the lowest of the low,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "95:6",
      "surahNumber": 95,
      "ayahNumber": 6,
      "text": "Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "95:7",
      "surahNumber": 95,
      "ayahNumber": 7,
      "text": "So what yet causes you to deny the Recompense?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "95:8",
      "surahNumber": 95,
      "ayahNumber": 8,
      "text": "Is not Allāh the most just of judges?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
