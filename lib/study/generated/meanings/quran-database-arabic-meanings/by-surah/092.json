{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 92,
  "entries": [
    {
      "verseKey": "92:1",
      "surahNumber": 92,
      "ayahNumber": 1,
      "text": "و الليل إذا يغشى : يُغطي الأشياء بظلمته (قسم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:2",
      "surahNumber": 92,
      "ayahNumber": 2,
      "text": "و النهار إذا تجلـّى : ظهر بضوْئه و وَضح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:4",
      "surahNumber": 92,
      "ayahNumber": 4,
      "text": "إنّ سعيكم لشتـّـى : إنّ عَمَـلكمْ لمخْـتلِف في الجزاء (جواب القسم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:6",
      "surahNumber": 92,
      "ayahNumber": 6,
      "text": "صَدّق بالحسنى : بالمِلـّـة الحُسْنـى و هي الإسلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:7",
      "surahNumber": 92,
      "ayahNumber": 7,
      "text": "فسنـُـيَـسّره : فـسَـنـُـوفّـقهو نـُـهيـّـئـُـه\\nلليُسرى : للخَصـلة المؤَدّية إلى اليُسْر و الرّاحَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:10",
      "surahNumber": 92,
      "ayahNumber": 10,
      "text": "للعُسْرى : للخصلة المؤدية إلى العُسْر و الشدّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:11",
      "surahNumber": 92,
      "ayahNumber": 11,
      "text": "ما يُـغْنى : ما يَدْفع العذاب عنه\\nترَدّى : هَـلـَـكَ . أوْ سَـقـَـط في النـّـار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:12",
      "surahNumber": 92,
      "ayahNumber": 12,
      "text": "إنّ علينا للهدى : الدّلالة على الحقّ أو بيان طريقه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:14",
      "surahNumber": 92,
      "ayahNumber": 14,
      "text": "نارًا تـَـلظى : تتلهّب و تتوقّد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:15",
      "surahNumber": 92,
      "ayahNumber": 15,
      "text": "لا يصْلاها : لا يَدْخلها أو لا يُقاسي حَرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:17",
      "surahNumber": 92,
      "ayahNumber": 17,
      "text": "سَـيُـجَـنّـبُها : سَـيُـبْعَدُ عنها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:18",
      "surahNumber": 92,
      "ayahNumber": 18,
      "text": "يتزكّى : يتـطهّر به منَ الذنوب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "92:19",
      "surahNumber": 92,
      "ayahNumber": 19,
      "text": "تـُـجْـزى : تكافَـأ ، نزلت في الصّديق رضي الله عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
