{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 67,
  "entries": [
    {
      "verseKey": "67:1",
      "surahNumber": 67,
      "ayahNumber": 1,
      "text": "تبارك الذي : تعالى و تمجّد أو تكاثر خَيْره\\nبيده الملك : له الأمر و النّهي و السلطان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:2",
      "surahNumber": 67,
      "ayahNumber": 2,
      "text": "خلق الموت : أوْدَه . أو قدّرَه أزلاً\\nليبلوكم : ليَختبركم فيما بين الحياة و الموت\\nأحسن عملا : أصْوبَه و أخلَصَه أو أسْرَع طاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:3",
      "surahNumber": 67,
      "ayahNumber": 3,
      "text": "طباقا : كلّ سَماءٍ مَقـْـــِبـيّة على الأخرى\\nتفاوت : اختلاف و عَدَم تناسب\\nفطور : شقوق و صدوع أو خلل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:4",
      "surahNumber": 67,
      "ayahNumber": 4,
      "text": "كرتين : رَجْعَتين رَجعة بعد رجعة\\nخاسئا : صاغرا لعدم ِوجْدان الفـُـطور\\nهو حسير : كليلٌ من كثرة المراجعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:5",
      "surahNumber": 67,
      "ayahNumber": 5,
      "text": "بمصابيح : بكواكب عظيمة مُضيئة\\nرجوما للشياطين : بانقـضاض الشّهب منها عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:7",
      "surahNumber": 67,
      "ayahNumber": 7,
      "text": "شهيقا : صَوْتا مُـنـْـكرًا كصوت الحمير\\nتفور : تغلي بهم غليَان القِدْر بما فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:8",
      "surahNumber": 67,
      "ayahNumber": 8,
      "text": "تكاد تميّـز : تتقطّع و تتفرّق و تنـْـشقّ\\nفَـوْج : جماعة من الكفار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:11",
      "surahNumber": 67,
      "ayahNumber": 11,
      "text": "فَسُحْقا : فبُعْدا من الرّحمة و الكرامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:15",
      "surahNumber": 67,
      "ayahNumber": 15,
      "text": "الأرض ذلولا : مُذلـّـلة ليّـنـَـة سَهْلة تستقـرّون عليها\\nمَناكبها : جَوَانبها . أو طُرُقِها و فِجَاجها\\nإليه النشور : إليه تبْعثون من القبور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:16",
      "surahNumber": 67,
      "ayahNumber": 16,
      "text": "منْ في السّماء : أمْرُه و قَـضاؤُه و سلطانه\\nيَخسف بكم : يُـغَوّر بكم\\nهِي تمور : تـَـرْتجّ و تضطرب فتعلو عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:17",
      "surahNumber": 67,
      "ayahNumber": 17,
      "text": "حاصبا : ريحًا من السّماء فيها حَصباء\\nكيف نذير : كيف إنذاري و قدْرتي على العِقاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:18",
      "surahNumber": 67,
      "ayahNumber": 18,
      "text": "كان نكير : إنكاري عليهم بالإهلاك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:19",
      "surahNumber": 67,
      "ayahNumber": 19,
      "text": "صافّات و يَقبضْن : باسطاتٍ أجنحتهنّ في الجوّ عند الطيران و يَضْمُمْـنـَـها إذا ضربنَ بها جُنوبهنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:20",
      "surahNumber": 67,
      "ayahNumber": 20,
      "text": "أمّن هذا ؟ ؟ : بَلْ مَنْ هذا ؟ ؟\\nجُندٌ لكم : أعْوان لكم و مَنـَـعَة\\nغرور : خديعة من الشيطان و جنده",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:21",
      "surahNumber": 67,
      "ayahNumber": 21,
      "text": "لجّوا في عُـتوّ : تمادَوْا في استكبار و عناد\\nنفور : شِرَادٍ و تباعد عن الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:22",
      "surahNumber": 67,
      "ayahNumber": 22,
      "text": "مُكِـبّا على وجهه : سَاقطا عليه لا يَـأمن العثور\\nيَمْشي سَويّا : مُسْـتـَويًا مُنتصِبا سالمًا من العثور (مَثلٌ للمشرك و الموحّد)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:24",
      "surahNumber": 67,
      "ayahNumber": 24,
      "text": "ذرأكم : خَلقكم و بَثـّـكم و فرّقكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:27",
      "surahNumber": 67,
      "ayahNumber": 27,
      "text": "رأوه زلفة : رَأوُا العذاب قريبا منهم\\nسيئت : كَئِبَتْ و اسْوَدّتْ غمّا و ذلاّ\\nبه تدعون : تـَـطلبون أن يُعجّل لكم استهزاءً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:28",
      "surahNumber": 67,
      "ayahNumber": 28,
      "text": "أرأيتم : أخبروني أو أروني\\nيُجير الكافرين : يُنـَجّـيهمْ. أو يَمنعهم أو يؤَمّنهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "67:30",
      "surahNumber": 67,
      "ayahNumber": 30,
      "text": "غَوْرا : غائرا ذاهبا في الأرض لا يُنال\\nبماء معين : جَار أو ظاهرٍ . سَهْل التـّـناوُل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
