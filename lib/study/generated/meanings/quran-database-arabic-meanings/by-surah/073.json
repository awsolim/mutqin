  "surahNumber": 73,
  "entries": [
    {
      "verseKey": "73:1",
      "surahNumber": 73,
      "ayahNumber": 1,
      "text": "المزّمل : المتلفّـف بثيابه (النبي صلى الله عليه و سلم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:4",
      "surahNumber": 73,
      "ayahNumber": 4,
      "text": "رتـّـل القرآن : اقرأه بتمهّل ، و تبْيين حروف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:5",
      "surahNumber": 73,
      "ayahNumber": 5,
      "text": "قوْلاً ثقيلا : شاقّـاعلى المكلـّـفـين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:6",
      "surahNumber": 73,
      "ayahNumber": 6,
      "text": "ناشِئة الليل : العبادة التي تنشأ به و تحدث\\nأشدّ وطأ : ثباتا للقدَم و رسوخا في العبادة\\nأقوَم قيلا : أثبتُ قِراءة لحضور القلب فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:7",
      "surahNumber": 73,
      "ayahNumber": 7,
      "text": "سَبْحًا : تصرّفا و تقـلـّـبا في مُهمّـاتك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:8",
      "surahNumber": 73,
      "ayahNumber": 8,
      "text": "تبتـّـل إليه : انقطع إلى عبادته تعالى ، و استغرق في مراقـبته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:10",
      "surahNumber": 73,
      "ayahNumber": 10,
      "text": "هجرًا جميلا : اعتزالا حَسَنا لا جزع فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:11",
      "surahNumber": 73,
      "ayahNumber": 11,
      "text": "ذرني و المكذبين : دَعْـني و إياهم فسأكفـيكهم\\nأولي النعمة : أرباب التنعّم ، و غضارة العيش\\nمهّـلهم قليلا : أمْهلهم زمانا قليلا بعده النّـكال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:12",
      "surahNumber": 73,
      "ayahNumber": 12,
      "text": "أنـْـكالا : قـيودا شديدة ثِقالا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:13",
      "surahNumber": 73,
      "ayahNumber": 13,
      "text": "طعامًـا ذا غصّة : ذا نُشوب في الحلق فلا يَـنـْـساغ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:14",
      "surahNumber": 73,
      "ayahNumber": 14,
      "text": "يوم ترجُف الأرض : تضطرب و تتزلزل (يوم القيامة)\\nكثيبا مهيلا : رَمْلا مُجْـتمِعًـا – سائلا مُنهالا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:16",
      "surahNumber": 73,
      "ayahNumber": 16,
      "text": "أخذا وبيلا : شديدا ثقيلا وَخيم العُقـبى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:18",
      "surahNumber": 73,
      "ayahNumber": 18,
      "text": "السماء منفطر به : شيء مُنشقّ في ذلك اليوم لِهوْله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "73:20",
      "surahNumber": 73,
      "ayahNumber": 20,
      "text": "لنْ تـُحصوه : لنْ تـُـطيقـوا ضَبْط وَقتِ قِـيامه\\nفـتـَـاب عَليكم : بالتـّرخيص في ترك قيامه المقدّر\\nفاقرءُوا ما تيسر من القرآن : فصلـّـوا ما سَهُـلَ عليكم منْ صلاة اللـّـيل ، و في الصّلاة قرآن\\nيَضربون : يُـسافـرون للتجارة و نحوها\\nأقيموا الصّـلاة : المفروضة\\nقرضا حسنا : احتسابا بطيبة نفـْـس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
