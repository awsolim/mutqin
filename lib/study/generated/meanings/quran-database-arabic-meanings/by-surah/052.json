{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 52,
  "entries": [
    {
      "verseKey": "52:1",
      "surahNumber": 52,
      "ayahNumber": 1,
      "text": "و الطور : (قسَمٌ) بجبَل طور سيناء الذي كلـّـم الله عنده موسى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:2",
      "surahNumber": 52,
      "ayahNumber": 2,
      "text": "و كتاب مسطور : مكتوب على وَجه الانتظام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:3",
      "surahNumber": 52,
      "ayahNumber": 3,
      "text": "في رقّ : ما يُـكْـتـَب فيه جلْدًا أو غيره\\nمنشور : مبْسوط غير مختوم عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:4",
      "surahNumber": 52,
      "ayahNumber": 4,
      "text": "و البيت المعمور : هو الضّراح في السّماء أو الكعبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:5",
      "surahNumber": 52,
      "ayahNumber": 5,
      "text": "و السّقف المرفوع : السّماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:6",
      "surahNumber": 52,
      "ayahNumber": 6,
      "text": "و البحر المسجور : الموقَـد نارًا يوْمَ القيامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:7",
      "surahNumber": 52,
      "ayahNumber": 7,
      "text": "إنّ عذاب . . : (جَوَاب القسَم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:9",
      "surahNumber": 52,
      "ayahNumber": 9,
      "text": "تمور السماء : تـَـضْـطرب و تـَـدور كالرّحَى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:11",
      "surahNumber": 52,
      "ayahNumber": 11,
      "text": "فويْـل : هَلاكٌ أوحَسْـرَة أو شدّة عذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:12",
      "surahNumber": 52,
      "ayahNumber": 12,
      "text": "خوْض : انـْدفاع في الأباطيل و الأكاذيب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:13",
      "surahNumber": 52,
      "ayahNumber": 13,
      "text": "يُدعّون : يُدفعون بـِعُـنـْـفٍ و شدّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:16",
      "surahNumber": 52,
      "ayahNumber": 16,
      "text": "اصلوها : ادخلوها . أو قاسوا حرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:18",
      "surahNumber": 52,
      "ayahNumber": 18,
      "text": "فاكهين : مُتلذذين نـَـاعمين مَسْرورين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:20",
      "surahNumber": 52,
      "ayahNumber": 20,
      "text": "سُرُرٍ مصفوفة : مَوْصولٍ بعضها ببعـض باستواءٍ\\nزوّجناهم : قرَنّـاهمْ\\nبحور عين : بـنساءٍ بيض نُـجْـل العيون حِـسَانِـها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:21",
      "surahNumber": 52,
      "ayahNumber": 21,
      "text": "ألتناهم : ما نـَـقـَـصنا الآباء بهذا الإلحاق\\nرَهين : مَرْهونٌ عِـنـْد الله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:23",
      "surahNumber": 52,
      "ayahNumber": 23,
      "text": "يتنازعون : يَتجاذبون و يَتعاورون\\nكأسًـا : خَمْرًا . أو إناءً فيه خمرٌ\\nلا لغوٌ فيها و لا تأثيم : لا كلامٌ سَاقط في أثناء شربها و لا فِعْـلٌ يوجب الإثم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:24",
      "surahNumber": 52,
      "ayahNumber": 24,
      "text": "لؤلؤ مكْـنونٌ : مَسْـتور مَصونٌ في أصدافه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:26",
      "surahNumber": 52,
      "ayahNumber": 26,
      "text": "مشفـقـين : خائفـين من العاقـبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:27",
      "surahNumber": 52,
      "ayahNumber": 27,
      "text": "عذاب السّموم : نار جهنّم النّـافذة في المَـسَامّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:28",
      "surahNumber": 52,
      "ayahNumber": 28,
      "text": "هو البرّ الرحيم : المحسِن العَطوف، العظيم الرحمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:30",
      "surahNumber": 52,
      "ayahNumber": 30,
      "text": "رَيْبَ المَنون : صُرُوف الدّهْـر المُهلكَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:32",
      "surahNumber": 52,
      "ayahNumber": 32,
      "text": "قوْمٌ طاغون : متجاوزون الحَدّ في العِناد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:33",
      "surahNumber": 52,
      "ayahNumber": 33,
      "text": "تقوّله : اختلق القرآن منْ تلقاء نفسه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:37",
      "surahNumber": 52,
      "ayahNumber": 37,
      "text": "خزائن ربّـك : خزائن رزقه و رَحمته أو مقـْـدوراته\\nهم المسيطرون : الأرباب الغالبون أو المسلـّـطون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:38",
      "surahNumber": 52,
      "ayahNumber": 38,
      "text": "لهم سُلـّـمٌ : مَرقـًـى إلى السماء يَصعدون به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:40",
      "surahNumber": 52,
      "ayahNumber": 40,
      "text": "منْ مَغْرَمٍ مثقلون : من التزام غرْمٍ متعبون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:42",
      "surahNumber": 52,
      "ayahNumber": 42,
      "text": "هم المكيدون : المَـجْـزيون بكيْدهم و مَكْرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:44",
      "surahNumber": 52,
      "ayahNumber": 44,
      "text": "كِسْـفـًـا : قطْعَة عَـظيمة\\nسحابٌ مَرْكوم : مجموعٌ بَعضه على بعض يُمْطِرُنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:45",
      "surahNumber": 52,
      "ayahNumber": 45,
      "text": "فيه يصعقون : يُهلكون (يوم بَدْر)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:46",
      "surahNumber": 52,
      "ayahNumber": 46,
      "text": "لا يغني عنهمْ : لا يَدْفع عـنهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:47",
      "surahNumber": 52,
      "ayahNumber": 47,
      "text": "عذابًـا دون ذلك : عذابا قبل ذلك هو القحط",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:48",
      "surahNumber": 52,
      "ayahNumber": 48,
      "text": "بأعيننا : في حِفظنا و حراستنا\\nسبّحْ بحمد ربـّـك : نزّهْه تعالى حامِدًا له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "52:49",
      "surahNumber": 52,
      "ayahNumber": 49,
      "text": "إدبار النجوم : وَقْت غَـيْـبَتها بضوْءِ الصّباح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
