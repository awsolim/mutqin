{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 28,
  "entries": [
    {
      "verseKey": "28:4",
      "surahNumber": 28,
      "ayahNumber": 4,
      "text": "علا في الأرض : تجبّرَ و طغى في أرض مصر\\nشِـيَعا : أصنافا في الخدمة و التـّـسخير و الإذلال\\nيستحيي نساءهم : يستبقي بَناتهم للخدمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:6",
      "surahNumber": 28,
      "ayahNumber": 6,
      "text": "يحذرون : يخافون من ذهاب مُلكهمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:8",
      "surahNumber": 28,
      "ayahNumber": 8,
      "text": "كانوا خاطئين : مُذبذبين آثمين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:9",
      "surahNumber": 28,
      "ayahNumber": 9,
      "text": "قرّة عين : هو مسرّة وفرح ٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:10",
      "surahNumber": 28,
      "ayahNumber": 10,
      "text": "فارغًا : خاليا من كلّ ما سِوى موسى\\nلَتبدي به : لَتصَرّح بأنه ابنها لشدّة وَجْدِها\\nرَبَطنا : بالعصمة و الصبر و التّثبيت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:11",
      "surahNumber": 28,
      "ayahNumber": 11,
      "text": "قصّيه : اتّبعي أثره و تعرّفي خبره\\nفبَصُرت به : أبْصَرته\\nعن جُنُب : عن بُعْد أو عن مكان بعيد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:12",
      "surahNumber": 28,
      "ayahNumber": 12,
      "text": "يكفلونه لكم : يقومون بتربيته لأجلكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:13",
      "surahNumber": 28,
      "ayahNumber": 13,
      "text": "تقرّ عينها : تـُـسرّ و تـَفرح بولدها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:14",
      "surahNumber": 28,
      "ayahNumber": 14,
      "text": "بلغ أشدّه : قوّة بدنه و نهاية نموّه\\nاستوى : اعتدل عقله و كمُل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:15",
      "surahNumber": 28,
      "ayahNumber": 15,
      "text": "فوكزه موسى : ضربه في صدره بجُمْع كفّه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:17",
      "surahNumber": 28,
      "ayahNumber": 17,
      "text": "ظهيرا للمجرمين : مُعينا لهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:18",
      "surahNumber": 28,
      "ayahNumber": 18,
      "text": "يترقّب : يتوقّع المكروه\\nيستصرخه : يستغيثه منْ بُعْد\\nإنك لغويّ : ضالّ عن الرّشد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:19",
      "surahNumber": 28,
      "ayahNumber": 19,
      "text": "يبطش : يأخذ يقوّة و عُنف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:20",
      "surahNumber": 28,
      "ayahNumber": 20,
      "text": "يسعى : يُسْرع في المشي\\nإن الملأ : وُجُوهَ القوم و كُـبَـراءَهم\\nيأتمرون بك : يتشاورون في شأنك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:22",
      "surahNumber": 28,
      "ayahNumber": 22,
      "text": "تلقاء مدين : جهتِها و نحْوها (قرية شعيب)\\nسواء السّبيل : الطريق الوسط الذي فيه النّجاة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:23",
      "surahNumber": 28,
      "ayahNumber": 23,
      "text": "أمّة من النّاس : جماعة كثيرة منهم\\nتذودان : تمنعان أغنامهما عن الماء\\nما خطبُكما ؟ : ما شأنكما ؟ ما مطلوبكما؟\\nيُصْدِر الرّعاء : يصرف الرعاة مواشيَهم عن الماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:27",
      "surahNumber": 28,
      "ayahNumber": 27,
      "text": "تأجُرَني : تكون لي أجيرا في رعي الغنم\\nحِجَج : سنين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:29",
      "surahNumber": 28,
      "ayahNumber": 29,
      "text": "آنس : أبصَرَ بوضوح\\nنارا : هي في الواقع نورٌ ربّانيّ\\nجذوة من النّار : عودٌ فيه نارٌ بلا لهب\\nتصطلون : تستدفئون بها من البرْد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:31",
      "surahNumber": 28,
      "ayahNumber": 31,
      "text": "تهـتـزّ : تتحرّك بشدّة و اضطراب\\nكأنّها جانّ : حيّة خفيفة في سرعة حركتها\\nلم يُعقّبْ : لم يرجع على عقبه أو لم يلتفت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:32",
      "surahNumber": 28,
      "ayahNumber": 32,
      "text": "جيْـبـك : فتحة القميص حيث يدخل الرّأس\\nبيضاء : لها شعاع يغلب شعاع الشمس\\nغير سوء : غير داء بَرَص و نحوه\\nاضمم إليك جناحك من الرّهب : ضمّ يدك اليُمنى إلى صدرك يذهبْ عنك الخوف من الحيّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:34",
      "surahNumber": 28,
      "ayahNumber": 34,
      "text": "ردْءًا : عَوْنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:35",
      "surahNumber": 28,
      "ayahNumber": 35,
      "text": "سنشدّ عضدك : سنقوّيك و نعينك\\nسلطانا : حجّة أو تسلّطا و غلبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:36",
      "surahNumber": 28,
      "ayahNumber": 36,
      "text": "مفترى : تنسبه إلى الله كذبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:38",
      "surahNumber": 28,
      "ayahNumber": 38,
      "text": "صرحا : قصرا . أو بناءً عاليًا مكشوفا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:40",
      "surahNumber": 28,
      "ayahNumber": 40,
      "text": "فنبذناهم في اليمّ : ألقيناهم و أغرقناهم في البحر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:41",
      "surahNumber": 28,
      "ayahNumber": 41,
      "text": "أئمّة : قادة في الضلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:42",
      "surahNumber": 28,
      "ayahNumber": 42,
      "text": "لعنة : طردا و إبعادًا عن الرّحمة\\nمن المقبوحين : المبعدين أو المشوّهين في الخِلـْـقـَـة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:43",
      "surahNumber": 28,
      "ayahNumber": 43,
      "text": "القرون الأولى : الأمم الماضية المكذبة\\nبصائر للنّاس : أنوارا لقلوبهم تبْصِر بها الحقائق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:44",
      "surahNumber": 28,
      "ayahNumber": 44,
      "text": "قضينا : عهِدْنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:45",
      "surahNumber": 28,
      "ayahNumber": 45,
      "text": "ثاويا : مُقيمًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:48",
      "surahNumber": 28,
      "ayahNumber": 48,
      "text": "سِحران تظاهرا : تـَـعَاونـَـا ( التوراة و القرآن)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:51",
      "surahNumber": 28,
      "ayahNumber": 51,
      "text": "وصّلنا لهم القول : أنزلنا القرآن عليهم مُتواصلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:54",
      "surahNumber": 28,
      "ayahNumber": 54,
      "text": "يدْرءون : يدفعون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:55",
      "surahNumber": 28,
      "ayahNumber": 55,
      "text": "اللّغو : السّبّ و الشّـتـْـم من الكفار\\nسلام عليكم : سَلِمتم مِنّا لا نُعارضكم بالشّـتم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:57",
      "surahNumber": 28,
      "ayahNumber": 57,
      "text": "نُـتخطّـف : نُنْـتزعْ بسرعة\\nيُجْبى إليه : يُجْلب و يُحمل إليه من كلّ جهة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:58",
      "surahNumber": 28,
      "ayahNumber": 58,
      "text": "كم أهلكنا : كثيرا أهلكنا\\nبَطِرت مَعيشَتها : طغتْ و تمرّدت في أيّام حياتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:61",
      "surahNumber": 28,
      "ayahNumber": 61,
      "text": "من المحضرين : ممّن أحضروا للنّار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:63",
      "surahNumber": 28,
      "ayahNumber": 63,
      "text": "أغوينا : دعَوْناهم إلى الغيّ فاتـّـبعونا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:66",
      "surahNumber": 28,
      "ayahNumber": 66,
      "text": "فعَمِيَتْ عليهم الأنباء : خَفِيَتْ و اشتبَهَتْ عليهم الحجج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:68",
      "surahNumber": 28,
      "ayahNumber": 68,
      "text": "الخيَرَة : الاختيار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:69",
      "surahNumber": 28,
      "ayahNumber": 69,
      "text": "ما تكنّ صدورهم : ما تُضمر من الباطل و العداوة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:71",
      "surahNumber": 28,
      "ayahNumber": 71,
      "text": "أرأيتم : أخبروني\\nسرمدا : دائما مُطّردا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:75",
      "surahNumber": 28,
      "ayahNumber": 75,
      "text": "يفترون : يختلقونه من الباطل في الدّنيا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:76",
      "surahNumber": 28,
      "ayahNumber": 76,
      "text": "فبغى عليهم : ظَلَمَهُم . أو تكبّرَ عليهم\\nلَتنوءُ بالعُصبة : لتـُـثـقل الجماعة الكثيرة و تميل بهم\\nلا تفرحْ : لا تبْطَرْ و لا تأشَرْ بكُثرَةِ المال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:78",
      "surahNumber": 28,
      "ayahNumber": 78,
      "text": "مِنَ القرون : من الأمم\\nلا يُسأل : سؤال استعلام بل سؤال توبيخ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:79",
      "surahNumber": 28,
      "ayahNumber": 79,
      "text": "في زينته : في مظاهر غِناه و تـَـرفِه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:80",
      "surahNumber": 28,
      "ayahNumber": 80,
      "text": "ويلكم : زجْرٌ لهم عن هذا التـّـمنّي\\nلا يلقّاها : لا يُوفّـق للعمل للمَثوبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:82",
      "surahNumber": 28,
      "ayahNumber": 82,
      "text": "ويْكأنّ الله : ألـَـمْ تـَـرَ الله\\nيَقـْـدِر : يُضيّق على من يشاء لحكمة\\nويكَأنّه لا يفلح : ألـَـم ترَ الشأن لا يُفلح . . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:85",
      "surahNumber": 28,
      "ayahNumber": 85,
      "text": "معادٍ : مكّة المكرّمة ظاهرا عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "28:86",
      "surahNumber": 28,
      "ayahNumber": 86,
      "text": "ظهيرا للكافرين : مُعينا لهم على ما هم عليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
