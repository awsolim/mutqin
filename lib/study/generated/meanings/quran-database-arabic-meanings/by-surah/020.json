{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 20,
  "entries": [
    {
      "verseKey": "20:2",
      "surahNumber": 20,
      "ayahNumber": 2,
      "text": "لِتشقى : لتتعب بالإفراط في مُكابدة الشدائد و التأسّف على قومك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:5",
      "surahNumber": 20,
      "ayahNumber": 5,
      "text": "على العرش استوى : استواءً يليق به تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:6",
      "surahNumber": 20,
      "ayahNumber": 6,
      "text": "ما تحت الثـّرى : ما وراه التراب. أو ما وراء الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:7",
      "surahNumber": 20,
      "ayahNumber": 7,
      "text": "أخفى : حديث النّـفـس و خواطرها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:10",
      "surahNumber": 20,
      "ayahNumber": 10,
      "text": "آنست نارا : أبصرتها بوُضوح\\nبقبس : بشعلة نار مقبوسة على رأس عود\\nهدًى : هاديا يهديني إلى الطريق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:12",
      "surahNumber": 20,
      "ayahNumber": 12,
      "text": "المقدّس : المُطهّر أو المبارك\\nطُوى : اسم للوادي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:15",
      "surahNumber": 20,
      "ayahNumber": 15,
      "text": "أكاد أخفيها : أقربُ أن أسترها من نفسي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:16",
      "surahNumber": 20,
      "ayahNumber": 16,
      "text": "فتـَردى : فتهلِك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:18",
      "surahNumber": 20,
      "ayahNumber": 18,
      "text": "أتوكّـأ عليها : أتحامل عليها في المشي و نحوه\\nأهشّ بها : أخبطُ بها الشجر ليتساقط الورق\\nمآرب أخرى : حاجات و منافع أخرى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:20",
      "surahNumber": 20,
      "ayahNumber": 20,
      "text": "حيّة تسعى : تمشي بسرعة و خفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:21",
      "surahNumber": 20,
      "ayahNumber": 21,
      "text": "سيرتها الأولى : إلى حالتها التي كانت عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:22",
      "surahNumber": 20,
      "ayahNumber": 22,
      "text": "إلى جناحك : إلى جنبك تحت العضد الأيسر\\nبيضاء : لها شعاع الشّمس\\nغير سُوء : غير داءٍ بَرَص و نحوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:24",
      "surahNumber": 20,
      "ayahNumber": 24,
      "text": "طغى : جاوز الحدّ في العتوّ و التجبّر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:29",
      "surahNumber": 20,
      "ayahNumber": 29,
      "text": "وزيرا : ظهيرا و مُعينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:31",
      "surahNumber": 20,
      "ayahNumber": 31,
      "text": "أزْري : ظهري أو قوتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:36",
      "surahNumber": 20,
      "ayahNumber": 36,
      "text": "أوتيت سؤْلك : أعطِيت مَسْـئولك و مطلوبك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:39",
      "surahNumber": 20,
      "ayahNumber": 39,
      "text": "فاقذفيه في اليمّ : فألقيه و اطرحيه في نهر النّيل\\nلتـُصنع على عيني : لترَبّي بمُراقبتي أو بمرأى منّي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:40",
      "surahNumber": 20,
      "ayahNumber": 40,
      "text": "من يكفله : من يضمّه إليه و يحفظه و يُربّيه\\nتقرّ عينها : تـُـسَرّ بلقائك\\nفتنّاك فتونا : خلّصناك من المِحن تخليصا\\nجئت على قدر : على وَفق الوقت المقدّر لإرسالك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:41",
      "surahNumber": 20,
      "ayahNumber": 41,
      "text": "اصطنعتك لنفسي : اصطفيتك لرسالتي و إقامة حُجّتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:42",
      "surahNumber": 20,
      "ayahNumber": 42,
      "text": "لا تنيا في ذكري : لا تفترا في تبليغ رسالتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:45",
      "surahNumber": 20,
      "ayahNumber": 45,
      "text": "يفرُط علينا : يعجل علينا بالعقوبة\\nيطغى : يزداد طُغيانا و عُـتوّاو جراءة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:46",
      "surahNumber": 20,
      "ayahNumber": 46,
      "text": "إنّـني معكما : حافظُكما و ناصركما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:50",
      "surahNumber": 20,
      "ayahNumber": 50,
      "text": "خَلـْقـَه : صورَته اللائقة بخاصّــته و منفعته\\nهَدَى : أرشدَه إلى ما يصلح له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:51",
      "surahNumber": 20,
      "ayahNumber": 51,
      "text": "فما بال القرون ؟ : فما حال و ما شأن الأمم؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:52",
      "surahNumber": 20,
      "ayahNumber": 52,
      "text": "لا يضلّ ربي : لا يغيب عن علمه شيء ما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:53",
      "surahNumber": 20,
      "ayahNumber": 53,
      "text": "مهدا : كالفراش الذي يُوطّأ للصّبي\\nسُبُـلا : طُرُقا تسلكونها لقضاء مآربكم\\nأزواجا : أصنافا أو ضروبا\\nشتـّى : مُختلفة الصّـفات و الخصائص",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:54",
      "surahNumber": 20,
      "ayahNumber": 54,
      "text": "لألي النـّـُـهى : لأصحاب العقول و البصائر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:56",
      "surahNumber": 20,
      "ayahNumber": 56,
      "text": "أبى : امتنع عن الإيمان و الطّاعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:58",
      "surahNumber": 20,
      "ayahNumber": 58,
      "text": "مكانا سُوى : وَسَطا أو مُستويا من الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:59",
      "surahNumber": 20,
      "ayahNumber": 59,
      "text": "يوم الزّينة : يوم عيدكم (يوم مشهود)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:60",
      "surahNumber": 20,
      "ayahNumber": 60,
      "text": "فجمع كيده : سحَرته الذين يكيد بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:61",
      "surahNumber": 20,
      "ayahNumber": 61,
      "text": "ويلكم : دُعاء عليهم بالهلاك\\nفيُسحتكم : فيستأصلكم و يُبيدكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:62",
      "surahNumber": 20,
      "ayahNumber": 62,
      "text": "أسرّوا النّجوى : أخفوا التّناجي أشدّ الإخفاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:63",
      "surahNumber": 20,
      "ayahNumber": 63,
      "text": "بطريقتكم المُثلى : بسنّتكم و شريعتكم الفضلى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:64",
      "surahNumber": 20,
      "ayahNumber": 64,
      "text": "فأجمعوا كيدَكم : فأحكموا سِحركم و اعزموا عليه\\nأفلح : فاز بالمطلوب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:67",
      "surahNumber": 20,
      "ayahNumber": 67,
      "text": "فأوجس في نفسه : أضمَرَ. أو وَجَد و أحسّ في نفسه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:69",
      "surahNumber": 20,
      "ayahNumber": 69,
      "text": "تلقف : تبتلعْ و تلتقـِمْ بسرعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:72",
      "surahNumber": 20,
      "ayahNumber": 72,
      "text": "و الذي فطرنا : أبدعنا و أوجدنا و هو الله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:76",
      "surahNumber": 20,
      "ayahNumber": 76,
      "text": "تزكّى : تطهّر من دنس الشّرك و الكفر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:77",
      "surahNumber": 20,
      "ayahNumber": 77,
      "text": "أسر بعبادي : سِرْ ليلا بهم من مصر\\nيَــبَـسا : يابسا لا ماء فيه و لا طين\\nلا تخاف دَرَكا : لا تخشى إدراكا و لحاقا أو تبعة\\nلا تخشى : الغرق من الأمام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:78",
      "surahNumber": 20,
      "ayahNumber": 78,
      "text": "فغشِــيهم : علاهم و غمرهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:80",
      "surahNumber": 20,
      "ayahNumber": 80,
      "text": "المنّ : مادّة صمغية حلوة كالعسل\\nالسّلوى : الطائر المعروف بالسّماني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:81",
      "surahNumber": 20,
      "ayahNumber": 81,
      "text": "لا تطغوْا : لا تكفروا نعمه أو لا تظلموا\\nفيحلّ عليكم : فيجب عليكم و يلزمكم\\nهَوَى : هلك . أو وَقع في الهاوية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:83",
      "surahNumber": 20,
      "ayahNumber": 83,
      "text": "ما أعجلك؟ : ما حملك على العجلة ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:85",
      "surahNumber": 20,
      "ayahNumber": 85,
      "text": "فتـنـّـا قومك : ابتليناهم . أو أوقعناهم في فتنة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:86",
      "surahNumber": 20,
      "ayahNumber": 86,
      "text": "أسِفا : حزينا . أو شديد الغضب\\nموعدي : وعدكم لي بالثبات على ديني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:87",
      "surahNumber": 20,
      "ayahNumber": 87,
      "text": "بملكِنا : بقدرتِنا و طاقتِنا\\nأوْزارا : أثقالا أو آثاما و تبـِعات\\nمن زينة القوم : من حليّ قبط مصر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:88",
      "surahNumber": 20,
      "ayahNumber": 88,
      "text": "عِجلا جسدا : مُجسّدا : أي أحمر من ذهب\\nلهُ خوار : صوت كصوت البقر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:92",
      "surahNumber": 20,
      "ayahNumber": 92,
      "text": "ما منعَك : ما حمَلك و اضطرّك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:95",
      "surahNumber": 20,
      "ayahNumber": 95,
      "text": "فما خطبُك ؟ : فما شأنك الخطير ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:96",
      "surahNumber": 20,
      "ayahNumber": 96,
      "text": "بَصُرتُ : علِمتُ بالبصيرة\\nأثر الرّسول : أثر فرس جبريل عليه السلام\\nفنبذتها : ألقيتُها في الحليّ المُذاب\\nسوّلت : زيّـنت و حسّـنت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:97",
      "surahNumber": 20,
      "ayahNumber": 97,
      "text": "لا مِساس : لا تمسّـني و لا أمسّـك\\nلنـنـْسِفـنّـه : لَنُذرّينّه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:100",
      "surahNumber": 20,
      "ayahNumber": 100,
      "text": "وزرا : عقوبة ثقيلة على إعراضه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:102",
      "surahNumber": 20,
      "ayahNumber": 102,
      "text": "زرقا : زُرق العيون . أو عُميا . أو عطاشا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:103",
      "surahNumber": 20,
      "ayahNumber": 103,
      "text": "يتخافتون : يتسارّون و يتهامسون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:104",
      "surahNumber": 20,
      "ayahNumber": 104,
      "text": "أنثلهم طريقة : أعدلهم و أفضلهم رأيا و مذهبا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:105",
      "surahNumber": 20,
      "ayahNumber": 105,
      "text": "ينسفها : يقتلعها أو يفتتها و يقرّقها بالرّياح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:106",
      "surahNumber": 20,
      "ayahNumber": 106,
      "text": "قاعا : أرضا ملساء لا نبات و لا بناء فيها\\nصفصفا : أرضا مُستوية أو لا نبات فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:107",
      "surahNumber": 20,
      "ayahNumber": 107,
      "text": "عِوَجا : مكانا مُنخفضا. أو انخفاضا\\nأمْـتـا : مكانا مُرتفعا . أو ارتفعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:108",
      "surahNumber": 20,
      "ayahNumber": 108,
      "text": "لا عِوَج له : لا يعوجّ له مدعُوٌ و لا يزيغ عنه\\nهَمْسا : صوتا خفيّا خافتا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:111",
      "surahNumber": 20,
      "ayahNumber": 111,
      "text": "عنـَتِ الوجوه : ذلّ النّاس و خضعوا\\nللحيّ : الدّائم الحياة بلا زوال\\nالقيّوم : الدّائم القيام بتدبير الخلق\\nحمل ظلما : شركا و كفرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:112",
      "surahNumber": 20,
      "ayahNumber": 112,
      "text": "هضما : نقصا من ثوابه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:113",
      "surahNumber": 20,
      "ayahNumber": 113,
      "text": "صرّفنا فيه : كرّرنا فيه بأساليب شتى\\nذِكرا : عِظة و اعتبارا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:114",
      "surahNumber": 20,
      "ayahNumber": 114,
      "text": "أن يُقضى إليك : أن يُفرغ و يُتمّ إليك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:115",
      "surahNumber": 20,
      "ayahNumber": 115,
      "text": "عَهـِدنا إلى آدم : أمرناه أو أوحينا إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:116",
      "surahNumber": 20,
      "ayahNumber": 116,
      "text": "أبى : امتنع من السّجود استكبارا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:118",
      "surahNumber": 20,
      "ayahNumber": 118,
      "text": "لا تعرَى : لا يُصيبك عُريٌ عن الملابس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:119",
      "surahNumber": 20,
      "ayahNumber": 119,
      "text": "لا تضحى : لا تبرز للشّمس فيصيبك حرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:120",
      "surahNumber": 20,
      "ayahNumber": 120,
      "text": "لا يبلى : لا يزول و لا يفنى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:121",
      "surahNumber": 20,
      "ayahNumber": 121,
      "text": "سوآتهما : عوراتهما\\nطفقا يخصفان : أخذا يُلصقان و يلزقان\\nعصى آدم : خالفا النّهي سهوا أو بتأوّل\\nفغوى : فضّل عن مطلوبه أو عن النّهي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:122",
      "surahNumber": 20,
      "ayahNumber": 122,
      "text": "اجتباه : اصطفاه للنّبوّة و قرّبه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:124",
      "surahNumber": 20,
      "ayahNumber": 124,
      "text": "معيشة ضنكا : ضيّقة شديدة (في قبره)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:128",
      "surahNumber": 20,
      "ayahNumber": 128,
      "text": "أفلم يهد لهم : أغفلوا فلم يُبيّن لهم مآلهم\\nكم أهلكنا : كثرة إهلاكنا الأمم الماضية\\nلأولى النـّـهى : لذوي العقول و البصائر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:129",
      "surahNumber": 20,
      "ayahNumber": 129,
      "text": "لكان لزاما : لكان إهلاكهم عاجلا لازما\\nأجل مسمّى : يوم القيامة (عطف على كلمة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:130",
      "surahNumber": 20,
      "ayahNumber": 130,
      "text": "سبّح بحمد ربّك : صلّ و أنت حامد لربّك\\nآناء الليل : ساعاته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:131",
      "surahNumber": 20,
      "ayahNumber": 131,
      "text": "أزواجا منهم : أصنافا من الكفّار\\nزهرة الحياة الدنيا : زينتها و بهجتها\\nلِنفتنهم فيه : لنجعله فتنة لهم و ابتلاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:133",
      "surahNumber": 20,
      "ayahNumber": 133,
      "text": "بيّــنة : هي القرآن المُعجـِز أم الآيات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:134",
      "surahNumber": 20,
      "ayahNumber": 134,
      "text": "من قبله : من قبل الإثبات بالبيّنة\\nنخزى : نَفتـَضح في الآخرة بالعذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "20:135",
      "surahNumber": 20,
      "ayahNumber": 135,
      "text": "مُتربّصٌ : مُنتظر مآله\\nالصّراط السّويّ : الطّريق المستقيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
