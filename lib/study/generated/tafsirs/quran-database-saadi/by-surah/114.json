  "entries": [
    {
      "verseKey": "114:1",
      "surahNumber": 114,
      "ayahNumber": 1,
      "text": "قل يا محمد: أعوذ وأعتصم برب الناس, القادر وحده على رد شر الوسواس",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "114:2",
      "surahNumber": 114,
      "ayahNumber": 2,
      "text": "ملك الناس المتصرف في كل سؤونهم, الغني عنهم",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "114:3",
      "surahNumber": 114,
      "ayahNumber": 3,
      "text": "إله الناس الذي لا معبود بحق سواه",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "114:4",
      "surahNumber": 114,
      "ayahNumber": 4,
      "text": "من أذى الشيطان الذي يوسوس عند الغفلة, ويختفي عند ذكر الله",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "114:5",
      "surahNumber": 114,
      "ayahNumber": 5,
      "text": "الذي يبث الشر والشكوك في صدور الناس",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "114:6",
      "surahNumber": 114,
      "ayahNumber": 6,
      "text": "من شياطين الجن والإنس",
      "kind": "tafsir",
      "source": "Quran-Database - Tafsir As-Saadi",
      "sourceId": "quran-database-saadi",
      "language": "ar",
      "direction": "rtl"
    }
  ]
