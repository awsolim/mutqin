{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 38,
  "entries": [
    {
      "verseKey": "38:1",
      "surahNumber": 38,
      "ayahNumber": 1,
      "text": "و القرآن : (قسم) جوابه ما الأمر كما تزعمون\\nذي الذكر : ذي البيان لما يُحتاج إليه في الدين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:2",
      "surahNumber": 38,
      "ayahNumber": 2,
      "text": "عزة : حميّـة و تكبر عن الحقّ\\nشقاق : مشاقّة و مخالفة لله و لرسوله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:3",
      "surahNumber": 38,
      "ayahNumber": 3,
      "text": "كم أهلكنا : كثيرة أهلكنا\\nقرن : أمة\\nفنادوْا : استغاثوا حين عاينوا العذاب\\nلات حين مناص : ليس الوقت وقت فرار و خلاص",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:5",
      "surahNumber": 38,
      "ayahNumber": 5,
      "text": "عجاب : بالغ الغاية في العَجَب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:6",
      "surahNumber": 38,
      "ayahNumber": 6,
      "text": "الملأ منهم : الوجوه من كفار قريش\\nامشوا : سيروا على طريقتكم و دينكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:7",
      "surahNumber": 38,
      "ayahNumber": 7,
      "text": "الملّة الآخرة : دين قريش الذي هم عليه\\nاختلاق : كذب و افتراء منه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:10",
      "surahNumber": 38,
      "ayahNumber": 10,
      "text": "الأسباب : المعارج إلى السماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:11",
      "surahNumber": 38,
      "ayahNumber": 11,
      "text": "جندٌ ما : \\\"هم مجتمع حقير و \\\"\\\"ما\\\"\\\" زائدة\\\"\\nهنالك : بمكّة يوم الفتح أو يوم بَدْر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:12",
      "surahNumber": 38,
      "ayahNumber": 12,
      "text": "ذو الأوتاد : الجنود أو المباني القويتين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:13",
      "surahNumber": 38,
      "ayahNumber": 13,
      "text": "أصحاب الأيكة : سكان الغيضة الكثيفة الملتفّة الشجر (قوم شعيب)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:15",
      "surahNumber": 38,
      "ayahNumber": 15,
      "text": "ما ينظر : ما ينتظر\\nصيحة واحدة : نفخة البعث\\nما لها من فواق : مالها توقـّـف قدْر فواق ناقة ، و هو ما بين حلبتيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:16",
      "surahNumber": 38,
      "ayahNumber": 16,
      "text": "قطّـنا : نصيبنا من العذاب الذي أوعدته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:17",
      "surahNumber": 38,
      "ayahNumber": 17,
      "text": "ذا الأيد : ذا القوّة في الدين و العبادة\\nإنه أوّاب : رجّاع إلى الله تعالى و طاعته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:18",
      "surahNumber": 38,
      "ayahNumber": 18,
      "text": "بالعشيّ و الإشراق : من الزّوال للغروب ، ووقت الضّحى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:20",
      "surahNumber": 38,
      "ayahNumber": 20,
      "text": "شددنا ملكه : قوّيناه بأسباب القوّة كلّها\\nآتيناه الحكمة : النبوّة و كمال العلم و اتقان العمل\\nفصل الخطاب : علم فصل الخصومات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:21",
      "surahNumber": 38,
      "ayahNumber": 21,
      "text": "الخصم : ملكين في صورة إنسانين\\nتسوّروا المحراب : علوْ سور مصلاّه و نزلوا إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:22",
      "surahNumber": 38,
      "ayahNumber": 22,
      "text": "بغى بعضنا : تعدّى و ظلم و جار\\nلا تشطط : لا تجر في حكمك\\nسواء الصّراط : وسط الطريق و هو عين الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:23",
      "surahNumber": 38,
      "ayahNumber": 23,
      "text": "اكفلنيها : انزلْ لي عنها حتى أكفلها\\nعزني في الخطاب : غلبني و قهرني في المُحاجّـة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:24",
      "surahNumber": 38,
      "ayahNumber": 24,
      "text": "الخلطاء : الشركاء\\nفتنّـاه : ابتليناه و امتحنّاه\\nخرّ راكعا : ساجدا لله تعالى\\nأناب : رجع إلى بالتـّـوبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:25",
      "surahNumber": 38,
      "ayahNumber": 25,
      "text": "لَزلفى : لقـُـربَة و مكانة\\nحسن مآب : حسن مرجع في الآخرة (الجنّة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:27",
      "surahNumber": 38,
      "ayahNumber": 27,
      "text": "باطلا : لَعِـبًا و عبَثا\\nفويل : هلاكٌ . أو وادٍ في جهنم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:30",
      "surahNumber": 38,
      "ayahNumber": 30,
      "text": "إنه أواب : رجّاعٌ إليه تعالى بالتوبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:31",
      "surahNumber": 38,
      "ayahNumber": 31,
      "text": "بالعشي : ما بعد الزوال إلى الغروب\\nالصافنات : الخيول الواقفة على ثلاث قوائم و طرف حافر الرابعة\\nالجياد : السّراع السوابق في العدو",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:32",
      "surahNumber": 38,
      "ayahNumber": 32,
      "text": "أحببت حب الخير : آثرتُ حبّ الخيل\\nعن ذكر ربي : على صلاتي العصر لله تعالى\\nتوارت بالحجاب : غرَبَت الشمس . أو غابت الخيل عن بصره لظلمة الليل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:33",
      "surahNumber": 38,
      "ayahNumber": 33,
      "text": "ردّوها علي : رُدّوا الخيل عليّ\\nفطفق مسحا بالسّوق و الأعناق : فَشرعَ يقطع سُوقها و أعْـنـَـاقها بالسّيف قربانا لله تعالى و كانَ ذلك مشروعا في ملّـتِه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:34",
      "surahNumber": 38,
      "ayahNumber": 34,
      "text": "فتنّـا سليمان : ابْـتليْناهُ و امتحنّـاه و عاقبْناه\\nجسدا : شِقّ إنسان ولِـد له\\nأناب : رَجَع إلى الله تعالى بالتـّـوبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:36",
      "surahNumber": 38,
      "ayahNumber": 36,
      "text": "رخاءً حيث أصاب : لـَــيّـنة . أو مُنقادة حيث أرَاد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:37",
      "surahNumber": 38,
      "ayahNumber": 37,
      "text": "غوّاص : في البحر لاستخْراج نفائسهِ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:38",
      "surahNumber": 38,
      "ayahNumber": 38,
      "text": "الأصفاد : الأغلال تجمع الأيدي إلى الأعناق",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:39",
      "surahNumber": 38,
      "ayahNumber": 39,
      "text": "بغير حساب : غير مُحاسَبعلى شيء من الأمْـرَين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:40",
      "surahNumber": 38,
      "ayahNumber": 40,
      "text": "لزلفى : لقـُرْبا و كَرَامة\\nحسن مآب : حُسْن مَرْجع في الآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:41",
      "surahNumber": 38,
      "ayahNumber": 41,
      "text": "بنصْب و عذاب : بتعب و مشقـّـة ، و ألـَـم و ضرّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:42",
      "surahNumber": 38,
      "ayahNumber": 42,
      "text": "اركض برجلك : اضربْ بها الأرض\\nهذا مغتسل : ماءٌ تغتسل به ، فيه شفاؤك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:44",
      "surahNumber": 38,
      "ayahNumber": 44,
      "text": "ضِغثا : قبضة من قضْبان أو عثكال النّخل بشماريخه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:45",
      "surahNumber": 38,
      "ayahNumber": 45,
      "text": "أولي الأيدي : أصحاب القوّة في الطّاعة\\nو الأبصار : و البصائر في الدّين و العلْم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:46",
      "surahNumber": 38,
      "ayahNumber": 46,
      "text": "أخلصناهم بخالصة : خَصصناهم بخصْـلـَـة لا شَوْب فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:49",
      "surahNumber": 38,
      "ayahNumber": 49,
      "text": "هذا ذكر : المذكور من محاسنهم شَرَفٌ لهُم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:52",
      "surahNumber": 38,
      "ayahNumber": 52,
      "text": "قاصرات الطرف : حُورٌ لا ينظرْن إلى غير أزواجهنّ\\nأتراب : مستوياتٌ في الشّباب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:54",
      "surahNumber": 38,
      "ayahNumber": 54,
      "text": "نفاد : انقطاع و فَـناءٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:55",
      "surahNumber": 38,
      "ayahNumber": 55,
      "text": "لشرّ مآب : لأسْوَأ مُنقلبٍ و مَصير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:56",
      "surahNumber": 38,
      "ayahNumber": 56,
      "text": "جهنّم يصلونها : يَدْخلونـَـها أو يقاسونَ حَرّها\\nفبئس المهاد : فبئس الفِـراش ، أي المستقرّ جهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:57",
      "surahNumber": 38,
      "ayahNumber": 57,
      "text": "حميم : ماءٌ بالغ نهاية الحرارة\\nغسّاق : صَديدٌ يسيل من أجسامِهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:58",
      "surahNumber": 38,
      "ayahNumber": 58,
      "text": "و آخر : و عذابٌ آخر\\nمن شكله أزواج : مِنْ مثلِه أصْنافٌ في الفظاعَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:59",
      "surahNumber": 38,
      "ayahNumber": 59,
      "text": "هذا فوج : جَمعٌ كَثيف مِنْ أتباعِكم الضّـالين\\nمقتحم معكم : داخلٌ مَعَكم النار قـَهْرًا عنه\\nلا مرحبا بهم : لا رَحُـبَـتْ بهم النار و لا اتـّـسعتْ\\nصلوا النّار : داخِلوها . أو مُقـَاسو حرّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:60",
      "surahNumber": 38,
      "ayahNumber": 60,
      "text": "فبئس القرار : فبئسَ المَقرّ للجميع جَهنّم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:63",
      "surahNumber": 38,
      "ayahNumber": 63,
      "text": "أتـّـخذناهم سخريّـا ؟ : مَهزوءًا بهم في الدنيا فأخطأنا ؟؟\\nزاغت عنهم الأبصار : مَـالتْ عنهمْ فلم نعلم مكَانـَـهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:69",
      "surahNumber": 38,
      "ayahNumber": 69,
      "text": "بالملأ الأعلى : المَلائكة\\nإذ يختصمون : في شأن آدم و خَلقِهِ و خِـلافته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "38:72",
      "surahNumber": 38,
      "ayahNumber": 72,
      "text": "سوّيته : أتمَمْتَ خَلقـَـه بالصّورة الإنسانية\\nساجدين : تحيّة له و تكريمًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
