{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 12,
  "entries": [
    {
      "verseKey": "12:3",
      "surahNumber": 12,
      "ayahNumber": 3,
      "text": "نقُصّ عليك : نُحدّثك أو نبيّن لك يا محمد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:6",
      "surahNumber": 12,
      "ayahNumber": 6,
      "text": "يجتبيك : يصطفيك بأمور عظام\\nتأويل الأحاديث : تعبير الرؤيا و تفسيرها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:8",
      "surahNumber": 12,
      "ayahNumber": 8,
      "text": "نحن عُصبة : جماعة كُفاة للقيام بأمره دونها\\nضلال مُبين : خطأ بيّن في إيثارهما علينا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:9",
      "surahNumber": 12,
      "ayahNumber": 9,
      "text": "اطرحوه أرضا : ألقوه في أرض بعيدة عن أبيه\\nيخلُ لكم وجه أبيكم : يخلص لكم حبّه و إقباله عليكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:10",
      "surahNumber": 12,
      "ayahNumber": 10,
      "text": "غيابة الجبّ : ما غاب و أظلم من قعر البئر\\nالسّيّارة : المسافرين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:12",
      "surahNumber": 12,
      "ayahNumber": 12,
      "text": "يرتع : يتّسع في أكل ما لذ و طاب\\nيلعب : يُسابق و يرم بالسّهام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:15",
      "surahNumber": 12,
      "ayahNumber": 15,
      "text": "أجمعوا : عزموا و صمّموا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:17",
      "surahNumber": 12,
      "ayahNumber": 17,
      "text": "نستبق : ننتضل في الرّمي بالسّهام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:18",
      "surahNumber": 12,
      "ayahNumber": 18,
      "text": "سوّلت : زيّنت و سهّلت\\nفصبر جميل : لا شكوى فيه لغير الله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:19",
      "surahNumber": 12,
      "ayahNumber": 19,
      "text": "سيّارة : رُفقة مُسافرون من مدين لمصر\\nواردهم : من يتقدّم الرّفقة ليستقي لهم\\nفأدلى دلوه : فأرسلها في الجبّ ليملأها ماءً\\nأسرّوه : أخفاه الوارد و أصحابه عن بقيّة الرّفقة ، أو أخفى أو إخوته أمره\\nبضاعة : متاعا للتّجارة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:20",
      "surahNumber": 12,
      "ayahNumber": 20,
      "text": "شروه : باعه إخوته . أو السّيّارة\\nبثمن بخس : ناقص عن القيمة نُقصانا ظاهرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:21",
      "surahNumber": 12,
      "ayahNumber": 21,
      "text": "أكرمي مثواه : اجعلي محلّ إقامته كريما مرضيّا\\nغالب على أمره : لا يقهره شيء ، و لا يدفعه عنه أحد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:22",
      "surahNumber": 12,
      "ayahNumber": 22,
      "text": "بلغ أشدّه : مُنتهى شدّة جسمه و قوّته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:23",
      "surahNumber": 12,
      "ayahNumber": 23,
      "text": "راودته : تمحّنت لمُواقعته إياها\\nهيت لك : أقبِل ، أسرع – إرادتي لك\\nمعاذ الله : أعوذ بالله معاذا مما دعوتني إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:24",
      "surahNumber": 12,
      "ayahNumber": 24,
      "text": "همّ بها : همّ الطّباع البشرية مع العصمة\\nالمُخلصين : المُختارين لطاعته أو لرسالته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:25",
      "surahNumber": 12,
      "ayahNumber": 25,
      "text": "استبقا الباب : تسابقا إليه يريد الخروج و هي تمنعه\\nقدّت قميصه : قطعته و شقّته\\nألفيا سيّدها : وجدا زوجها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:26",
      "surahNumber": 12,
      "ayahNumber": 26,
      "text": "شهد شاهد : صبيّ في المهد أنطقه الله ببراءته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:30",
      "surahNumber": 12,
      "ayahNumber": 30,
      "text": "شغفها حُـبّا : شقّ حُبُه سويداء قلبها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:31",
      "surahNumber": 12,
      "ayahNumber": 31,
      "text": "أعتدت لهن مُـتـّكأ : هيّأت لهنّ ما يتّكئن عليه\\nأكبرنه : دهشن برؤية جماله الرائع\\nقطّعن أيديهنّ : خدشنها بالسّكاكين لفرط ذهولهنّ و دهشتهنّ\\nحاش لله : تنزيها لله عن العجز عن خلق مثله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:32",
      "surahNumber": 12,
      "ayahNumber": 32,
      "text": "فاستعصم : فامتنع امتناعا شديدا و أبى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:33",
      "surahNumber": 12,
      "ayahNumber": 33,
      "text": "أصبوا إليهنّ : أمِلْ إلى إجابتهنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:36",
      "surahNumber": 12,
      "ayahNumber": 36,
      "text": "أعصر خمرا : عنبا يؤول لخمر أسقيه الملك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:37",
      "surahNumber": 12,
      "ayahNumber": 37,
      "text": "ذ لكما : التأويل و الإخبار بما يأتي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:40",
      "surahNumber": 12,
      "ayahNumber": 40,
      "text": "الدّين القيّم : المُستقيم . أو الثّابت بالبراهين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:43",
      "surahNumber": 12,
      "ayahNumber": 43,
      "text": "عِجاف : مهازيل جدّا\\nتعبرون : تعلمون تأويلها و تفسيرها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:44",
      "surahNumber": 12,
      "ayahNumber": 44,
      "text": "أضغاث أحلام : تخاليطها و أباطيلها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:45",
      "surahNumber": 12,
      "ayahNumber": 45,
      "text": "ادّكر بعد أمّة : تذكّر بعد مدّة طويلة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:47",
      "surahNumber": 12,
      "ayahNumber": 47,
      "text": "دأبا : دائبين كعادتكم في الزّراعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:48",
      "surahNumber": 12,
      "ayahNumber": 48,
      "text": "تُحصنون : تخبؤونه من البذر للزّراعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:49",
      "surahNumber": 12,
      "ayahNumber": 49,
      "text": "يُغاث النّاس : يُمطرون فتخصب أراضيهم\\nيعصرون : ما شأنه أن يُعصر كالزّيتون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:50",
      "surahNumber": 12,
      "ayahNumber": 50,
      "text": "ما بال النّسوة ؟ : ما حالهنّ ما شأنهنّ ؟",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:51",
      "surahNumber": 12,
      "ayahNumber": 51,
      "text": "ما خطبكنّ؟ : ما شأنكنّ و أمركنّ ؟\\nحاش لله : تنزيها لله و تعجيبا من عفّة يوسف\\nحصحص الحقّ : ظهر و انكشف بعد خفاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:54",
      "surahNumber": 12,
      "ayahNumber": 54,
      "text": "مكين : ذو مكانة رفيعة و نفوذ أمر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:56",
      "surahNumber": 12,
      "ayahNumber": 56,
      "text": "يتبوّأ منها : يتّخذ منها نباءة و منزلا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:59",
      "surahNumber": 12,
      "ayahNumber": 59,
      "text": "جهّزهم بجَهازهم : أعطاهم ما هم في حاجة إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:62",
      "surahNumber": 12,
      "ayahNumber": 62,
      "text": "بضاعتهم : ثمن ما اشتروه من الطّعام\\nرحالهم : أوعيتهم التي فيها الطّعام و غيره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:65",
      "surahNumber": 12,
      "ayahNumber": 65,
      "text": "متاعهم : طعامهم . أو رحالهم\\nما نبغي ؟ : ما نطلب من الإحسان بعد ذلك؟\\nنمير أهلنا : نجلب لهم الطّعام من مصر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:66",
      "surahNumber": 12,
      "ayahNumber": 66,
      "text": "موثقا : عهدا مُؤكّدا باليمين يوثق به\\nيُحاط بكم : تُغلبوا . أو تهلكوا جميعا\\nوكيل : مُضطلع رقيبٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:69",
      "surahNumber": 12,
      "ayahNumber": 69,
      "text": "آوى إليه أخاه : ضمّ إليه أخاه الشّقيق بنيامين\\nفلا تبتئس : فلا تحزن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:70",
      "surahNumber": 12,
      "ayahNumber": 70,
      "text": "السّقاية : إناءً من ذهب للشّرب اتخذ للكيل\\nأذّن مؤذن : نادى مُنادٍ و أعلم مُعلم\\nالعير : القافلة فيها الأحمال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:72",
      "surahNumber": 12,
      "ayahNumber": 72,
      "text": "صواع الملك : \\\"صاعه \\\"\\\"مكياله\\\"\\\" ، و هو السّقاية \\\"\\nزعيم : كفيل أؤدّيه إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:76",
      "surahNumber": 12,
      "ayahNumber": 76,
      "text": "كدنا ليوسف : دبّرنا لتحصيل غرضه\\nدين الملك : شريعة ملك مصر أو حُكمه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:79",
      "surahNumber": 12,
      "ayahNumber": 79,
      "text": "معاذ الله : نعوذ بالله معاذا و نعتصم به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:80",
      "surahNumber": 12,
      "ayahNumber": 80,
      "text": "استيأسوا منه : يئسوا من إجابة يوسف لهم\\nخلصوا نجيّا : انفردوا متناجين مُتشاورين\\nما فرّطتم : قصّرتم ، و (ما : زائدة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:82",
      "surahNumber": 12,
      "ayahNumber": 82,
      "text": "العير : القافلة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:83",
      "surahNumber": 12,
      "ayahNumber": 83,
      "text": "سوّلت : زيّنت و سهّلت",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:84",
      "surahNumber": 12,
      "ayahNumber": 84,
      "text": "يا أسفى : يا حُزني الشّديد\\nابيضّت عيناه : أصابتهما غشاوة فابيضّتا\\nكظيم : ممتلئ من الغيظ أو الحزن يكتمه و لا يُبديه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:85",
      "surahNumber": 12,
      "ayahNumber": 85,
      "text": "تفتأ : لا تفتأ و لا تزال\\nتكون حرضا : تصير مريضا مُشفيا على الهلاك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:86",
      "surahNumber": 12,
      "ayahNumber": 86,
      "text": "بثي : أشدّ غمّي و همّي",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "12:87",
      "surahNumber": 12,
      "ayahNumber": 87,
