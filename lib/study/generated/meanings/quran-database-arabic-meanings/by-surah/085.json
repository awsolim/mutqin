  "surahNumber": 85,
  "entries": [
    {
      "verseKey": "85:1",
      "surahNumber": 85,
      "ayahNumber": 1,
      "text": "و السماء : (أَقسَمَ) اللهُ بها وبما بعدها\\nذات البروج : ذات المنازلِ المعروفة للكواكب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "85:2",
      "surahNumber": 85,
      "ayahNumber": 2,
      "text": "اليوم الموعود : يومِ القيامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "85:3",
      "surahNumber": 85,
      "ayahNumber": 3,
      "text": "شاهد : من يَشهدُ على غيرِه فيه\\nمشهودٍ : من يَشهدُ عليه غيرُه فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "85:4",
      "surahNumber": 85,
      "ayahNumber": 4,
      "text": "قُـتِـل : لقد لُعِنَ أشدَّ اللَّعْنِ (جواب القسم)\\nالأخدود : \\\"الشِّقِّ العظيم ؛ كالخَنْدَق\\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "85:8",
      "surahNumber": 85,
      "ayahNumber": 8,
      "text": "ما نقموا : ما كَرِهُوا وما عابُوا وما أنكَروا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "85:10",
      "surahNumber": 85,
      "ayahNumber": 10,
      "text": "فـَـتَـنوا : عَذبُوا أو أَحرَقُوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "85:12",
      "surahNumber": 85,
      "ayahNumber": 12,
      "text": "بَطْش ربّـك : أخْذَه الجبابرةَ والظلمةَ بالعذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "85:13",
      "surahNumber": 85,
      "ayahNumber": 13,
      "text": "هو يُبدئ : يَخلُقُ ابتِداءً بقدرته\\nيُعيد : يَبعثُ الموتى يوم القيامة بقدرته",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "85:14",
      "surahNumber": 85,
      "ayahNumber": 14,
      "text": "الوَدود : المُتودِّدُ إلى أوليائِه بالكرامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "85:15",
      "surahNumber": 85,
      "ayahNumber": 15,
      "text": "المجيد : العظيمُ الجليلُ المُتعالِى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
