  "entries": [
    {
      "verseKey": "87:1",
      "surahNumber": 87,
      "ayahNumber": 1,
      "text": "سبّح اسم ربّك : نَزِّهُه ومَجِّدهُ تعالى عمَّا لا يَليق به",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "87:2",
      "surahNumber": 87,
      "ayahNumber": 2,
      "text": "خَلق : أَوْجَدَ كلَّ شىءٍ بقدرتِه\\nفسَوّى : بَينَ خَلْقِه فى الإحْكام والإتقان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "87:3",
      "surahNumber": 87,
      "ayahNumber": 3,
      "text": "قـَـدّر : جعلَ الأشياءَ على مَقادِيرَمَخصوصهٍ\\nفهَـدَى : فَوجَّه كلَّ واحدٍ منها إلى ما يَنبَغى له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "87:4",
      "surahNumber": 87,
      "ayahNumber": 4,
      "text": "أخْرَجَ المرعى : أنـْـبَتَ العُشبَ رَطْبًا غَضًّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "87:5",
      "surahNumber": 87,
      "ayahNumber": 5,
      "text": "فجَعَله غـُـثاءً : يابِسًا هَشِيمًا من بعدُ كالغُثاءِ(هو ما يَحمِلُه السَّيلُ من البَالِى من ورقِ الشجرِ مُخالِطًا زَبَدَه)\\nأحْوَى : أسْودَ أو أسْمَرَ بعد الخُضرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "87:6",
      "surahNumber": 87,
      "ayahNumber": 6,
      "text": "سنـُـقرؤك : ما نُوحِى إليكَ بواسطةِ جبريل عليه السلام\\nفلا تنسى : أبَدًا من قوةِ الحفظِ والإتقان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "87:8",
      "surahNumber": 87,
      "ayahNumber": 8,
      "text": "نـُـيـسّـرُك لليُـسرى : نُوفِّقُكَ للطريقةِ اليُسرى فى كل أمْرٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "87:12",
      "surahNumber": 87,
      "ayahNumber": 12,
      "text": "يَصْـلى النّار الكبرى : يَدخُلُ جهنَّمَ أو يُقاسِى حَرَّها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "87:14",
      "surahNumber": 87,
      "ayahNumber": 14,
      "text": "أفْـلح : فازَ بالبُغْيةِ\\nتزَكّى : تَطهِّرَ من الكفر والمعاصى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "87:18",
      "surahNumber": 87,
      "ayahNumber": 18,
      "text": "إنّ هَذا : المذكورَ (الآياتِ الأربعَ السابقة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
