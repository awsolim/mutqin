{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 68,
  "entries": [
    {
      "verseKey": "68:1",
      "surahNumber": 68,
      "ayahNumber": 1,
      "text": "و القلم : ( قَسَمٌ) بالقلم الذي يُكتب به\\nو ما يسطرون : و الذي يكتبونه بالقلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:2",
      "surahNumber": 68,
      "ayahNumber": 2,
      "text": "ما أنت : يا محمد (جواب القسم)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:3",
      "surahNumber": 68,
      "ayahNumber": 3,
      "text": "غير ممنون : غير مقطوع عنك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:6",
      "surahNumber": 68,
      "ayahNumber": 6,
      "text": "بأيكم المفتون : في أيّ الفريقين منكم المجنون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:9",
      "surahNumber": 68,
      "ayahNumber": 9,
      "text": "ودّوا لو تدهن : أحبّوا لـَوْ تلايـنُهمْ و تصانِعُهمْ\\nفيُدهِنون : فَهُمْ يُلاينونـَـك و يُصانعُونك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:10",
      "surahNumber": 68,
      "ayahNumber": 10,
      "text": "حلاف : كثير الحَلِفِ في الحقّ و الباطل\\nمهين : حقير في الرأي و التمييز أو كَذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:11",
      "surahNumber": 68,
      "ayahNumber": 11,
      "text": "همّاز : عيّـاب أو مُغتاب للنّـاس\\nمشّـاء بنميم : بالسِّعَايَة و الإفساد بين الناس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:13",
      "surahNumber": 68,
      "ayahNumber": 13,
      "text": "عُـتلّ : فاحِش لئيم ، أة غليظ جافٍ\\nزنيم : دَعِيّ مُـلصَق بقوْمِه أو شِرّير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:15",
      "surahNumber": 68,
      "ayahNumber": 15,
      "text": "أساطير الأولين : أباطيلهم المسطرة في كتبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:16",
      "surahNumber": 68,
      "ayahNumber": 16,
      "text": "سنسمه على الخرطوم : سَنلحِق به عارًا لا يُـفارقه كالوَسْم على الأنف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:17",
      "surahNumber": 68,
      "ayahNumber": 17,
      "text": "بَلوناهم : امْتحنّـا اهل مكّة بالقحْط\\nالجنّة : بُسْـتان بالقرب من صنعاء\\nليَصْرمنها : لـَـيَـقـْـطعنّ ثمارها بعد الإستواء\\nمصبحين : داخلين في وقت الصّباح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:18",
      "surahNumber": 68,
      "ayahNumber": 18,
      "text": "لا يستثنون : حِصّة المساكين مُخالِفـِينَ لأبيهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:19",
      "surahNumber": 68,
      "ayahNumber": 19,
      "text": "فطاف عليها : أحاط نازلا عليها\\nطائف : بَلاءٌ و عذابٌ (نارٌ مُحْرقة)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:20",
      "surahNumber": 68,
      "ayahNumber": 20,
      "text": "كالصريم : كالليل الأسود أو البستان المّصروم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:21",
      "surahNumber": 68,
      "ayahNumber": 21,
      "text": "فتنادوْا مصحبين : نادى بَعضهم بَعْضا حين أصبحوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:22",
      "surahNumber": 68,
      "ayahNumber": 22,
      "text": "اغدوا على حرْثِكم : بَـاكِرُوا مُقبلين على ثماركم\\nصارمين : قاصدين قطعها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:23",
      "surahNumber": 68,
      "ayahNumber": 23,
      "text": "يَتخافتون : يَتسارّونَ بالحديث فيما بينهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:25",
      "surahNumber": 68,
      "ayahNumber": 25,
      "text": "غَدوْا : ساروا غُـدوة إلى حرثهم\\nعلى حرْد : على انفراد عن المساكين\\nقادرين : على الصّرام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:26",
      "surahNumber": 68,
      "ayahNumber": 26,
      "text": "إنّـا ضالون : الطّريق ، و ما هذه جنّـتـنا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:28",
      "surahNumber": 68,
      "ayahNumber": 28,
      "text": "أوْسَطهم : أحسنهم رأيا و أرجحهم عقلا\\nلولا تسبّحون : هلاّ تستغفرون الله من فعلكم و خبْث نيّـتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:30",
      "surahNumber": 68,
      "ayahNumber": 30,
      "text": "يَتلاومون : يَلوم بَعضهم بَعضا على قصْدهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:32",
      "surahNumber": 68,
      "ayahNumber": 32,
      "text": "إلى ربـّـنا راغـبون : طالبون منه الخير و العفو",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:38",
      "surahNumber": 68,
      "ayahNumber": 38,
      "text": "لمَـا يتحيّرون : لـلـّـذي تختارونه و تشتهونه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:39",
      "surahNumber": 68,
      "ayahNumber": 39,
      "text": "لكم أيمان علينا : عهود مؤكّدة بالأيْمَان\\nلما تحْكمون : لـلـّذي تحكمون به لأنفسكمْ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:40",
      "surahNumber": 68,
      "ayahNumber": 40,
      "text": "زعـيم : كفيلٌ بأن يكون لهم ذلك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:42",
      "surahNumber": 68,
      "ayahNumber": 42,
      "text": "يُكشف عن ساق : كنايَة عن شدّة هوْل يوم القـيامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:43",
      "surahNumber": 68,
      "ayahNumber": 43,
      "text": "خاشعة أبْصارهم : ذليلة مُنكسِرَة\\nترْهقهم ذلـّـة : يَغشاهم ذلّ و خسْران و نـَـدامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:44",
      "surahNumber": 68,
      "ayahNumber": 44,
      "text": "فذرني : دَعْـني و خَلـّـني (تهديد شديد)\\nسنستدرجهم : سَنُدنيهم من العذاب دَرَجَة فدَرجة حتى نوقِعَهم فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:45",
      "surahNumber": 68,
      "ayahNumber": 45,
      "text": "أمْلِي لهمْ : أمْهِلهمْ ليزدادوا إثما",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:46",
      "surahNumber": 68,
      "ayahNumber": 46,
      "text": "مَغرَمٍ : غَرامة ذلك الأجر\\nمُثقلون : مُكلفون حِمْلاً ثقيلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:48",
      "surahNumber": 68,
      "ayahNumber": 48,
      "text": "كصاحب الحوت : يونس عليه السّـلام\\nمَكظوم : مَمْـلوءٌ غَـيْظا في قـلبه على قَوْمه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:49",
      "surahNumber": 68,
      "ayahNumber": 49,
      "text": "لنـُـبذ بالعراء : لـَـطرح من بَــْطن الحوت بالأرض الفضاء المُهلِكة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:50",
      "surahNumber": 68,
      "ayahNumber": 50,
      "text": "فاجتباه رَبّه : فاصْـفاه بعَوْدة الوَحْي إليه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "68:51",
      "surahNumber": 68,
      "ayahNumber": 51,
      "text": "ليـُــزلقـونك : ليُزلـّـونَ قـَدَمَك فيَرمونـَـك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
