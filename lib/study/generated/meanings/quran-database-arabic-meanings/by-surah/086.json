  "surahNumber": 86,
  "entries": [
    {
      "verseKey": "86:1",
      "surahNumber": 86,
      "ayahNumber": 1,
      "text": "و الطارق : (قسمٌ) بالنَّجم الثَّاقِب يَطلُعُ ليلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:3",
      "surahNumber": 86,
      "ayahNumber": 3,
      "text": "النـّـجم الثاقب : المُضِىءُ المُتوهِّجُ أو المُرتفِعُ العالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:4",
      "surahNumber": 86,
      "ayahNumber": 4,
      "text": "إن كلّ نـَـفس : ما كلُّ نَفسٍ (جواب القسم)\\nلمّـاعَـليها : إلا عليها\\nحافِـظٌ : مُهَيْمنٌ ورَقِيبٌ وهو الله تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:6",
      "surahNumber": 86,
      "ayahNumber": 6,
      "text": "ماءٍ : مُمتَزجٍ من مائَي الرجلِ والمرأة\\nدَافِـق : مَصبُوبٍ بِدَفْعٍ وسُرعةٍ فى الرَّحِم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:7",
      "surahNumber": 86,
      "ayahNumber": 7,
      "text": "مِـنْ بين الصلب : ظَهْر كلٍّ من الرجل والمرأة\\nو التـّرائب : عِظامِ الصَّدرِ أو الأطرافِ مِن كلٍّ منهما ، أو يَخرجُ من كل البَدَنِ مِنهما ، والصُّلْبُ والترائب كِنايةٌ عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:8",
      "surahNumber": 86,
      "ayahNumber": 8,
      "text": "رَجْعِه : إعادَةِ الإنسانِ بعدَ فنائه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:9",
      "surahNumber": 86,
      "ayahNumber": 9,
      "text": "تبْلى السّرائر : تـُكشَفُ مَكنوناتُ القلوب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:11",
      "surahNumber": 86,
      "ayahNumber": 11,
      "text": "ذات الرّجْـع : المطرِ لِرُجُوعِه إلى الأرض مِرارًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:12",
      "surahNumber": 86,
      "ayahNumber": 12,
      "text": "ذات الصّدْع : النباتِ الذى تـَنشَقُّ عنه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:13",
      "surahNumber": 86,
      "ayahNumber": 13,
      "text": "لـَـقوْلٌ فصل : فاصلٌ بين الحق والباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:16",
      "surahNumber": 86,
      "ayahNumber": 16,
      "text": "أكيدُ كيْدًا : أُجازيهم على فِعلِهم بالاسْتدْراج",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "86:17",
      "surahNumber": 86,
      "ayahNumber": 17,
      "text": "فمهّل الكافرين : فلا تـَستَعجـِلْ بالانتقام منهمْ\\nأمْهلهُمْ روَيْدا : إمْهالاً قريبًا ، أو قليلاً حتى يَأتِيَهم العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
