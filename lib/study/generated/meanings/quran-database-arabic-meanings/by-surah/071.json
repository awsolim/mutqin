  "surahNumber": 71,
  "entries": [
    {
      "verseKey": "71:4",
      "surahNumber": 71,
      "ayahNumber": 4,
      "text": "إنّ أجل الله : وَقـْـتَ مَجيء عذابه إنْ لم تُؤمِنوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:6",
      "surahNumber": 71,
      "ayahNumber": 6,
      "text": "فِرارًا : تـَـبَاعُـدًا و نِفـَـارًا عن الإيمان",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:7",
      "surahNumber": 71,
      "ayahNumber": 7,
      "text": "استـَـغْـشَوْا ثِيابهم : بالغُوا في التـّـغَطّـى بها كَرَاهة لي\\nأصرّوا : تشدّدوا و انـْـهَمَـكُوا في الكُـفـر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:11",
      "surahNumber": 71,
      "ayahNumber": 11,
      "text": "يُرْسِل السّماء : المطر الذي في السّحاب\\nمِدْرارًا : غزيرًا مُـتـتابعًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:13",
      "surahNumber": 71,
      "ayahNumber": 13,
      "text": "لا تـَـرْجونَ لله وَقارًا : لا تعتقِـدون أو لا تخافون عَظمَة الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:14",
      "surahNumber": 71,
      "ayahNumber": 14,
      "text": "خلقـَـكمْ أطوارا : مُدَرّجًا لكم في حالاتٍ مُختلِفة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:15",
      "surahNumber": 71,
      "ayahNumber": 15,
      "text": "سموات طِباقا : كلّ سَمَـاءٍ مُقـْـبيَّة على الأخْرى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:16",
      "surahNumber": 71,
      "ayahNumber": 16,
      "text": "نورًا : مُنـَـوّرًا لِوَجْهِ الأرض في الظلام\\nالشّمس سِرَاجًـا : مِصْباحًـا مُضيئا يمحُو الظلام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:17",
      "surahNumber": 71,
      "ayahNumber": 17,
      "text": "أنـْـبَـتـَـكم من الأرض : أنـْـشأكم من طينتها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:19",
      "surahNumber": 71,
      "ayahNumber": 19,
      "text": "الأرض بساطًا : فِـراشا مبسوطا للاستقـرار عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:20",
      "surahNumber": 71,
      "ayahNumber": 20,
      "text": "سُبُلاً فِجَاجًـا : طرُقـًـا وَاسِعات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:21",
      "surahNumber": 71,
      "ayahNumber": 21,
      "text": "خَسَـارًا : ضلالا في الدنيا و عِقابًـا في الآخرة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:22",
      "surahNumber": 71,
      "ayahNumber": 22,
      "text": "مَكْرًا كُـبّـَارًا : بَالِغَ الغَـايةِ في الكِـبَر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:23",
      "surahNumber": 71,
      "ayahNumber": 23,
      "text": "وَدًّا : أصنامٌ عَبَدوها ثمّ انتقلت إلى العَرَب .، فكان وَدّ لِكـَــلـْـب\\nسُوَاعًـا : و سُوَاعٌ لِهُـذيْـل\\nيَغوثَ : وَ يَغُوث لِغَطفان\\nيَعُوق : و يَعُوق لِهَمَذان\\nنـَـسْرَا : و نـَـسْـرٌ لآلِ ذي الكَلاع مِنْ حِمْير",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:25",
      "surahNumber": 71,
      "ayahNumber": 25,
      "text": "ممّا خطيئاتِهم : \\\"من أجل ذنوبهم و \\\"\\\"ما\\\"\\\" زائدة \\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:26",
      "surahNumber": 71,
      "ayahNumber": 26,
      "text": "ديّـارًا : أحدًا يَدور ة يَتحرّك في الأرض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "71:28",
      "surahNumber": 71,
      "ayahNumber": 28,
      "text": "تبارًا : هَلاكًا وَ دَمارًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
