{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 96,
  "entries": [
    {
      "verseKey": "96:1",
      "surahNumber": 96,
      "ayahNumber": 1,
      "text": "Recite in the name of your Lord who created –",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:2",
      "surahNumber": 96,
      "ayahNumber": 2,
      "text": "Created man from a clinging substance.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:3",
      "surahNumber": 96,
      "ayahNumber": 3,
      "text": "Recite, and your Lord is the most Generous -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:4",
      "surahNumber": 96,
      "ayahNumber": 4,
      "text": "Who taught by the pen –",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:5",
      "surahNumber": 96,
      "ayahNumber": 5,
      "text": "Taught man that which he knew not.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:6",
      "surahNumber": 96,
      "ayahNumber": 6,
      "text": "No! [But] indeed, man transgresses",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:7",
      "surahNumber": 96,
      "ayahNumber": 7,
      "text": "Because he sees himself self-sufficient.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:8",
      "surahNumber": 96,
      "ayahNumber": 8,
      "text": "Indeed, to your Lord is the return.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:9",
      "surahNumber": 96,
      "ayahNumber": 9,
      "text": "Have you seen the one who forbids",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:10",
      "surahNumber": 96,
      "ayahNumber": 10,
      "text": "A servant when he prays?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:11",
      "surahNumber": 96,
      "ayahNumber": 11,
      "text": "Have you seen if he is upon guidance",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:12",
      "surahNumber": 96,
      "ayahNumber": 12,
      "text": "Or enjoins righteousness?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:13",
      "surahNumber": 96,
      "ayahNumber": 13,
      "text": "Have you seen if he denies and turns away -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:14",
      "surahNumber": 96,
      "ayahNumber": 14,
      "text": "Does he not know that Allāh sees?",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:15",
      "surahNumber": 96,
      "ayahNumber": 15,
      "text": "No! If he does not desist, We will surely drag him by the forelock –",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:16",
      "surahNumber": 96,
      "ayahNumber": 16,
      "text": "A lying, sinning forelock.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:17",
      "surahNumber": 96,
      "ayahNumber": 17,
      "text": "Then let him call his associates;",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:18",
      "surahNumber": 96,
      "ayahNumber": 18,
      "text": "We will call the angels of Hell.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "96:19",
      "surahNumber": 96,
      "ayahNumber": 19,
      "text": "No! Do not obey him. But prostrate and draw near [to Allāh].",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
