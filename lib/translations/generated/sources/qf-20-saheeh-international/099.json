{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 99,
  "entries": [
    {
      "verseKey": "99:1",
      "surahNumber": 99,
      "ayahNumber": 1,
      "text": "When the earth is shaken with its [final] earthquake",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "99:2",
      "surahNumber": 99,
      "ayahNumber": 2,
      "text": "And the earth discharges its burdens",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "99:3",
      "surahNumber": 99,
      "ayahNumber": 3,
      "text": "And man says, \"What is [wrong] with it?\" -",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "99:4",
      "surahNumber": 99,
      "ayahNumber": 4,
      "text": "That Day, it will report its news",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "99:5",
      "surahNumber": 99,
      "ayahNumber": 5,
      "text": "Because your Lord has inspired [i.e., commanded] it.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "99:6",
      "surahNumber": 99,
      "ayahNumber": 6,
      "text": "That Day, the people will depart separated [into categories] to be shown [the result of] their deeds.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "99:7",
      "surahNumber": 99,
      "ayahNumber": 7,
      "text": "So whoever does an atom's weight of good will see it,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "99:8",
      "surahNumber": 99,
      "ayahNumber": 8,
      "text": "And whoever does an atom's weight of evil will see it.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
