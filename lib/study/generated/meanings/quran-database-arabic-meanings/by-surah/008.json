{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 8,
  "entries": [
    {
      "verseKey": "8:1",
      "surahNumber": 8,
      "ayahNumber": 1,
      "text": "الأنفال : غنائم بدر\\nلله و الرّسول : مفوّضٌ إليهما أمرُها\\nذات بينكم : أحوالكم التي يحصل بها اتّصالكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:2",
      "surahNumber": 8,
      "ayahNumber": 2,
      "text": "وجلت قلوبهم : فزعت و رقّت استعظاما و هيبة\\nيتوكّلون : يعتمدون و إلى الله يُفوّضون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:7",
      "surahNumber": 8,
      "ayahNumber": 7,
      "text": "الطائفين : هما العير و النّفير\\nذات الشّوكة : ذات السّلاح و القوّة . و هي النّفير\\nدابر الكافرين : آخرهم و المراد جميعهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:9",
      "surahNumber": 8,
      "ayahNumber": 9,
      "text": "مُردفين : مُتبِعا بعضهم بعضا آخر منهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:11",
      "surahNumber": 8,
      "ayahNumber": 11,
      "text": "يغشّيكم النّعاس : يجعله غاشيا عليكم كالغطاء\\nأمنة منه : أمنا من الله و تقوية لكم\\nرجز الشّيطان : وسوسته و تخويفه إياكم من العطش\\nليربط : يشدّ و يقوّي باليقين و الصّبر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:12",
      "surahNumber": 8,
      "ayahNumber": 12,
      "text": "أنِّي معكم : مُعينكم على تثبيت المؤمنين\\nالرّعب : الخوف و الفزع و الإنزعاج\\nكلّ بنان : كلّ الأطراف أو كلّ مفصل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:13",
      "surahNumber": 8,
      "ayahNumber": 13,
      "text": "شاقّوا : خالفوا و عصوْا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:15",
      "surahNumber": 8,
      "ayahNumber": 15,
      "text": "زحفا : جيشا زاحفا نحوكم لقتالكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:16",
      "surahNumber": 8,
      "ayahNumber": 16,
      "text": "مُتحرّفا : مظهرا الفرار خِدعة ثم يكرّ\\nمُتحيّزا إلى فئة : منضمّا إليها ليقاتل العدوّ معها\\nباء بغضب : رجع متلبّسا به مستحقّا له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:17",
      "surahNumber": 8,
      "ayahNumber": 17,
      "text": "لِيُبليَ المؤمنين : ليُنعم عليهم بالنّصر و الأجر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:18",
      "surahNumber": 8,
      "ayahNumber": 18,
      "text": "موهن . . : مُضعف . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:19",
      "surahNumber": 8,
      "ayahNumber": 19,
      "text": "تستفتحوا : تطلبوا النّصر لأهدى الفئتين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:24",
      "surahNumber": 8,
      "ayahNumber": 24,
      "text": "يُحييكم : يورثكم حياةً أبديّة في نعيم سرمديّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:26",
      "surahNumber": 8,
      "ayahNumber": 26,
      "text": "يتخطّفكم النّاس : يستلبوكم و يصطلموكم بسرعة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:28",
      "surahNumber": 8,
      "ayahNumber": 28,
      "text": "فتنة : ابتلاء و محنة أو سبب في الإثم و العقاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:29",
      "surahNumber": 8,
      "ayahNumber": 29,
      "text": "فرقانا : هداية و نورا أو نجاة . أو مخرجًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:30",
      "surahNumber": 8,
      "ayahNumber": 30,
      "text": "ليُثبتوك : ليحبسوك أو ليُقيّدوك بالوثاق\\nيمكر الله : يعاملهم معاملة الماكرين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:31",
      "surahNumber": 8,
      "ayahNumber": 31,
      "text": "أساطير الأوّلين : أكاذيبهم المسطورة في كتبهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:35",
      "surahNumber": 8,
      "ayahNumber": 35,
      "text": "مُكاءً و تصدية : صفيرا و تصفيقا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:36",
      "surahNumber": 8,
      "ayahNumber": 36,
      "text": "حسرة : ندما و تأسّفا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:37",
      "surahNumber": 8,
      "ayahNumber": 37,
      "text": "فيركمه جميعا : فيجمعه ملقى بعضه على بعض",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:38",
      "surahNumber": 8,
      "ayahNumber": 38,
      "text": "سُنّة الأوّلين : عادة الله في المُكذّبين لرسله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:39",
      "surahNumber": 8,
      "ayahNumber": 39,
      "text": "فتنة : شرك أو بلاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:41",
      "surahNumber": 8,
      "ayahNumber": 41,
      "text": "لله خُمسه : و الأربعة الأخماس للغانمين\\nيوم الفرقان : بين الحقّ و الباطل (يوم بدر)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:42",
      "surahNumber": 8,
      "ayahNumber": 42,
      "text": "بالعدوة الدّنيا : بحافّة الوادي و ضفّته الأقرب للمدينة\\nالرّكب : عير قريش فيها أموالهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:43",
      "surahNumber": 8,
      "ayahNumber": 43,
      "text": "لَفشلتهم : لجُبنتُم عن القتال و هبتموه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:46",
      "surahNumber": 8,
      "ayahNumber": 46,
      "text": "تذهب ريحكم : تتلاشى قوّتكم أو دولتكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:47",
      "surahNumber": 8,
      "ayahNumber": 47,
      "text": "بطرًا : طغيانًا أو فخرا و أشرّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:48",
      "surahNumber": 8,
      "ayahNumber": 48,
      "text": "إنِّي جار لكم : مُجير و مُعين و ناصر لكم\\nنكص على عقبيه : رجع القهقري و ولّى مُدبرا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:52",
      "surahNumber": 8,
      "ayahNumber": 52,
      "text": "كدأب : كعادة . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:57",
      "surahNumber": 8,
      "ayahNumber": 57,
      "text": "تثقفنّهم : تصادفنّهم و تظفرنّ بهم\\nفشرِّد بهم : ففرّق و بدّد و خوّف بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:58",
      "surahNumber": 8,
      "ayahNumber": 58,
      "text": "من قوم : قد عاهدوك\\nفانبذ إليهم : فاطرح إليهم عهدهم و حاربهم\\nعلى سواء : على استواء في العلم بنبذه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:59",
      "surahNumber": 8,
      "ayahNumber": 59,
      "text": "سبقوا : خلصوا و أفلتوا من العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:60",
      "surahNumber": 8,
      "ayahNumber": 60,
      "text": "قوّة : كل ما يُتقوّى به في الحرب\\nرباط الخيل : حبسها للجهاد في سبيل الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:61",
      "surahNumber": 8,
      "ayahNumber": 61,
      "text": "جنحوا للسّلم : مالوا للمُسالمة و المصالحة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:62",
      "surahNumber": 8,
      "ayahNumber": 62,
      "text": "حسبك الله : كافيك في دفع خديعتهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:65",
      "surahNumber": 8,
      "ayahNumber": 65,
      "text": "حرِّض المؤمنين : بالغ في حثّهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:67",
      "surahNumber": 8,
      "ayahNumber": 67,
      "text": "يُثخن : يُبالغ في القتل حتى يذل الكفر\\nعرض الدّنيا : حطامها بأخذكم الفدية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:71",
      "surahNumber": 8,
      "ayahNumber": 71,
      "text": "فأمكن منهم : فأقدرك عليهم يوم بدر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "8:75",
      "surahNumber": 8,
      "ayahNumber": 75,
      "text": "أولوا الأرحام : ذووا القربات\\nأوْلى : بالميراث من الأجانب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
