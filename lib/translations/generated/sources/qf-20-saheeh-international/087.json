{
  "sourceId": "qf-20-saheeh-international",
  "sourceName": "Saheeh International",
  "language": "en",
  "direction": "ltr",
  "surahNumber": 87,
  "entries": [
    {
      "verseKey": "87:1",
      "surahNumber": 87,
      "ayahNumber": 1,
      "text": "Exalt the name of your Lord, the Most High,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:2",
      "surahNumber": 87,
      "ayahNumber": 2,
      "text": "Who created and proportioned",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:3",
      "surahNumber": 87,
      "ayahNumber": 3,
      "text": "And who destined and [then] guided",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:4",
      "surahNumber": 87,
      "ayahNumber": 4,
      "text": "And who brings out the pasture",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:5",
      "surahNumber": 87,
      "ayahNumber": 5,
      "text": "And [then] makes it black stubble.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:6",
      "surahNumber": 87,
      "ayahNumber": 6,
      "text": "We will make you recite, [O Muḥammad], and you will not forget,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:7",
      "surahNumber": 87,
      "ayahNumber": 7,
      "text": "Except what Allāh should will. Indeed, He knows what is declared and what is hidden.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:8",
      "surahNumber": 87,
      "ayahNumber": 8,
      "text": "And We will ease you toward ease.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:9",
      "surahNumber": 87,
      "ayahNumber": 9,
      "text": "So remind, if the reminder should benefit;",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:10",
      "surahNumber": 87,
      "ayahNumber": 10,
      "text": "He who fears [Allāh] will be reminded.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:11",
      "surahNumber": 87,
      "ayahNumber": 11,
      "text": "But the wretched one will avoid it –",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:12",
      "surahNumber": 87,
      "ayahNumber": 12,
      "text": "[He] who will [enter and] burn in the greatest Fire,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:13",
      "surahNumber": 87,
      "ayahNumber": 13,
      "text": "Neither dying therein nor living.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:14",
      "surahNumber": 87,
      "ayahNumber": 14,
      "text": "He has certainly succeeded who purifies himself",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:15",
      "surahNumber": 87,
      "ayahNumber": 15,
      "text": "And mentions the name of his Lord and prays.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:16",
      "surahNumber": 87,
      "ayahNumber": 16,
      "text": "But you prefer the worldly life,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:17",
      "surahNumber": 87,
      "ayahNumber": 17,
      "text": "While the Hereafter is better and more enduring.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:18",
      "surahNumber": 87,
      "ayahNumber": 18,
      "text": "Indeed, this is in the former scriptures,",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    },
    {
      "verseKey": "87:19",
      "surahNumber": 87,
      "ayahNumber": 19,
      "text": "The scriptures of Abraham and Moses.",
      "sourceId": "qf-20-saheeh-international",
      "sourceName": "Saheeh International"
    }
  ]
}
