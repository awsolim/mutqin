{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 43,
  "entries": [
    {
      "verseKey": "43:4",
      "surahNumber": 43,
      "ayahNumber": 4,
      "text": "أمّ الكتاب : اللّوح المحفوظ . أو العلم الأزليّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:5",
      "surahNumber": 43,
      "ayahNumber": 5,
      "text": "أفنضرب عنكم الذكر : أفنترك تذكيركم و إلزامكم الحجّة بإنزال القرآن\\nصَفحًا : إعراضا أو مُعرضين عنكم\\nأن كنتم قوما مسرفين ؟ : لكونكم مُفرطين في الجهالة و الضّلالة ؟ لا نتركه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:6",
      "surahNumber": 43,
      "ayahNumber": 6,
      "text": "كم أرسلنا : كثيرا أرسلنا\\nفي الأولين : في الأمم السّابقة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:8",
      "surahNumber": 43,
      "ayahNumber": 8,
      "text": "بطْشًا : قوة\\nمثل الأوّلين : صفتهم أو قصّـتهم العجيبة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:10",
      "surahNumber": 43,
      "ayahNumber": 10,
      "text": "الأرض مهدا : فِراشا ممهّدا للاستقرار عليها\\nسُبُـلاً : طُرُقا تسلكونها . أو معايش",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:11",
      "surahNumber": 43,
      "ayahNumber": 11,
      "text": "ماءً بقدَر : بتقدير مُحكمٍ أو بمقدار الحاجة\\nفأنشرنا به : فأحيينا بالماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:12",
      "surahNumber": 43,
      "ayahNumber": 12,
      "text": "خلَقَ الأزواج : أوجد أصناف المخلوقات و أنواعها\\nو الأنعام : و من الأنعام و هو الإبل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:13",
      "surahNumber": 43,
      "ayahNumber": 13,
      "text": "لتستووا : لتستقرّوا . و تستعلوا\\nسخّر : ذلـّـل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:16",
      "surahNumber": 43,
      "ayahNumber": 16,
      "text": "مُقرنين : مُطيقين و غالبين أو ضابطين\\nأصفاكم بالبنين : أخلصكم و آثركم بهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:17",
      "surahNumber": 43,
      "ayahNumber": 17,
      "text": "مثلا : شِبْهاً و مُما ثِلا\\nهو كظيم : مملوء في قلبه غيظا و غمّـا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:18",
      "surahNumber": 43,
      "ayahNumber": 18,
      "text": "يُنشّـأ في الحلية : يُربّى في الزّينة و النعمة (البنات)\\nفي الخصام : المُخاصمة و الجدال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:20",
      "surahNumber": 43,
      "ayahNumber": 20,
      "text": "يخرصون : يكذبون فيما قالوه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:22",
      "surahNumber": 43,
      "ayahNumber": 22,
      "text": "على أمّة : على دين و طريقة تـُـؤمّ و تـُـقـْـصد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:23",
      "surahNumber": 43,
      "ayahNumber": 23,
      "text": "قال مُترفوها : مُـتنعّموها المنغمسون في شهواتهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:26",
      "surahNumber": 43,
      "ayahNumber": 26,
      "text": "إنّـني براء : بريءٌ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:27",
      "surahNumber": 43,
      "ayahNumber": 27,
      "text": "فطرني : خلقـَـني و أبدعني",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:28",
      "surahNumber": 43,
      "ayahNumber": 28,
      "text": "كلمة باقية : كلمة التوحيد ، أو البراءة\\nفي عَقِبه : ذرّيته إلى يوم القيامة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:31",
      "surahNumber": 43,
      "ayahNumber": 31,
      "text": "من القريتين : من إحدى القريتين مكّة و الطائف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:32",
      "surahNumber": 43,
      "ayahNumber": 32,
      "text": "سُخريّـا : مسخّرا في العمل ، مُسْتخدَما فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:33",
      "surahNumber": 43,
      "ayahNumber": 33,
      "text": "أمّة واحدة : مُطْبـِـقـَـة ً على الكفر حبّـا للدنيا\\nمعارج : مصاعِد و مَراقي و دَرَجا من فضّة\\nيظهرون : يَـصعدون و يرتقون",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:35",
      "surahNumber": 43,
      "ayahNumber": 35,
      "text": "زخرُفا : ذهبا ، أو زينة مزوقة ً\\nلمّا متاع . . : إلاّ متاع . .",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:36",
      "surahNumber": 43,
      "ayahNumber": 36,
      "text": "من يعْشُ : من يتعامَ و يُعْرض و يتغافل\\nنقيّض له : نسبّـب . أو نتِـحْ له\\nله قرين : مُصاحبٌ له لا يُفارقه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:44",
      "surahNumber": 43,
      "ayahNumber": 44,
      "text": "إنه لذكر : إن القرآن لشرفٌ عظيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:49",
      "surahNumber": 43,
      "ayahNumber": 49,
      "text": "بما عَهِد عندك : منْ كشف العذاب عمّن اهتدى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:50",
      "surahNumber": 43,
      "ayahNumber": 50,
      "text": "ينْـكثون : ينقضون عهدهم بالإهتداء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:52",
      "surahNumber": 43,
      "ayahNumber": 52,
      "text": "هوَ مَهين : ضعيف حقيرٌ\\nيُبين : يُفصِح الكلام لِلـُـثغَة في لسانه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:53",
      "surahNumber": 43,
      "ayahNumber": 53,
      "text": "مُقترنين : مقرونين به يُصدقونه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:54",
      "surahNumber": 43,
      "ayahNumber": 54,
      "text": "فاستخفّ قومه : وجدهم خفاف العقول",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:55",
      "surahNumber": 43,
      "ayahNumber": 55,
      "text": "آسفونا : أغْضَبونا أشدّ الغضب بأعمالهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:56",
      "surahNumber": 43,
      "ayahNumber": 56,
      "text": "سَلَفا : قدْوَة للكفّار في استحقاق العقاب\\nمثلا للآخرين : عِـبْرَة و عظة للكفّار بعدهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:57",
      "surahNumber": 43,
      "ayahNumber": 57,
      "text": "منه يصدّون : من أجله يضجّون و يصيحونَ فرَحا و جَذلاً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:58",
      "surahNumber": 43,
      "ayahNumber": 58,
      "text": "قوم خصِمون : لُدّ شداد الخصومة بالباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:59",
      "surahNumber": 43,
      "ayahNumber": 59,
      "text": "مثلا : آية و عبرة عجيبة كالمثل السّـائر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:60",
      "surahNumber": 43,
      "ayahNumber": 60,
      "text": "لجعلنا منكم : بذلكم . أو لولـّـدْنا منكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:61",
      "surahNumber": 43,
      "ayahNumber": 61,
      "text": "إنه لعلمٌ للسّـاعة : يُعلَم قربُها بنزوله (عليه السلام)\\nفلا تمترنّ بها : فلا تشكّنّ في قيَامها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:65",
      "surahNumber": 43,
      "ayahNumber": 65,
      "text": "فويل : هلاك أو حسرة أو شدّة عذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:66",
      "surahNumber": 43,
      "ayahNumber": 66,
      "text": "هل ينظرون : هل ينتظرون\\nبغتتة : فجأة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:67",
      "surahNumber": 43,
      "ayahNumber": 67,
      "text": "الأخلاء : الأحباء في غير ذات الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:70",
      "surahNumber": 43,
      "ayahNumber": 70,
      "text": "تحبَرون : تسرّون سرورا ظاهرَ الأثر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:71",
      "surahNumber": 43,
      "ayahNumber": 71,
      "text": "أكوابٍ : أقداح لا عُرَى لها و لا خراطيم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:75",
      "surahNumber": 43,
      "ayahNumber": 75,
      "text": "لا يُفتـّـر عنهم : لا يُخـفّـف عنهم\\nمُبلسون : ساكنون أو حزينون من شدّة اليأس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:77",
      "surahNumber": 43,
      "ayahNumber": 77,
      "text": "ليقضِ علينا ربّك : ليُمتـْـنا حتـّى نخلُـصَ من هذا العذاب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:79",
      "surahNumber": 43,
      "ayahNumber": 79,
      "text": "أمْ أبرموا أمرًا : بلْ أأحكموا كيْدا له صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:80",
      "surahNumber": 43,
      "ayahNumber": 80,
      "text": "نجواهم : تناجيهم فيما بينهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:83",
      "surahNumber": 43,
      "ayahNumber": 83,
      "text": "يخوضوا : يدخلوا مدَاخل الباطل",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:84",
      "surahNumber": 43,
      "ayahNumber": 84,
      "text": "في السّمـاء إله : هو معْبودٌ في السّماء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:85",
      "surahNumber": 43,
      "ayahNumber": 85,
      "text": "تبارك الذي . . : تعالى أو تكاثر خيْرُه و إحسانه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:87",
      "surahNumber": 43,
      "ayahNumber": 87,
      "text": "فأنّى يُأفكون : فكيف يُصْرُفون عن عبادته تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:88",
      "surahNumber": 43,
      "ayahNumber": 88,
      "text": "وَ قِـيـلِه : و عنده علم قول الرسول صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "43:89",
      "surahNumber": 43,
      "ayahNumber": 89,
      "text": "فاصفحْ عنهم : فأعرض عنهم\\nسلامٌ : أمري تـَـسلـّــمٌ و مُـتـَـاركة ٌ لكم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
