{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 89,
  "entries": [
    {
      "verseKey": "89:1",
      "surahNumber": 89,
      "ayahNumber": 1,
      "text": "و الفجر : (أَقْسَمَ تعالى) بالوقتِ المعروف",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:2",
      "surahNumber": 89,
      "ayahNumber": 2,
      "text": "و ليالٍ عشْر : العَشْرِ الأُوَلِ من ذِى الحِجَّة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:3",
      "surahNumber": 89,
      "ayahNumber": 3,
      "text": "و الشّـفـع و الوتر : يومِ النَّحْرِ ، ويَومِ عَرَفَة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:4",
      "surahNumber": 89,
      "ayahNumber": 4,
      "text": "و الليل إذا يَسْر : إذا يَمضِى ويَذهَبُ أو يُسارُ فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:5",
      "surahNumber": 89,
      "ayahNumber": 5,
      "text": "هَلْ في ذلك : المذكورِ الذى أَقـسَمْـنـَا به\\nقـَـسَـمٌ لذي حِجْر ؟ : مُقسَمٌ به حَقيقٌ بالتعظيمِ لدى العُقلاءِ ـ نعم ـ (وجواب القسم) لـَنُعذبَنَّ الكافرين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:6",
      "surahNumber": 89,
      "ayahNumber": 6,
      "text": "بـِعادٍ : \\\"قَومِ هُودٍ ؛ سُمُّوا باسمِ أبيهم\\\"",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:7",
      "surahNumber": 89,
      "ayahNumber": 7,
      "text": "إرَم : هو اسمُ جَدِّهم وبه سُمِّـيَت القبيلة\\nذات العِماد : الشدةِ أو الأبْنِية الرَّفيعةِ المُحكَمَة بالعَمَد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:9",
      "surahNumber": 89,
      "ayahNumber": 9,
      "text": "جابوا الصّخْـر : قَـطَعُوه ونـَحَتـُوا فيه بيوتـَهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:10",
      "surahNumber": 89,
      "ayahNumber": 10,
      "text": "ذي الأوتاد : الجُيُوشِ الكثيرةِ التى تَشُدُّ مُـلـْـكَه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:13",
      "surahNumber": 89,
      "ayahNumber": 13,
      "text": "سَوْط عذاب : عذابًا شديدًا مُؤلِمًا دائمًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:14",
      "surahNumber": 89,
      "ayahNumber": 14,
      "text": "إنّ ربّـك لبالمرصاد : يَرقـُـبُ أعمَالَهم ويُجازيهم عليها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:15",
      "surahNumber": 89,
      "ayahNumber": 15,
      "text": "ابْـتلاه ربّه : امْـتـَحَنه واخـتـَـبَره بالنعم أو الـنـِّقم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:16",
      "surahNumber": 89,
      "ayahNumber": 16,
      "text": "فقدر عليه رزقه : فَضَـيَّـقـَه عليه ولم يَبسُطْه له",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:17",
      "surahNumber": 89,
      "ayahNumber": 17,
      "text": "كلاّ : رَدْعٌ للإنسان عمَّا قاله فى الحالَيْن\\nبلْ : لكم أعمالٌ أسوأ ُ من ذلك",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:18",
      "surahNumber": 89,
      "ayahNumber": 18,
      "text": "لا تحاضّون : لا يَحُثُّ بعضُكم بعضًا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:19",
      "surahNumber": 89,
      "ayahNumber": 19,
      "text": "تأكلون التـّـراث : مِيراثَ النساءِ والصِّغار\\nأكْلاً لمّـا : جَمعًا بين الحلال والحرام",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:20",
      "surahNumber": 89,
      "ayahNumber": 20,
      "text": "حُـبّـا جَمّـا : كثيًرا مع حِرصٍ وشَرَهٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:21",
      "surahNumber": 89,
      "ayahNumber": 21,
      "text": "دُكّتِ الأرض : دقَّـتْ وكُـسِرَتْ بالزَّلازل\\nدكّـا دكّـا : دَكًّا مُـتـَتـَابـِعًا حتى صارت هَباءً",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:22",
      "surahNumber": 89,
      "ayahNumber": 22,
      "text": "و المَـلـَـك : ملائكة ُ كلِّ سماءٍ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:23",
      "surahNumber": 89,
      "ayahNumber": 23,
      "text": "أنـّـى له الذكرى : من أين له مَنفـَعَـتـُها ؟ هـَيْهات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "89:26",
      "surahNumber": 89,
      "ayahNumber": 26,
      "text": "لا يوثِـق : لا يَشُـدُّ بالسلاسلِ والأغلال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
