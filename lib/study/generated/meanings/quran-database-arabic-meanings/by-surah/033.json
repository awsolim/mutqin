{
  "kind": "meaning",
  "source": "Quran-Database - Arabic Meanings",
  "sourceId": "quran-database-arabic-meanings",
  "language": "ar",
  "direction": "rtl",
  "surahNumber": 33,
  "entries": [
    {
      "verseKey": "33:1",
      "surahNumber": 33,
      "ayahNumber": 1,
      "text": "اتّقِ الله : دُمْ على تقواه أو ازدد منها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:3",
      "surahNumber": 33,
      "ayahNumber": 3,
      "text": "وكيلا : حافظا مفَـوّضـًـا إليه كلّ أمر",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:4",
      "surahNumber": 33,
      "ayahNumber": 4,
      "text": "تُظاهرون منهنّ : تُحرّمونهنّ كحُرمة أمّهاتكم\\nأدعياءكم : من تتبنّونهم من أبناء غيركم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:5",
      "surahNumber": 33,
      "ayahNumber": 5,
      "text": "أقْسط : أعدل\\nمواليكم : أولياؤكم في الدّين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:6",
      "surahNumber": 33,
      "ayahNumber": 6,
      "text": "أولى بالمؤمنين : أرأف بهم ، و أنفع لهم\\nأزواجه أمّهاتهم : مثلهنّ في تحريم نكاحهنّ و تعظيم حُرمتهنّ\\nأولوا الأرحام : ذوو القرابات",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:7",
      "surahNumber": 33,
      "ayahNumber": 7,
      "text": "ميثاقهم : العَهدَ على الوفاء بما حُـمّـلوا\\nميثاقا غليظا : عهدا وثيقا قويّا على الوفاء",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:9",
      "surahNumber": 33,
      "ayahNumber": 9,
      "text": "جاءتكم جنود : الأحزاب يوم الخندق سنة خمس",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:10",
      "surahNumber": 33,
      "ayahNumber": 10,
      "text": "زاغت الأبصار : مالتْ عن سَنـَـنها حَيْرة و دهشة\\nبلغتِ القلوب الحناجر : نهايات الحلاقيم ( تمثيل لشدّة الخوف )",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:11",
      "surahNumber": 33,
      "ayahNumber": 11,
      "text": "ابتـُـلِـيَ المؤمنون : اختـُـبـِـروا بالشّدائد و مُحّصوا\\nزلزلوا : اضطربوا كثيرا من شدّة الفزع",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:12",
      "surahNumber": 33,
      "ayahNumber": 12,
      "text": "غرورا : قولا باطلا . أو خداعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:13",
      "surahNumber": 33,
      "ayahNumber": 13,
      "text": "يثرب : اسم المدينة المنوّرة قديما\\nلا مُقام لكم : لا إقامة لكم هـهنا\\nإن بيوتنا عورة : قاصية يخشى عليها العدوّ\\nفِرارًا : هرَبا من القتال مع المؤمنين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:14",
      "surahNumber": 33,
      "ayahNumber": 14,
      "text": "من أقطارها : نواحيها و جوانبهاد\\nسُــئـلوا الفتنة : طـُـلِـبَ منهم مُقاتلة المسلمين\\nما تلبّـثوا بها : ما أخّروا المقاتلة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:17",
      "surahNumber": 33,
      "ayahNumber": 17,
      "text": "يعصِمكم من الله : يمنعكم من قَدَره تعالى",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:18",
      "surahNumber": 33,
      "ayahNumber": 18,
      "text": "المعوّقين منكم : المُثَبّطين منكم عن الرّسول صلى الله عليه و سلم\\nهلمّ إلينا : أقبـِـلوا أو قرّبوا أنفسكم إلينا\\nالبأس : الحرب و القتال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:19",
      "surahNumber": 33,
      "ayahNumber": 19,
      "text": "أشحّةً عليكم : بُخلاء عليكم بكلّ ما ينفعكم\\nيُغشى عليه من الموت : تُصيبه الغشية من سكراته\\nسلقوكم : آذوكم و رموكم\\nبألسنة حدادٍ : ذربة سليطة قاطعة كالحديد\\nأشحّة على الخير : بُخلاء حريصين على المال و الغنيمة\\nفأحبط الله : كأبطل الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:20",
      "surahNumber": 33,
      "ayahNumber": 20,
      "text": "بادون في الأعراب : كانوا معهم في البادية",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:21",
      "surahNumber": 33,
      "ayahNumber": 21,
      "text": "أُسوة حسنة : قُدْوة صالحة في كلّ الأمور",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:23",
      "surahNumber": 33,
      "ayahNumber": 23,
      "text": "قضى نحبه : وفيّ بنـَذره . أو مات شهيدا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:26",
      "surahNumber": 33,
      "ayahNumber": 26,
      "text": "الذين ظاهروهم : يهود قريظة الذين عاونوا الأحزاب\\nصياصيهم : حصونهم و معاقلهم\\nالرّعب : الخوف الشّديد",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:28",
      "surahNumber": 33,
      "ayahNumber": 28,
      "text": "أمتّعكنّ : أعطكنّ مُتعة الطّلاق\\nأسرّحكنّ : أطلّقكنّ\\nسراحا جميلا : طلاقا حسنا لا ضِرار فيه",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:30",
      "surahNumber": 33,
      "ayahNumber": 30,
      "text": "بفاحشة مُـبَـيّـنة : بمعصية كبيرة ظاهرة القُبح",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:31",
      "surahNumber": 33,
      "ayahNumber": 31,
      "text": "يقنت منكنّ : تثطِعْ أو تخضعْ من كنّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:32",
      "surahNumber": 33,
      "ayahNumber": 32,
      "text": "فلا تخضعن بالقول : لا تلنّ القول و لا ترقّـقـنه للرّجال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:33",
      "surahNumber": 33,
      "ayahNumber": 33,
      "text": "قَرْنَ في بيوتكنّ : الزمنَ بيوتكنّ و كذا جميع النّساء\\nلا تبرّجن : لا تُبدين الزّينة الواجب سترُها\\nالجاهليّة الأولى : ما كان قبل الإسلام من الجهالات\\nالرّجس : الذنب. أو الإثم أو النّقص",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:34",
      "surahNumber": 33,
      "ayahNumber": 34,
      "text": "الحكمة : هدي النّبوّة أو أحكام القرآن",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:35",
      "surahNumber": 33,
      "ayahNumber": 35,
      "text": "القانتين : المطيعين الخاضعين لله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:36",
      "surahNumber": 33,
      "ayahNumber": 36,
      "text": "الخِـيَـرَة : الإختيار",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:37",
      "surahNumber": 33,
      "ayahNumber": 37,
      "text": "وطرا : حاجته المهمّة ، كناية عن الطّلاق\\nحرجٌ : ضيق أو إثم\\nأدعيائهم : من تبنّوهم (قبل نسخ التّبنّي)",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:38",
      "surahNumber": 33,
      "ayahNumber": 38,
      "text": "فرض الله له : قسَمَ له أو قدّر أو أحلّ له\\nخلوْا من قبل : مضوْا من قبلك من الأنبياء\\nقدَرا مقدورا : مُرادا أزلاً . أو قضاءً مقضيّا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:39",
      "surahNumber": 33,
      "ayahNumber": 39,
      "text": "حسيبا : مُحاسبا على الأعمال",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:42",
      "surahNumber": 33,
      "ayahNumber": 42,
      "text": "بُكرة و أصيلا : أوّل النّهار و آخره",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:49",
      "surahNumber": 33,
      "ayahNumber": 49,
      "text": "سراحا جميلا : عاريا عن أذى و منع واجب",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:50",
      "surahNumber": 33,
      "ayahNumber": 50,
      "text": "آتيت أجورهنّ : أعطيتهنّ مهورهنّ\\nأفاء الله عليك : رجعه إليك من الغنيمة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:51",
      "surahNumber": 33,
      "ayahNumber": 51,
      "text": "تُرجي : تُأخّر و لا تضاجع\\nتُـؤوي إليك : تَضمّ إليك و تضاجع\\nإبتغَيْتَ : طلبت\\nعَزَلـتَ : اجتنبت بالإرجاء\\nذلك أدنى أن تقرّ أعينهنّ : التفويض إلى مشيئتك أقرب إلى سرورهنّ لعلمهنّ أنّه بحُكم الله",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:52",
      "surahNumber": 33,
      "ayahNumber": 52,
      "text": "رقيبا : حفيظا و مضطلعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:53",
      "surahNumber": 33,
      "ayahNumber": 53,
      "text": "غير ناظرين إناه : غير منتظرين نضجه و استواءه\\nفانتشروا : فتفرّقوا و لا تمكُثوا عنده\\nسألتموهنّ متاعا : حاجة يُنتفع بها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:56",
      "surahNumber": 33,
      "ayahNumber": 56,
      "text": "يُصلّون على النبيّ : يُـثنون عليه بإظهار شرفه و تعظيم شأنه صلى الله عليه و سلم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:58",
      "surahNumber": 33,
      "ayahNumber": 58,
      "text": "بُهتانا : فعلا شنيعا . أو كذبا فظيعا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:59",
      "surahNumber": 33,
      "ayahNumber": 59,
      "text": "يُدنين عليهنّ : يُرخين و يُـسْدِلن عليهن\\nجلابيبهنّ : ما يستتِـرن به كالمِلاءة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:60",
      "surahNumber": 33,
      "ayahNumber": 60,
      "text": "المرجفون : المشيعون للأخبار الكاذبة\\nلَنُغرينّك بهم : لنسلّطنّك عليهم",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:61",
      "surahNumber": 33,
      "ayahNumber": 61,
      "text": "ثقِـفوا : وُجدوا و أدركوا",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:68",
      "surahNumber": 33,
      "ayahNumber": 68,
      "text": "ضعفين : مِثلين",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:69",
      "surahNumber": 33,
      "ayahNumber": 69,
      "text": "وجيها : ذا جاهٍ و قدر مُستجاب الدّعوة",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:70",
      "surahNumber": 33,
      "ayahNumber": 70,
      "text": "قولا سديدا : صوابا . أو صدقا. أو قاصدا إلى الحقّ",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    },
    {
      "verseKey": "33:72",
      "surahNumber": 33,
      "ayahNumber": 72,
      "text": "عرضنا الأمانة : التّكاليف من أوامر و نواهٍ\\nفأبين : امتنعنَ\\nأشفقن منها : خِفـْـنَ من الخيانة فيها",
      "kind": "meaning",
      "source": "Quran-Database - Arabic Meanings",
      "sourceId": "quran-database-arabic-meanings",
      "language": "ar",
      "direction": "rtl"
    }
  ]
}
